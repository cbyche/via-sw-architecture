 id="e67" value="journal + projection + 위치/intent 원자 확정" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1322" y="802" width="550.64" height="34.35" /></mxCell><mxCell id="e69" value="내구 확정 결과 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1322" y="913" width="215.06" height="34.35" /></mxCell><mxCell id="e71" value="3  같은 현재 검사 뒤 c9 전송" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1322" y="1024" width="327.2" height="34.35" /></mxCell><mxCell id="e73" value="접수 확인 전 같은 종료; 없던 ACK는 만들지 않음" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1322" y="1135" width="521.24" height="34.35" /></mxCell><mxCell id="e75" value="4  유효 checkpoint + tail → reducer 재생" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1322" y="1246" width="508.64" height="34.35" /></mxCell><mxCell id="e77" value="복원 상태/사건 위치 반환; replay 자체는 전송 안 함" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1322" y="1357" width="573.32" height="34.35" /></mxCell><mxCell id="e79" value="5  c9 접수 여부 확인 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1322" y="1468" width="293.18" height="34.35" /></mxCell><mxCell id="e81" value="같은 command key로 외부 상태 조회" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1322" y="1579" width="392.3" height="34.35" /></mxCell><mxCell id="e83" value="접수/미접수/불명 상태 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1322" y="1690" width="291.08" height="34.35" /></mxCell><mxCell id="e85" value="확인된 상태만 사용자에게 게시" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1322" y="1801" width="320.06" height="34.35" /></mxCell><mxCell id="e87" value="읽을 결론: 같은 사건으로 상태 재구성과 원인 추적" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=22;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1322" y="2070" width="557.12" height="35.7" /></mxCell><mxCell id="e88" value="대가: 사건 schema/삭제/재생/검증 부담" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1322" y="2115" width="429.26" height="34.35" /></mxCell><mxCell id="e89" value="생략한 공통 연동: 추론은 Model Access의 한 벌 Omni; 업무 실행은 Task Manager/Agent Gateway가 Downstream Agent에 위임." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="2200" width="1285.94" height="31.650000000000002" /></mxCell><mxCell id="e90" value="실선 = 요청/전달, 점선 = 결과. 별도 언급 없는 참여자는 논리 책임. 시간 간격은 성능 수치가 아닌 사건 순서. 수작업 설계 추적, 미측정." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="2240" width="1323.18" height="31.650000000000002" /></mxCell></root></mxGraphModel></diagram></mxfile>

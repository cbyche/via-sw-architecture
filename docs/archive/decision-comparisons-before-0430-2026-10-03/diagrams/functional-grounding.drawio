ce=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1962" y="1810" width="491.36" height="82.95" /></mxCell><mxCell id="e91" value="검정 = 공통 / 파랑 = A 고유 / 초록 = B 고유 / 색은 선호나 우위가 아님" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=18;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="2024" width="683.0" height="30.3" /></mxCell><mxCell id="e92" value="제목 칸 = Component / 둥근 내부 상자 = Module / 원통 = 저장 / 육각형 = 외부 의존성" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=17;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="2058" width="786.6" height="28.950000000000003" /></mxCell><mxCell id="e93" value="구조 제안 / 미선정 / 미측정. B의 파생 대상 모델은 독립적인 source 사실이 아니다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=17;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="2091" width="736.96" height="28.950000000000003" /></mxCell><mxCell id="e94" value="실선 → 요청/전달   점선 → 반환/확인" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=17;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2168.06" y="2024" width="327.94" height="28.950000000000003" /></mxCell></root></mxGraphModel></diagram></mxfile>

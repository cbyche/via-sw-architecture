l=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=17;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="2058" width="786.6" height="28.950000000000003" /></mxCell><mxCell id="e106" value="생성 완료 ≠ 실제 청취. A도 게시 검증을 거치며 B도 streaming/중첩을 사용할 수 있다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=17;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="2091" width="762.12" height="28.950000000000003" /></mxCell><mxCell id="e107" value="실선 → 요청/전달   점선 → 반환/확인" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=17;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2168.06" y="2024" width="327.94" height="28.950000000000003" /></mxCell></root></mxGraphModel></diagram></mxfile>

overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=28;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="184" width="1435.44" height="43.800000000000004" /></mxCell><mxCell id="e7" value="공통 근거: Interaction Manager의 발화/화면 + Context Manager의 관련 자료 + Task Manager의 확인된 질문/결과" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=25;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="231" width="1519.0" height="39.75" /></mxCell><mxCell id="e9" value="A  통합 판단" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=35;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="295" width="234.8" height="53.25" /></mxCell><mxCell id="e10" value="관련 맥락을 모아 한 주체가 의미를 생산" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=25;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="346" width="501.0" height="39.75" /></mxCell><mxCell id="e11" value="B  Task별 지속 판단" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=35;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="888" y="295" width="378.3" height="53.25" /></mxCell><mxCell id="e12" value="공통 대화 + 생성된 Task마다 판단 담당" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=25;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="888" y="346" width="503.5" height="39.75" /></mxCell><mxCell id="e13" value="C  기능별 전문 판단" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#7446A4;fontSize=35;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1712" y="295" width="361.5" height="53.25" /></mxCell><mxCell id="e14" value="대상 / 업무 연결 / 관계를 나누어 생산" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#7446A4;fontSize=25;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1712" y="346" width="497.5" height="39.75" /></mxCell><mxCell id="e17" value="코드 조정" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="110" y="377" width="100.4" height="33.0" /></mxCell><mxCell id="e18" value="코드 조정" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="940" y="377" width="100.4" height="33.0" /></mxCell><mxCell id="e19" value="코드 조정" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1770" y="377" width="100.4" height="33.0" /></mxCell><mxCell id="e23" value="1  원문 + 관련 맥락" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=24;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="145" y="480" width="256.15999999999997" height="38.400000000000006" /></mxCell><mxCell id="e25" value="2  PDF + 결론 참조&lt;br&gt;두 요청의 관계" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=24;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="470" y="480" width="252.8" height="70.80000000000001" /></mxCell><mxCell id="e28" value="관련 기록 조회" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=24;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="140" y="675" width="181.76" height="38.400000000000006" /></mxCell><mxCell id="e30" value="조건/질문 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=24;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="140" y="712" width="181.76" height="38.400000000000006" /></mxCell><mxCell id="e31" value="기록 소유: Request Controller" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=25;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="175" y="850" width="433.5" height="39.75" /></mxCell><mxCell id="e32" value="정정: 메일 조건만 바꾼 의미 제안&lt;br&gt;Task별 검색 / 조건 보존 / 부분 수정 가능" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=26;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="108" y="886" width="571.68" height="74" /></mxCell><mxCell id="e33" value="아래 채택도 같은 Request Controller" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=22;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="115" y="963" width="448.44" height="35.7" /></mxCell><mxCell id="e38" value="1  원문/보고서 근거" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=24;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="968" y="488" width="250.4" height="38.400000000000006" /></mxCell><mxCell id="e40" value="1  원문/메일 근거&lt;br&gt;3  보고서의 결론 참조" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=24;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1325" y="480" width="274.4" height="70.80000000000001" /></mxCell><mxCell id="e42" value="2  PDF / 결론 참조" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=24;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="968" y="549" width="252.8" height="38.400000000000006" /></mxCell><mxCell id="e44" value="2  필요 참조 / 메일 제안" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=24;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1320" y="549" width="319.04" height="38.400000000000006" /></mxCell><mxCell id="e51" value="Task 수명 동안 각 담당이 조건/질문 보존" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=24;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="985" y="666" width="507.68" height="38.400000000000006" /></mxCell><mxCell id="e52" value="4  채택 후 저장 ↕ 이전 조건/질문 읽기" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=24;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="985" y="707" width="483.68" height="38.400000000000006" /></mxCell><mxCell id="e55" value="Task 없음 / 생성 전 / 교차 관계" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=24;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="967" y="849" width="417.44" height="38.400000000000006" /></mxCell><mxCell id="e57" value="정정: 메일 담당이 내용 교체 / PDF 조건 유지" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=24;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="972" y="963" width="561.44" height="38.400000000000006" /></mxCell><mxCell id="e62" value="1  원문/자료 후보" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#7446A4;fontSize=24;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1780" y="488" width="226.4" height="38.400000000000006" /></mxCell><mxCell id="e64" value="1  원문/Task 후보" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#7446A4;fontSize=24;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2140" y="488" width="237.92" height="38.400000000000006" /></mxCell><mxCell id="e66" value="2  결론의 대상/범위" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#7446A4;fontSize=24;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1780" y="549" width="250.4" height="38.400000000000006" /></mxCell><mxCell id="e68" value="2  보고서/메일 연결" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#7446A4;fontSize=24;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2140" y="549" width="250.4" height="38.400000000000006" /></mxCell><mxCell id="e71" value="3  원문 + 대상/업무 제안" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#7446A4;fontSize=24;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1790" y="688" width="319.04" height="38.400000000000006" /></mxCell><mxCell id="e73" value="4  PDF / 결론→메일 의존 / 교체 범위" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#7446A4;fontSize=24;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1780" y="826" width="471.2" height="38.400000000000006" /></mxCell><mxCell id="e77" value="조정자가 기록/조회, 의미 값은 생산자만 변경" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#7446A4;fontSize=27;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1790" y="866" width="521.82" height="37.05" /></mxCell><mxCell id="e78" value="정정: 표 대상 + 메일 연결 + 교체 관계를 결합" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#7446A4;fontSize=24;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1790" y="965" width="570.56" height="38.400000000000006" /></mxCell><mxCell id="e83" value="각 안의 의미 제안 → 현재 입력/근거/질문/권한 검사 → 채택 또는 관련 담당 재판단/사용자 확인" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=24;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="165" y="996" width="1145.6" height="38.400000000000006" /></mxCell><mxCell id="e84" value="채택: State Store에 의미/상태/명령 의도 저장 → 담당 통지.   미채택 제안은 실행·게시 금지.   Task 사실의 원본은 Task Manager." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=24;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="115" y="1105" width="1651.52" height="38.400000000000006" /></mxCell><mxCell id="e85" value="위임: Task Manager → Agent Gateway ↔ 외부 Downstream Agent   |   직접 답변/질문: Response Manager ↔ Interaction Manager" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=24;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="115" y="1140" width="1721.12" height="38.400000000000006" /></mxCell><mxCell id="e87" value="강점 후보: 교차 맥락 이해 / 짧은 처리 경로&lt;br&gt;대가: 맥락 누락·혼입 / 통합 판단 부담&lt;br&gt;V-01~03: 전체 관계   V-04~06: 조정 절약" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=25;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="1208" width="564.5" height="114" /></mxCell><mxCell id="e88" value="강점 후보: 긴 Task의 조건·질문 이어가기&lt;br&gt;대가: 참가 누락 / 참조 왕복 / 지속 상태&lt;br&gt;V-01~03: 지역 연속성   V-08: Task 규칙" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=25;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="888" y="1208" width="555.0" height="114" /></mxCell><mxCell id="e89" value="강점 후보: 기능별 집중 판단 / 오류 구분&lt;br&gt;대가: 부분 판단 불일치 / 추가 추론·결합&lt;br&gt;V-01~03: 전문화   V-08/09: 변경·분석" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#7446A4;fontSize=25;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1712" y="1208" width="524.0" height="114" /></mxCell><mxCell id="e90" value="모든 판단자: Model Access ↔ 공유 on-device Omni 1벌. 역할별 Context/KV와 호출 비용은 별도. 입력 수신·ASR은 계속." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=25;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="1325" width="1588.0" height="39.75" /></mxCell><mxCell id="e91" value="네모 = Component 이름 / 원통 = 상태 이름. 색 = A/B/C 구분, 우열 아님. 실선 = 요청/전달, 점선 화살표 = 반환. 논리 분해이며 process 분리가 아님." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=22;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="1371" width="1728.4" height="35.7" /></mxCell><mxCell id="e92" value="B: Task는 외부에 위임한 사용자 목표. 앱별 담당 아님. C: 충돌은 원 생산자가 재판단. 같은 Omni의 역할 분리가 정확성 향상을 보장하지 않음." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="1406" width="1518.74" height="34.35" /></mxCell></root></mxGraphModel></diagram></mxfile>

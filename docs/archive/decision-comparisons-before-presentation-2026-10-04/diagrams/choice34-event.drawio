x="1312" y="1535" width="1184" height="225" /></mxCell><mxCell id="e56" value="" style="rounded=1;arcSize=4;fillColor=#087A53;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="1312" y="1535" width="8" height="225" /></mxCell><mxCell id="e6" style="edgeStyle=none;rounded=0;strokeColor=#C7D1DD;strokeWidth=2;endArrow=none;endFill=0;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="64" y="202" /><mxPoint as="targetPoint" x="2496" y="202" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e13" style="edgeStyle=none;rounded=0;strokeColor=#195FBD;strokeWidth=2;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="656" y="600" /><mxPoint as="targetPoint" x="656" y="665" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e18" style="edgeStyle=none;rounded=0;strokeColor=#195FBD;strokeWidth=2;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="656" y="890" /><mxPoint as="targetPoint" x="656" y="955" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e23" style="edgeStyle=none;rounded=0;strokeColor=#195FBD;strokeWidth=2;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="656" y="1180" /><mxPoint as="targetPoint" x="656" y="1245" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e28" style="edgeStyle=none;rounded=0;strokeColor=#195FBD;strokeWidth=2;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="656" y="1470" /><mxPoint as="targetPoint" x="656" y="1535" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e39" style="edgeStyle=none;rounded=0;strokeColor=#087A53;strokeWidth=2;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1904" y="600" /><mxPoint as="targetPoint" x="1904" y="665" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e44" style="edgeStyle=none;rounded=0;strokeColor=#087A53;strokeWidth=2;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1904" y="890" /><mxPoint as="targetPoint" x="1904" y="955" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e49" style="edgeStyle=none;rounded=0;strokeColor=#087A53;strokeWidth=2;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1904" y="1180" /><mxPoint as="targetPoint" x="1904" y="1245" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e54" style="edgeStyle=none;rounded=0;strokeColor=#087A53;strokeWidth=2;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1904" y="1470" /><mxPoint as="targetPoint" x="1904" y="1535" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e60" style="edgeStyle=none;rounded=0;strokeColor=#C7D1DD;strokeWidth=2;endArrow=none;endFill=0;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="64" y="2120" /><mxPoint as="targetPoint" x="2496" y="2120" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e2" value="VIA  /  ARCHITECTURE REVIEW" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=18;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="42" width="309.32" height="30.3" /></mxCell><mxCell id="e3" value="04-34  /  STAGE 04" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=18;fontStyle=1;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2287.12" y="42" width="208.88" height="30.3" /></mxCell><mxCell id="e4" value="음성 대화의 반응성과 정정 정확성을 위한 실행&lt;br&gt;발화 단위와 연속 수정" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=34;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="75" width="780.48" height="94" /></mxCell><mxCell id="e5" value="같은 사건의 1~5단계 / 본문 §4와 대응 / 시간축은 측정 비율이 아님" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=22;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="166" width="759.52" height="35.7" /></mxCell><mxCell id="e7" value="공통 입력과 끝점은 유지한다. 각 칸은 사건 설명이며 Component 또는 process 배치를 뜻하지 않는다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=23;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="238" width="1186.06" height="37.05" /></mxCell><mxCell id="e8" value="A  확정 발화 단위 처리" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=28;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="300" width="336.16" height="43.800000000000004" /></mxCell><mxCell id="e11" value="1. “이 표를 보내…” 부분 입력" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=27;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="92" y="393" width="418.4" height="42.45" /></mxCell><mxCell id="e12" value="Interaction Manager / Speech Input Worker: 연속 수신" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=23;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="92" y="458" width="727.44" height="38" /></mxCell><mxCell id="e16" value="2. 발화 중 처리" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=27;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="92" y="683" width="226.7" height="42.45" /></mxCell><mxCell id="e17" value="입력 지속 / 발화 의미와 외부 명령은 확정 대기" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=23;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="92" y="748" width="550.34" height="38" /></mxCell><mxCell id="e21" value="3. “아니, 설명만” 정정" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=27;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="92" y="973" width="330.92" height="42.45" /></mxCell><mxCell id="e22" value="확정 발화 → Request Controller → Request Interpreter" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=23;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="92" y="1038" width="727.44" height="38" /></mxCell><mxCell id="e26" value="4. 의미와 게시 허용" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=27;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="92" y="1263" width="280.7" height="42.45" /></mxCell><mxCell id="e27" value="Request Controller: 최종 의미/현재 권한 확인" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=23;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="92" y="1328" width="580.24" height="38" /></mxCell><mxCell id="e31" value="5. 설명 중 “세 번째 열” 끼어들기" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=27;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="92" y="1553" width="472.4" height="42.45" /></mxCell><mxCell id="e32" value="Interaction Manager 즉시 stop / 실제 전달 반환 / 새 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=23;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="92" y="1618" width="745.84" height="38" /></mxCell><mxCell id="e33" value="같은 정상 사건의 흐름. 실패/철회/재시작은 본문 §6.&lt;br&gt;표시/생성 완료와 실제 청취, 접수와 업무 완료를 구별한다.&lt;br&gt;구조의 유리한 조건과 반증은 본문 §8~9에서 검토한다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=22;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="84" y="1870" width="650.4" height="95.10000000000001" /></mxCell><mxCell id="e34" value="B  잠정 작업을 계속 수정" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=28;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1312" y="300" width="364.16" height="43.800000000000004" /></mxCell><mxCell id="e37" value="1. “이 표를 보내…” 부분 입력" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=27;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1340" y="393" width="418.4" height="42.45" /></mxCell><mxCell id="e38" value="동일 입력 → Incremental Interaction Runtime: 부분 발화 버전" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=23;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1340" y="458" width="794.14" height="38" /></mxCell><mxCell id="e42" value="2. 발화 중 처리" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=27;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1340" y="683" width="226.7" height="42.45" /></mxCell><mxCell id="e43" value="Incremental Interaction Runtime → [요청] / ← [반환] Request&lt;br&gt;Interpreter/Context Manager: 잠정 해석/읽기" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=23;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1340" y="748" width="827.26" height="70" /></mxCell><mxCell id="e47" value="3. “아니, 설명만” 정정" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=27;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1340" y="973" width="330.92" height="42.45" /></mxCell><mxCell id="e48" value="Incremental Interaction Runtime: 옛 의미/응답 무효화, 유효 읽기 재사용 후&lt;br&gt;갱신" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=23;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1340" y="1038" width="960.66" height="70" /></mxCell><mxCell id="e52" value="4. 의미와 게시 허용" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=27;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1340" y="1263" width="280.7" height="42.45" /></mxCell><mxCell id="e53" value="동일. Incremental Interaction Runtime의 유효 결과만 Response&lt;br&gt;Manager에 전달" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=23;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1340" y="1328" width="819.44" height="70" /></mxCell><mxCell id="e57" value="5. 설명 중 “세 번째 열” 끼어들기" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=27;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1340" y="1553" width="472.4" height="42.45" /></mxCell><mxCell id="e58" value="같은 stop / 해당 fragment의 의존 작업 수정, 옛 chunk 차단" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=23;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1340" y="1618" width="743.54" height="38" /></mxCell><mxCell id="e59" value="같은 정상 사건의 흐름. 실패/철회/재시작은 본문 §6.&lt;br&gt;표시/생성 완료와 실제 청취, 접수와 업무 완료를 구별한다.&lt;br&gt;구조의 유리한 조건과 반증은 본문 §8~9에서 검토한다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=22;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1332" y="1870" width="650.4" height="95.10000000000001" /></mxCell><mxCell id="e61" value="검정 = 공통 / 파랑 = A 고유 / 초록 = B 고유 / 색은 우위가 아님" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=19;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="2138" width="651.72" height="31.650000000000002" /></mxCell><mxCell id="e62" value="실선 → 요청/전달 / 점선 → 반환/확인" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=18;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2149.24" y="2138" width="346.76" height="30.3" /></mxCell><mxCell id="e63" value="제목 상자 = Component / 내부 둥근 상자 = Module / 원통 = 저장 / 접힌 종이 = 자료 / 육각형 = 연동 대상" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=17;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="2176" width="962.38" height="28.950000000000003" /></mxCell><mxCell id="e64" value="실제 소요 시간/성능을 표시하지 않는다. 요청과 반환의 송수신 책임은 각 단계와 본문 표에 명시한다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=17;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="2212" width="856.64" height="28.950000000000003" /></mxCell></root></mxGraphModel></diagram></mxfile>

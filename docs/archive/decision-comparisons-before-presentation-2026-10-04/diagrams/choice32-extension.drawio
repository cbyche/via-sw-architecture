<mxfile host="app.diagrams.net" type="device"><diagram id="choice32-extension" name="화면 지칭의 두 경로를 결합하는 최소 확장 — 주요 구조 DP 자격을 철회한 이유"><mxGraphModel page="1" pageWidth="2560" pageHeight="2250" grid="1" gridSize="8"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="e1" value="" style="rounded=1;arcSize=4;fillColor=#263445;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="0" y="0" width="2560" height="9" /></mxCell><mxCell id="via" value="" style="rounded=1;arcSize=4;fillColor=#FAFBFD;strokeColor=#C7D1DD;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="480" width="2432" height="1330" /></mxCell><mxCell id="cm" value="Context Manager" style="swimlane;html=1;startSize=62;horizontal=1;align=left;spacingLeft=18;fontSize=23;fontStyle=1;fillColor=white;swimlaneFillColor=white;strokeColor=#263445;fontColor=#263445;strokeWidth=2.2;collapsible=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="110" y="550" width="1430" height="1190" /></mxCell><mxCell id="cm-role" value="화면/객체의 획득, 공통 참조와 현재 자료의 해석" style="text;html=1;strokeColor=none;fillColor=none;fontSize=17;fontColor=#5B697B;align=left;spacing=0;" vertex="1" parent="cm"><mxGeometry as="geometry" x="18" y="76" width="1394" height="25" /></mxCell><mxCell id="ri" value="Request Interpreter" style="swimlane;html=1;startSize=62;horizontal=1;align=left;spacingLeft=18;fontSize=23;fontStyle=1;fillColor=white;swimlaneFillColor=white;strokeColor=#263445;fontColor=#263445;strokeWidth=2.2;collapsible=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1770" y="650" width="660" height="160" /></mxCell><mxCell id="ri-role" value="같은 원문으로 지칭을 해석. 객체도 후보 근거" style="text;html=1;strokeColor=none;fillColor=none;fontSize=17;fontColor=#5B697B;align=left;spacing=0;" vertex="1" parent="ri"><mxGeometry as="geometry" x="18" y="76" width="624" height="25" /></mxCell><mxCell id="rc" value="Request Controller" style="swimlane;html=1;startSize=62;horizontal=1;align=left;spacingLeft=18;fontSize=2
45;strokeWidth=1.7;" vertex="1" parent="1"><mxGeometry as="geometry" x="150" y="270" width="520" height="130" /></mxCell><mxCell id="app" value="같은 앱의 공개 객체 API" style="shape=hexagon;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fillColor=#F7F9FC;strokeColor=#263445;fontColor=#263445;strokeWidth=1.7;" vertex="1" parent="1"><mxGeometry as="geometry" x="930" y="270" width="520" height="130" /></mxCell><mxCell id="obs" value="관측 조립 Module" style="rounded=1;arcSize=15;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fillColor=#EEF4FF;strokeColor=#195FBD;fontColor=#195FBD;strokeWidth=1.7;" vertex="1" parent="cm"><mxGeometry as="geometry" x="60" y="170" width="490" height="130" /></mxCell><mxCell id="obj" value="객체 제공자 Module" style="rounded=1;arcSize=15;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fillColor=#EDF9F2;strokeColor=#087A53;fontColor=#087A53;strokeWidth=1.7;" vertex="1" parent="cm"><mxGeometry as="geometry" x="820" y="170" width="550" height="130" /></mxCell><mxCell id="ref" value="공통 대상 참조&lt;br&gt;관측 근거 + 가능한 객체 ID/버전&lt;br&gt;출처 / 유효 범위 / unknown" style="shape=note;size=20;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fillColor=#F7F9FC;strokeColor=#263445;fontColor=#263445;strokeWidth=1.7;" vertex="1" parent="cm"><mxGeometry as="geometry" x="360" y="540" width="710" height="160" /></mxCell><mxCell id="resolve" value="참조 해석 Module&lt;br&gt;자료 읽기 / 재확인 필요 반환" style="rounded=1;arcSize=15;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fillColor=#F7F9FC;strokeColor=#263445;fontColor=#263445;strokeWidth=1.7;" vertex="1" parent="cm"><mxGeometry as="geometry" x="360" y="930" width="710" height="150" /></mxCell><mxCell id="e2" value="VIA  /  ARCHITECTURE REVIEW" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=18;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="42" width="309.32" height="30.3" /></mxCell><mxCell id="e3" value="04-32  /  STAGE 04" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=18;fontStyle=1;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2287.12" y="42" width="208.88" height="30.3" /></mxCell><mxCell id="e4" value="화면 지칭의 두 경로를 결합하는 최소 확장&lt;br&gt;주요 구조 DP 자격을 철회한 이유" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=34;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="75" width="712.48" height="94" /></mxCell><mxCell id="e5" value="공통 대상 참조와 resolver를 사용하는 설계 반례 / 새 주요 대안 또는 구현 결과가 아님" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=22;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="166" width="981.72" height="35.7" /></mxCell><mxCell id="e10" value="VIA SOFTWARE" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=18;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="86" y="496" width="141.92" height="30.3" /></mxCell><mxCell id="e11" value="Context 획득/참조 부분만 확대" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=16;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2212.88" y="498" width="261.12" height="27.6" /></mxCell><mxCell id="e20" value="관측 수집은 Interaction Manager 경유" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="120" y="440" width="379.52" height="30.3" /></mxCell><mxCell id="e26" value="관측 참조 생성" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="185" y="930" width="138.32" height="30.3" /></mxCell><mxCell id="e28" value="가능하면 객체 참조 보강" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1010" y="930" width="221.48" height="30.3" /></mxCell><mxCell id="e30" value="같은 표현을 두 경로에서 사용" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="490" y="1330" width="268.64" height="30.3" /></mxCell><mxCell id="e38" value="의미 요청 / 대상 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1810" y="940" width="207.8" height="30.3" /></mxCell><mxCell id="e41" value="Task Manager 경유: 확정 인계" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1790" y="1370" width="294.56" height="30.3" /></mxCell><mxCell id="e43" value="객체 API가 없는 영역은 관측 참조 유지. 객체가 있어도 시점/유효성 확인은 필요.&lt;br&gt;추론은 기존 Model Access/공유 Omni를 사용. 외부 업무는 같은 Downstream Agent가 실행.&lt;br&gt;제공자와 resolver의 개발량은 남지만, 대화/Task 원본과 확정 구조를 유지하며 점진 도입 가능." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=24;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="110" y="1870" width="1162.88" height="103.20000000000002" /></mxCell><mxCell id="e45" value="검정 = 공통 / 파랑 = A 고유 / 초록 = B 고유 / 색은 우위가 아님" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=19;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="2128" width="651.72" height="31.650000000000002" /></mxCell><mxCell id="e46" value="실선 → 요청/전달 / 점선 → 반환/확인" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=18;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2149.24" y="2128" width="346.76" height="30.3" /></mxCell><mxCell id="e47" value="제목 상자 = Component / 내부 둥근 상자 = Module / 원통 = 저장 / 접힌 종이 = 자료 / 육각형 = 연동 대상" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=17;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="2166" width="962.38" height="28.950000000000003" /></mxCell><mxCell id="e48" value="파랑 = 관측 경로 / 초록 = 객체 확장 / 검정 = 공통. 새 Component를 늘려야만 얻는 성질이 아니다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=17;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="2202" width="876.36" height="28.950000000000003" /></mxCell></root></mxGraphModel></diagram></mxfile>

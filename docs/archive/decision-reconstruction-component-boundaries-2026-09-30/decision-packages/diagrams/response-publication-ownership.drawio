        <mxCell id="common" value="공통 조건  |  Request Controller의 admission·상세 Text/Voice 요약·단일 발화·local stop·전달 불명 보존은 동일하다." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontColor=#161616;" vertex="1" parent="1">
          <mxGeometry x="40" y="1391" width="2400" height="34" as="geometry" />
        </mxCell>
        <mxCell id="notes-bg0" value="" style="fillColor=#F7F7F7;strokeColor=#161616;" vertex="1" parent="1">
          <mxGeometry x="40" y="1440" width="1240" height="160" as="geometry" />
        </mxCell>
        <mxCell id="note-0-0" value="얻는 것  |  모든 응답의 원장·발화 차례·복구 계약을 한곳에서 관리" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontColor=#161616;" vertex="1" parent="1">
          <mxGeometry x="60" y="1455" width="1200" height="34" as="geometry" />
        </mxCell>
        <mxCell id="note-0-1" value="부담  |  직접 답변과 업무 알림 기능 변경이 공통 owner에 모임" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontColor=#161616;" vertex="1" parent="1">
          <mxGeometry x="60" y="1499" width="1200" height="34" as="geometry" />
        </mxCell>
        <mxCell id="note-0-2" value="검토 질문  |  공통 계층이 전달 의미를 통일하는가, 변화만 묶는가?" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontColor=#161616;" vertex="1" parent="1">
          <mxGeometry x="60" y="1543" width="1200" height="34" as="geometry" />
        </mxCell>
        <mxCell id="notes-bg1" value="" style="fillColor=#F7F7F7;strokeColor=#161616;" vertex="1" parent="1">
          <mxGeometry x="1320" y="1440" width="1240" height="160" as="geometry" />
        </mxCell>
        <mxCell id="note-1-0" value="얻는 것  |  대화 응답과 업무 알림의 독립적인 변경·원장 관리" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontColor=#161616;" vertex="1" parent="1">
          <mxGeometry x="1340" y="1455" width="1200" height="34" as="geometry" />
        </mxCell>
        <mxCell id="note-1-1" value="부담  |  전달 이력 조회·중단·복구가 두 원장과 arbiter에 걸침" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontColor=#161616;" vertex="1" parent="1">
          <mxGeometry x="1340" y="1499" width="1200" height="34" as="geometry" />
        </mxCell>
        <mxCell id="note-1-2" value="검토 질문  |  arbiter를 얇게 유지하면서 원장 정합성을 지킬 수 있는가?" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontColor=#161616;" vertex="1" parent="1">
          <mxGeometry x="1340" y="1543" width="1200" height="34" as="geometry" />
        </mxCell>
        <mxCell id="scope" value="내부 블록은 책임의 설명용 분해이며 새 승인 Component가 아님 · 기대 효과는 가설 · ASR·측정 수치는 후속 검토" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=21;fontColor=#161616;" vertex="1" parent="1">
          <mxGeometry x="40" y="1627" width="2400" height="33" as="geometry" />
        </mxCell>
        <mxCell id="status" value="검토 기준선과 논의용 대안의 비교 / 구현·성능 측정 없음" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=19;fontColor=#161616;" vertex="1" parent="1">

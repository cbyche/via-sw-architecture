<mxfile host="app.diagrams.net" type="device"><diagram name="Context 획득 · 요청을 알려면 자료가, 자료를 고르려면 요청이 필요하다  |  배경" id="context-acquisition-strategy-background"><mxGraphModel page="1" pageWidth="2560" pageHeight="1440" grid="1" gridSize="10"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="challenge" value="" style="rounded=1;arcSize=8;html=1;fillColor=#FFFFFF;strokeColor=#171717;strokeWidth=2.5;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="48" y="1170" width="2464" height="170" /></mxCell><mxCell id="challenge-title" value="Architecture Challenge" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;fontColor=#171717;fontSize=20;fontStyle=1;fontFamily=Arial;align=left;verticalAlign=top;spacing=0;connectable=0;" vertex="1" parent="challenge"><mxGeometry as="geometry" x="16" y="8" width="2432" height="27" /></mxCell><mxCell id="challenge-text-0" value="기본 Context를 발화 중 준비할 것인가, 확정 입력에서 조회 계획을 만든 뒤 필요한 source를 읽을 것인가?" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;fontColor=#171717;fontSize=20;fontStyle=0;fontFamily=Arial;align=left;verticalAlign=top;spacing=0;connectable=0;" vertex="1" parent="challenge"><mxGeometry as="geometry" x="16" y="44" width="2432" height="27" /></mxCell><mxCell id="scenario" value="" style="rounded=1;arcSize=8;html=1;fillColor=#FFFFFF;strokeColor=#171717;strokeWidth=2.5;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="48" y="142" width="2464" height="104" /></mxCell><mxCell id="scenario-title" value="사용자 상황" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;fontColor=#171717;fontSize=20;fontStyle=1;fontFamily=Arial;align=left;verticalAlign=top;spacing=0;connectable=0;" vertex="1" parent="scenario"><mxGeometry as="geometry" x="16" y="8" width="2432" height="27" /></mxCell><mxCell id="scenario-text-0" value="“아까 그 보고서 어디까지 됐어?”와
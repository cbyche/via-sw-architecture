ed=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#BFBFBF;strokeWidth=1.3;fontFamily=Calibri;fontSize=18.666666666666668;fontColor=#000000;fontStyle=0;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="108" y="822" width="900" height="78" as="geometry"/></mxCell><mxCell id="table-3-2" value="▪ 사용하지 않는 관계도 생산 / 갱신 비용 발생 (QA05↓)&#xa;▪ 생산, 저장, 조회 계약과 추가 RAM을 유지 (QA04↓, QA06↓)" style="shape=rectangle;rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#BFBFBF;strokeWidth=1.3;fontFamily=Calibri;fontSize=18.666666666666668;fontColor=#000000;fontStyle=0;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1008" y="822" width="900" height="78" as="geometry"/></mxCell><mxCell id="table-4-0" value="Trade&#xa;Off" style="shape=rectangle;rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#BFBFBF;strokeWidth=1.3;fontFamily=Calibri;fontSize=20;fontColor=#000000;fontStyle=1;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="12" y="900" width="96" height="148" as="geometry"/></mxCell><mxCell id="table-4-1" value="" style="shape=rectangle;rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#BFBFBF;strokeWidth=1.3;fontFamily=Calibri;fontSize=18.666666666666668;fontColor=#000000;fontStyle=0;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="108" y="900" width="900" height="148" as="geometry"/></mxCell><mxCell id="table-4-2" value="" style="shape=rectangle;rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#BFBFBF;strokeWidth=1.3;fontFamily=Calibri;fontSize=18.666666666666668;fontColor=#000000;fontStyle=0;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1008" y="900" width="900" height="148" as="geometry"/></mxCell><mxCell id="Ari" value="Request Interpreter" style="shape=rectangle;rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.1;fontFamily=Calib
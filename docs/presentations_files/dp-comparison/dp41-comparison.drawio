1.0;"><mxGeometry as="geometry" x="1045" y="481" width="255" height="94" /></mxCell><mxCell id="n150" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.2;&quot;&gt;요청 틀 (RequestFrame)&lt;br&gt;목표: 표 추가 + 메일 초안&lt;br&gt;표 / 보고서: 아직 미확정&lt;br&gt;보고서 결과 → 메일 / 발송 금지&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=15;fontColor=#000000;fontStyle=0;"><mxGeometry as="geometry" x="1057" y="489" width="225" height="72.0" /></mxCell><mxCell id="n151" parent="1" vertex="1" value="" style="fontFamily=Apple SD Gothic Neo;shape=note;size=18;fillColor=white;strokeColor=#000000;strokeWidth=1.0;"><mxGeometry as="geometry" x="1350" y="553" width="285" height="61" /></mxCell><mxCell id="n152" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.2;&quot;&gt;코드가 관리하는 해결 상태&lt;br&gt;보고서 후보: Task1 / Task2&lt;br&gt;답변 뒤 Task1로 연결&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#000000;fontStyle=0;"><mxGeometry as="geometry" x="1362" y="561" width="255" height="50.400000000000006" /></mxCell><mxCell id="n153" parent="1" vertex="1" value="" style="fontFamily=Apple SD Gothic Neo;rounded=0;fillColor=white;strokeColor=none;strokeWidth=1.7;"><mxGeometry as="geometry" x="1668" y="617" width="149.7" height="17.6" /></mxCell><mxCell id="n154" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.2;&quot;&gt;결과 반영 → 코드 검사&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=13;fontColor=#000000;fontStyle=0;"><mxGeometry as="geometry" x="1670" y="618" width="177" height="15.6" /></mxCell><mxCell id="n155" parent="1" vertex="1" value="" style="fontFamily=Apple SD Gothic Neo;shape
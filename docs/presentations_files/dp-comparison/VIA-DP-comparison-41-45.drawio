r=#000000;fontStyle=0;"><mxGeometry as="geometry" x="1045" y="766" width="790" height="18.0" /></mxCell></root></mxGraphModel></diagram><diagram id="dp45-comparison" name="04-45. VIA 과거 근거의 요청별 구성과 공통 생산/조회"><mxGraphModel dx="1920" dy="1080" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n1" parent="1" vertex="1" value="" style="fontFamily=Apple SD Gothic Neo;rounded=0;fillColor=white;strokeColor=none;strokeWidth=1.7;"><mxGeometry as="geometry" x="0" y="0" width="1920" height="1080" /></mxCell><mxCell id="n2" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;VIA SOFTWARE ARCHITECTURE / DP 설계 비교&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=19;fontColor=#087E8B;fontStyle=1;"><mxGeometry as="geometry" x="40" y="22" width="1300" height="24.7" /></mxCell><mxCell id="n3" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;구조 비교 / 장단점 / QA Trade-off&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=right;verticalAlign=top;spacing=0;fontSize=19;fontColor=#5F6B77;fontStyle=0;"><mxGeometry as="geometry" x="1430" y="22" width="450" height="24.7" /></mxCell><mxCell id="n4" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;04-45. VIA 과거 근거의 요청별 구성과 공통 생산/조회&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=39;fontColor=#18232E;fontStyle=1;"><mxGeometry as="geometry" x="40" y="65" width="1840" height="50.7" /></mxCell><mxCell id="n5" parent="1" edge="1" style="fontFamily=Apple SD Gothic Neo;edgeStyle=none;rounded=0;strokeColor=#CDD6DE;strokeWidth=2;endArrow=none;endFill=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="40" y="121" /><mxPoint as="targetPoint" x="1880" y="121" /><Array as="points" /></mxGeometry></mxCell><mxCell id="n6" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;R23 “지난번 네가 설명한 평가 기준에 맞춰, 앞서 조사한 제품 비교 결과와 받아둔 견적을 이번 제안서에 반영해줘.”&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=20;fontColor=#18232E;fontStyle=0;"><mxGeometry as="geometry" x="40" y="137" width="1840" height="26.0" /></mxCell><mxCell id="n7" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;공통: VIA가 실제 설명한 내용 + 제품 조사와 견적의 결과 / 현재 제안서 업무 연결은 해석 결과 / 로컬 VIA + 클라우드 모델&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=17;fontColor=#18232E;fontStyle=0;"><mxGeometry as="geometry" x="40" y="168" width="1840" height="22.1" /></mxCell><mxCell id="n8" parent="1" vertex="1" value="" style="fontFamily=Apple SD Gothic Neo;rounded=0;fillColor=#D5E7C7;strokeColor=#CDD6DE;strokeWidth=1.7;"><mxGeometry as="geometry" x="40" y="195" width="1840" height="48" /></mxCell><mxCell id="n9" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;A 원본 서비스 조합형&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=center;verticalAlign=top;spacing=0;fontSize=25;fontColor=#18232E;fontStyle=1;"><mxGeometry as="geometry" x="156.0" y="206" width="838" height="32.5" /></mxCell><mxCell id="n10" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;B 공통 파생 기억 저장소형&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=center;verticalAlign=top;spacing=0;fontSize=25;fontColor=#18232E;fontStyle=1;"><mxGeometry as="geometry" x="1026.0" y="206" width="838" height="32.5" /></mxCell><mxCell id="n11" parent="1" edge="1" style="fontFamily=Apple SD Gothic Neo;edgeStyle=none;rounded=0;strokeColor=#CDD6DE;strokeWidth=2;endArrow=none;endFill=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1010" y="195" /><mxPoint as="targetPoint" x="1010" y="795" /><Array as="points" /></mxGeometry></mxCell><mxCell id="n12" parent="1" edge="1" style="fontFamily=Apple SD Gothic Neo;edgeStyle=none;rounded=0;strokeColor=#CDD6DE;strokeWidth=2;endArrow=none;endFill=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="40" y="795" /><mxPoint as="targetPoint" x="1880" y="795" /><Array as="points" /></mxGeometry></mxCell><mxCell id="n13" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;PARTIAL: 실제 전달한 예외 문구 한 구간과 결과 참조의 예시 / 기준 전체의 완전 추출을 뜻하지 않음 / 과거 게시와 현재 의미 채택은 별개&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=16;fontColor=#18232E;fontStyle=0;"><mxGeometry as="geometry" x="40" y="809" width="1840" height="20.8" /></mxCell><mxCell id="n14" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;첫 요청 / 준비된 반복 조회 / 정정 직후 / 표현 밖 관계를 구분. A의 유효 관계 cache와 부분 갱신도 허용한다.&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=16;fontColor=#18232E;fontStyle=0;"><mxGeometry as="geometry" x="40" y="838" width="1840" height="20.8" /></mxCell><mxCell id="n15" parent="1" edge="1" style="fontFamily=Apple SD Gothic Neo;edgeStyle=none;rounded=0;strokeColor=#CDD6DE;strokeWidth=2;endArrow=none;endFill=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="40" y="873" /><mxPoint as="targetPoint" x="1880" y="873" /><Array as="points" /></mxGeometry></mxCell><mxCell id="n16" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;새 관계 / 미묘한 조건&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=16;fontColor=#18232E;fontStyle=1;"><mxGeometry as="geometry" x="42" y="878" width="266" height="20.8" /></mxCell><mxCell id="n17" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;요청 목적에 맞춘 원문 구성의 유연성; 검색 누락 가능&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=16;fontColor=#18232E;fontStyle=0;"><mxGeometry as="geometry" x="315" y="878" width="745" height="20.8" /></mxCell><mxCell id="n18" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;지원 표현 / 추출 조건에 제한; 정확성의 고정 우열 없음&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=16;fontColor=#18232E;fontStyle=0;"><mxGeometry as="geometry" x="1080" y="878" width="795" height="20.8" /></mxCell><mxCell id="n19" parent="1" edge="1" style="fontFamily=Apple SD Gothic Neo;edgeStyle=none;rounded=0;strokeColor=#CDD6DE;strokeWidth=2;endArrow=none;endFill=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="40" y="902" /><mxPoint as="targetPoint" x="1880" y="902" /><Array as="points" /></mxGeometry></mxCell><mxCell id="n20" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;준비된 반복 조회 R24&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=16;fontColor=#18232E;fontStyle=1;"><mxGeometry as="geometry" x="42" y="907" width="266" height="20.8" /></mxCell><mxCell id="n21" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;warm 관계 cache로 조회 / 재해석 축소 가능&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=16;fontColor=#18232E;fontStyle=0;"><mxGeometry as="geometry" x="315" y="907" width="745" height="20.8" /></mxCell><mxCell id="n22" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;유효 게시가 원본 교차 결합을 대체하면 경로 단축 가능&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=16;fontColor=#18232E;fontStyle=0;"><mxGeometry as="geometry" x="1080" y="907" width="795" height="20.8" /></mxCell><mxCell id="n23" parent="1" edge="1" style="fontFamily=Apple SD Gothic Neo;edgeStyle=none;rounded=0;strokeColor=#CDD6DE;strokeWidth=2;endArrow=none;endFill=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="40" y="931" /><mxPoint as="targetPoint" x="1880" y="931" /><Array as="points" /></mxGeometry></mxCell><mxCell id="n24" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;첫 조회 / 정정 직후&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=16;fontColor=#18232E;fontStyle=1;"><mxGeometry as="geometry" x="42" y="936" width="266" height="20.8" /></mxCell><mxCell id="n25" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;현재 원본으로 구성; fan-out / 해석 비용&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=16;fontColor=#18232E;fontStyle=0;"><mxGeometry as="geometry" x="315" y="936" width="745" height="20.8" /></mxCell><mxCell id="n26" parent="1" 
le SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=20;fontColor=#18232E;fontStyle=0;"><mxGeometry as="geometry" x="158" y="888" width="836" height="26.0" /></mxCell><mxCell id="n25" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;▪ 교차 사건의 중앙 전이 변경, 평균 4.0개 (변경 용이성 ↓)&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=20;fontColor=#18232E;fontStyle=0;"><mxGeometry as="geometry" x="158" y="917" width="836" height="26.0" /></mxCell><mxCell id="n26" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;V-04 응답 신속성&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=20;fontColor=#18232E;fontStyle=0;"><mxGeometry as="geometry" x="158" y="964" width="335" height="26.0" /></mxCell><mxCell id="n27" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;●●○&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=23;fontColor=#18232E;fontStyle=0;"><mxGeometry as="geometry" x="515" y="963" width="112" height="29.900000000000002" /></mxCell><mxCell id="n28" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;0.85 s&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=21;fontColor=#18232E;fontStyle=1;"><mxGeometry as="geometry" x="643" y="964" width="140" height="27.3" /></mxCell><mxCell id="n29" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;평균 반응시간 ↓&lt;/div&gt;" style="fontFamil
e="1" pageWidth="1920" pageHeight="1080" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n1" parent="1" vertex="1" value="" style="fontFamily=Apple SD Gothic Neo;rounded=0;fillColor=white;strokeColor=none;strokeWidth=1.7;"><mxGeometry as="geometry" x="0" y="0" width="1920" height="1080" /></mxCell><mxCell id="n2" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;VIA SOFTWARE ARCHITECTURE / DP 설계 비교&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=19;fontColor=#087E8B;fontStyle=1;"><mxGeometry as="geometry" x="40" y="22" width="1300" height="24.7" /></mxCell><mxCell id="n3" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;구조 비교 / 장단점 / QA Trade-off&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=right;verticalAlign=top;spacing=0;fontSize=19;fontColor=#5F6B77;fontStyle=0;"><mxGeometry as="geometry" x="1430" y="22" width="450" height="24.7" /></mxCell><mxCell id="n4" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;04-42. 대화와 업무 상태의 소유 및 확정&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=39;fontColor=#18232E;fontStyle=1;"><mxGeometry as="geometry" x="40" y="65" width="1840" height="50.7" /></mxCell><mxCell id="n5" parent="1" edge="1" style="fontFamily=Apple SD Gothic Neo;edgeStyle=none;rounded=0;strokeColor=#CDD6DE;strokeWidth=2;endArrow=none;endFill=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="40" y="121" /><mxPoint as="targetPoint" x="1880" y="121" /><Array as="points" /></mxGeometry></mxCell><mxCell id="n6" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;보고서 기간 질문을 실제 제시 → “응, 상반기로 해줘” → 내부 접수 / 외부 전달 확인&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=22;fontColor=#18232E;fontStyle=0;"><mxGeometry as="geometry" x="40" y="140" width="1840" height="28.6" /></mxCell><mxCell id="n7" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;공통: 별도 Conversation / Request / Task / Execution 수명 / 로컬 VAD와 지속 입력 / 클라우드 모델 / 같은 의미 판단&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=17;fontColor=#18232E;fontStyle=0;"><mxGeometry as="geometry" x="40" y="171" width="1840" height="22.1" /></mxCell><mxCell id="n8" parent="1" vertex="1" value="" style="fontFamily=Apple SD Gothic Neo;rounded=0;fillColor=#D5E7C7;strokeColor=#CDD6DE;strokeWidth=1.7;"><mxGeometry as="geometry" x="40" y="195" width="1840" height="48" /></mxCell><mxCell id="n9" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;A 모듈형 통합 Core / 공동 확정&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=center;verticalAlign=top;spacing=0;fontSize=23;fontColor=#18232E;fontStyle=1;"><mxGeometry as="geometry" x="156.0" y="206" width="838" height="29.900000000000002" /></mxCell><mxCell id="n10" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;B 독립 대화 / 업무 서비스 / 별도 접수&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=center;verticalAlign=top;spacing=0;fontSize=23;fontColor=#18232E;fontStyle=1;"><mxGeometry as="geometry" x="1026.0" y="206" width="838" height="29.900000000000002" /></mxCell><mxCell id="n11" parent="1" edge="1" style="fontFamily=Apple SD Gothic Neo;edgeStyle=none;rounded=0;strokeColor=#CDD6DE;strokeWidth=2;endArrow=none;endFill=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1010" y="195" /><mxPoint as="targetPoint" x="1010" y="795" /><Array as="points" /></mxGeometry></mxCell><mxCell id="n12" parent="1" edge="1" style="fontFamily=Apple SD Gothic Neo;edgeStyle=none;rounded=0;strokeColor=#CDD6DE;strokeWidth=2;endArrow=none;endFill=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="40" y="795" /><mxPoint as="targetPoint" x="1880" y="795" /><Array as="points" /></mxGeometry></mxCell><mxCell id="n13" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;공통 의미 제안은 Request Interpreter, 채택은 Request Controller / 실제 전달 원장은 Response Manager / 모델 / 외부 통신은 transaction 밖&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=17;fontColor=#18232E;fontStyle=0;"><mxGeometry as="geometry" x="42" y="811" width="1840" height="22.1" /></mxCell><mxCell id="n14" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;B: hold 요청 시각과 업무 gate 적용 ACK 시각은 다름 / ACK 전 DISPATCHING은 UNKNOWN / 외부 확인으로 처리&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=17;fontColor=#18232E;fontStyle=0;"><mxGeometry as="geometry" x="42" y="840" width="1840" height="22.1" /></mxCell><mxCell id="n15" parent="1" edge="1" style="fontFamily=Apple SD Gothic Neo;edgeStyle=none;rounded=0;strokeColor=#CDD6DE;strokeWidth=2;endArrow=none;endFill=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="40" y="875" /><mxPoint as="targetPoint" x="1880" y="875" /><Array as="points" /></mxGeometry></mxCell><mxCell id="n16" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;정확성 / 모델 비용&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=18;fontColor=#18232E;fontStyle=1;"><mxGeometry as="geometry" x="42" y="883" width="245" height="23.400000000000002" /></mxCell><mxCell id="n17" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;같은 의미 판단 / 공동 확정은 의미 정답 보증 아님&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=18;fontColor=#18232E;fontStyle=0;"><mxGeometry as="geometry" x="300" y="883" width="720" height="23.400000000000002" /></mxCell><mxCell id="n18" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;같은 판단 / 코드 인계 자체는 추가 모델 호출 아님&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=18;fontColor=#18232E;fontStyle=0;"><mxGeometry as="geometry" x="1050" y="883" width="820" height="23.400000000000002" /></mxCell><mxCell id="n19" parent="1" edge="1" style="fontFamily=Apple SD Gothic Neo;edgeStyle=none;rounded=0;strokeColor=#CDD6DE;strokeWidth=2;endArrow=none;endFill=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="40" y="909" /><mxPoint as="targetPoint" x="1880" y="909" /><Array as="points" /></mxGeometry></mxCell><mxCell id="n20" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;응답성&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=18;fontColor=#18232E;fontStyle=1;"><mxGeometry as="geometry" x="42" y="917" width="245" height="23.400000000000002" /></mxCell><mxCell id="n21" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;관련 변경 한 번 확정 / 같은 Core 실행 / 복원 경계&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=18;fontColor=#18232E;fontStyle=0;"><mxGeometry as="geometry" x="300" y="917" width="720" height="23.400000000000002" /></mxCell><mxCell id="n22" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;명령 / 접수 / 대화 반영 왕복과 재확인 비용&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=18;fontColor=#18232E;fontStyle=0;"><mxGeometry as="geometry" x="1050" y="917" width="820" height="23.400000000000002" /></mxCell><mxCell id="n23" parent="1" edge="1" style="fontFamily=Apple SD Gothic Neo;edgeStyle=none;rounded=0;strokeColor=#CDD6DE;strokeWidth=2;endArrow=none;endFill=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="40" y="943" /><mxPoint as="targetPoint" x="1880" y="943" /><Array as="points" /></mxGeometry></mxCell><mxCell id="n24" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;변경 / 수명&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=18;fontColor=#18232E;fontStyle=1;"><mxGeometry as="geometry" x="42" y="951" width="245" height="23.400000000000002" /></mxCell><mxCell id="n25" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;모듈형 변경 가능 / 공통 확정 계약 변경 영향&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=18;fontColor=#18232E;fontStyle=0;"><mxGeometry as="geometry" x="300" y="951" width="720" height="23.400000000000002" /></mxCell><mxCell id="n26" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;업무 저장 / 실행 수명 독립 / 서비스 계약 변경 비용&lt;/div&gt;" style="font
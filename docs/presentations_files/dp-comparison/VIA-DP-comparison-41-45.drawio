okeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=16;fontColor=#5F6B77;fontStyle=0;"><mxGeometry as="geometry" x="1040" y="777" width="808" height="19.2" /></mxCell></root></mxGraphModel></diagram><diagram id="dp44-comparison" name="04-44. VIA 지속 입력과 Task 알림의 후속 실행 구조"><mxGraphModel dx="1920" dy="1080" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n1" parent="1" vertex="1" value="" style="fontFamily=Apple SD Gothic Neo;rounded=0;fillColor=white;strokeColor=none;strokeWidth=1.7;"><mxGeometry as="geometry" x="0" y="0" width="1920" height="1080" /></mxCell><mxCell id="n2" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;VIA SOFTWARE ARCHITECTURE / DP 설계 비교&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=19;fontColor=#087E8B;fontStyle=1;"><mxGeometry as="geometry" x="40" y="22" width="1300" height="24.7" /></mxCell><mxCell id="n3" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;구조 비교 / 장단점 / QA Trade-off&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=right;verticalAlign=top;spacing=0;fontSize=19;fontColor=#5F6B77;fontStyle=0;"><mxGeometry as="geometry" x="1430" y="22" width="450" height="24.7" /></mxCell><mxCell id="n4" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;04-44. VIA 지속 입력과 Task 알림의 후속 실행 구조&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=39;fontColor=#18232E;fontStyle=1;"><mxGeometry as="geometry" x="40" y="65" width="1840" height="50.7" /></mxCell><mxCell id="n5" parent="1" edge="1" style="fontFamily=Apple SD Gothic Neo;edgeStyle=none;rounded=0;strokeColor=#CDD6DE;strokeWidth=2;endArrow=none;endFill=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="40" y="121" /><mxPoint as="targetPoint" x="1880" y="121" /><Array as="points" /></mxGeometry></mxCell><mxCell id="n6" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;“잠깐, 표부터 설명해줘.” + 메일 수신자 질문 도착 + 이전 응답 준비가 늦게 완료&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=22;fontColor=#18232E;fontStyle=0;"><mxGeometry as="geometry" x="40" y="140" width="1840" height="28.6" /></mxCell><mxCell id="n7" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;공통: 계속 입력 수신 / 로컬 VAD와 즉시 음성 중단 / 클라우드 음성 / 의미 모델 / 같은 Request / Task / 실제 전달 원본&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=17;fontColor=#18232E;fontStyle=0;"><mxGeometry as="geometry" x="40" y="171" width="1840" height="22.1" /></mxCell><mxCell id="n8" parent="1" vertex="1" value="" style="fontFamily=Apple SD Gothic Neo;rounded=0;fillColor=#D5E7C7;strokeColor=#CDD6DE;strokeWidth=1.7;"><mxGeometry as="geometry" x="40" y="195" width="1840" height="48" /></mxCell><mxCell id="n9" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;A 중앙에서 완료 회수와 다음 실행 지시&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=center;verticalAlign=top;spacing=0;fontSize=23;fontColor=#18232E;fontStyle=1;"><mxGeometry as="geometry" x="156.0" y="206" width="838" height="29.900000000000002" /></mxCell><mxCell id="n10" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;B 연결된 단계가 입력과 조건으로 실행&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=center;verticalAlign=top;spacing=0;fontSize=23;fontColor=#18232E;fontStyle=1;"><mxGeometry as="geometry" x="1026.0" y="206" width="838" height="29.900000000000002" /></mxCell><mxCell id="n11" parent="1" edge="1" style="fontFamily=Apple SD Gothic Neo;edgeStyle=none;rounded=0;strokeColor=#CDD6DE;strokeWidth=2;endArrow=none;endFill=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1010" y="195" /><mxPoint as="targetPoint" x="1010" y="795" /><Array as="points" /></mxGeometry></mxCell><mxCell id="n12" parent="1" edge="1" style="fontFamily=Apple SD Gothic Neo;edgeStyle=none;rounded=0;strokeColor=#CDD6DE;strokeWidth=2;endArrow=none;endFill=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="40" y="795" /><mxPoint as="targetPoint" x="1880" y="795" /><Array as="points" /></mxGeometry></mxCell><mxCell id="n13" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;공통 후속 처리: source / 권한 / 입력 세대 검사 → Publication Control → Interaction Manager 실제 표시/재생 → receipt&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=17;fontColor=#18232E;fontStyle=0;"><mxGeometry as="geometry" x="42" y="811" width="1840" height="22.1" /></mxCell><mxCell id="n14" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;확인 질문은 별도 admission으로 현재 입력 해소를 기다리지 않고 제시 / 발화 시작은 업무 취소 완료가 아님&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=17;fontColor=#18232E;fontStyle=0;"><mxGeometry as="geometry" x="42" y="840" width="1840" height="22.1" /></mxCell><mxCell id="n15" parent="1" edge="1" style="fontFamily=Apple SD Gothic Neo;edgeStyle=none;rounded=0;strokeColor=#CDD6DE;strokeWidth=2;endArrow=none;endFill=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="40" y="871" /><mxPoint as="targetPoint" x="1880" y="871" /><Array as="points" /></mxGeometry></mxCell><mxCell id="n16" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;요청 처리 정확성&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=16;fontColor=#18232E;fontStyle=1;"><mxGeometry as="geometry" x="42" y="877" width="245" height="20.8" /></mxCell><mxCell id="n17" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;같은 의미 판단 / 중앙에서 현재 입력과 대기 참조 관리&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=16;fontColor=#18232E;fontStyle=0;"><mxGeometry as="geometry" x="300" y="877" width="720" height="20.8" /></mxCell><mxCell id="n18" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;같은 판단 / 각 Window와 Join의 참조 일치 필요&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=16;fontColor=#18232E;fontStyle=0;"><mxGeometry as="geometry" x="1050" y="877" width="820" height="20.8" /></mxCell><mxCell id="n19" parent="1" edge="1" style="fontFamily=Apple SD Gothic Neo;edgeStyle=none;rounded=0;strokeColor=#CDD6DE;strokeWidth=2;endArrow=none;endFill=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="40" y="896" /><mxPoint as="targetPoint" x="1880" y="896" /><Array as="points" /></mxGeometry></mxCell><mxCell id="n20" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;상호작용 응답시간&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=16;fontColor=#18232E;fontStyle=1;"><mxGeometry as="geometry" x="42" y="902" width="245" height="20.8" /></mxCell><mxCell id="n21" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;중앙의 완료 회수와 다음 지시 / 짧은 dispatch 가능&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=16;fontColor=#18232E;fontStyle=0;"><mxGeometry as="geometry" x="300" y="902" width="720" height="20.8" /></mxCell><mxCell id="n22" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;준비된 소비자 활성화 / 채널과 Join 대기 비용&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=16;fontColor=#18232E;fontStyle=0;"><mxGeometry as="geometry" x="1050" y="902" width="820" height="20.8" /></mxCell><mxCell id="n23" parent="1" edge="1" style="fontFamily=Apple SD Gothic Neo;edgeStyle=none;rounded=0;strokeColor=#CDD6DE;strokeWidth=2;endArrow=none;endFill=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="40" y="921" /><mxPoint as="targetPoint" x="1880" y="921" /><Array as="points" /></mxGeometry></mxCell><mxCell id="n24" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;VIA 요청 처리시간&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=16;fontColor=#18232E;fontStyle=1;"><mxGeometry as="geometry" x="42" y="927" width="245" height="20.8" /></mxCell><mxCell id="n25" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;단계마다 중앙 전이를 경유 / 병행 실행 허용&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=16;fontColor=#18232E;fontStyle=0;">
try></mxCell><mxCell id="screen-voice-grounding-background-20" parent="1" edge="1" style="edgeStyle=none;rounded=0;strokeColor=#00889A;strokeWidth=2.5;endArrow=open;endFill=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1315" y="610" /><mxPoint as="targetPoint" x="1385" y="555" /><Array as="points"><mxPoint x="1350" y="585" /></Array></mxGeometry></mxCell><mxCell id="screen-voice-grounding-background-21" parent="1" vertex="1" value="pointer로 첫 표 지시" style="fontFamily=Calibri;fontSize=25.333333333333332;fontColor=#000000;fontStyle=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="80" y="602" width="512" height="44" /></mxCell><mxCell id="screen-voice-grounding-background-22" parent="1" vertex="1" value="다른 창의 표로 이동" style="fontFamily=Calibri;fontSize=25.333333333333332;fontColor=#000000;fontStyle=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="704" y="619" width="512" height="44" /></mxCell><mxCell id="screen-voice-grounding-background-23" parent="1" vertex="1" value="첫 표는 이미 보이지 않음" style="fontFamily=Calibri;fontSize=25.333333333333332;fontColor=#000000;fontStyle=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="1328" y="619" width="512" height="44" /></mxCell><mxCell id="screen-voice-grounding-background-24" parent="1" edge="1" style="edgeStyle=none;rounded=0;strokeColor=#A6A6A6;strokeWidth=2.5;endArrow=open;endFill=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="620" y="479" /><mxPoint as="targetPoint" x="656" y="479" /><Array as="points" /></mxGeometry></mxCell><mxCell id="screen-voice-grounding-background-25" parent="1" edge="1" style="edgeStyle=none;rounded=0;strokeColor=#A6A6A6;strokeWidth=2.5;endArrow=open;endFill=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1244" y="479" /><mxPoint as="targetPoint" x="1280" y="479" /><Array as="points" /></mxGeometry></mxCell><mxCell id="screen-voice-grounding-background-26" parent="1" vertex="1" value="“아니, 여기.”로 정정하면 선택 범위와 바꿀 지칭도 다시 연결해야 합니다." style="fontFamily=Calibri;fontSize=30.666666666666668;fontColor=#000000;fontStyle=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="52" y="700" width="1816" height="54" /></mxCell><mxCell id="screen-voice-grounding-background-27" parent="1" vertex="1" value="근거: 말한 구간, 당시 화면, pointer 경로와 선택 범위" style="fontFamily=Calibri;fontSize=29.333333333333332;fontColor=#000000;fontStyle=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="52" y="766" width="1816" height="50" /></mxCell><mxCell id="screen-voice-grounding-background-28" parent="1" vertex="1" value="마지막 화면만 쓰면 첫 표를 잃고, 시각이 겹친다는 이유만으로 대상을 정하면 틀릴 수 있습니다." style="fontFamily=Calibri;fontSize=29.333333333333332;fontColor=#000000;fontStyle=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="52" y="837" width="1816" height="58" /></mxCell><mxCell id="screen-voice-grounding-background-29" parent="1" vertex="1" value="새 주제 탐색 · 번호와 A/B 미정" style="fontFamily=Calibri;fontSize=22.666666666666668;fontColor=#000000;fontStyle=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="52" y="1034" width="1816" height="30" /></mxCell></root></mxGraphModel></diagram></mxfile>

<mxfile host="app.diagrams.net" type="device"><diagram id="via-common-request-background" name="말과 화면, 이전 업무를 섞은 요청"><mxGraphModel page="1" pageWidth="1920" pageHeight="1080" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="via-common-request-background-1" parent="1" vertex="1" value="말과 화면, 이전 업무를 섞은 요청" style="fontFamily=Calibri;fontSize=40.0;fontColor=#000000;fontStyle=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="60" y="30" width="1040" height="60" /></mxCell><mxCell id="via-common-request-background-2" parent="1" edge="1" style="edgeStyle=none;rounded=0;strokeColor=#A6A6A6;strokeWidth=1.5;endArrow=none;endFill=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="52" y="104" /><mxPoint as="targetPoint" x="1872" y="104" /><Array as="points" /></mxGeometry></mxCell><mxCell id="via-common-request-background-3" parent="1" edge="1" style="edgeStyle=none;rounded=0;strokeColor=#A6A6A6;strokeWidth=1.5;endArrow=none;endFill=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="52" y="908" /><mxPoint as="targetPoint" x="1868" y="908" /><Array as="points" /></mxGeometry></mxCell><mxCell id="via-common-request-background-4" parent="1" vertex="1" value="설계 질문" style="fontFamily=Calibri;fontSize=30.666666666666668;fontColor=#C00000;fontStyle=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="52" y="935" width="180" height="50" /></mxCell><mxCell id="via-common-request-background-5" parent="1" vertex="1" value="이 연결을 유지하며 새 입력, 과거 맥락과 업무를 어떻게 다룰까?" style="fontFamily=Calibri;fontSize=30.666666666666668;fontColor=#000000;fontStyle=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="260" y="932" width="1608" height="100" /></mxCell><mxCell id="via-common-request-background-6" parent="1" vertex="1" value="“이 표를 아까 보고서에 넣어줘.&lt;br&gt;아니, 두 번째 표만. 메일은 보내지 말고.”" style="fontFamily=Calibri;fontSize=36.0;fontColor=#000000;fontStyle=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="52" y="150" width="1816" height="110" /></mxCell><mxCell id="via-common-request-background-7" parent="1" vertex="1" value="화면에서 가리킨 자료" style="fontFamily=Calibri;fontSize=29.333333333333332;fontColor=#000000;fontStyle=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="52" y="292" width="568" height="52" /></mxCell><mxCell id="via-common-request-background-8" parent="1" vertex="1" value="앞서 진행한 업무" style="fontFamily=Calibri;fontSize=29.333333333333332;fontColor=#000000;fontStyle=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="676" y="292" width="568" height="52" /></mxCell><mxCell id="via-common-request-background-9" parent="1" vertex="1" value="바꾼 부분과 유지할 조건" style="fontFamily=Calibri;fontSize=29.333333333333332;fontColor=#000000;fontStyle=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="1300" y="292" width="568" height="52" /></mxCell><mxCell id="via-common-request-background-10" parent="1" vertex="1" value="첫 번째 표" style="fontFamily=Calibri;fontSize=29.333333333333332;fontColor=#000000;fontStyle=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=0;shape=rect;fillColor=#F2F2F2;strokeColor=#A6A6A6;strokeWidth=2;spacing=14;"><mxGeometry as="geometry" x="80" y="365" width="504" height="72" /></mxCell><mxCell id="via-common-request-background-11" parent="1" vertex="1" value="두 번째 표" style="fontFamily=Calibri;fontSize=29.333333333333332;fontColor=#000000;fontStyle=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=0;shape=rect;fillColor=#FFFFFF;strokeColor=#00889A;strokeWidth=2;spacing=14;"><mxGeometry as="geometry" x="80" y="460" width="504" height="72" /></mxCell><mxCell id="via-common-request-background-12" parent="1" vertex="1" value="보고서 작성 업무" style="fontFamily=Calibri;fontSize=29.333333333333332;fontColor=#000000;fontStyle=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=0;shape=rect;fillColor=#FFFFFF;strokeColor=#A6A6A6;strokeWidth=2;spacing=14;"><mxGeometry as="geometry" x="704" y="365" width="504" height="72" /></mxCell><mxCell id="via-common-request-background-13" parent="1" vertex="1" value="메일 초안 업무" style="fontFamily=Calibri;fontSize=29.333333333333332;fontColor=#000000;fontStyle=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=0;shape=rect;fillColor=#FFFFFF;strokeColor=#A6A6A6;strokeWidth=2;spacing=14;"><mxGeometry as="geometry" x="704" y="460" width="504" height="72" /></mxCell><mxCell id="via-common-request-background-14" parent="1" vertex="1" value="표는 두 번째만&lt;br&gt;메일 발송 금지 유지" style="fontFamily=Calibri;fontSize=32.0;fontColor=#000000;fontStyle=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="1328" y="372" width="504" height="150" /></mxCell><mxCell id="via-common-request-background-15" parent="1" edge="1" style="edgeStyle=none;rounded=0;strokeColor=#00889A;strokeWidth=2.5;endArrow=open;endFill=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="332" y="560" /><mxPoint as="targetPoint" x="332" y="598" /><Array as="points" /></mxGeometry></mxCell><mxCell id="via-common-request-background-16" parent="1" edge="1" style="edgeStyle=none;rounded=0;strokeColor=#00889A;strokeWidth=2.5;endArrow=open;endFill=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="956" y="560" /><mxPoint as="targetPoint" x="956" y="598" /><Array as="points" /></mxGeometry></mxCell><mxCell id="via-common-request-background-17" parent="1" edge="1" style="edgeStyle=none;rounded=0;strokeColor=#00889A;strokeWidth=2.5;endArrow=open;endFill=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1580" y="560" /><mxPoint as="targetPoint" x="1580" y="598" /><Array as="points" /></mxGeometry></mxCell><mxCell id="via-common-request-background-18" parent="1" vertex="1" value="실제 자료와 범위" style="fontFamily=Calibri;fontSize=32.0;fontColor=#000000;fontStyle=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="52" y="615" width="568" height="52" /></mxCell><mxCell id="via-common-request-background-19" parent="1" vertex="1" value="수정할 보고서 업무" style="fontFamily=Calibri;fontSize=32.0;fontColor=#000000;fontStyle=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="676" y="615" width="568" height="52" /></mxCell><mxCell id="via-common-request-background-20" parent="1" vertex="1" value="정정 범위와 기존 조건" style="fontFamily=Calibri;fontSize=32.0;fontColor=#000000;fontStyle=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="1300" y="615" width="568" height="52" /></mxCell><mxCell id="via-common-request-background-21" parent="1" vertex="1" value="잘못 연결하면 다른 자료를 넣거나, 금지한 메일을 보내게 됩니다." style="fontFamily=Calibri;fontSize=30.666666666666668;fontColor=#000000;fontStyle=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="52" y="714" width="1816" height="50" /></mxCell><mxCell id="via-common-request-background-22" parent="1" vertex="1" value="VIA는 대상과 업무 연결, 정정 범위를 함께 판단하고 기존 조건을 보존해야 합니다." style="fontFamily=Calibri;fontSize=29.333333333333332;fontColor=#000000;fontStyle=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="52" y="786" width="1816" height="50" /></mxCell><mxCell id="via-common-request-background-23" parent="1" vertex="1" value="보고서를 어떻게 작성할지 추론하고 실제로 만드는 일은 Downstream Agent가 맡습니다." style="fontFamily=Calibri;fontSize=25.333333333333332;fontColor=#000000;fontStyle=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="52" y="843" width="1816" height="46" /></mxCell></root></mxGraphModel></diagram><diagram id="dp44-background" name="DP44. 정정과 업무 알림이 겹치는 대화"><mxGraphModel page="1" pageWidth="1920" pageHeight="1080" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="dp44-background-1" parent="1" vertex="1" value="DP44. 정정과 업무 알림이 겹치는 대화" style="fontFamily=Calibri;fontSize=40.0;fontColor=#000000;fontStyle=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="60" y="30" width="1040" height="60" /></mxCell><mxCell id="dp44-background-2" parent="1" edge="1" style="edgeStyle=none;rounded=0;strokeColor=#A6A6A6;strokeWidth=1.5;endArrow=none;endFill=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="52" y="104" /><mxPoint as="targetPoint" x="1872" y="104" /><Array as="points" /></mxGeometry></mxCell><mxCell id="dp44-background-3" parent="1" edge="1" style="edgeStyle=none;rounded=0;strokeColor=#A6A6A6;strokeWidth=1.5;endArrow=none;endFill=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="52" y="908" /><mxPoint as="targetPoint" x="1868" y="908" /><Array as="points" /></mxGeometry></mxCell><mxCell id="dp44-background-4" parent="1" vertex="1" value="설계 질문" style="fontFamily=Calibri;fontSize=30.666666666666668;fontColor=#C00000;fontStyle=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="52" y="935" width="180" height="50" /></mxCell><mxCell id="dp44-background-5" parent="1" vertex="1" value="사용자와 여러 Agent가 보내는 입력·질문·결과를&lt;br&gt;사용자 통제를 유지하며 어떻게 처리할까?" style="fontFamily=Calibri;fontSize=30.666666666666668;fontColor=#000000;fontStyle=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="260" y="932" width="1608" height="100" /></mxCell><mxCell id="dp44-background-6" parent="1" vertex="1" value="VIA가 보고서를 설명하는 동안, 사용자는 “잠깐, 표부터 설명해줘”라고 고칩니다." style="fontFamily=Calibri;fontSize=33.333333333333336;fontColor=#000000;fontStyle=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="52" y="151" width="1816" height="58" /></mxCell><mxCell id="dp44-background-7" parent="1" vertex="1" value="그 사이 메일 업무의 질문이 오고, 정정 전 답변도 뒤늦게 준비됩니다." style="fontFamily=Calibri;fontSize=30.666666666666668;fontColor=#000000;fontStyle=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="52" y="217" width="1816" height="48" /></mxCell><mxCell id="dp44-background-8" parent="1" vertex="1" value="사용자" style="fontFamily=Calibri;fontSize=29.333333333333332;fontColor=#000000;fontStyle=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="52" y="327" width="280" height="48" /></mxCell><mxCell id="dp44-background-9" parent="1" edge="1" style="edgeStyle=none;rounded=0;strokeColor=#D0D0D0;strokeWidth=1.4;endArrow=none;endFill=0;dashed=1;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="345" y="350" /><mxPoint as="targetPoint" x="1850" y="350" /><Array as="points" /></mxGeometry></mxCell><mxCell id="dp44-background-10" parent="1" vertex="1" value="VIA 설명" style="fontFamily=Calibri;fontSize=29.333333333333332;fontColor=#000000;fontStyle=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="52" y="415" width="280" height="48" /></mxCell><mxCell id="dp44-background-11" parent="1" edge="1" style="edgeStyle=none;rounded=0;strokeColor=#D0D0D0;strokeWidth=1.4;endArrow=none;endFill=0;dashed=1;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="345" y="438" /><mxPoint as="targetPoint" x="730" y="438" /><Array as="points" /></mxGeometry></mxCell><mxCell id="dp44-background-12" parent="1" vertex="1" value="메일 업무" style="fontFamily=Calibri;fontSize=29.333333333333332;fontColor=#000000;fontStyle=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="52" y="525" width="280" height="48" /></mxCell><mxCell id="dp44-background-13" parent="1" edge="1" style="edgeStyle=none;rounded=0;strokeColor=#D0D0D0;strokeWidth=1.4;endArrow=none;endFill=0;dashed=1;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="345" y="548" /><mxPoint as="targetPoint" x="910" y="548" /><Array as="points" /></mxGeometry></mxCell><mxCell id="dp44-background-14" parent="1" vertex="1" value="이전 답변 준비" style="fontFamily=Calibri;fontSize=29.333333333333332;fontColor=#000000;fontStyle=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="52" y="627" width="280" height="48" /></mxCell><mxCell id="dp44-background-15" parent="1" edge="1" style="edgeStyle=none;rounded=0;strokeColor=#D0D0D0;strokeWidth=1.4;endArrow=none;endFill=0;dashed=1;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="345" y="650" /><mxPoint as="targetPoint" x="1050" y="650" /><Array as="points" /></mxGeometry></mxCell><mxCell id="dp44-background-16" parent="1" vertex="1" value="“잠깐, 표부터 설명해줘.”" style="fontFamily=Calibri;fontSize=32.0;fontColor=#000000;fontStyle=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="740" y="292" width="710" height="50" /></mxCell><mxCell id="dp44-background-17" parent="1" edge="1" style="edgeStyle=none;rounded=0;strokeColor=#00889A;strokeWidth=8;endArrow=none;endFill=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="745" y="350" /><mxPoint as="targetPoint" x="1290" y="350" /><Array as="points" /></mxGeometry></mxCell><mxCell id="dp44-background-18" parent="1" edge="1" style="edgeStyle=none;rounded=0;strokeColor=#00889A;strokeWidth=8;endArrow=none;endFill=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="360" y="438" /><mxPoint as="targetPoint" x="745" y="438" /><Array as="points" /></mxGeometry></mxCell><mxCell id="dp44-background-19" parent="1" edge="1" style="edgeStyle=none;rounded=0;strokeColor=#C00000;strokeWidth=4;endArrow=none;endFill=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="745" y="417" /><mxPoint as="targetPoint" x="745" y="460" /><Array as="points" /></mxGeometry></mxCell><mxCell id="dp44-background-20" parent="1" vertex="1" value="즉시 중단 · 입력은 계속 수신" style="fontFamily=Calibri;fontSize=29.333333333333332;fontColor=#000000;fontStyle=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="780" y="402" width="1050" height="60" /></mxCell><mxCell id="dp44-background-21" parent="1" vertex="1" value="보고서 설명 중" style="fontFamily=Calibri;fontSize=25.333333333333332;fontColor=#000000;fontStyle=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="360" y="466" width="350" height="44" /></mxCell><mxCell id="dp44-background-22" parent="1" vertex="1" value="" style="fontFamily=Calibri;fontSize=28.0;fontColor=#000000;fontStyle=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=0;shape=ellipse;fillColor=#FFFFFF;strokeColor=#00889A;strokeWidth=2;spacing=14;"><mxGeometry as="geometry" x="915" y="534" width="28" height="28" /></mxCell><mxCell id="dp44-background-23" parent="1" vertex="1" value="“받는 사람은 누구인가요?”" style="fontFamily=Calibri;fontSize=29.333333333333332;fontColor=#000000;fontStyle=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="910" y="578" width="620" height="48" /></mxCell><mxCell id="dp44-background-24" parent="1" edge="1" style="edgeStyle=none;rounded=0;strokeColor=#00889A;strokeWidth=2.5;endArrow=open;endFill=0;dashed=1;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="943" y="548" /><mxPoint as="targetPoint" x="1430" y="548" /><Array as="points" /></mxGeometry></mxCell><mxCell id="dp44-background-25" parent="1" vertex="1" value="메일 업무로 연결&lt;br&gt;적절한 차례에 제시" style="fontFamily=Calibri;fontSize=29.333333333333332;fontColor=#000000;fontStyle=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="1460" y="516" width="390" height="86" /></mxCell><mxCell id="dp44-background-26" parent="1" vertex="1" value="" style="fontFamily=Calibri;fontSize=28.0;fontColor=#000000;fontStyle=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=0;shape=ellipse;fillColor=#FFFFFF;strokeColor=#C00000;strokeWidth=2;spacing=14;"><mxGeometry as="geometry" x="1066" y="636" width="28" height="28" /></mxCell><mxCell id="dp44-background-27" parent="1" edge="1" style="edgeStyle=none;rounded=0;strokeColor=#C00000;strokeWidth=2.5;endArrow=open;endFill=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1094" y="650" /><mxPoint as="targetPoint" x="1295" y="650" /><Array as="points" /></mxGeometry></mxCell><mxCell id="dp44-background-28" parent="1" edge="1" style="edgeStyle=none;rounded=0;strokeColor=#C00000;strokeWidth=3;endArrow=none;endFill=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1320" y="636" /><mxPoint as="targetPoint" x="1348" y="664" /><Array as="points" /></mxGeometry></mxCell><mxCell id="dp44-background-29" parent="1" edge="1" style="edgeStyle=none;rounded=0;strokeColor=#C00000;strokeWidth=3;endArrow=none;endFill=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1348" y="636" /><mxPoint as="targetPoint" x="1320" y="664" /><Array as="points" /></mxGeometry></mxCell><mxCell id="dp44-background-30" parent="1" vertex="1" value="정정 전 후보는 다시 말하지 않음" style="fontFamily=Calibri;fontSize=28.0;fontColor=#000000;fontStyle=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="1390" y="627" width="460" height="52" /></mxCell><mxCell id="dp44-background-31" parent="1" vertex="1" value="정정 전 답변을 다시 말하거나 메일 질문을 놓치면, 사용자의 제어가 무너집니다." style="fontFamily=Calibri;fontSize=30.666666666666668;fontColor=#000000;fontStyle=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="52" y="733" width="1816" height="54" /></mxCell><mxCell id="dp44-background-32" parent="1" vertex="1" value="도착 순서만으로 다음 처리를 정할 수 없습니다. 준비 완료와 실제 전달도 구별해야 합니다." style="fontFamily=Calibri;fontSize=29.333333333333332;fontColor=#000000;fontStyle=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="52" y="817" width="1816" height="64" /></mxCell></root></mxGraphModel></diagram><diagram id="dp45-background" name="DP45. 과거 설명과 업무 결과의 재사용"><mxGraphModel page="1" pageWidth="1920" pageHeight="1080" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="dp45-background-1" parent="1" vertex="1" value="DP45. 과거 설명과 업무 결과의 재사용" style="fontFamily=Calibri;fontSize=40.0;fontColor=#000000;fontStyle=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geom
{"id":"sh/sj6t8jmd","kind":"textbox","name":"DP3 object 247","position":{"left":65,"top":137,"width":1780,"height":58},"text":"현재 CPU 가정과 QA01 우선순위에서는 A를 선택한다","style":{"fontSize":38.67,"typeface":"Calibri","color":"#111111","bold":true,"alignment":"left"},"geometry":"rect","lineWidth":0},

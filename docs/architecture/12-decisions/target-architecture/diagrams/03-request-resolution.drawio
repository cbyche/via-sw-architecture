        <mxCell id="caption-1" value="입력 시점 근거는 Interaction Manager가 제공하고, 대화·Task·자료 근거는 Context Manager가 owner read port로 모은다." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=16;fontColor=#526178;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="90" y="379" width="1047" height="28" as="geometry" />
        </mxCell>
        <mxCell id="caption-2" value="추가 조회가 필요하고 예산이 남은 경우에만 ③으로 진행한다. Request Interpreter의 제안 자체는 실행 허가가 아니다." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=16;fontColor=#526178;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="90" y="704" width="969" height="28" as="geometry" />
        </mxCell>
        <mxCell id="caption-3" value="호출 2 이후에는 추가 semantic 호출 없이 ②에서 확정 / clarification / 확인 불가로 분기한다. 새 사용자 입력은 새 revision이다." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=16;fontColor=#526178;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="90" y="1064" width="1110" height="28" as="geometry" />
        </mxCell>
        <mxCell id="caption-4" value="input revision당 semantic 총 2회: 최초 해석·refinement·형식 repair·원음 재확인·stale 재해석을 모두 합산한다." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=16;fontColor=#172033;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="1184" width="987" height="28" as="geometry" />
        </mxCell>
        <mxCell id="caption-5" value="정정·관련 source 변경 시 이전 proposal·admission을 무효화한다. revision / budget 검사 실패 시 오래된 근거로 호출·확정하지 않는다." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=16;fontColor=#526178;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="90" y="1219" width="1153" height="28" as="geometry" />
        </mxCell>
        <mxCell id="caption-6" value="Clarification·실패 안내도 publication admission 후 게시한다. 업무 dispatch에는 Semantic Commit이 필요하며 조회는 실행 허가가 아니다." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=16;fontColor=#526178;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="90" y="1254" width="1202" height="28" as="geometry" />

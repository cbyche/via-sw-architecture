        <mxCell id="read-0" value="&lt;div style='font-size:19px;font-weight:bold'&gt;Request Controller 요청&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;source·범위·목적·consumer 지정&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;현재 policy / consent 확인&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F8FB;strokeColor=#0891B2;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">

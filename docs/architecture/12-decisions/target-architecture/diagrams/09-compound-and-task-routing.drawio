        <mxCell id="dependent-0" value="&lt;div style='font-size:19px;font-weight:bold'&gt;R1 · 자료 요약&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;범위가 명확하면 VIA 직접 처리&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;조사·업무 분석이면 Agent 위임&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#F3ECFF;strokeColor=#7C3AED;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="90" y="215" width="340" height="132" as="geometry" />
        </mxCell>
        <mxCell id="dependent-1" value="&lt;div style='font-size:19px;font-weight:bold'&gt;결과 version 고정&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;실제 summary ID·내용 version&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;실패 / 미완료이면 R2를 보류&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#F3ECFF;strokeColor=#7C3AED;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="540" y="215" width="340" height="132" as="geometry" />
        </mxCell>
        <mxCell id="dependent-2" value="&lt;div style='font-size:19px;font-weight:bold'&gt;R2 · 전송 준비&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;수신자·허용 Context·최신 권한&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;입력 결과 version으로 재검증&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#F3ECFF;strokeColor=#7C3AED;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="990" y="215" width="340" height="132" as="geometry" />
        </mxCell>
        <mxCell id="dependent-3" value="&lt;div style='font-size:19px;font-weight:bold'&gt;Task + Agent Command&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;해제 key로 중복 dispatch 방지&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;실제 발송·도구 계획은 Agent 책임&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#F3ECFF;strokeColor=#7C3AED;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1440" y="215" width="340" height="132" as="geometry" />
        </mxCell>
        <mxCell id="independent-0" value="&lt;div style='font-size:19px;font-weight:bold'&gt;R3 · 발표자료 계속&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;기존 Task B와 Execution 연결&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;새 목표로 잘못 분리하지 않음&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F9F3;strokeColor=#059669;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="90" y="500" width="340" height="132" as="geometry" />
        </mxCell>
        <mxCell id="independent-1" value="&lt;div style='font-size:19px;font-weight:bold'&gt;업무 상태 확인&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;이미 실행 중이면 불필요한 재시작 없음&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;필요한 제어만 해당 Agent에 전달&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F9F3;strokeColor=#059669;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="540" y="500" width="340" height="132" as="geometry" />
        </mxCell>
        <mxCell id="independent-2" value="&lt;div style='font-size:19px;font-weight:bold'&gt;별도 진행·결과&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;다른 Agent 또는 같은 Agent여도&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;Task·Execution identity로 구분&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F9F3;strokeColor=#059669;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="990" y="500" width="340" height="132" as="geometry" />
        </mxCell>
        <mxCell id="independent-3" value="&lt;div style='font-size:19px;font-weight:bold'&gt;원래 대화로 통지&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;Task B 결과임을 명시&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;전체 요청의 부분 완료를 구분&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F9F3;strokeColor=#059669;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1440" y="500" width="340" height="132" as="geometry" />

  <diagram id="09-compound-and-task-routing" name="복합 요청 — 사용자가 말한 관계만 실행으로 연결">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1130" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="dependent" value="A · DATA DEPENDENCY — Controller의 Request Graph가 해제 조건을 소유" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=12;spacingLeft=12;fontStyle=1;fontSize=14;fillColor=#F8FAFC;strokeColor=#D5DDE9;dashed=0;arcSize=14;" vertex="1" parent="1">
          <mxGeometry x="45" y="150" width="1810" height="260" as="geometry" />
        </mxCell>
        <mxCell id="independent" value="B · INDEPENDENT TASK — 위 요청의 대기·실패가 별도 업무를 막지 않는다" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=12;spacingLeft=12;fontStyle=1;fontSize=14;fillColor=#F8FAFC;strokeColor=#D5DDE9;dashed=0;arcSize=14;" vertex="1" parent="1">
          <mxGeometry x="45" y="435" width="1810" height="260" as="geometry" />

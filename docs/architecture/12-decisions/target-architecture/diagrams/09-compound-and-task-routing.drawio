        <mxCell id="conditional-3" value="&lt;div style='font-size:19px;font-weight:bold'&gt;실행 전 재확인&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;Agent가 외부 precondition 검증&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;일정 변경 경쟁 시 보류·재검증&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D97706;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">

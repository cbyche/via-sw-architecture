        </mxCell>
        <mxCell id="caption-0" value="→ 관계·전달  ·  점선 = 보조 관계" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=14;fontColor=#526178;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1580" y="96" width="257" height="26" as="geometry" />
        </mxCell>
        <mxCell id="caption-1" value="“조사해서 보고서를 만들어줘”도 같은 위임 경로다. Agent가 지원하지 못하면 VIA가 내부 계획을 대신 짜서 실행하지 않는다." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=16;fontColor=#526178;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="90" y="369" width="1008" height="28" as="geometry" />
        </mxCell>
        <mxCell id="caption-2" value="독립된 지속 업무는 별도 Task다. 일회성 직접 답변은 Request만으로 충분하며 모든 질문에 장기 Task를 만들지 않는다." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=16;fontColor=#526178;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="90" y="654" width="965" height="28" as="geometry" />
        </mxCell>
        <mxCell id="caption-3" value="사용자가 명시한 조건은 보존한다. 한 업무 내부 조건은 Agent가 수행하고 VIA는 업무 경계에서 확인된 사실만 연결한다." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=16;fontColor=#526178;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="90" y="939" width="960" height="28" as="geometry" />
        </mxCell>
        <mxCell id="caption-4" value="Task 개수는 동사나 Tool 개수가 아니라 독립된 사용자 업무로 정한다. 동일 Agent의 불투명한 실행 하나로 독립 Task를 합치지 않는다." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=16;fontColor=#172033;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="1024" width="1095" height="28" as="geometry" />
        </mxCell>

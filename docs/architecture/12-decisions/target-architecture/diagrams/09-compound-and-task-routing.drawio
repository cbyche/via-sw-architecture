        <mxCell id="conditional" value="C · CONDITIONAL — “3시가 비었으면 일정을 만들고, 아니면 알려줘”" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=12;spacingLeft=12;fontStyle=1;fontSize=14;fillColor=#F8FAFC;strokeColor=#D5DDE9;dashed=0;arcSize=14;" vertex="1" parent="1">

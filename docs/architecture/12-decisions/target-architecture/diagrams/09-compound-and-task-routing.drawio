        <mxCell id="conditional-0" value="&lt;div style='font-size:19px;font-weight:bold'&gt;조건 근거 확보&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;일정의 source revision·조회 시각&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;업무 분석 조건이면 Agent가 판단&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D97706;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="90" y="785" width="340" height="132" as="geometry" />
        </mxCell>
        <mxCell id="conditional-1" value="&lt;div style='font-size:19px;font-weight:bold'&gt;참 / 거짓 / 불명&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;불명을 거짓으로 간주하지 않음&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;모호하면 추가 근거·질문&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D97706;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="540" y="785" width="340" height="132" as="geometry" />
        </mxCell>
        <mxCell id="conditional-2" value="&lt;div style='font-size:19px;font-weight:bold'&gt;선택한 분기만 해제&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;생성은 Agent / 충돌 안내는 VIA&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;dependency version·조건 사실 기록&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D97706;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="990" y="785" width="340" height="132" as="geometry" />

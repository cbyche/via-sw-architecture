        <mxCell id="caption-0" value="→ 관계·전달  ·  점선 = 보조 관계" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=14;fontColor=#526178;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1580" y="96" width="257" height="26" as="geometry" />
        </mxCell>
        <mxCell id="caption-1" value="후속 node의 목표는 미리 이해할 수 있어도 실제 결과가 생기기 전에 결과 의존 command를 확정·전송하지 않는다." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=16;fontColor=#526178;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="90" y="369" width="910" height="28" as="geometry" />
        </mxCell>
        <mxCell id="caption-2" value="Task 질문에 “응”이라고 답해도 질문 ID·Request·Execution·revision을 유일하게 결합할 수 없으면 재확인한다." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=16;fontColor=#526178;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="90" y="654" width="940" height="28" as="geometry" />
        </mxCell>
        <mxCell id="caption-3" value="VIA는 명시된 조건·순서·결과 의존을 보존한다. 업무 내부 계획이나 Tool 단위 workflow를 새로 만들지 않는다." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=16;fontColor=#526178;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="90" y="939" width="901" height="28" as="geometry" />
        </mxCell>
        <mxCell id="caption-4" value="Capability 불충족·접수 불명 상태에서 다른 Agent로 조용히 재위임하지 않는다. 기존 실행 확인과 사용자 목표·권한을 다시 맞춘다." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=16;fontColor=#172033;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="1024" width="1065" height="28" as="geometry" />
        </mxCell>

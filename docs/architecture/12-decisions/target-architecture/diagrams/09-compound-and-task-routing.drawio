  <diagram id="09-compound-and-task-routing" name="업무 구분 — 독립 목표는 VIA Task, 업무 내부 단계는 Agent">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1130" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="single-goal" value="A · 하나의 업무 — 요약과 발송을 통째로 같은 Agent에 위임" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=12;spacingLeft=12;fontStyle=1;fontSize=14;fillColor=#F8FAFC;strokeColor=#D5DDE9;dashed=0;arcSize=14;" vertex="1" parent="1">
          <mxGeometry x="45" y="150" width="1810" height="260" as="geometry" />
        </mxCell>
        <mxCell id="independent" value="B · 독립된 두 업무 — 같은 Agent를 사용해도 Task identity는 분리" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=12;spacingLeft=12;fontStyle=1;fontSize=14;fillColor=#F8FAFC;strokeColor=#D5DDE9;dashed=0;arcSize=14;" vertex="1" parent="1">
          <mxGeometry x="45" y="435" width="1810" height="260" as="geometry" />
        </mxCell>
        <mxCell id="cross-goal" value="C · 목표 사이 실제 의존 — 별도 Task의 확정 결과를 인계해야 할 때만 VIA가 연결" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=12;spacingLeft=12;fontStyle=1;fontSize=14;fillColor=#F8FAFC;strokeColor=#D5DDE9;dashed=0;arcSize=14;" vertex="1" parent="1">
          <mxGeometry x="45" y="720" width="1810" height="260" as="geometry" />
        </mxCell>
        <mxCell id="single-goal-0" value="&lt;div style='font-size:19px;font-weight:bold'&gt;요청 의미 확정&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;자료·수신자·제약·완료 조건&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;목표: 요약한 내용을 메일로 전달&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1E8;strokeColor=#EA580C;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="90" y="215" width="340" height="132" as="geometry" />
        </mxCell>
        <mxCell id="single-goal-1" value="&lt;div style='font-size:19px;font-weight:bold'&gt;하나의 VIA Task&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;Controller → Task Manager&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;요약·발송 전체 목표로 command&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1E8;strokeColor=#EA580C;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="540" y="215" width="340" height="132" as="geometry" />
        </mxCell>
        <mxCell id="single-goal-2" value="&lt;div style='font-size:19px;font-weight:bold'&gt;Agent 내부 수행&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;요약 → 발송의 순서·도구·재시도&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;VIA가 내부 단계별로 지휘하지 않음&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1E8;strokeColor=#EA580C;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="990" y="215" width="340" height="132" as="geometry" />
        </mxCell>
        <mxCell id="single-goal-3" value="&lt;div style='font-size:19px;font-weight:bold'&gt;동일 Task 결과&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;성공 / 부분 완료 / 실패 구분&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;요약만 됐으면 발송 완료가 아님&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1E8;strokeColor=#EA580C;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1440" y="215" width="340" height="132" as="geometry" />
        </mxCell>
        <mxCell id="independent-0" value="&lt;div style='font-size:19px;font-weight:bold'&gt;독립 목표 식별&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;보고서 작성 + 일정 등록&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;Request Interpreter가 의미 구분&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F9F3;strokeColor=#059669;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="90" y="500" width="340" height="132" as="geometry" />
        </mxCell>
        <mxCell id="independent-1" value="&lt;div style='font-size:19px;font-weight:bold'&gt;Task A / Task B&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;각각 목표·결과·질문·제어 상태&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;동일 Agent 또는 서로 다른 Agent&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F9F3;strokeColor=#059669;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="540" y="500" width="340" height="132" as="geometry" />
        </mxCell>
        <mxCell id="independent-2" value="&lt;div style='font-size:19px;font-weight:bold'&gt;각각 진행·실패&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;Task·Execution identity로 event 결합&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;한쪽 실패가 다른 업무를 막지 않음&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F9F3;strokeColor=#059669;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="990" y="500" width="340" height="132" as="geometry" />
        </mxCell>
        <mxCell id="independent-3" value="&lt;div style='font-size:19px;font-weight:bold'&gt;별도 결과 전달&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;Task A 완료 / Task B 실패 등&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;전체 성공으로 뭉뚱그리지 않음&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F9F3;strokeColor=#059669;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1440" y="500" width="340" height="132" as="geometry" />
        </mxCell>
        <mxCell id="cross-goal-0" value="&lt;div style='font-size:19px;font-weight:bold'&gt;명시된 목표 간 관계&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;별도 Task B가 Task A 결과를 사용&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;한 업무의 내부 단계와 구분&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#F3ECFF;strokeColor=#7C3AED;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="90" y="785" width="340" height="132" as="geometry" />
        </mxCell>
        <mxCell id="cross-goal-1" value="&lt;div style='font-size:19px;font-weight:bold'&gt;선행 결과 확인&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;실제 artifact ID·내용 version&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;실패·불명이면 후속 목표 보류&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#F3ECFF;strokeColor=#7C3AED;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="540" y="785" width="340" height="132" as="geometry" />
        </mxCell>
        <mxCell id="cross-goal-2" value="&lt;div style='font-size:19px;font-weight:bold'&gt;후속 admission&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;조건·권한·최신 요청 재검증&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;graph·node·result로 중복 해제 방지&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#F3ECFF;strokeColor=#7C3AED;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="990" y="785" width="340" height="132" as="geometry" />
        </mxCell>
        <mxCell id="cross-goal-3" value="&lt;div style='font-size:19px;font-weight:bold'&gt;후속 Agent 수행&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;Task B가 받은 결과 version 사용&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;내부 계획·실행은 해당 Agent 책임&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#F3ECFF;strokeColor=#7C3AED;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1440" y="785" width="340" height="132" as="geometry" />
        </mxCell>

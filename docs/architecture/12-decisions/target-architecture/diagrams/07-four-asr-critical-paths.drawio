        <mxCell id="caption-0" value="→ 관계·전달  ·  점선 = 보조 관계" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=14;fontColor=#526178;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1580" y="96" width="257" height="26" as="geometry" />
        </mxCell>
        <mxCell id="caption-1" value="QA-19는 frozen QA-11/12 field의 중복 없는 micro-average. 추가 Task binding·continuity 검사는 별도 회귀 의미를 유지한다." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=16;fontColor=#526178;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="90" y="369" width="1104" height="28" as="geometry" />
        </mxCell>
        <mxCell id="caption-2" value="입력 중 사전 준비는 종료 후 중복 합산하지 않는다. Barge-in QA-04는 별도 회귀이며 QA-09 평균에 넣지 않는다." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=16;fontColor=#526178;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="90" y="654" width="925" height="28" as="geometry" />
        </mxCell>
        <mxCell id="caption-3" value="Adapter가 있어도 canonical 계약 자체가 달라지면 여러 owner가 바뀔 수 있다. 그림의 박스 개수는 점수가 아니다." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=16;fontColor=#526178;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="90" y="939" width="945" height="28" as="geometry" />
        </mxCell>
        <mxCell id="caption-4" value="확인 불가를 성공으로 세지 않는다. Safety·evidence qualification과 QA-41 memory 진단은 별도로 보존한다." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=16;fontColor=#526178;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="90" y="1224" width="924" height="28" as="geometry" />
        </mxCell>
        <mxCell id="caption-5" value="이후 Decision Package에서는 네 축의 applicability와 trade-off를 각각 보고한다. 한 축으로 미리 후보를 제거하거나 가중 합산하지 않는다." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=16;fontColor=#172033;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="1324" width="1178" height="28" as="geometry" />
        </mxCell>
        <mxCell id="key-blue" value="입력·응답" style="rounded=1;whiteSpace=wrap;html=1;shadow=0;fillColor=#EAF2FF;strokeColor=#2563EB;fontColor=#2563EB;strokeWidth=1.5;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">

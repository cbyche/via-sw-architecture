        <mxCell id="send-3" value="&lt;div style='font-size:19px;font-weight:bold'&gt;불명 상태 조정&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;조회 + idempotency 지원 시 재전송&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;미지원이면 임의 재실행 금지&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1E8;strokeColor=#EA580C;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">

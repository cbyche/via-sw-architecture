        <mxCell id="send-1" value="&lt;div style='font-size:19px;font-weight:bold'&gt;전송 시작 CAS&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;PENDING → DISPATCHING&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;hold·epoch·policy를 원자 확인&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1E8;strokeColor=#EA580C;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">

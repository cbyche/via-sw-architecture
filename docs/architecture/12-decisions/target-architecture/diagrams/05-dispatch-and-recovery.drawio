        <mxCell id="send-0" value="&lt;div style='font-size:19px;font-weight:bold'&gt;의도·Outbox 원자 기록&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;Request revision·Task·command ID&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;허용 범위·Agent·중복 방지 key&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1E8;strokeColor=#EA580C;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">

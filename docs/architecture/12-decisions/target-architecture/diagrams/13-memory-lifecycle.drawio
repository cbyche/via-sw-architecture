        <mxCell id="delete-0" value="&lt;div style='font-size:19px;font-weight:bold'&gt;삭제 대상 확정&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;Request Controller → Context Manager&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;대화 삭제와 기억 삭제 구분&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="90" y="785" width="340" height="132" as="geometry" />
        </mxCell>
        <mxCell id="delete-1" value="&lt;div style='font-size:19px;font-weight:bold'&gt;Tombstone + epoch&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;DB commit과 새 사용 차단&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;invalidation / cleanup intent&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="540" y="785" width="340" height="132" as="geometry" />
        </mxCell>
        <mxCell id="delete-2" value="&lt;div style='font-size:19px;font-weight:bold'&gt;파생 상태 무효화&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;summary · cache · KV · 생성 결과&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;진행 중 작업과 pin도 사용 금지&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="990" y="785" width="340" height="132" as="geometry" />
        </mxCell>
        <mxCell id="delete-3" value="&lt;div style='font-size:19px;font-weight:bold'&gt;파일 정리 · 확인&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;PURGE_PENDING → 확인 상태&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;외부 복사본 삭제를 약속하지 않음&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1440" y="785" width="340" height="132" as="geometry" />
        </mxCell>
        <mxCell id="blob-0" value="&lt;div style='font-size:19px;font-weight:bold'&gt;임시 blob 기록&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;허용된 최소 crop / snapshot&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;쓰기 완료 · digest 확보&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="90" y="1070" width="340" height="132" as="geometry" />
        </mxCell>
        <mxCell id="blob-1" value="&lt;div style='font-size:19px;font-weight:bold'&gt;최종 파일 rename&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;완성된 blob identity 확보&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;DB 참조 전 orphan일 수 있음&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="540" y="1070" width="340" height="132" as="geometry" />
        </mxCell>
        <mxCell id="blob-2" value="&lt;div style='font-size:19px;font-weight:bold'&gt;DB manifest commit&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;owner · scope · expiry · digest&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;이 시점부터 참조 가능&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="990" y="1070" width="340" height="132" as="geometry" />
        </mxCell>
        <mxCell id="blob-3" value="&lt;div style='font-size:19px;font-weight:bold'&gt;복구 / 회수&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;누락은 EVIDENCE_GAP&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;orphan · cleanup intent 재처리&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">

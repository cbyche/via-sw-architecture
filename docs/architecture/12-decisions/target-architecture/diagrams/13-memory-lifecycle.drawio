        <mxCell id="read-1" value="&lt;div style='font-size:19px;font-weight:bold'&gt;Owner read / Source&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;원본 · typed ID · source version&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;후보 coverage · 누락 receipt&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F8FB;strokeColor=#0891B2;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">

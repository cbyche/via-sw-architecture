  <diagram id="13-memory-lifecycle" name="기억의 수명 — 원본을 보존하고 파생 view를 재구성">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1530" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="layers" value="A · 기억 계층 — 서로 다른 수명이며 자동 승격 파이프라인이 아니다" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=12;spacingLeft=12;fontStyle=1;fontSize=14;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=0;arcSize=14;" vertex="1" parent="1">
          <mxGeometry x="45" y="150" width="1810" height="260" as="geometry" />
        </mxCell>
        <mxCell id="read" value="B · 조회 — 요약은 필요한 원문과 typed record를 대신하지 않는다" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=12;spacingLeft=12;fontStyle=1;fontSize=14;fillColor=#F8FAFC;strokeColor=#D5DDE9;dashed=0;arcSize=14;" vertex="1" parent="1">
          <mxGeometry x="45" y="435" width="1810" height="260" as="geometry" />
        </mxCell>
        <mxCell id="delete" value="C · 삭제 / 철회 — 사용 차단과 물리 정리의 완료를 구분한다" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=12;spacingLeft=12;fontStyle=1;fontSize=14;fillColor=#F8FAFC;strokeColor=#D5DDE9;dashed=0;arcSize=14;" vertex="1" parent="1">
          <mxGeometry x="45" y="720" width="1810" height="260" as="geometry" />
        </mxCell>
        <mxCell id="blob" value="D · Evidence 파일 — DB 밖 파일을 같은 transaction이라고 부르지 않는다" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=12;spacingLeft=12;fontStyle=1;fontSize=14;fillColor=#F8FAFC;strokeColor=#D5DDE9;dashed=0;arcSize=14;" vertex="1" parent="1">
          <mxGeometry x="45" y="1005" width="1810" height="260" as="geometry" />
        </mxCell>
        <mxCell id="raw" value="&lt;div style='font-size:19px;font-weight:bold'&gt;단기 입력 근거&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;Interaction Manager RAM timeline · 현재 요청 pin&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;raw 상시 디스크 저장 없음&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#2563EB;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="90" y="215" width="340" height="132" as="geometry" />
        </mxCell>
        <mxCell id="view" value="&lt;div style='font-size:19px;font-weight:bold'&gt;중기 작업 view&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;Context summary · cache · index&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;source revision으로 재구성&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F8FB;strokeColor=#0891B2;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="540" y="215" width="340" height="132" as="geometry" />

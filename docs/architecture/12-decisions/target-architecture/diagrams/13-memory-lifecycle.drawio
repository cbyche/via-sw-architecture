        <mxCell id="caption-0" value="→ 관계·전달  ·  점선 = 보조 관계" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=14;fontColor=#526178;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1580" y="96" width="257" height="26" as="geometry" />
        </mxCell>
        <mxCell id="caption-1" value="진행 중 업무·대기 질문·미전달 결과는 cache가 아니다. 단기·중기·장기는 의미 수명이며 RAM·파일·DB와 구분한다." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=16;fontColor=#526178;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="90" y="369" width="920" height="28" as="geometry" />
        </mxCell>
        <mxCell id="caption-2" value="부정·수치·권한·대상·업무 상태는 정확한 기록을 유지한다. source 삭제 뒤 파생 요약만 남겨 사실처럼 사용하지 않는다." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=16;fontColor=#526178;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="90" y="654" width="960" height="28" as="geometry" />
        </mxCell>
        <mxCell id="caption-3" value="재시작은 tombstone을 먼저 적용한다. 과거 대화나 KV에서 삭제한 기억을 자동 복원하지 않는다." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=16;fontColor=#526178;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="90" y="939" width="774" height="28" as="geometry" />
        </mxCell>
        <mxCell id="caption-4" value="삭제는 반대로 DB tombstone과 cleanup intent를 먼저 기록한다. 참조가 있으나 파일이 없으면 정상 evidence로 읽지 않는다." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=16;fontColor=#526178;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="90" y="1224" width="1038" height="28" as="geometry" />
        </mxCell>
        <mxCell id="caption-5" value="기본값: raw는 RAM · 요청 evidence cache 24시간 · 내용 없는 진단 로그 7일 · 대화/Task와 허용 기억은 명시 삭제." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=17;fontColor=#172033;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="1318" width="1039" height="29" as="geometry" />
        </mxCell>
        <mxCell id="caption-6" value="용량 상한을 넘기면 정리·재조회·입력 범위 안내로 처리한다. 활성 원본을 몰래 버리거나 무한히 저장하지 않는다." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=17;fontColor=#526178;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="90" y="1363" width="952" height="29" as="geometry" />
        </mxCell>
        <mxCell id="caption-7" value="보관 설정은 변경 가능하며 QA target이 아니다. 주요 설계 계약: memory-and-context-lifecycle.md" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=16;fontColor=#526178;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="90" y="1444" width="850" height="28" as="geometry" />
        </mxCell>
        <mxCell id="key-blue" value="입력·응답" style="rounded=1;whiteSpace=wrap;html=1;shadow=0;fillColor=#EAF2FF;strokeColor=#2563EB;fontColor=#2563EB;strokeWidth=1.5;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="48" y="92" width="172" height="25" as="geometry" />
        </mxCell>
        <mxCell id="key-purple" value="의미·요청" style="rounded=1;whiteSpace=wrap;html=1;shadow=0;fillColor=#F3ECFF;strokeColor=#7C3AED;fontColor=#7C3AED;strokeWidth=1.5;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="233" y="92" width="172" height="25" as="geometry" />
        </mxCell>

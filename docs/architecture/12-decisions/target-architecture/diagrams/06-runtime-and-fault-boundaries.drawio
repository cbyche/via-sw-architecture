        <mxCell id="caption-0" value="→ 관계·전달  ·  점선 = 보조 관계" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=14;fontColor=#526178;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1580" y="96" width="257" height="26" as="geometry" />
        </mxCell>
        <mxCell id="caption-1" value="Omni service 장애: 두 추론 역할은 함께 중단. Capture · ASR · local stop · Agent event 수신은 유지; UI에서 처리 불가 안내." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=17;fontColor=#172033;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="1133" width="1181" height="29" as="geometry" />
        </mxCell>
        <mxCell id="caption-2" value="Core 장애: 새 admission 중단 · Voice lease 만료 시 playback 정지 · Task 취소는 내구 접수 전까지 성공으로 표시하지 않음." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=16;fontColor=#526178;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="90" y="1174" width="1073" height="28" as="geometry" />
        </mxCell>
        <mxCell id="caption-3" value="ASR 장애: bounded 입력 보존 후 재연결 · gap 명시 · 불완전 근거로 위임 금지. Supervisor는 상태 의미를 결정하지 않음." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=16;fontColor=#526178;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="90" y="1214" width="1018" height="28" as="geometry" />
        </mxCell>
        <mxCell id="caption-4" value="CPU / accelerator / KV / 메모리 대역폭 / 열 예산을 함께 확인한다. 제품 장비에서의 적합성은 아직 미측정이다." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=16;fontColor=#526178;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="90" y="1254" width="939" height="28" as="geometry" />
        </mxCell>
        <mxCell id="caption-5" value="선은 process 간 계약이다. UI → Voice 왼쪽 경로는 명시적 local stop이며 Core나 추론 서비스 응답을 기다리지 않는다." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=16;fontColor=#172033;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="1384" width="1008" height="28" as="geometry" />
        </mxCell>

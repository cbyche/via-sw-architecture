        <mxCell id="caption-0" value="→ 관계·전달  ·  점선 = 보조 관계" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=14;fontColor=#526178;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1580" y="96" width="257" height="26" as="geometry" />
        </mxCell>
        <mxCell id="caption-1" value="Supervisor: process 재시작·health·backoff만 담당한다. Request·Task 의미 상태나 성공 여부를 결정하지 않는다." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=16;fontColor=#526178;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="90" y="941" width="973" height="28" as="geometry" />
        </mxCell>
        <mxCell id="caption-2" value="Core 장애: 새 admission 중단 · Voice lease 만료 시 재생 중단 · UI는 마지막 확인 상태와 연결 문제 표시." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=16;fontColor=#526178;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="90" y="978" width="916" height="28" as="geometry" />
        </mxCell>
        <mxCell id="caption-3" value="Model Access는 하나의 논리 계약이다. S2S adapter는 Voice, semantic adapter는 Core에 배치하며 모델을 복제하지 않는다." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=18;fontColor=#172033;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="1102" width="1186" height="30" as="geometry" />
        </mxCell>
        <mxCell id="caption-4" value="Voice stop은 Core 응답을 기다리지 않는다. Task 취소는 Core의 내구 접수·Agent 확인이 필요하며 Core 장애 중 성공 접수를 약속하지 않는다." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=16;fontColor=#526178;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="90" y="1146" width="1180" height="28" as="geometry" />
        </mxCell>

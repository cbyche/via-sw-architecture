  <diagram id="06-runtime-and-fault-boundaries" name="배치와 장애 경계 — 입력은 독립, Omni 가중치는 한 곳에">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1470" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="pc" value="USER PC — Voice / ASR / Core / Shared Inference / UI / Connector 경계" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=12;spacingLeft=12;fontStyle=1;fontSize=14;fillColor=#F8FAFC;strokeColor=#94A3B8;dashed=0;arcSize=14;" vertex="1" parent="1">
          <mxGeometry x="45" y="150" width="1810" height="1190" as="geometry" />
        </mxCell>
        <mxCell id="voice" value="&lt;div style='font-size:19px;font-weight:bold'&gt;Voice Process&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;IM: capture · playback · local stop&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;AEC · 활동 감지 · 짧은 buffer&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;Model Access client · weights 없음&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#2563EB;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="90" y="235" width="400" height="165" as="geometry" />
        </mxCell>
        <mxCell id="asr" value="&lt;div style='font-size:19px;font-weight:bold'&gt;Speech Input Worker&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;Streaming ASR × 1 · 전용 입력 근거&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;CPU 예산 · bounded queue · 시간/revision&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;Omni 장애·semantic 완료를 기다리지 않음&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F8FB;strokeColor=#0891B2;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="650" y="235" width="500" height="165" as="geometry" />
        </mxCell>
        <mxCell id="input-note" value="&lt;div style='font-size:19px;font-weight:bold'&gt;입력 보호 조건&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;Capture + ASR 인식 + Omni Voice 진행&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;녹음만 쌓아 두는 것은 정상 동시 처리 아님&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;별도 process ≠ 물리 자원 완전 격리&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D97706;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1340" y="235" width="450" height="165" as="geometry" />
        </mxCell>
        <mxCell id="core" value="&lt;div style='font-size:19px;font-weight:bold'&gt;Core Process&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;Controller · Interpreter · Context · Task&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;Response · Policy · Gateway 상태 권위&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;IM timeline · Model Access client&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;semantic 가중치를 별도 적재하지 않음&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#F3ECFF;strokeColor=#7C3AED;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="90" y="560" width="400" height="190" as="geometry" />
        </mxCell>
        <mxCell id="service" value="&lt;div style='font-size:19px;font-weight:bold'&gt;Shared Inference Service&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;Model Access server · Omni adapter&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;단일 scheduler / weights owner&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;VOICE · SEMANTIC 별도 session/KV&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;Voice 예약 + semantic 최소 진행량&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;chunked prefill · deadline · cancel&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="650" y="530" width="500" height="250" as="geometry" />
        </mxCell>
        <mxCell id="weights" value="&lt;div style='font-size:19px;font-weight:bold'&gt;Omni Model × 1&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;Thinker 약 10B + encoder / speech 모듈&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;같은 PC · 모듈별 한 번 적재&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;두 역할이 같은 weights를 사용&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;가중치 공유 ≠ 같은 Context / 권한&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1340" y="530" width="450" height="250" as="geometry" />
        </mxCell>
        <mxCell id="ui" value="&lt;div style='font-size:19px;font-weight:bold'&gt;UI Process&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;Text · 화면 evidence&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;Core 연결 문제 표시&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;명시적 local stop&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#2563EB;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">

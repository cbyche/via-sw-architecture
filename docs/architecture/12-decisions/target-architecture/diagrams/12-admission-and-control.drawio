        <mxCell id="caption-0" value="→ 관계·전달  ·  점선 = 보조 관계" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=14;fontColor=#526178;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1580" y="96" width="257" height="26" as="geometry" />
        </mxCell>
        <mxCell id="caption-1" value="Confidence 하나로 허용하지 않는다. 모델의 분류 오류는 남는 위험이며 같은 모델의 자기 판단은 독립 검증이 아니다." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=16;fontColor=#526178;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="90" y="369" width="948" height="28" as="geometry" />
        </mxCell>
        <mxCell id="caption-2" value="Core 인계는 S2S agent runtime을 추가하는 경로가 아니다. 사용자 입력을 다시 받거나 답변을 두 번 게시하지 않는다." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=16;fontColor=#526178;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="90" y="654" width="967" height="28" as="geometry" />
        </mxCell>
        <mxCell id="caption-3" value="물리적인 발화 시작과 host hold 기록은 같은 시각이 아니다. 이미 나간 Action을 막았거나 되돌렸다고 주장하지 않는다." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=16;fontColor=#526178;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="90" y="939" width="972" height="28" as="geometry" />
        </mxCell>
        <mxCell id="caption-4" value="짧은 “응”은 실제 제시한 질문의 ID · Task · Execution · revision에 유일하게 연결될 때만 적용한다." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=19;fontColor=#172033;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="1031" width="1035" height="31" as="geometry" />
        </mxCell>
        <mxCell id="caption-5" value="여러 질문이 경쟁하면 질문 대상을 확인한다. 침묵 · 오래된 승인 · 다른 대화의 답은 실행 허가가 아니다." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=17;fontColor=#526178;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="90" y="1078" width="899" height="29" as="geometry" />
        </mxCell>
        <mxCell id="caption-6" value="검토 완료 기준선 · 판정 정확도와 실제 runtime 성능은 미측정 · 자세한 상태 전이는 control-and-lifecycle.md" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=16;fontColor=#526178;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="90" y="1144" width="938" height="28" as="geometry" />
        </mxCell>

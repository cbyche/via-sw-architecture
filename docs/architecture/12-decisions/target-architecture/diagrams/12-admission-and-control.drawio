        </mxCell>
        <mxCell id="handoff" value="B · CORE — 제외 조건 · unknown · 불일치 · 시간 초과 중 하나라도 있는 경우" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=12;spacingLeft=12;fontStyle=1;fontSize=14;fillColor=#F8FAFC;strokeColor=#D5DDE9;dashed=0;arcSize=14;" vertex="1" parent="1">

        <mxCell id="race-1" value="&lt;div style='font-size:19px;font-weight:bold'&gt;State Store transaction&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;hold · admission · command epoch&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;PENDING → DISPATCHING CAS&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D97706;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">

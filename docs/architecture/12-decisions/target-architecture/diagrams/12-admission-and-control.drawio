        <mxCell id="direct-0" value="&lt;div style='font-size:19px;font-weight:bold'&gt;현재 Voice 질문&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;원음 + final 전사만 제공&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;대화 · 화면 · Task 이력 없음&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#2563EB;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="90" y="215" width="340" height="132" as="geometry" />
        </mxCell>
        <mxCell id="direct-1" value="&lt;div style='font-size:19px;font-weight:bold'&gt;Omni VoiceProposal&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;일반 개념 / 안정된 일반 설명&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;dependency flags + text / audio&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#2563EB;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="540" y="215" width="340" height="132" as="geometry" />
        </mxCell>
        <mxCell id="direct-2" value="&lt;div style='font-size:19px;font-weight:bold'&gt;Request Controller 허용 검사&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;전사 · 질문 focus · revision 검사&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;DIRECT_VOICE owner를 한 번 확정&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#2563EB;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="990" y="215" width="340" height="132" as="geometry" />
        </mxCell>
        <mxCell id="direct-3" value="&lt;div style='font-size:19px;font-weight:bold'&gt;응답 전달&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;Response Manager → Interaction Manager&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;내구 publication + output epoch&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;승인 단위만 표시 · 재생&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#2563EB;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1440" y="215" width="340" height="132" as="geometry" />
        </mxCell>
        <mxCell id="handoff-0" value="&lt;div style='font-size:19px;font-weight:bold'&gt;직접 경로 미허용&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;speculative audio 폐기&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;입력과 수집 근거는 유지&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#F3ECFF;strokeColor=#7C3AED;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="90" y="500" width="340" height="132" as="geometry" />
        </mxCell>
        <mxCell id="handoff-1" value="&lt;div style='font-size:19px;font-weight:bold'&gt;같은 Request → CORE&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;새 Request로 복제하지 않음&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;이전 route / generation 차단&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#F3ECFF;strokeColor=#7C3AED;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="540" y="500" width="340" height="132" as="geometry" />
        </mxCell>
        <mxCell id="handoff-2" value="&lt;div style='font-size:19px;font-weight:bold'&gt;의미 해석·근거 보완&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;Request Interpreter + Context Manager&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;총 2회 안에서 해석 · 보완&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;형식 repair도 같은 예산 사용&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#F3ECFF;strokeColor=#7C3AED;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="990" y="500" width="340" height="132" as="geometry" />
        </mxCell>
        <mxCell id="handoff-3" value="&lt;div style='font-size:19px;font-weight:bold'&gt;Request Controller 확정&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;직접 응답 / 질문 / Agent 위임&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;불충분한 근거는 commit하지 않음&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#F3ECFF;strokeColor=#7C3AED;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1440" y="500" width="340" height="132" as="geometry" />
        </mxCell>

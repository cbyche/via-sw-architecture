  <diagram id="08-response-and-interruption" name="응답 생성·게시·중단 — 한 요청에는 하나의 출력 소유권">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1150" math="0" shadow="0">

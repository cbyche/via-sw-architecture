  <diagram id="08-response-and-interruption" name="응답 생성·게시·중단 — 한 요청에는 하나의 출력 소유권">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1440" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="s2s" value="A · S2S 직접 응답 — 명백한 자체 지식 질문만 허용" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=12;spacingLeft=12;fontStyle=1;fontSize=14;fillColor=#F8FAFC;strokeColor=#D5DDE9;dashed=0;arcSize=14;" vertex="1" parent="1">
          <mxGeometry x="45" y="150" width="1810" height="260" as="geometry" />
        </mxCell>
        <mxCell id="core-response" value="B · CORE / AGENT 응답 — 확인된 사실과 질문을 같은 출력 계약으로 전달" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=12;spacingLeft=12;fontStyle=1;fontSize=14;fillColor=#F8FAFC;strokeColor=#D5DDE9;dashed=0;arcSize=14;" vertex="1" parent="1">
          <mxGeometry x="45" y="435" width="1810" height="260" as="geometry" />
        </mxCell>
        <mxCell id="interrupt" value="C · BARGE-IN — 의미 해석과 Agent 취소를 기다리지 않는 로컬 경로" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=12;spacingLeft=12;fontStyle=1;fontSize=14;fillColor=#F8FAFC;strokeColor=#D5DDE9;dashed=0;arcSize=14;" vertex="1" parent="1">
          <mxGeometry x="45" y="720" width="1810" height="260" as="geometry" />
        </mxCell>
        <mxCell id="notification" value="D · 비동기 알림 — 화면에 먼저 표시하고 사용자 발화가 끝난 뒤 말한다" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=12;spacingLeft=12;fontStyle=1;fontSize=14;fillColor=#F8FAFC;strokeColor=#D5DDE9;dashed=0;arcSize=14;" vertex="1" parent="1">
          <mxGeometry x="45" y="1005" width="1810" height="260" as="geometry" />
        </mxCell>
        <mxCell id="s2s-0" value="&lt;div style='font-size:19px;font-weight:bold'&gt;입력 stream&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;Interaction Manager → Model Access&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;ASR 입력 근거 + 공유 Omni 음성 역할&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#2563EB;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="90" y="215" width="340" height="132" as="geometry" />
        </mxCell>
        <mxCell id="s2s-1" value="&lt;div style='font-size:19px;font-weight:bold'&gt;Provisional generation&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;Interaction Manager buffer에 handle·audio 보류&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;input revision·출력 세대 결합&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#2563EB;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="540" y="215" width="340" height="132" as="geometry" />
        </mxCell>
        <mxCell id="s2s-2" value="&lt;div style='font-size:19px;font-weight:bold'&gt;Request Controller admission&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;좁은 direct 허용 / 나머지는 Core&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;VoiceProposal + host 허용 검사&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#2563EB;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="990" y="215" width="340" height="132" as="geometry" />
        </mxCell>
        <mxCell id="s2s-3" value="&lt;div style='font-size:19px;font-weight:bold'&gt;Response Manager&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;publication 기록 후 handle release&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;Interaction Manager에서만 실제 표시·재생&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#2563EB;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1440" y="215" width="340" height="132" as="geometry" />
        </mxCell>
        <mxCell id="core-response-0" value="&lt;div style='font-size:19px;font-weight:bold'&gt;게시할 사실·질문&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;Request Controller가 identity·scope admission&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;Task event는 새 발화 없이 도착&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#2563EB;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="90" y="500" width="340" height="132" as="geometry" />
        </mxCell>
        <mxCell id="core-response-1" value="&lt;div style='font-size:19px;font-weight:bold'&gt;필요한 응답 구성&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;Response Manager → Model Access&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;template / Omni 해석·음성 역할&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#2563EB;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="540" y="500" width="340" height="132" as="geometry" />
        </mxCell>
        <mxCell id="core-response-2" value="&lt;div style='font-size:19px;font-weight:bold'&gt;Publication outbox&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;내용·source·version·출력 세대&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;확정 payload와 생성 내용 검사&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#2563EB;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="990" y="500" width="340" height="132" as="geometry" />
        </mxCell>
        <mxCell id="core-response-3" value="&lt;div style='font-size:19px;font-weight:bold'&gt;Interaction Manager&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;상세 Text 표시 · Voice는 차례 대기&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;채널별 실제 전달 receipt 반환&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#2563EB;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1440" y="500" width="340" height="132" as="geometry" />
        </mxCell>
        <mxCell id="interrupt-0" value="&lt;div style='font-size:19px;font-weight:bold'&gt;새 발화 감지&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;acoustic onset과 감지 시각 구분&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;Interaction Manager의 local event&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="90" y="785" width="340" height="132" as="geometry" />
        </mxCell>
        <mxCell id="interrupt-1" value="&lt;div style='font-size:19px;font-weight:bold'&gt;즉시 재생 중단&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;output epoch 증가·buffer 폐기&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;늦은 audio·이전 release 거절&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="540" y="785" width="340" height="132" as="geometry" />
        </mxCell>
        <mxCell id="interrupt-2" value="&lt;div style='font-size:19px;font-weight:bold'&gt;중단 사실 전달&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;Response Manager에 실제 audible 범위&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;Request Controller에 새 입력·hold event&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="990" y="785" width="340" height="132" as="geometry" />
        </mxCell>
        <mxCell id="interrupt-3" value="&lt;div style='font-size:19px;font-weight:bold'&gt;새 요청 해석&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;정정 / 새 질문 / 업무 취소 구분&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;재개 의도가 불명확할 때만 확인&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1440" y="785" width="340" height="132" as="geometry" />
        </mxCell>
        <mxCell id="notification-0" value="&lt;div style='font-size:19px;font-weight:bold'&gt;Agent 결과 확인&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;Task Manager → Request Controller&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;상태·결과 연결; 실패·입력 필요 보존&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#2563EB;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">

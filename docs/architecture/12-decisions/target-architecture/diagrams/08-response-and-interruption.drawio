        </mxCell>
        <mxCell id="notification-2" value="&lt;div style='font-size:19px;font-weight:bold'&gt;Response Manager 발화 대기열&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;사용자 발화 중 모든 음성 알림 보류&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;종료 뒤 새 입력과 충돌 여부 확인&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#2563EB;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">

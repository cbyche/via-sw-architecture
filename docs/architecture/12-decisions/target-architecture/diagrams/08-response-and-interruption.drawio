        </mxCell>
        <mxCell id="interrupt-2" value="&lt;div style='font-size:19px;font-weight:bold'&gt;중단 사실 전달&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;Response에 실제 audible 범위&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;Controller에 새 입력·hold event&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="990" y="785" width="340" height="132" as="geometry" />
        </mxCell>
        <mxCell id="interrupt-3" value="&lt;div style='font-size:19px;font-weight:bold'&gt;새 요청 해석&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;정정 / 새 질문 / 업무 취소 구분&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;다른 Task는 자동 취소하지 않음&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">

        <mxCell id="caption-0" value="→ 관계·전달  ·  점선 = 보조 관계" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=14;fontColor=#526178;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1580" y="96" width="257" height="26" as="geometry" />
        </mxCell>
        <mxCell id="caption-1" value="직접 경로에서도 승인 전 audio는 재생하지 않는다. Core로 전환하면 speculative generation을 버리고 중복 응답을 막는다." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=16;fontColor=#526178;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="90" y="369" width="1024" height="28" as="geometry" />
        </mxCell>
        <mxCell id="caption-2" value="전체 생성물을 무조건 기다리는 구조는 아니다. 게시 가능한 의미 단위와 Text·audio 대응을 확보한 경우에만 bounded streaming release한다." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=16;fontColor=#526178;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="90" y="654" width="1170" height="28" as="geometry" />
        </mxCell>
        <mxCell id="caption-3" value="Core 장애·포화 중에도 로컬 stop은 유지한다. 재시작 후 확인되지 않은 음성 구간은 UNKNOWN이며 자동으로 재생하지 않는다." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=16;fontColor=#526178;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="90" y="939" width="1007" height="28" as="geometry" />
        </mxCell>
        <mxCell id="caption-4" value="Text에 표시한 내용과 음성으로 들려준 범위는 다르다. 후속 “방금 말한 것”은 실제 전달 channel과 prefix를 근거로 연결한다." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=16;fontColor=#172033;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="1034" width="1043" height="28" as="geometry" />
        </mxCell>

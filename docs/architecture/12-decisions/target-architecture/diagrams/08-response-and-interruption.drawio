        <mxCell id="s2s-0" value="&lt;div style='font-size:19px;font-weight:bold'&gt;입력 stream&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;Interaction Manager → Model Access&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;같은 S2S가 transcript·답변 생성&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#2563EB;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="90" y="215" width="340" height="132" as="geometry" />
        </mxCell>
        <mxCell id="s2s-1" value="&lt;div style='font-size:19px;font-weight:bold'&gt;Provisional generation&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;IM buffer에 handle·audio 보류&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;input revision·출력 세대 결합&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#2563EB;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="540" y="215" width="340" height="132" as="geometry" />
        </mxCell>
        <mxCell id="s2s-2" value="&lt;div style='font-size:19px;font-weight:bold'&gt;Controller admission&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;입력 의미·경로·답변 scope 확인&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;direct 허용 / Core 전환 결정&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#2563EB;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="990" y="215" width="340" height="132" as="geometry" />
        </mxCell>
        <mxCell id="s2s-3" value="&lt;div style='font-size:19px;font-weight:bold'&gt;Response Manager&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;publication 기록 후 handle release&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;IM에서만 실제 표시·재생&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#2563EB;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1440" y="215" width="340" height="132" as="geometry" />
        </mxCell>
        <mxCell id="core-response-0" value="&lt;div style='font-size:19px;font-weight:bold'&gt;게시할 사실·질문&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;Controller가 identity·scope admission&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;Task event는 새 발화 없이 도착&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#2563EB;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="90" y="500" width="340" height="132" as="geometry" />
        </mxCell>
        <mxCell id="core-response-1" value="&lt;div style='font-size:19px;font-weight:bold'&gt;필요한 응답 구성&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;Response Manager → Model Access&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;template / 공유 LLM 요약 / 같은 S2S&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#2563EB;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="540" y="500" width="340" height="132" as="geometry" />
        </mxCell>
        <mxCell id="core-response-2" value="&lt;div style='font-size:19px;font-weight:bold'&gt;Publication outbox&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;내용·source·version·출력 세대&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;확정 payload와 생성 내용 검사&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#2563EB;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="990" y="500" width="340" height="132" as="geometry" />
        </mxCell>
        <mxCell id="core-response-3" value="&lt;div style='font-size:19px;font-weight:bold'&gt;Interaction Manager&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;Text 표시 + Voice 활성 시 핵심 재생&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;채널별 실제 전달 receipt 반환&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#2563EB;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">

        <mxCell id="caption-0" value="→ 관계·전달  ·  점선 = 보조 관계" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=14;fontColor=#526178;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1580" y="96" width="257" height="26" as="geometry" />
        </mxCell>
        <mxCell id="caption-1" value="파랑 점선: InputStarted / hold는 ASR·Omni 완료를 기다리지 않는다. 같은 원음은 VOICE session에도 전달하며 ASR에는 의미 확정 권한이 없다." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=16;fontColor=#526178;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="90" y="369" width="1205" height="28" as="geometry" />
        </mxCell>
        <mxCell id="caption-2" value="순서와 시간 비율은 고정하지 않는다. 동시 활성 session을 batch 또는 교대로 진행하며 실제 kernel 병렬성·즉시 선점을 가정하지 않는다." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=16;fontColor=#526178;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="90" y="1094" width="1121" height="28" as="geometry" />
        </mxCell>
        <mxCell id="caption-3" value="계속 말하는 동안: ASR은 별도 예산으로 진행 · Omni Voice도 기한 내 진행 · semantic이 무한히 밀리지 않을 용량이 필요하다." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=18;fontColor=#172033;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="1172" width="1172" height="30" as="geometry" />
        </mxCell>
        <mxCell id="caption-4" value="포화 대응: background 중단 → 긴 신규 추론 제한 → 확인된 상태 UI 안내. 입력 유실·기한 초과는 기능 실패로 드러낸다." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=17;fontColor=#526178;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="90" y="1223" width="1057" height="29" as="geometry" />
        </mxCell>
        <mxCell id="caption-5" value="Capture / recognition / Omni Voice 세 단계의 진행을 구분한다. 원음과 근거를 누락시키거나 잘못된 이전 결과를 게시하지 않는다." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=17;fontColor=#526178;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="90" y="1273" width="1160" height="29" as="geometry" />
        </mxCell>
        <mxCell id="caption-6" value="추가 ASR · 이중 음성 처리 · 역할별 KV · 공유 장애 비용이 있다. 이 설계의 품질·latency 우세는 아직 검증되지 않았다." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=17;fontColor=#526178;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="90" y="1323" width="1055" height="29" as="geometry" />
        </mxCell>
        <mxCell id="caption-7" value="색은 책임 구분이며 우선순위 점수가 아니다. ASR과 speech 역할은 다른 기능; 실시간 예약도 의미 확정·dispatch 권한을 주지 않는다." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=16;fontColor=#526178;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="90" y="1394" width="1089" height="28" as="geometry" />
        </mxCell>

        <mxCell id="voice-job" value="&lt;div style='font-size:19px;font-weight:bold'&gt;VOICE session&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;audio stream · 좁은 direct/Core 제안&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;승인된 내용을 음성화 · tool 없음&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#2563EB;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="90" y="505" width="340" height="130" as="geometry" />
        </mxCell>
        <mxCell id="semantic-job" value="&lt;div style='font-size:19px;font-weight:bold'&gt;SEMANTIC session&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;목표·referent·Task·handling 제안&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;응답 구성 / 기억 요약은 별도 job&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#F3ECFF;strokeColor=#7C3AED;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="90" y="675" width="340" height="130" as="geometry" />
        </mxCell>
        <mxCell id="scheduler" value="&lt;div style='font-size:19px;font-weight:bold'&gt;Model Access scheduler&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;VOICE 연산·KV 예약&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;semantic 최소 진행량 + deadline&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;긴 prefill / encoder 작업 상한&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;취소·admission·bounded microbatch&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="650" y="530" width="500" height="245" as="geometry" />
        </mxCell>
        <mxCell id="omni" value="&lt;div style='font-size:19px;font-weight:bold'&gt;Omni weights × 1&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;Thinker 약 10B + 주변 모듈&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;두 역할의 Context는 합치지 않음&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;모델 장애는 두 역할에 동시 영향&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;ASR의 자원 비용은 별도&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1440" y="530" width="340" height="245" as="geometry" />

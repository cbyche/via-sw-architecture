  <diagram id="11-shared-omni-scheduling" name="공유 Omni — 의미 해석 중에도 듣고, 두 역할을 함께 진행">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1490" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="input" value="A · INPUT — 추론 결과를 기다리지 않고 수신·인식을 계속한다" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=12;spacingLeft=12;fontStyle=1;fontSize=14;fillColor=#F8FAFC;strokeColor=#D5DDE9;dashed=0;arcSize=14;" vertex="1" parent="1">
          <mxGeometry x="45" y="150" width="1810" height="260" as="geometry" />
        </mxCell>

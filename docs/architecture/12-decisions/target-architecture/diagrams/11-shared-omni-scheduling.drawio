          <mxGeometry x="45" y="435" width="1810" height="410" as="geometry" />
        </mxCell>
        <mxCell id="schedule" value="C · ACCELERATOR — 전체 호출을 직렬 잠그지 않고 짧은 계산 단위로 교대한다" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=12;spacingLeft=12;fontStyle=1;fontSize=14;fillColor=#F8FAFC;strokeColor=#D5DDE9;dashed=0;arcSize=14;" vertex="1" parent="1">
          <mxGeometry x="45" y="875" width="1810" height="260" as="geometry" />
        </mxCell>
        <mxCell id="input-0" value="&lt;div style='font-size:19px;font-weight:bold'&gt;Voice capture&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;microphone · sample sequence&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;AEC · 활동 감지 · local stop&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F8FB;strokeColor=#0891B2;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="90" y="215" width="340" height="132" as="geometry" />
        </mxCell>
        <mxCell id="input-1" value="&lt;div style='font-size:19px;font-weight:bold'&gt;독립 Streaming ASR&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;전용 CPU 예산 · partial / final&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;시간 근거 · 정정 revision · gap&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F8FB;strokeColor=#0891B2;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="540" y="215" width="340" height="132" as="geometry" />
        </mxCell>
        <mxCell id="input-2" value="&lt;div style='font-size:19px;font-weight:bold'&gt;IM timeline&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;원음 + 당시 화면 + 전사 revision&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;Omni 불일치는 별도 proposal&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F8FB;strokeColor=#0891B2;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="990" y="215" width="340" height="132" as="geometry" />
        </mxCell>
        <mxCell id="input-3" value="&lt;div style='font-size:19px;font-weight:bold'&gt;Controller&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;Final → 의미 해석 · host 검증&lt;/div&gt;&lt;div style='font-size:15px;color:#526178'&gt;입력 시작 hold는 별도 즉시 경로&lt;/div&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F8FB;strokeColor=#0891B2;strokeWidth=2;fontColor=#172033;dashed=0;arcSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1440" y="215" width="340" height="132" as="geometry" />

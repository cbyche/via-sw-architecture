      "B": "96.5",
      "reason": "B의 후보화에서 빠진 교차 단서를 최종 결합이 자동으로 복구하지 못할 잔여 위험"
    },
    "expansion": {
      "A": "96",
      "B": "92",
      "reason": "집합 경계와 화면 전환은 원본 재판단 뒤에도 후보 범위와 발화의 대응을 잘못 유지할 위험"
    },
    "partial": {
      "A": "97",
      "B": "98.5",
      "reason": "B의 생산자별 revision과 부분 후보 교체가 정정하지 않은 항목 보존에 유리하다는 가설; A도 patch 허용"
    },
    "history_explicit": {
      "A": "99",
      "B": "99",
      "reason": "실제 전달과 Task ID 관계는 양안 모두 원본의 명시 관계로 조회"
    },
    "history_cache": {
      "A": "99",
      "B": "99",
      "reason": "같은 유효 관계의 재조회는 A cache와 B 게시 관계 모두 재사용"
    },
    "history_semantic": {
      "A": "97",
      "B": "96",
      "reason": "B의 과거에 게시한 의미 관계는 현재 요청에서 원본을 읽어도 잘못된 연결을 남길 수 있음"
    },
    "history_new_relation": {
      "A": "97",
      "B": "94",
      "reason": "B는 새 관계 생산 결과를 게시한 뒤 현재 해석에 다시 전달해 의미 연결 오류 지점이 추가됨"
    },
    "other": {
      "A": "99",
      "B": "99",
      "reason": "해당 DP는 지칭 의미 생산자를 바꾸지 않음"
    },
    "history_updated_ready": {
      "A": "97",
      "B": "96",
      "reason": "변경 원본은 양안 모두 읽지만 B의 갱신된 파생 의미 연결에는 잔여 게시 오류 위험이 있음"
    },
    "history_current_comparison": {
      "A": "97",
      "B": "97",
      "reason": "새 질문의 비용과 일정 관계는 게시 관계 종류를 새로 만들지 않고 양안 모두 현재 요청에서 같은 원본으로 해석"
    }

idth="220.04" height="30.3" /></mxCell><mxCell id="e69" value="⑥ 요청별 실행 시작" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=18;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2218" y="582" width="178.64" height="30.3" /></mxCell><mxCell id="e71" value="⑰ 최종 제안 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=18;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2222" y="510" width="160.64" height="30.3" /></mxCell><mxCell id="e73" value="⑦ / ⑮ 모델 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#233247;fontSize=18;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2057" y="785" width="158.12" height="30.3" /></mxCell><mxCell id="e78" value="③ / ⑪ 원본 읽기" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#233247;fontSize=18;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1376" y="803" width="158.12" height="30.3" /></mxCell><mxCell id="e80" value="④ / ⑫ 원문 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#233247;fontSize=18;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1562" y="896" width="158.12" height="30.3" /></mxCell><mxCell id="e83" value="모델 내부는 VIA 책임 밖 / on-device, weights 한 벌" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5E6D80;fontSize=16;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2000" y="1001" width="465.6" height="27.6" /></mxCell><mxCell id="e86" value="⑨ 읽기 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=18;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1748" y="744" width="113.48" height="30.3" /></mxCell><mxCell id="e90" value="⑩ 위임 / ⑬~⑭ 근거 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=17;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1734" y="883" width="215.4" height="28.950000000000003" /></mxCell><mxCell id="e93" value="DESIGN FOCUS  /  실행 수명 유지 → 읽기 동안 연산 양보 → 재개" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=18;fontFamily=Arial;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1337" y="1219" width="608.48" height="30.3" /></mxCell><mxCell id="e94" value="Semantic Resolution Worker가 재개 handle과 임시 read set 보유&lt;br&gt;Capability Read Broker가 권한과 예산을 검사해 읽기 위임&lt;br&gt;⑱ 최종 확정 권한은 계속 Request Controller에 있음" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#233247;fontSize=22;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1337" y="1257" width="797.8" height="105" /></mxCell><mxCell id="e95" value="READ_REQUIRED와 같은 실행의 재개 지원은 미확인. 대기 중 KV 수명 관리가 추가된다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#956016;fontSize=18;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1337" y="1369" width="788.48" height="30.3" /></mxCell><mxCell id="e97" value="범례" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5E6D80;fontSize=17;fontFamily=Arial;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="1552" width="42.0" height="28.950000000000003" /></mxCell><mxCell id="e99" value="호출 / 전달" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5E6D80;fontSize=17;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="190" y="1551" width="107.62" height="28.950000000000003" /></mxCell><mxCell id="e101" value="결과 / 복원" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5E6D80;fontSize=17;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="405" y="1551" width="107.62" height="28.950000000000003" /></mxCell><mxCell id="e103" value="구조 차이 또는 확대 대상" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5E6D80;fontSize=17;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="597" y="1551" width="220.16" height="28.950000000000003" /></mxCell><mxCell id="e104" value="외부 책임 경계 ≠ 원격 배치  |  모델은 on-device 의존성" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5E6D80;fontSize=17;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1020" y="1551" width="511.88" height="28.950000000000003" /></mxCell><mxCell id="e105" value="①~⑤ 기본 준비는 공통. 전체 ①~⑱ 왕복 순서와 호출 수명은 다음 실행 상세도에서 확대한다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5E6D80;fontSize=18;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="1597" width="818.36" height="30.3" /></mxCell><mxCell id="e106" value="설계 탐색  /  미채택 대안  /  미측정" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5E6D80;fontSize=17;fontFamily=Arial;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2157.52" y="1598" width="338.48" height="28.950000000000003" /></mxCell></root></mxGraphModel></diagram></mxfile>

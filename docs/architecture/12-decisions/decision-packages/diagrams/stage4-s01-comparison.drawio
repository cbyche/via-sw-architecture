 입력과 근거 참조" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#233247;fontSize=18;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="491" y="413" width="225.8" height="30.3" /></mxCell><mxCell id="e23" value="② 기본 Context 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#233247;fontSize=18;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="329" y="522" width="202.76" height="30.3" /></mxCell><mxCell id="e25" value="⑤ Context + receipt" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#233247;fontSize=18;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="666" y="545" width="220.04" height="30.3" /></mxCell><mxCell id="e27" value="⑥ / ⑭ 해석 호출" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=18;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="970" y="582" width="158.12" height="30.3" /></mxCell><mxCell id="e29" value="⑨ / ⑰ 제안 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=18;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="974" y="510" width="158.12" height="30.3" /></mxCell><mxCell id="e31" value="⑦ / ⑮ 모델 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#233247;fontSize=18;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="809" y="785" width="158.12" height="30.3" /></mxCell><mxCell id="e36" value="③ / ⑪ 원본 읽기" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#233247;fontSize=18;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="128" y="803" width="158.12" height="30.3" /></mxCell><mxCell id="e38" value="④ / ⑫ 원문 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#233247;fontSize=18;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="314" y="896" width="158.12" height="30.3" /></mxCell><mxCell id="e41" value="모델 내부는 VIA 책임 밖 / on-device, weights 한 벌" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5E6D80;fontSize=16;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="752" y="1001" width="465.6" height="27.6" /></mxCell><mxCell id="e43" value="⑩ 추가 읽기" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=18;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="109" y="604" width="113.48" height="30.3" /></mxCell><mxCell id="e46" value="DESIGN FOCUS  /  종료 → 보완 → 새 호출" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=18;fontFamily=Arial;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="89" y="1219" width="401.84" height="30.3" /></mxCell><mxCell id="e47" value="해석 호출 1 종료 → Request Controller가 추가 읽기 조정&lt;br&gt;추가 Context 결합 → 해석 호출 2 시작&lt;br&gt;⑱ Request Controller가 현재 revision과 receipt로 최종 확정" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#233247;fontSize=22;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="89" y="1257" width="751.6" height="105" /></mxCell><mxCell id="e48" value="별도 호출이어도 기존 session이나 prefix의 재사용을 금지하는 구조는 아니다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#956016;fontSize=18;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="89" y="1369" width="721.52" height="30.3" /></mxCell><mxCell id="e50" value="A" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=white;fontSize=27;fontFamily=Arial;fontStyle=1;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1323.63" y="246" width="24.74" height="42.45" /></mxCell><mxCell id="e51" value="하나의 실행 안에서 재개" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#233247;fontSize=27;fontFamily=Arial;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1380" y="237" width="328.22" height="42.45" /></mxCell><mxCell id="e52" value="탐색안 / 중단 및 재개 계약 추가" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5E6D80;fontSize=18;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1380" y="276" width="302.12" height="30.3" /></mxCell><mxCell id="e54" value="VIA SOFTWARE / 비교 영역" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgrou
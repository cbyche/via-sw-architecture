top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2298.28" y="42" width="197.72" height="30.3" /></mxCell><mxCell id="e4" value="요청 해석 정확성을 위한 추가 자료 확인 설계&lt;br&gt;해석을 끝내고 재호출할 것인가, 멈춘 해석을 이어갈 것인가?" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=34;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="75" width="1013.72" height="94" /></mxCell><mxCell id="e5" value="T는 호출을 끝내고 Request Controller로 돌아온다. A는 읽기를 기다리는 작업과 모델 재개 계약을 새로 갖는다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=22;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="166" width="1255.4" height="35.7" /></mxCell><mxCell id="e8" value="공통 시작 1~5 / 최종 입력과 기본 자료를 준비한다" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=21;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="88" y="245" width="542.24" height="34.35" /></mxCell><mxCell id="e15" value="사용자 발화 또는 Text" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="269" width="212.12" height="30.3" /></mxCell><mxCell id="e17" value="1. 확정 입력과 당시 근거" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="915" y="269" width="236.96" height="30.3" /></mxCell><mxCell id="e19" value="2. 허용 범위의 기본 자료 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1400" y="269" width="284.12" height="30.3" /></mxCell><mxCell id="e21" value="3. 현재 원문 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1885" y="269" width="171.8" height="30.3" /></mxCell><mxCell id="e23" value="4. 원문과 버전 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1760" y="360" width="189.8" height="30.3" /></mxCell><mxCell id="e25" value="5. 기본 Context와 읽지 못한 범위 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1240" y="388" width="373.4" height="30.3" /></mxCell><mxCell id="e27" value="T" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=white;fontSize=27;fontStyle=1;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="75.63" y="467" width="24.74" height="42.45" /></mxCell><mxCell id="e28" value="호출 종료 → 자료 보완 → 새 호출" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=28;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="132" y="409" width="472.24" height="43.800000000000004" /></mxCell><mxCell id="e29" value="실제 target / 추가 읽기를 Request Controller가 조정" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="132" y="499" width="533.96" height="30.3" /></mxCell><mxCell id="e31" value="VIA SOFTWARE" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=18;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="86" y="574" width="141.92" height="30.3" /></mxCell><mxCell id="e32" value="비교에 필요한 책임만 표시" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=16;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1012.24" y="576" width="213.76" height="27.6" /></mxCell><mxCell id="e40" value="추가 읽기는 해석기 안에 없다.&lt;br&gt;9 첫 호출이 끝난 뒤&lt;br&gt;Request Controller가 진행한다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=22;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="736" y="1090" width="390.8" height="95.10000000000001" /></mxCell><mxCell id="e44" value="10 조회" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1064" y="1277" width="77.48" height="30.3" /></mxCell><mxCell id="e46" value="13 자료를 받은 뒤 새 호출" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="799" y="957" width="248.12" height="30.3" /></mxCell><mxCell id="e48" value="6 첫 해석 호출" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="117" y="972" width="142.64" height="30.3" /></mxCell><mxCell id="e50" value="9 자료 부족 제안" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="438" y="969" width="160.64" height="30.3" /></mxCell><mxCell id="e52" value="14 새 호출" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="115" y="1017" width="106.64" height="30.3" /></mxCell><mxCell id="e54" value="17 최종 제안" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="728" y="997" width="124.64" height="30.3" /></mxCell><mxCell id="e59" value="7 / 15 모델 실행" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="130" y="1566" width="169.28" height="30.3" /></mxCell><mxCell id="e61" value="8 / 16 실행 결과" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="389" y="1600" width="169.28" height="30.3" /></mxCell><mxCell id="e63" value="상태 사용" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="586" y="1762" width="91.16" height="30.3" /></mxCell><mxCell id="e70" value="책임 이동과 계약 변경" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=21;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="88" y="2107" width="236.06" height="34.35" /></mxCell><mxCell id="e71" value="T: 해석기는 읽기 제안 후 종료한다. 추가 조회와 새 호출은 Request Controller가 소유한다.&lt;br&gt;A는 이름 교체가 아니다: 읽기 대기 상태, 권한 검사 접점, 모델 재개 인터페이스가 필요하다.&lt;br&gt;두 안 모두 Context Manager가 원본을 읽고 Request Controller가 최종 의미를 확정한다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="88" y="2148" width="1004.66" height="99" /></mxCell><mxCell id="e72" value="별도 호출도 기존 모델 세션을 재사용할 수 있다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#895914;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="88" y="2254" width="439.28" height="30.3" /></mxCell><mxCell id="e74" value="A" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=white;fontSize=27;fontStyle=1;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1323.63" y="467" width="24.74" height="42.45" /></mxCell><mxCell id="e75" value="같은 작업에서 읽기 대기 → 재개" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=28;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1380" y="409" width="448.16" height="43.800000000000004" /></mxCell><mxCell id="e76" value="탐색안 / Worker와 Broker, 모델 중단 및 재개 계약 추가" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1380" y="499" width="534.68" height="30.3" /></mxCell><mxCell id="e78" value="VIA SOFTWARE" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=18;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1334" y="574" width="141.92" height="30.3" /></mxCell><mxCell id="e79" value="비교에 필요한 책임만 표시" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=16;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2260.24" y="576" width="213.76" height="27.6" /></mxCell><mxCell id="e83" value="추가 읽기의 대기와 재개는 아래 Worker가 맡는다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1379" y="836" width="509.2" height="33.0" /></mxCell><mxCell id="e93" value="9 필요한 자료 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1822" y="1015" width="178.64" height="30.3" /></mxCell><mxCell id="e95" value="14 자료 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1832" y="1318" width="124.64" height="30.3" /></mxCell><mxCell id="e99" value="10 조회 위임" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2027" y="1300" width="124.64" height="30.3" /></mxCell><mxCell id="e101" value="13 자료 + 읽은 버전" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2253" y="1330" width="194.12" height="30.3" /></mxCell><mxCell id="e103" value="6 해석 시작" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1365" y="972" width="113.48" height="30.3" /></mxCell><mxCell id="e105" value="17 최종 제안 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1527" y="969" width="171.8" height="30.3" /></mxCell><mxCell id="e110" value="7 / 15 모델 실행" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1378" y="1566" width="169.28" height="30.3" /></mxCell><mxCell id="e112" value="8 / 16 실행 결과" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1637" y="1600" width="169.28" height="30.3" /></mxCell><mxCell id="e114" value="상태 사용" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1834" y="1762" width="91.16" height="30.3" /></mxCell><mxCell id="e121" value="책임 이동과 계약 변경" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=21;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1336" y="2107" width="236.06" height="34.35" /></mxCell><mxCell id="e122" value="A: Worker가 작업을 유지하고 Broker로 자료를 읽는다. 모델 연산은 기다리는 동안 양보한다.&lt;br&gt;A는 이름 교체가 아니다: 읽기 대기 상태, 권한 검사 접점, 모델 재개 인터페이스가 필요하다.&lt;br&gt;두 안 모두 Context Manager가 원본을 읽고 Request Controller가 최종 의미를 확정한다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1336" y="2148" width="989.54" height="99" /></mxCell><mxCell id="e123" value="모델의 중단 및 재개 지원은 미확인. 지원되지 않으면 이 대안은 성립하지 않는다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#895914;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1336" y="2254" width="729.08" height="30.3" /></mxCell><mxCell id="e125" value="색:  검정 = 공통     파랑 = T 전용     초록 = A/B 전용" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=19;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="2322" width="584.84" height="31.650000000000002" /></mxCell><mxCell id="e126" value="실선 → 요청/전달     점선 → 결과/복원" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=18;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2126.92" y="2322" width="369.08" height="30.3" /></mxCell><mxCell id="e127" value="모양:  제목 칸이 있는 박스 = Component   |   내부 둥근 박스 = Module   |   원통 = 저장소   |   접힌 종이 = 자료   |   육각형 = 연동 대상/모델" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=17;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="2360" width="1347.26" height="28.950000000000003" /></mxCell><mxCell id="e128" value="11~12의 원본 조회 왕복과 전체 호출 순서는 다음 실행 상세도에 표시한다. 상자 분리는 별도 process를 뜻하지 않는다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=17;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="2400" width="1021.2" height="28.950000000000003" /></mxCell><mxCell id="e129" value="탐색안 / 미채택 / 미측정" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=17;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2271.76" y="2400" width="224.24" height="28.950000000000003" /></mxCell></root></mxGraphModel></diagram></mxfile>

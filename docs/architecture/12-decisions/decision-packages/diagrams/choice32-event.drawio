metry" x="2287.12" y="42" width="208.88" height="30.3" /></mxCell><mxCell id="e4" value="화면 지칭의 정확성을 위한 대상 결합&lt;br&gt;통합 해석과 분리 생산 후 결합" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=34;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="75" width="623.4" height="94" /></mxCell><mxCell id="e5" value="화면 7을 가리키며 “이 표와” → 스크롤 → 화면 8의 “저 표를 비교” → 첫 대상만 정정" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=22;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="166" width="943.0" height="35.7" /></mxCell><mxCell id="e7" value="A  말과 화면을 함께 해석" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=30;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="285" width="389.6" height="46.5" /></mxCell><mxCell id="e8" value="위에서 아래로 읽기. 가로 화살표의 시작/끝이 실제 송신자/수신자." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="345" width="664.4" height="33.0" /></mxCell><mxCell id="e10" value="Interaction&lt;br&gt;Manager" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=20;fontStyle=1;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="107.8" y="415" width="144.4" height="62" /></mxCell><mxCell id="e13" value="Context Manager" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=20;fontStyle=1;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="321.0" y="415" width="194.0" height="34" /></mxCell><mxCell id="e16" value="Joint&lt;br&gt;Grounding Interpreter" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=20;fontStyle=1;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="521.8" y="415" width="268.4" height="62" /></mxCell><mxCell id="e19" value="Model Access" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=20;fontStyle=1;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="815.6" y="415" width="156.8" height="34" /></mxCell><mxCell id="e22" value="Request Controller" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=20;fontStyle=1;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1016.4" y="415" width="231.2" height="34" /></mxCell><mxCell id="e24" value="1  첫 지시: 화면 7, 포인터 p1, 시점 t1" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="74" y="580" width="452.36" height="34.35" /></mxCell><mxCell id="e26" value="2  스크롤 뒤 둘째 지시: 화면 8, p2, t2" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="74" y="691" width="452.36" height="34.35" /></mxCell><mxCell id="e28" value="같은 원문/관측 묶음; Request Controller가 해석 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="74" y="802" width="606.5" height="34.35" /></mxCell><mxCell id="e30" value="3  말 + 화면 + 포인터/시점의 공동 해석" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="74" y="913" width="437.24" height="34.35" /></mxCell><mxCell id="e32" value="완성 대응 d1=L@7, d2=R@8 제안" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="74" y="1024" width="355.34" height="34.35" /></mxCell><mxCell id="e34" value="관측 ID/창/시점 검증; 모호하면 재해석/질문" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="74" y="1135" width="474.2" height="34.35" /></mxCell><mxCell id="e36" value="검증된 두 대상과 비교 관계 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="74" y="1246" width="346.1" height="34.35" /></mxCell><mxCell id="e38" value="4  “첫 표는 왼쪽 말고 오른쪽”" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="74" y="1357" width="335.18" height="34.35" /></mxCell><mxCell id="e40" value="해당 관측과 정정 원문으로 대응 재해석" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="74" y="1468" width="409.1" height="34.35" /></mxCell><mxCell id="e42" value="새 첫 참조 + 유지할 둘째 참조 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="74" y="1579" width="385.16" height="34.35" /></mxCell><mxCell id="e44" value="5  입력/자료/권한 현재 검사 후 인계" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="74" y="1690" width="398.18" height="34.35" /></mxCell><mxCell id="e46" value="읽을 결론: 복잡한 시각 표현과 말의 맥락을 함께 활용" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=22;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="74" y="2070" width="592.76" height="35.7" /></mxCell><mxCell id="e47" value="대가: 시간/대상 오결합 가능; 관련 장면 재해석" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="74" y="2115" width="503.18" height="34.35" /></mxCell><mxCell id="e48" value="B  두 근거를 생산한 뒤 결합" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=30;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1312" y="285" width="438.2" height="46.5" /></mxCell><mxCell id="e49" value="위에서 아래로 읽기. 가로 화살표의 시작/끝이 실제 송신자/수신자." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1312" y="345" width="664.4" height="33.0" /></mxCell><mxCell id="e51" value="Grounding&lt;br&gt;Coordinator" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=20;fontStyle=1;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1355.8" y="415" width="144.4" height="62" /></mxCell><mxCell id="e54" value="Scene&lt;br&gt;Candidate Producer" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=20;fontStyle=1;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1550.4" y="415" width="231.2" height="62" /></mxCell><mxCell id="e57" value="Deictic&lt;br&gt;Anchor Producer" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=20;fontStyle=1;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1807.0" y="415" width="194.0" height="62" /></mxCell><mxCell id="e60" value="Grounding&lt;br&gt;Join Engine" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=20;fontStyle=1;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2069.8" y="415" width="144.4" height="62" /></mxCell><mxCell id="e63" value="Request Controller" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=20;fontStyle=1;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2264.4" y="415" width="231.2" height="34" /></mxCell><mxCell id="e65" value="1  화면 7/p1/t1 기록을 Context Manager에서 수신" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1322" y="580" width="574.58" height="34.35" /></mxCell><mxCell id="e67" value="2  화면 8/p2/t2 및 최종 발화와 같은 범위로 고정" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1322" y="688" width="544.34" height="34.35" /></mxCell><mxCell id="e69" value="화면/포인터/시점 → 후보 생성 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1322" y="796" width="372.14" height="34.35" /></mxCell><mxCell id="e71" value="발화/시점/이전 참조 → 지시 조건 생성 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1322" y="904" width="461.18" height="34.35" /></mxCell><mxCell id="e73" value="3  L@7, R@8 등의 영역/종류/시점 후보" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1322" y="1012" width="426.32" height="34.35" /></mxCell><mxCell id="e75" value="d1:t1의 표, d2:t2의 표, 관계=비교" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1322" y="1120" width="397.34" height="34.35" /></mxCell><mxCell id="e77" value="호환되는 두 버전 확인 후 조건 결합 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1322" y="1228" width="435.14" height="34.35" /></mxCell><mxCell id="e79" value="d1=L@7, d2=R@8 또는 미해결" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1322" y="1336" width="321.32" height="34.35" /></mxCell><mxCell id="e81" value="4  첫 표 정정: 언어 조건 수정 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1322" y="1444" width="390.2" height="34.35" /></mxCell><mxCell id="e83" value="수정한 첫 지시 조건 + 새 버전 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1322" y="1552" width="385.16" height="34.35" /></mxCell><mxCell id="e85" value="화면 후보가 충분하면 재사용; 없으면 재생산" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1322" y="1660" width="464.12" height="34.35" /></mxCell><mxCell id="e87" value="새 결합 결과와 사용한 두 근거 버전 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1322" y="1768" width="435.14" height="34.35" /></mxCell><mxCell id="e89" value="5  새 결합 결과/버전 반환 → 현재 검사 후 인계" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1322" y="1876" width="513.26" height="34.35" /></mxCell><mxCell id="e91" value="읽을 결론: 시간/위치 결합 근거와 정정 범위를 명시" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=22;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1322" y="2070" width="570.76" height="35.7" /></mxCell><mxCell id="e92" value="대가: 두 생산의 누락/지연; 표현 밖 영역은 재지칭" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1322" y="2115" width="537.2" height="34.35" /></mxCell><mxCell id="e93" value="생략한 공통 연동: 추론은 Model Access의 한 벌 Omni; 업무 실행은 Task Manager/Agent Gateway가 Downstream Agent에 위임." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="2200" width="1285.94" height="31.650000000000002" /></mxCell><mxCell id="e94" value="실선 = 요청/전달, 점선 = 결과. 별도 언급 없는 참여자는 논리 책임. 시간 간격은 성능 수치가 아닌 사건 순서. 수작업 설계 추적, 미측정." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="2240" width="1323.18" height="31.650000000000002" /></mxCell></root></mxGraphModel></diagram></mxfile>

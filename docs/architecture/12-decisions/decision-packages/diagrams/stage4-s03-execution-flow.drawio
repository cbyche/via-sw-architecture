ml=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=19;fontStyle=1;fillColor=#F7F9FC;strokeColor=#263445;fontColor=#263445;strokeWidth=1.7;" vertex="1" parent="1"><mxGeometry as="geometry" x="105" y="320" width="230" height="104" /></mxCell><mxCell id="produce-actor3" value="추가 의미 표현 모델" style="shape=hexagon;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=19;fontStyle=1;fillColor=#F7F9FC;strokeColor=#263445;fontColor=#263445;strokeWidth=1.7;" vertex="1" parent="1"><mxGeometry as="geometry" x="1695" y="320" width="230" height="104" /></mxCell><mxCell id="produce-actor4" value="의미 색인" style="shape=cylinder;size=14;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=19;fontStyle=1;fillColor=#F7F9FC;strokeColor=#263445;fontColor=#263445;strokeWidth=1.7;" vertex="1" parent="1"><mxGeometry as="geometry" x="2225" y="320" width="230" height="104" /></mxCell><mxCell id="target-actor2" value="원본 소유자" style="shape=hexagon;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=19;fontStyle=1;fillColor=#F7F9FC;strokeColor=#263445;fontColor=#263445;strokeWidth=1.7;" vertex="1" parent="1"><mxGeometry as="geometry" x="953" y="1242" width="230" height="104" /></mxCell><mxCell id="target-actor5" value="공유 Omni" style="shape=hexagon;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=19;fontStyle=1;fillColor=#F7F9FC;strokeColor=#263445;fontColor=#263445;strokeWidth=1.7;" vertex="1" parent="1"><mxGeometry as="geometry" x="2225" y="1242" width="230" height="104" /></mxCell><mxCell id="alternative-actor4" value="의미 색인" style="shape=cylinder;size=14;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=19;fontStyle=1;fillColor=#F7F9FC;strokeColor=#263445;fontColor=#263445;strokeWidth=1.7;" vertex="1" parent="1"><mxGeometry as="geometry" x="1067" y="2386" width="190" height="104" /></mxCell><mxCell id="alternative-actor5" value="원본 소유자" style="shape=hexagon;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=19;fontStyle=1;fillColor=#F7F9FC;strokeColor=#263445;fontColor=#263445;strokeWidth=1.7;" vertex="1" parent="1"><mxGeometry as="geometry" x="1303" y="2386" width="190" height="104" /></mxCell><mxCell id="alternative-actor8" value="공유 Omni" style="shape=hexagon;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=19;fontStyle=1;fillColor=#F7F9FC;strokeColor=#263445;fontColor=#263445;strokeWidth=1.7;" vertex="1" parent="1"><mxGeometry as="geometry" x="2009" y="2386" width="190" height="104" /></mxCell><mxCell id="alternative-actor9" value="추가 의미 표현 모델" style="shape=hexagon;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=19;fontStyle=1;fillColor=#F7F9FC;strokeColor=#263445;fontColor=#263445;strokeWidth=1.7;" vertex="1" parent="1"><mxGeometry as="geometry" x="2245" y="2386" width="190" height="104" /></mxCell><mxCell id="e2" value="VIA  /  ARCHITECTURE REVIEW" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=18;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="42" width="309.32" height="30.3" /></mxCell><mxCell id="e3" value="S-03 / 실행 순서  /  STAGE 04" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=18;fontStyle=1;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2181.64" y="42" width="314.36" height="30.3" /></mxCell><mxCell id="e4" value="자료 변경과 사용자 요청은 서로 다른 때 시작한다" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=42;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="87" width="1030.28" height="62.7" /></mxCell><mxCell id="e5" value="각 흐름은 1부터 읽는다. 색인은 후보를 찾는 자료이며, 원본과 현재 권한 확인은 양안에 남는다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=23;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="151" width="1101.42" height="37.05" /></mxCell><mxCell id="e8" value="A의 추가 자료 준비 / 허용된 원본이 변경되거나 삭제될 때" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=26;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="88" y="258" width="757.32" height="41.1" /></mxCell><mxCell id="e20" value="1. 변경 또는 삭제와 원본 버전 전달" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="232" y="446" width="367.2" height="33.0" /></mxCell><mxCell id="e22" value="2. 현재 원문, 권한과 버전 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="232" y="520" width="327.2" height="33.0" /></mxCell><mxCell id="e24" value="3. 읽을 수 있는 원문과 버전 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="232" y="594" width="347.2" height="33.0" /></mxCell><mxCell id="e26" value="4. 문서의 검색 표현 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="762" y="668" width="262.4" height="33.0" /></mxCell><mxCell id="e28" value="5. 추가 의미 표현 모델 호출" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1292" y="742" width="294.8" height="33.0" /></mxCell><mxCell id="e30" value="6. 검색 표현과 모델 버전 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1292" y="816" width="314.8" height="33.0" /></mxCell><mxCell id="e32" value="7. 검색 표현과 모델 버전 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="762" y="890" width="314.8" height="33.0" /></mxCell><mxCell id="e34" value="8. 완성된 색인과 원본 버전 목록 함께 게시" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="762" y="964" width="439.6" height="33.0" /></mxCell><mxCell id="e35" value="자료 소유자의 변경 알림이 없으면 허용 범위의 버전을 확인한다. 게시 전에는 일부 생성물을 검색에 사용하지 않는다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="88" y="1057" width="1101.26" height="31.650000000000002" /></mxCell><mxCell id="e37" value="T의 요청 처리 / 확정된 사용자 입력과 허용 범위 도착" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=26;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="88" y="1180" width="705.32" height="41.1" /></mxCell><mxCell id="e51" value="1. 범위와 이름, 기간, 주제 단서 전달" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="232" y="1368" width="392.0" height="33.0" /></mxCell><mxCell id="e53" value="2. 기존 이름, 단어 색인과 캐시에서 후보 조회" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="699" y="1446" width="472.0" height="33.0" /></mxCell><mxCell id="e55" value="3. 후보의 현재 원문, 버전과 권한 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="656" y="1516" width="399.6" height="33.0" /></mxCell><mxCell id="e57" value="4. 원문과 읽지 못한 범위 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="656" y="1590" width="314.8" height="33.0" /></mxCell><mxCell id="e59" value="5. 검증한 Context 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="232" y="1664" width="256.8" height="33.0" /></mxCell><mxCell id="e61" value="6. 현재 입력과 Context 해석 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="232" y="1738" width="361.6" height="33.0" /></mxCell><mxCell id="e63" value="7. 의미 해석 모델 호출 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1504" y="1812" width="294.8" height="33.0" /></mxCell><mxCell id="e65" value="8. 공유 Omni에 해석 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1928" y="1886" width="272.0" height="33.0" /></mxCell><mxCell id="e67" value="9. 해석 결과 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1928" y="1960" width="190.0" height="33.0" /></mxCell><mxCell id="e69" value="10. 모델 결과 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1504" y="2034" width="202.4" height="33.0" /></mxCell><mxCell id="e71" value="11. 의미 제안 반환 / 현재 근거 검증" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="232" y="2108" width="384.4" height="33.0" /></mxCell><mxCell id="e72" value="후보가 모호하거나 원문이 없으면 확정하지 않는다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="88" y="2201" width="477.68" height="31.650000000000002" /></mxCell><mxCell id="e74" value="A의 요청 처리 / 같은 입력과 허용 범위 도착" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=26;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="88" y="2324" width="585.2" height="41.1" /></mxCell><mxCell id="e96" value="1. T와 같은 범위와 자료 단서 전달" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="232" y="2512" width="359.6" height="33.0" /></mxCell><mxCell id="e98" value="2. 의미 후보 조회 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="468" y="2586" width="242.4" height="33.0" /></mxCell><mxCell id="e100" value="3. 질문의 검색 표현 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="703" y="2660" width="262.4" height="33.0" /></mxCell><mxCell id="e102" value="4. 추가 의미 표현 모델에 질문 전달" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="939" y="2734" width="367.2" height="33.0" /></mxCell><mxCell id="e104" value="5. 질문의 검색 표현 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="939" y="2808" width="262.4" height="33.0" /></mxCell><mxCell id="e106" value="6. 검색 표현 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="703" y="2882" width="190.0" height="33.0" /></mxCell><mxCell id="e108" value="7. 의미 색인에서 후보 조회" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="703" y="2956" width="282.4" height="33.0" /></mxCell><mxCell id="e110" value="8. 후보와 원본 버전 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="703" y="3030" width="262.4" height="33.0" /></mxCell><mxCell id="e112" value="9. 후보, 준비 상태와 누락 범위 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="468" y="3104" width="379.6" height="33.0" /></mxCell><mxCell id="e114" value="10. 후보 원본과 현재 권한 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="468" y="3178" width="327.2" height="33.0" /></mxCell><mxCell id="e116" value="11. 현재 원문과 버전 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="468" y="3252" width="274.8" height="33.0" /></mxCell><mxCell id="e118" value="12. 검증한 Context 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="232" y="3326" width="269.2" height="33.0" /></mxCell><mxCell id="e120" value="13. 현재 입력과 Context의 의미 해석 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="232" y="3400" width="446.4" height="33.0" /></mxCell><mxCell id="e122" value="14. 의미 해석 모델 호출 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1645" y="3474" width="307.2" height="33.0" /></mxCell><mxCell id="e124" value="15. 공유 Omni에 해석 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1881" y="3548" width="284.4" height="33.0" /></mxCell><mxCell id="e126" value="16. 해석 결과 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1881" y="3622" width="202.4" height="33.0" /></mxCell><mxCell id="e128" value="17. 모델 결과 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1645" y="3696" width="202.4" height="33.0" /></mxCell><mxCell id="e130" value="18. 제안 반환 / 현재 근거 검증" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="232" y="3770" width="332.0" height="33.0" /></mxCell><mxCell id="e131" value="색인이 없으면 기존 조회를 사용한다. 후보 한 건도 실제 대상의 확정은 아니다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="88" y="3863" width="750.14" height="31.650000000000002" /></mxCell><mxCell id="e133" value="색:  검정 = 공통     파랑 = T 전용     초록 = A/B 전용" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=19;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="4422" width="584.84" height="31.650000000000002" /></mxCell><mxCell id="e134" value="실선 → 요청/전달     점선 → 결과/복원" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=18;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2126.92" y="4422" width="369.08" height="30.3" /></mxCell><mxCell id="e135" value="모양:  제목 칸이 있는 박스 = Component   |   내부 둥근 박스 = Module   |   원통 = 저장소   |   접힌 종이 = 자료   |   육각형 = 연동 대상/모델" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=17;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="4460" width="1347.26" height="28.950000000000003" /></mxCell><mxCell id="e136" value="검색 후보가 충분하지 않으면 원본 조회 또는 사용자 확인으로 진행한다. 추가 의미 모델은 공유 Omni와 별도 비용이다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=17;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="4500" width="1004.88" height="28.950000000000003" /></mxCell><mxCell id="e137" value="탐색안 / 미채택 / 미측정" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=17;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2271.76" y="4500" width="224.24" height="28.950000000000003" /></mxCell></root></mxGraphModel></diagram></mxfile>

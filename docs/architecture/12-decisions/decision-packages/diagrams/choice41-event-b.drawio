5" y="1931" width="363.68" height="31.650000000000002" /></mxCell><mxCell id="e96" value="답변 해석 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="560" y="1990" width="145.56" height="31.650000000000002" /></mxCell><mxCell id="e98" value="질문/후보와 답변 해석" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="765" y="2049" width="214.34" height="31.650000000000002" /></mxCell><mxCell id="e100" value="답변 의미 반환: 예산 보고서라는 후보 제한 표현" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="765" y="2108" width="463.24" height="31.650000000000002" /></mxCell><mxCell id="e102" value="해석 결과 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="560" y="2167" width="145.56" height="31.650000000000002" /></mxCell><mxCell id="e104" value="변경 틀 전달. 질문 버전/후보 검사" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="560" y="2226" width="337.46" height="31.650000000000002" /></mxCell><mxCell id="e106" value="코드로 Task 후보 결합. 앞선 금지 조건 유지" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1585" y="2285" width="434.36" height="31.650000000000002" /></mxCell><mxCell id="e108" value="7  완성 의미 + 근거/Task 버전 제안" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="355" y="2344" width="362.92" height="31.650000000000002" /></mxCell><mxCell id="e110" value="현재 자료 제공/실행 인계 권한 검사" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="355" y="2403" width="344.68" height="31.650000000000002" /></mxCell><mxCell id="e112" value="현재 허용 또는 거절" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="355" y="2462" width="195.34" height="31.650000000000002" /></mxCell><mxCell id="e114" value="사용한 자료 버전의 현재 유효성 확인" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="355" y="2521" width="351.9" height="31.650000000000002" /></mxCell><mxCell id="e116" value="유효/변경/철회 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="355" y="2580" width="195.34" height="31.650000000000002" /></mxCell><mxCell id="e118" value="Task/질문의 현재 상태 확인" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="355" y="2639" width="273.24" height="31.650000000000002" /></mxCell><mxCell id="e120" value="현재 상태와 버전" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="355" y="2698" width="164.56" height="31.650000000000002" /></mxCell><mxCell id="e122" value="입력/질문과 채택 버전 검사. 불일치면 인계하지 않고 재평가" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="355" y="2757" width="570.02" height="31.650000000000002" /></mxCell><mxCell id="e124" value="채택 버전 통지; Engine 소유 상태를 State Store에 보관" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="355" y="2816" width="568.5" height="31.650000000000002" /></mxCell><mxCell id="e126" value="저장 성공/실패 반환. 실패면 외부 인계 보류" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="355" y="2875" width="425.24" height="31.650000000000002" /></mxCell><mxCell id="e128" value="8  조건부 Task 생성/변경 + command ID. 버전이 또 바뀌면 거절" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="355" y="2934" width="641.84" height="31.650000000000002" /></mxCell><mxCell id="e130" value="허용된 요청/조건/참조와 command ID" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1380" y="2993" width="362.92" height="31.650000000000002" /></mxCell><mxCell id="e132" value="외부 업무 위임. 업무 계획/도구 실행은 Agent 책임" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1995" y="3052" width="495.92" height="31.650000000000002" /></mxCell><mxCell id="e134" value="접수 결과. 완료와 구별" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1995" y="3111" width="226.12" height="31.650000000000002" /></mxCell><mxCell id="e136" value="해당 Task의 접수/거절/불명" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1380" y="3170" width="273.24" height="31.650000000000002" /></mxCell><mxCell id="e138" value="확인된 상태" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="355" y="3229" width="114.78" height="31.650000000000002" /></mxCell><mxCell id="e140" value="사용자에게 확인된 상태 전달 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="355" y="3288" width="321.12" height="31.650000000000002" /></mxCell><mxCell id="e142" value="필요한 응답 구성 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="765" y="3347" width="214.34" height="31.650000000000002" /></mxCell><mxCell id="e144" value="같은 Omni의 분리된 응답 세션" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="765" y="3406" width="292.24" height="31.650000000000002" /></mxCell><mxCell id="e146" value="응답 결과" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="765" y="3465" width="95.78" height="31.650000000000002" /></mxCell><mxCell id="e148" value="Text/음성 구성 결과" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="765" y="3524" width="204.46" height="31.650000000000002" /></mxCell><mxCell id="e150" value="같은 사용자 출력: 접수 상태/질문/보류. 작업 완료로 꾸미지 않음" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="150" y="3583" width="624.36" height="31.650000000000002" /></mxCell><mxCell id="e152" value="실제 전달 기록" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="150" y="3642" width="145.56" height="31.650000000000002" /></mxCell><mxCell id="e154" value="게시 기록 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="355" y="3701" width="145.56" height="31.650000000000002" /></mxCell><mxCell id="e156" value="관련 질문/채택 상태에 실제 게시 기록 연결" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="355" y="3760" width="413.46" height="31.650000000000002" /></mxCell><mxCell id="e158" value="같은 열/시작/끝. A의 Engine 열은 비움. 모델 가중치 한 벌, 해석/응답 세션은 분리. 채택 상태 보관은 State Store." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="3927" width="1148.76" height="31.650000000000002" /></mxCell><mxCell id="e159" value="B의 조건부 부분 해석: Engine → Interpreter → Model Access → Omni → 역순 후보 반환 → Engine 결합. 이 사례는 추가 해석 없이 질문." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="3967" width="1376.38" height="31.650000000000002" /></mxCell><mxCell id="e160" value="실선=전달/요청, 점선=반환. 논리 순서를 수작업으로 추적한 설계이며 호출 횟수/간격은 성능 측정값이 아님." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="4007" width="1018.04" height="31.650000000000002" /></mxCell></root></mxGraphModel></diagram></mxfile>

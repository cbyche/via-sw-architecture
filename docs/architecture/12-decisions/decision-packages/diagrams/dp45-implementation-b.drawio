Geometry></mxCell><mxCell id="wire48" source="read" target="policy" edge="1" parent="1" style="edgeStyle=none;rounded=0;strokeColor=#195FBD;strokeWidth=2;endArrow=open;endFill=0;exitX=0.8666666666666667;exitY=1.0;exitPerimeter=0;entryX=0.0;entryY=0.5;entryPerimeter=0;"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint as="point" x="1344" y="1745" /><mxPoint as="point" x="3120" y="1745" /><mxPoint as="point" x="3120" y="1535" /></Array></mxGeometry></mxCell><mxCell id="wire49" source="policy" target="read" edge="1" parent="1" style="edgeStyle=none;rounded=0;strokeColor=#195FBD;strokeWidth=2;endArrow=open;endFill=0;dashed=1;exitX=0.0;exitY=0.7142857142857143;exitPerimeter=0;entryX=0.8;entryY=1.0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint as="point" x="3140" y="1580" /><mxPoint as="point" x="3140" y="1780" /><mxPoint as="point" x="1304" y="1780" /></Array></mxGeometry></mxCell><mxCell id="note0" parent="1" vertex="1" value="VIA / DP-45 / IMPLEMENTATION DESIGN" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=26;fontStyle=1;align=left;spacing=0;"><mxGeometry as="geometry" x="64" y="18" width="608.6" height="33.8" /></mxCell><mxCell id="note1" parent="1" vertex="1" value="구현 설계 / 제품 구현 및 모델 실행 아님" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=24;fontStyle=0;align=right;spacing=0;"><mxGeometry as="geometry" x="3265.44" y="20" width="510.56" height="31.2" /></mxCell><mxCell id="note2" parent="1" vertex="1" value="B: 공통 관계 생산과 게시본 조회" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=44;fontStyle=1;align=left;spacing=0;"><mxGeometry as="geometry" x="64" y="68" width="739.28" height="57.2" /></mxCell><mxCell id="note3" parent="1" vertex="1" value="같은 원본, 권한과 요청. 긴 I/O와 모델 호출은 비동기 작업이며 실제 읽은 버전과 누락을 반환한다." style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=28;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="64" y="140" width="1413.6" height="36.4" /></mxCell><mxCell id="note4" parent="1" vertex="1" value="입력 등록" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=21;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="390" y="430" width="105.86" height="27.3" /></mxCell><mxCell id="note5" parent="1" vertex="1" value="0  허용된 현재 요청에서 조회 시작" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=24;fontStyle=1;align=left;spacing=0;"><mxGeometry as="geometry" x="64" y="958" width="430.88" height="31.2" /></mxCell><mxCell id="note6" parent="1" vertex="1" value="현재 요청 해석" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=21;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="365" y="1249" width="161.72" height="27.3" /></mxCell><mxCell id="note7" parent="1" vertex="1" value="공통 후속: 의미 제안 → 현재 검사 → 채택" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=24;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="64" y="1460" width="534.56" height="31.2" /></mxCell><mxCell id="note8" parent="1" vertex="1" value="위임은 채택 후에만 수행" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=26;fontStyle=1;align=left;spacing=0;"><mxGeometry as="geometry" x="64" y="1934" width="319.48" height="33.8" /></mxCell><mxCell id="note9" parent="1" vertex="1" value="Task Manager → Agent Gateway&lt;br&gt;→ Downstream Agent: 제안서 작성" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=24;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="64" y="1979" width="468.8" height="62.4" /></mxCell><mxCell id="note10" parent="1" vertex="1" value="실선 = 요청 / 점선 파랑 = 완료 / 빨강 = 사용 차단 / 회색 = 상태 접근. 선 교차는 접속점이 아니다." style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=24;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="64" y="2082" width="1275.2" height="31.2" /></mxCell><mxCell id="note11" parent="1" vertex="1" value="양안 공통: 로컬 VIA, owner별 State Store 저장, bounded async executor. 상자 수는 thread / process / DB 제품 수가 아니다." style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=24;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="64" y="2121" width="1755.2" height="31.2" /></mxCell><mxCell id="note12" parent="1" vertex="1" value="1 확정 변경" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=21;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="3040" y="551" width="133.58" height="27.3" /></mxCell><mxCell id="note13" parent="1" vertex="1" value="job 등록" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#758294;fontSize=21;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="2740" y="827" width="105.44" height="27.3" /></mxCell><mxCell id="note14" parent="1" vertex="1" value="2 claimed job" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=21;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="2252" y="824" width="188.18" height="27.3" /></mxCell><mxCell id="note15" parent="1" vertex="1" value="3 원본 snapshot" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=21;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="1438" y="673" width="202.46" height="27.3" /></mxCell><mxCell id="note16" parent="1" vertex="1" value="4 추출 / 명시 연결 결과" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=21;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="1135" y="831" width="273.02" height="27.3" /></mxCell><mxCell id="note17" parent="1" vertex="1" value="조건부 의미 API" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=22;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="790" y="859" width="190.6" height="28.6" /></mxCell><mxCell id="note18" parent="1" vertex="1" value="게시 전 재검사" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=21;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="1638" y="819" width="161.72" height="27.3" /></mxCell><mxCell id="note19" parent="1" vertex="1" value="5 검증 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=21;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="1442" y="931" width="133.58" height="27.3" /></mxCell><mxCell id="note20" parent="1" vertex="1" value="6 조건부 transaction" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#758294;fontSize=21;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="1692" y="1109" width="265.04" height="27.3" /></mxCell><mxCell id="note21" parent="1" vertex="1" value="게시 결과" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#758294;fontSize=21;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="2252" y="972" width="105.86" height="27.3" /></mxCell><mxCell id="note22" parent="1" vertex="1" value="변경 범위 먼저 DIRTY" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#B63732;fontSize=21;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="2770" y="1079" width="244.88" height="27.3" /></mxCell><mxCell id="note23" parent="1" vertex="1" value="7 Query" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=21;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="674" y="1469" width="105.02" height="27.3" /></mxCell><mxCell id="note24" parent="1" vertex="1" value="8 후보 / coverage 조회" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=21;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="1440" y="1520" width="286.04" height="27.3" /></mxCell><mxCell id="note25" parent="1" vertex="1" value="9 covered" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=21;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="2252" y="1560" width="132.74" height="27.3" /></mxCell><mxCell id="note26" parent="1" vertex="1" value="검증한 snapshot / gaps" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=21;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="1980" y="1674" width="292.76" height="27.3" /></mxCell><mxCell id="note27" parent="1" vertex="1" value="10 Bundle / receipt" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=21;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="744" y="1739" width="271.34" height="27.3" /></mxCell><mxCell id="note28" parent="1" vertex="1" value="11 미생산: read 대기 등록" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#758294;fontSize=21;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="1100" y="1389" width="307.46" height="27.3" /></mxCell><mxCell id="note29" parent="1" vertex="1" value="11 지원 범위 backfill" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=21;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="2370" y="1394" width="272.18" height="27.3" /></mxCell><mxCell id="note30" parent="1" vertex="1" value="12 게시 알림 후 재조회" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=21;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="812" y="1109" width="259.16" height="27.3" /></mxCell><mxCell id="note31" parent="1" vertex="1" value="resume" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=21;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="1387" y="1461" width="91.16" height="27.3" /></mxCell><mxCell id="note32" parent="1" vertex="1" value="현재 epoch 검사 + 사용 등록" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=21;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="1820" y="1719" width="328.46" height="27.3" /></mxCell><mxCell id="note33" parent="1" vertex="1" value="원본은 owner별로 State Store에 저장" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=none;fontColor=#758294;fontSize=22;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="3184" y="1300" width="459.88" height="28.6" /></mxCell><mxCell id="note34" parent="1" vertex="1" value="공통 User Memory" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=26;fontStyle=1;align=left;spacing=0;"><mxGeometry as="geometry" x="3184" y="1784" width="265.92" height="33.8" /></mxCell><mxCell id="note35" parent="1" vertex="1" value="Context Manager의 명시 저장과 삭제 원장&lt;br&gt;양안 동일 / 과거 관계에서 자동 등록하지 않음&lt;br&gt;B+ 원본 조합 우회는 이 순수 B 그림 밖" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=23;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="3184" y="1831" width="543.44" height="89.7" /></mxCell></root></mxGraphModel></diagram></mxfile>

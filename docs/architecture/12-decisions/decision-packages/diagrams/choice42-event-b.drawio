eColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=24;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="718" y="652" width="462.08" height="38.400000000000006" /></mxCell><mxCell id="e32" value="현재 검사 → 업무 상태·명령·접수 결과 저장" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=24;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1678" y="714" width="525.92" height="38.400000000000006" /></mxCell><mxCell id="e34" value="로컬 접수 결과 / 외부 접수와 별개" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=24;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="718" y="776" width="424.16" height="38.400000000000006" /></mxCell><mxCell id="e36" value="접수 결과를 대화 저장소에 반영" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=24;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="718" y="838" width="379.52" height="38.400000000000006" /></mxCell><mxCell id="e38" value="현재 전송 조건 확인 후 답변 전달" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=24;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1678" y="900" width="409.28" height="38.400000000000006" /></mxCell><mxCell id="e40" value="외부 Agent 접수 확인" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=24;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1678" y="962" width="271.04" height="38.400000000000006" /></mxCell><mxCell id="e42" value="확인된 외부 접수 상태 전달" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=24;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="718" y="1024" width="331.52" height="38.400000000000006" /></mxCell><mxCell id="e44" value="“상반기 조건을 전달했어요”" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=24;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="183" y="1086" width="331.52" height="38.400000000000006" /></mxCell><mxCell id="e46" value="실제 전달 기록 P2 → 대화 상태에 보관" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=24;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="183" y="1148" width="468.8" height="38.400000000000006" /></mxCell><mxCell id="e47" value="경쟁: Q1이 철회되거나 X1이 끝났으면 현재 검사에서 거절. 실패한 명령을 외부에 전달하지 않는다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=26;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="1290" width="1276.28" height="41.1" /></mxCell><mxCell id="e49" value="검정: 공통  ·  파랑: A  ·  초록: B     실선: 요청·변경  /  점선 화살표: 반환·조회 결과" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=28;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="1360" width="1096.36" height="37.05" /></mxCell><mxCell id="e50" value="같은 의미 해석·자료·권한 조건 / 모델 호출과 Agent 연동 내부는 축약 / 선 간격은 소요시간이 아님" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=21;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1440.52" y="1399" width="1055.48" height="34.35" /></mxCell></root></mxGraphModel></diagram></mxfile>

<mxfile host="app.diagrams.net" type="device"><diagram name="대화 Context · 다음 발화 사이에도 업무·질문·기억은 변한다  |  배경" id="conversation-context-maintenance-background"><mxGraphModel page="1" pageWidth="2560" pageHeight="1440" grid="1" gridSize="10"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="challenge" value="" style="rounded=1;arcSize=8;html=1;fillColor=#FFFFFF;strokeColor=#171717;strokeWidth=2.5;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="48" y="1170" width="2464" height="170" /></mxCell><mxCell id="challenge-title" value="Architecture Challenge" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;fontColor=#171717;fontSize=20;fontStyle=1;fontFamily=Arial;align=left;verticalAlign=top;spacing=0;connectable=0;" vertex="1" parent="challenge"><mxGeometry as="geometry" x="16" y="8" width="2432" height="27" /></mxCell><mxCell id="challenge-text-0" value="여러 owner 기록을 요청 시 조합할 것인가, 활성 대화의 working view를 지속 갱신하고 revision barrier 뒤 소비할 것인가?" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;fontColor=#171717;fontSize=20;fontStyle=0;fontFamily=Arial;align=left;verticalAlign=top;spacing=0;connectable=0;" vertex="1" parent="challenge"><mxGeometry as="geometry" x="16" y="44" width="2432" height="27" /></mxCell><mxCell id="scenario" value="" style="rounded=1;arcSize=8;html=1;fillColor=#FFFFFF;strokeColor=#171717;strokeWidth=2.5;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="48" y="142" width="2464" height="104" /></mxCell><mxCell id="scenario-title" value="사용자 상황" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;fontColor=#171717;fontSize=20;fontStyle=1;fontFamily=Arial;align=left;verticalAlign=top;spacing=0;connectable=0;" vertex="1" parent="scenario"><mxGeometry as="geometry" x="16" y="8" width="2432" height="27" /></mxCell><mxCell id="scenario-text-0" value="보고서와 메일 업무를 오가며 “아까 형식으로 정리해줘”라고 한다. 그 사이 취소·질문·선호 삭제가 발생한다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;fontColor=#171717;fontSize=20;fontStyle=0;fontFamily=Arial;align=left;verticalAlign=top;spacing=0;connectable=0;" vertex="1" parent="scenario"><mxGeometry as="geometry" x="16" y="44" width="2432" height="27" /></mxCell><mxCell id="pressure0" value="" style="rounded=1;arcSize=8;html=1;fillColor=#FFFFFF;strokeColor=#171717;strokeWidth=2.5;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="48" y="925" width="792" height="205" /></mxCell><mxCell id="pressure0-title" value="요청 시 구성" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;fontColor=#171717;fontSize=20;fontStyle=1;fontFamily=Arial;align=left;verticalAlign=top;spacing=0;connectable=0;" vertex="1" parent="pressure0"><mxGeometry as="geometry" x="16" y="8" width="760" height="27" /></mxCell><mxCell id="pressure0-text-0" value="쓰는 범위만 읽고 조합한다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;fontColor=#171717;fontSize=20;fontStyle=0;fontFamily=Arial;align=left;verticalAlign=top;spacing=0;connectable=0;" vertex="1" parent="pressure0"><mxGeometry as="geometry" x="16" y="44" width="760" height="27" /></mxCell><mxCell id="pressure0-text-1" value="유효 cache·summary는 재사용한다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;fontColor=#171717;fontSize=20;fontStyle=0;fontFamily=Arial;align=left;verticalAlign=top;spacing=0;connectable=0;" vertex="1" parent="pressure0"><mxGeometry as="geometry" x="16" y="69" width="760" height="27" /></mxCell><mxCell id="pressure0-text-2" value="반복 조합 비용이 요청 경로에 남는다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;fontColor=#171717;fontSize=20;fontStyle=0;fontFamily=Arial;align=left;verticalAlign=top;spacing=0;connectable=0;" vertex="1" parent="pressure0"><mxGeo
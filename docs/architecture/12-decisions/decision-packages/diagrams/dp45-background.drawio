<mxfile host="app.diagrams.net" type="device"><diagram id="dp45-background" name="DP45. 과거 설명과 업무 결과의 재사용"><mxGraphModel page="1" pageWidth="1920" pageHeight="1080" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="dp45-background-1" parent="1" vertex="1" value="DP45. 과거 설명과 업무 결과의 재사용" style="fontFamily=Calibri;fontSize=40.0;fontColor=#000000;fontStyle=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="60" y="30" width="1040" height="60" /></mxCell><mxCell id="dp45-background-2" parent="1" edge="1" style="edgeStyle=none;rounded=0;strokeColor=#A6A6A6;strokeWidth=1.5;endArrow=none;endFill=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="52" y="104" /><mxPoint as="targetPoint" x="1872" y="104" /><Array as="points" /></mxGeometry></mxCell><mxCell id="dp45-background-3" parent="1" edge="1" style="edgeStyle=none;rounded=0;strokeColor=#A6A6A6;strokeWidth=1.5;endArrow=none;endFill=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="52" y="908" /><mxPoint as="targetPoint" x="1868" y="908" /><Array as="points" /></mxGeometry></mxCell><mxCell id="dp45-background-4" parent="1" vertex="1" value="설계 질문" style="fontFamily=Calibri;fontSize=30.666666666666668;fontColor=#C00000;fontStyle=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="52" y="935" width="180" height="50" /></mxCell><mxCell id="dp45-background-5" parent="1" vertex="1" value="VIA의 설명, 여러 Agent 결과와 정정·실제 전달 기록을&lt;br&gt;나중 요청에서 어떻게 다시 연결해 사용할까?" style="fontFamily=Calibri;fontSize=30.666666666666668;fontColor=#000000;fontStyle=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="260" y="932" width="1608" height="100" /></mxCell><mxCell id="dp45-background-6" parent="1" vertex="1" value="“지난번 네가 설명한 기준으로,&lt;br&gt;제품 비교와 견적도 이번 제안서에 반영해줘.”" style="fontFamily=Calibri;fontSize=36.0;fontColor=#000000;fontStyle=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="52" y="150" width="1816" height="110" /></mxCell><mxCell id="dp45-background-7" parent="1" vertex="1" value="VIA에게 들은 설명" style="fontFamily=Calibri;fontSize=30.666666666666668;fontColor=#000000;fontStyle=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="52" y="310" width="568" height="50" /></mxCell><mxCell id="dp45-background-8" parent="1" vertex="1" value="평가 기준&lt;br&gt;원문과 실제 전달 범위" style="fontFamily=Calibri;fontSize=29.333333333333332;fontColor=#000000;fontStyle=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=0;shape=rect;fillColor=#FFFFFF;strokeColor=#A6A6A6;strokeWidth=2;spacing=14;"><mxGeometry as="geometry" x="52" y="382" width="568" height="117" /></mxCell><mxCell id="dp45-background-9" parent="1" vertex="1" value="제품 조사 Agent 결과" style="fontFamily=Calibri;fontSize=30.666666666666668;fontColor=#000000;fontStyle=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="676" y="310" width="568" height="50" /></mxCell><mxCell id="dp45-background-10" parent="1" vertex="1" value="제품 비교&lt;br&gt;확인된 결과와 자료 참조" style="fontFamily=Calibri;fontSize=29.333333333333332;fontColor=#000000;fontStyle=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=0;shape=rect;fillColor=#FFFFFF;strokeColor=#A6A6A6;strokeWidth=2;spacing=14;"><mxGeometry as="geometry" x="676" y="382" width="568" height="117" /></mxCell><mxCell id="dp45-background-11" parent="1" vertex="1" value="견적 Agent 결과" style="fontFamily=Calibri;fontSize=30.666666666666668;fontColor=#000000;fontStyle=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="1300" y="310" width="568" height="50" /></mxCell><mxCell id="dp45-background-12" parent="1" vertex="1" value="견적&lt;br&gt;확인된 결과와 버전" style="fontFamily=Calibri;fontSize=29.333333333333332;fontColor=#000000;fontStyle=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=0;shape=rect;fillColor=#FFFFFF;strokeColor=#A6A6A6;strokeWidth=2;spacing=14;"><mxGeometry as="geometry" x="1300" y="382" width="568" height="117" /></mxCell><mxCell id="dp45-background-13" parent="1" edge="1" style="edgeStyle=none;rounded=0;strokeColor=#00889A;strokeWidth=2.5;endArrow=none;endFill=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="336" y="503" /><mxPoint as="targetPoint" x="336" y="523" /><Array as="points" /></mxGeometry></mxCell><mxCell id="dp45-background-14" parent="1" edge="1" style="edgeStyle=none;rounded=0;strokeColor=#00889A;strokeWidth=2.5;endArrow=open;endFill=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="336" y="590" /><mxPoint as="targetPoint" x="336" y="605" /><Array as="points" /></mxGeometry></mxCell><mxCell id="dp45-background-15" parent="1" edge="1" style="edgeStyle=none;rounded=0;strokeColor=#00889A;strokeWidth=2.5;endArrow=none;endFill=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="960" y="503" /><mxPoint as="targetPoint" x="960" y="523" /><Array as="points" /></mxGeometry></mxCell><mxCell id="dp45-background-16" parent="1" edge="1" style="edgeStyle=none;rounded=0;strokeColor=#00889A;strokeWidth=2.5;endArrow=open;endFill=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="960" y="590" /><mxPoint as="targetPoint" x="960" y="605" /><Array as="points" /></mxGeometry></mxCell><mxCell id="dp45-background-17" parent="1" edge="1" style="edgeStyle=none;rounded=0;strokeColor=#00889A;strokeWidth=2.5;endArrow=none;endFill=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1584" y="503" /><mxPoint as="targetPoint" x="1584" y="523" /><Array as="points" /></mxGeometry></mxCell><mxCell id="dp45-background-18" parent="1" edge="1" style="edgeStyle=none;rounded=0;strokeColor=#00889A;strokeWidth=2.5;endArrow=open;endFill=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1584" y="590" /><mxPoint as="targetPoint" x="1584" y="605" /><Array as="points" /></mxGeometry></mxCell><mxCell id="dp45-background-19" parent="1" vertex="1" value="그 뒤 “가격은 비교에서 빼줘”라고 조건을 고쳤습니다." style="fontFamily=Calibri;fontSize=32.0;fontColor=#000000;fontStyle=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="52" y="535" width="1816" height="50" /></mxCell><mxCell id="dp45-background-20" parent="1" vertex="1" value="이번 요청의 과거 맥락&lt;br&gt;실제 전달한 기준 · 정정한 조건 · 사용 가능한 결과" style="fontFamily=Calibri;fontSize=30.666666666666668;fontColor=#000000;fontStyle=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=0;shape=rect;fillColor=#F2F2F2;strokeColor=#A6A6A6;strokeWidth=2;spacing=14;"><mxGeometry as="geometry" x="52" y="627" width="1816" height="109" /></mxCell><mxCell id="dp45-background-21" parent="1" vertex="1" value="옛 조건이나 전달하지 않은 설명을 쓰면, 이번 업무를 다른 뜻으로 맡기게 됩니다." style="fontFamily=Calibri;fontSize=30.666666666666668;fontColor=#000000;fontStyle=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="52" y="767" width="1816" height="52" /></mxCell><mxCell id="dp45-background-22" parent="1" vertex="1" value="기록이 여러 곳에 흩어져 있고, 수정·삭제 후 사용할 수 있는 범위도 바뀝니다." style="fontFamily=Calibri;fontSize=29.333333333333332;fontColor=#000000;fontStyle=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="52" y="837" width="1816" height="48" /></mxCell></root></mxGraphModel></diagram></mxfile>

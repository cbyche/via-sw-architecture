<mxfile host="app.diagrams.net" type="device"><diagram id="choice46-quality" name="46 | 구조 차이가 만드는 조건별 QA 손익"><mxGraphModel page="1" pageWidth="2560" pageHeight="1440" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="t0" vertex="1" parent="1" value="46 | 구조 차이가 만드는 조건별 QA 손익" style="text;html=1;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;overflow=visible;fillColor=#FFFFFF;strokeColor=none;fontSize=36;fontStyle=1;fontFamily=Apple SD Gothic Neo;"><mxGeometry as="geometry" x="40" y="20" width="2480" height="46.800000000000004" /></mxCell><mxCell id="t1" vertex="1" parent="1" value="설명용 가설 / 미선정·미구현·미측정. 시간 관계는 코드이며 과거 의미 가공만 조건부 모델 호출이다." style="text;html=1;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;overflow=visible;fillColor=#FFFFFF;strokeColor=none;fontSize=24;fontStyle=0;fontFamily=Apple SD Gothic Neo;"><mxGeometry as="geometry" x="40" y="75" width="2480" height="31.200000000000003" /></mxCell><mxCell id="t2" vertex="1" parent="1" value="QA 관점" style="text;html=1;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;overflow=visible;fillColor=#FFFFFF;strokeColor=none;fontSize=28;fontStyle=1;fontFamily=Apple SD Gothic Neo;"><mxGeometry as="geometry" x="40" y="150" width="380" height="36.4" /></mxCell><mxCell id="t3" vertex="1" parent="1" value="A 요청별 원본 결합" style="text;html=1;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;overflow=visible;fillColor=#FFFFFF;strokeColor=none;fontSize=28;fontStyle=1;fontFamily=Apple SD Gothic Neo;"><mxGeometry as="geometry" x="430" y="150" width="990" height="36.4" /></mxCell><mxCell id="t4" vertex="1" parent="1" value="B 공통 관계 생산 / 조회" style="text;html=1;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;overflow=visible;fillColor=#FFFFFF;strokeColor=none;fontSize=28;fontStyle=1;fontFamily=Apple SD Gothic Neo;"><mxGeometry as="geometry" x="1500" y="150" width="1010" height="36.4" /></mxCell><mxCell id="t5" vertex="1" parent="1" value="요청 처리 정확성" style="text;html=1;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;overflow=visible;fillColor=#FFFFFF;strokeColor=none;fontSize=27;fontStyle=1;fontFamily=Apple SD Gothic Neo;"><mxGeometry as="geometry" x="40" y="250" width="380" height="35.1" /></mxCell><mxCell id="t6" vertex="1" parent="1" value="이번 요청의 원본·새 관계를 직접 검토&lt;br&gt;cache도 허용 / query 결합 오류 가능" style="text;html=1;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;overflow=visible;fillColor=#FFFFFF;strokeColor=none;fontSize=27;fontStyle=0;fontFamily=Apple SD Gothic Neo;"><mxGeometry as="geometry" x="430" y="250" width="990" height="70.2" /></mxCell><mxCell id="t7" vertex="1" parent="1" value="게시된 관계·coverage 범위에서 검토&lt;br&gt;누락·낡은 view·공통 오류 전파 가능" style="text;html=1;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;overflow=visible;fillColor=#FFFFFF;strokeColor=none;fontSize=27;fontStyle=0;fontFamily=Apple SD Gothic Neo;"><mxGeometry as="geometry" x="1500" y="250" width="1010" height="70.2" /></mxCell><mxCell id="t8" vertex="1" parent="1" value="응답속도" style="text;html=1;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;overflow=visible;fillColor=#FFFFFF;strokeColor=none;fontSize=27;fontStyle=1;fontFamily=Apple SD Gothic Neo;"><mxGeometry as="geometry" x="40" y="435" width="380" height="35.1" /></mxCell><mxCell id="t9" vertex="1" parent="1" value="필요한 순간 시간·과거 근거 결합&lt;br&gt;prefetch/cache로 대기 줄일 수 있음" style="text;html=1;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;overflow=visible;fillColor=#FFFFFF;strokeColor=none;fontSize=27;fontStyle=0;fontFamily=Apple SD Gothic Neo;"><mxGeometry as="geometry" x="430" y="435" width="990" height="70.2" /></mxCell><mxCell id="t10" vertex="1" parent="1" value="유효 hit면 반복 결합을 줄일 수 있음&lt;br&gt;첫 생산·정정·NOT_COVERED는 대기" style="text;html=1;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;overflow=visible;fillColor=#FFFFFF;strokeColor=none;fontSize=27;fontStyle=0;fontFamily=Apple SD Gothic Neo;"><mxGeometry as="geometry" x="1500" y="435" width="1010" height="70.2" /></mxCell><mxCell id="t11" vertex="1" parent="1" value="모델 사용 비용" style="text;html=1;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;overflow=visible;fillColor=#FFFFFF;strokeColor=none;fontSize=27;fontStyle=1;fontFamily=Apple SD Gothic Neo;"><mxGeometry as="geometry" x="40" y="620" width="380" height="35.1" /></mxCell><mxCell id="t12" vertex="1" parent="1" value="필요한 과거 의미만 가공&lt;br&gt;재사용 시 cache / 반복 가공 비용" style="text;html=1;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;overflow=visible;fillColor=#FFFFFF;strokeColor=none;fontSize=27;fontStyle=0;fontFamily=Apple SD Gothic Neo;"><mxGeometry as="geometry" x="430" y="620" width="990" height="70.2" /></mxCell><mxCell id="t13" vertex="1" parent="1" value="과거 의미 생산비를 반복 사용에 상각&lt;br&gt;미사용·재생산·실패·폐기 비용 포함" style="text;html=1;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;overflow=visible;fillColor=#FFFFFF;strokeColor=none;fontSize=27;fontStyle=0;fontFamily=Apple SD Gothic Neo;"><mxGeometry as="geometry" x="1500" y="620" width="1010" height="70.2" /></mxCell><mxCell id="t14" vertex="1" parent="1" value="변경 용이성" style="text;html=1;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;overflow=visible;fillColor=#FFFFFF;strokeColor=none;fontSize=27;fontStyle=1;fontFamily=Apple SD Gothic Neo;"><mxGeometry as="geometry" x="40" y="805" width="380" height="35.1" /></mxCell><mxCell id="t15" vertex="1" parent="1" value="query/result·원본 adapter가 변경 경계&lt;br&gt;새 관계는 Resolver/Composer 지원 변경" style="text;html=1;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;overflow=visible;fillColor=#FFFFFF;strokeColor=none;fontSize=27;fontStyle=0;fontFamily=Apple SD Gothic Neo;"><mxGeometry as="geometry" x="430" y="805" width="990" height="70.2" /></mxCell><mxCell id="t16" vertex="1" parent="1" value="producer/schema/coverage·reader가 경계&lt;br&gt;공통 생산 변경과 소비 호환 비용" style="text;html=1;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;overflow=visible;fillColor=#FFFFFF;strokeColor=none;fontSize=27;fontStyle=0;fontFamily=Apple SD Gothic Neo;"><mxGeometry as="geometry" x="1500" y="805" width="1010" height="70.2" /></mxCell><mxCell id="t17" vertex="1" parent="1" value="로컬 메모리" style="text;html=1;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;overflow=visible;fillColor=#FFFFFF;strokeColor=none;fontSize=27;fontStyle=1;fontFamily=Apple SD Gothic Neo;"><mxGeometry as="geometry" x="40" y="990" width="380" height="35.1" /></mxCell><mxCell id="t18" vertex="1" parent="1" value="같은 raw 예산 + 동시 query/set/cache&lt;br&gt;동시 query가 적으면 상태 비용 축소" style="text;html=1;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;overflow=visible;fillColor=#FFFFFF;strokeColor=none;fontSize=27;fontStyle=0;fontFamily=Apple SD Gothic Neo;"><mxGeometry as="geometry" x="430" y="990" width="990" height="70.2" /></mxCell><mxCell id="t19" vertex="1" parent="1" value="같은 raw + view/index/dep/backlog/lease&lt;br&gt;중복 query 축소량이 추가 상태보다 커야 이익" style="text;html=1;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;overflow=visible;fillColor=#FFFFFF;strokeColor=none;fontSize=27;fontStyle=0;fontFamily=Apple SD Gothic Neo;"><mxGeometry as="geometry" x="1500" y="990" width="1010" height="70.2" /></mxCell><mxCell id="t20" vertex="1" parent="1" value="시간 overlap/순서의 생산·조회만으로 모델 요금 절감을 부여하지 않는다.&lt;br&gt;46 전체 A/B는 시간+과거 선택의 두 묶음이다. 시간 A+45B / 시간 B+45A는 별도 교차 조합이다.&lt;br&gt;상위 QA로 구조를 선택한 후 약한 축을 tactic으로 보완한다. 숫자 우열·선택 승자는 아직 없다." style="text;html=1;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;overflow=visible;fillColor=#FFFFFF;strokeColor=none;fontSize=24;fontStyle=0;fontFamily=Apple SD Gothic Neo;"><mxGeometry as="geometry" x="40" y="1210" width="2480" height="93.60000000000001" /></mxCell></root></mxGraphModel></diagram></mxfile>

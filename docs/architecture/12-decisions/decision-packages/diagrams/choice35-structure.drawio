B;fontSize=28;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="26" width="421.54" height="37.05" /></mxCell><mxCell id="e3" value="35 / 설계 비교" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=28;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2310.44" y="26" width="185.56" height="37.05" /></mxCell><mxCell id="e4" value="대화와 업무 상태, 무엇을 원본으로 삼는가?" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=48;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="74" width="1032.32" height="70.80000000000001" /></mxCell><mxCell id="e5" value="같은 정상 사용: 보고서 T1의 질문 Q7 “기간은?” → “상반기로 해줘” → 답변 확정과 업무 이어가기" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=29;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="142" width="1421.46" height="45.150000000000006" /></mxCell><mxCell id="e7" value="공통 목적" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=28;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="214" width="137.36" height="43.800000000000004" /></mxCell><mxCell id="e8" value="Q7 답변, T1 조건, 전송 준비를 일관되게 저장. Agent 접수와 사용자 실제 전달은 확인한 뒤 별도 기록." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=28;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="260" y="214" width="1463.44" height="43.800000000000004" /></mxCell><mxCell id="e9" value="같은 해석과 검사" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=27;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="262" width="230.48" height="42.45" /></mxCell><mxCell id="e10" value="같은 Omni와 현재 권한/버전 검사. 어느 안도 기록만으로 외부 접수나 사용자 전달을 추정하지 않는다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=27;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="330" y="262" width="1368.8" height="42.45" /></mxCell><mxCell id="e12" value="A  현재 상태가 원본" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=39;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="80" y="326" width="401.9" height="58.650000000000006" /></mxCell><mxCell id="e13" value="상태 변경을 확정하고, 그 값을 읽어 계속 처리한다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=28;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="80" y="382" width="724.24" height="43.800000000000004" /></mxCell><mxCell id="e19" value="1  상태 변경 값" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=26;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="145" y="530" width="218.6" height="41.1" /></mxCell><mxCell id="e21" value="T1 조건과 전송 준비도 같은 확정 묶음" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=24;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="690" y="530" width="463.04" height="38.400000000000006" /></mxCell><mxCell id="e22" value="B  확정 사건이 원본" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=39;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1330" y="326" width="401.9" height="58.650000000000006" /></mxCell><mxCell id="e23" value="사건을 확정하고, 같은 코드로 현재 상태를 계산한다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=28;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1330" y="382" width="734.88" height="43.800000000000004" /></mxCell><mxCell id="e29" value="1  확정할 의미 사건" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=26;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1395" y="530" width="270.6" height="41.1" /></mxCell><mxCell id="e31" value="T1 조건과 전송 준비도 같은 확정 묶음" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=24;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1940" y="530" width="463.04" height="38.400000000000006" /></mxCell><mxCell id="e35" value="2  Q7=답변 완료 / T1=상반기&lt;br&gt;c9=전송 대기" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=26;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="155" y="740" width="399.56" height="76.2" /></mxCell><mxCell id="e37" value="같은 transaction" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=25;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="582" y="610" width="244.0" height="39.75" /></mxCell><mxCell id="e38" value="권위 원본은 현재 기록&lt;br&gt;감사 조회와 backup도 가능&lt;br&gt;상태 변환 코드도 재사용 가능" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=27;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="740" y="825" width="398.96" height="115.35000000000001" /></mxCell><mxCell id="e40" value="3  정상 조회 / 재시작에도 현재 기록" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=26;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="135" y="981" width="491.08" height="41.1" /></mxCell><mxCell id="e45" value="2  답변 확정(Q7, 상반기)&lt;br&gt;전송 준비(c9)" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=26;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1405" y="740" width="351.2" height="76.2" /></mxCell><mxCell id="e47" value="3  사건 적용" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=26;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1870" y="718" width="176.48" height="41.1" /></mxCell><mxCell id="e49" value="결정적 코드로 상태 계산" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=26;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2050" y="786" width="316.36" height="41.1" /></mxCell><mxCell id="e51" value="보존 사건으로 다시 계산" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=26;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1410" y="966" width="316.36" height="41.1" /></mxCell><mxCell id="e53" value="4  정상 조회" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=25;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2290" y="1000" width="170.0" height="39.75" /></mxCell><mxCell id="e54" value="사건 + 상태를 같은 transaction에 확정" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=24;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1995" y="607" width="500.96" height="38.400000000000006" /></mxCell><mxCell id="e55" value="반환 화살표는 대표 owner만 표시. 모든 owner가 자기 현재 상태를 조회한다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=24;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="80" y="1050" width="935.36" height="38.400000000000006" /></mxCell><mxCell id="e56" value="재구성: 검증된 checkpoint로 단축 가능. 모델/외부 명령은 재실행 안 함." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=24;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1330" y="1050" width="902.24" height="38.400000000000006" /></mxCell><mxCell id="e58" value="같은 사용자 결과" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=28;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="80" y="1118" width="238.72" height="43.800000000000004" /></mxCell><mxCell id="e59" value="Agent Gateway가 저장된 명령을 전달 → 실제 접수 확인 → Response Manager가 상태를 안내하고 전달 사실 기록" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=26;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="370" y="1118" width="1487.4" height="41.1" /></mxCell><mxCell id="e60" value="A의 선택 이유" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=29;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="80" y="1184" width="206.94" height="45.150000000000006" /></mxCell><mxCell id="e61" value="현재 운영과 필요한 감사 조회로 충분할 때&lt;br&gt;직접 갱신 중심. 새 조회는 보존 정보와 변환에 의존" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=27;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="80" y="1230" width="698.66" height="90" /></mxCell><mxCell id="e62" value="B의 선택 이유와 대가" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=29;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1330" y="1184" width="311.92" height="45.150000000000006" /></mxCell><mxCell id="e63" value="재구성과 원인 검증, 조회 구조 변경을 반복 활용할 때&lt;br&gt;대가: 사건의 장기 호환, 삭제와 재생 관리, 저장 공간" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=27;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1330" y="1230" width="732.14" height="90" /></mxCell><mxCell id="e65" value="실선: 요청/기록   점선: 반환/재구성   파랑: A   초록: B" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=28;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="1372" width="698.46" height="37.05" /></mxCell><mxCell id="e66" value="정상 정확도/속도 우열은 미측정. 감사 기록으로 충분하면 B의 추가 이익은 작다. / 미선정" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=28;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1463.58" y="1405" width="1032.42" height="37.05" /></mxCell></root></mxGraphModel></diagram></mxfile>

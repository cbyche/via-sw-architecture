58" y="1607.5" /></Array></mxGeometry></mxCell><mxCell id="wire44" source="resolver" target="completion" edge="1" parent="1" style="edgeStyle=none;rounded=0;strokeColor=#195FBD;strokeWidth=2;endArrow=open;endFill=0;dashed=1;exitX=0.0;exitY=0.5457142857142857;exitPerimeter=0;entryX=1.0;entryY=0.44285714285714284;entryPerimeter=0;"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint as="point" x="1506" y="1615.5" /><mxPoint as="point" x="1506" y="1199" /><mxPoint as="point" x="1518" y="1199" /><mxPoint as="point" x="1518" y="1182.0" /></Array></mxGeometry></mxCell><mxCell id="wire45" source="resolver" target="proposal" edge="1" parent="1" style="edgeStyle=none;rounded=0;strokeColor=#195FBD;strokeWidth=2;endArrow=open;endFill=0;dashed=1;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint as="point" x="1830.0" y="1844" /><mxPoint as="point" x="1885.0" y="1844" /></Array></mxGeometry></mxCell><mxCell id="note0" parent="1" vertex="1" value="VIA / DP-47 / 구현 수준 상세 설계" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=26;fontStyle=1;align=left;spacing=0;"><mxGeometry as="geometry" x="60" y="22" width="650" height="33.800000000000004" /></mxCell><mxCell id="note1" parent="1" vertex="1" value="설계 가정 / 제품 미구현 / 모델 호출과 측정 없음" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=23;fontStyle=0;align=right;spacing=0;"><mxGeometry as="geometry" x="3113" y="25" width="667" height="29.900000000000002" /></mxCell><mxCell id="note2" parent="1" vertex="1" value="B / 두 생산자의 후보를 저장하고, coordinator가 준비된 후보의 결합을 지시한다" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=43;fontStyle=1;align=left;spacing=0;"><mxGeometry as="geometry" x="60" y="67" width="2150" height="55.9" /></mxCell><mxCell id="note3" parent="1" vertex="1" value="1 입력 등록 → 2 작업 전달 → 3 원본 조회 → 4 의미 처리 → 5 조건부 게시 → 6 다음 실행 → 7 제안 → 8 채택" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=27;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="60" y="139" width="1944" height="35.1" /></mxCell><mxCell id="note4" parent="1" vertex="1" value="STYLE  Orchestrated dataflow + Fork–Join / Producer–Consumer / 생산자별 versioned repository" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=29;fontStyle=1;align=left;spacing=0;"><mxGeometry as="geometry" x="60" y="196" width="2552" height="37.7" /></mxCell><mxCell id="note5" parent="1" vertex="1" value="1 입력/전사 revision 등록 / capture는 의미 처리와 병행" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=23;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="60" y="1259" width="920" height="29.900000000000002" /></mxCell><mxCell id="note6" parent="1" vertex="1" value="사각형 = 실행 코드   칸이 있는 상자 = RAM queue   겹친 카드 = RAM data model   원통 = 영속 DB   접힌 종이 = immutable DTO" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=24;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="900" y="2080" width="2304" height="31.200000000000003" /></mxCell><mxCell id="note7" parent="1" vertex="1" value="검정 양방향 = async 호출/반환   파랑 → = P2P enqueue/dispatch   파랑 점선 = 완료   빨강 = 재판단/정정   회색 = 상태 read/write / 별도 bus와 pub/sub 없음" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#758294;fontSize=23;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="60" y="2122" width="2737" height="29.900000000000002" /></mxCell><mxCell id="note8" parent="1" vertex="1" value="R 태그 = 이 adapter의 readAsync 호출/반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=25;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="1530" y="560" width="825" height="32.5" /></mxCell><mxCell id="note9" parent="1" vertex="1" value="M 태그 = 이 adapter의 invokeAsync 호출/반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=25;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="2260" y="560" width="875" height="32.5" /></mxCell><mxCell id="note10" parent="1" vertex="1" value="Candidate Exchange State = 위 두 RAM repository / RevisionGate 아래 조건부 게시 + 일관된 read-set" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=23;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="1530" y="1417" width="1955" height="29.900000000000002" /></mxCell><mxCell id="note11" parent="1" vertex="1" value="6 JOIN: 호환된 read-set을 Binding Work Queue로 전달" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=22;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="1530" y="1455" width="968" height="28.6" /></mxCell><mxCell id="note12" parent="1" vertex="1" value="7 후보 부족: RejudgeRequest → Completion Inbox → Coordinator → 원 producer queue" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#B63732;fontSize=25;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="1530" y="1745" width="1875" height="32.5" /></mxCell><mxCell id="note13" parent="1" vertex="1" value="t0만 있으면 원본을 다시 읽고 t7,t8을 생산한 뒤 재결합 / coordinator는 의미 값을 채우지 않는다" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#B63732;fontSize=23;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="1530" y="1795" width="1449" height="29.900000000000002" /></mxCell></root></mxGraphModel></diagram></mxfile>

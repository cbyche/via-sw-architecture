<mxfile host="app.diagrams.net" type="device"><diagram name="Agent 상태 · 원격 업무의 현재 모습을 무엇으로 구성할까?  |  배경" id="agent-state-observation-background"><mxGraphModel page="1" pageWidth="2560" pageHeight="1440" grid="1" gridSize="10"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="challenge" value="" style="rounded=1;arcSize=8;html=1;fillColor=#FFFFFF;strokeColor=#171717;strokeWidth=2.5;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="48" y="1170" width="2464" height="170" /></mxCell><mxCell id="challenge-title" value="Architecture Challenge" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;fontColor=#171717;fontSize=20;fontStyle=1;fontFamily=Arial;align=left;verticalAlign=top;spacing=0;connectable=0;" vertex="1" parent="challenge"><mxGeometry as="geometry" x="16" y="8" width="2432" height="27" /></mxCell><mxCell id="challenge-text-0" value="일반 progress를 event reducer로 계속 구성할 것인가, 변경 신호와 사용자 조회에 따라 snapshot을 읽어 구성할 것인가?" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;fontColor=#171717;fontSize=20;fontStyle=0;fontFamily=Arial;align=left;verticalAlign=top;spacing=0;connectable=0;" vertex="1" parent="challenge"><mxGeometry as="geometry" x="16" y="44" width="2432" height="27" /></mxCell><mxCell id="scenario" value="" style="rounded=1;arcSize=8;html=1;fillColor=#FFFFFF;strokeColor=#171717;strokeWidth=2.5;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="48" y="142" width="2464" height="104" /></mxCell><mxCell id="scenario-title" value="사용자 상황" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;fontColor=#171717;fontSize=20;fontStyle=1;fontFamily=Arial;align=left;verticalAlign=top;spacing=0;connectable=0;" vertex="1" parent="scenario"><mxGeometry as="geometry" x="16" y="8" width="2432" height="27" /></mxCell><mxCell id="scenario-text-0" value="보고서와 메일 업무가 동시에 진행된다. 사용자는 “보고서 어디까지 됐어?”라고 묻고, 다른 Agent는 승인을 요청한다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;fontColor=#171717;fontSize=20;fontStyle=0;fontFamily=Arial;align=left;verticalAlign=top;spacing=0;connectable=0;" vertex="1" parent="scenario"><mxGeometry as="geometry" x="16" y="44" width="2432" height="27" /></mxCell><mxCell id="pressure0" value="" style="rounded=1;arcSize=8;html=1;fillColor=#FFFFFF;strokeColor=#171717;strokeWidth=2.5;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="48" y="925" width="792" height="205" /></mxCell><mxCell id="pressure0-title" value="로컬 projection 유지" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;fontColor=#171717;fontSize=20;fontStyle=1;fontFamily=Arial;align=left;verticalAlign=top;spacing=0;connectable=0;" vertex="1" parent="pressure0"><mxGeometry as="geometry" x="16" y="8" width="760" height="27" /></mxCell><mxCell id="pressure0-text-0" value="query 없이 확인한 상태를 읽을 수 있다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;fontColor=#171717;fontSize=20;fontStyle=0;fontFamily=Arial;align=left;verticalAlign=top;spacing=0;connectable=0;" vertex="1" parent="pressure0"><mxGeometry as="geometry" x="16" y="44" width="760" height="27" /></mxCell><mxCell id="pressure0-text-1" value="event 의미·순서·gap 보정 책임이 생긴다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;fontColor=#171717;fontSize=20;fontStyle=0;fontFamily=Arial;align=left;verticalAlign=top;spacing=0;connectable=0;" vertex="1" parent="pressure0"><mxGeometry as="geometry" x="16" y="69" width="760" height="27" /></mxCell><mxCell id="pressure0-text-2" value="로컬 값이 원격의 지금을 보장하지 않는다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;fontColor=#171717;fontSize=20;fontStyle=0;fontFamily=Arial;align=left;verticalAlign=top;spacing=0;connectable=0;" vertex="1" parent="p
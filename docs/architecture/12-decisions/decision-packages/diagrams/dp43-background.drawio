x="1856" y="127" /><Array as="points" /></mxGeometry></mxCell><mxCell id="n6" parent="1" vertex="1" value="" style="fontFamily=Apple SD Gothic Neo;rounded=0;fillColor=#FFF4A8;strokeColor=none;strokeWidth=1.7;"><mxGeometry as="geometry" x="64" y="151" width="1792" height="52" /></mxCell><mxCell id="n7" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;한 번의 정정이 대상·Task 연결·요청 관계를 함께 바꿀 수 있다&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=31;fontColor=#18232E;fontStyle=1;"><mxGeometry as="geometry" x="82" y="158" width="1756" height="40.300000000000004" /></mxCell><mxCell id="n8" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;VIA는 의도부터 처리 방향까지 판단하고, 기존 조건을 유지하면서 바뀐 부분을 반영해야 한다.&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=25;fontColor=#5F6B77;fontStyle=0;"><mxGeometry as="geometry" x="64" y="220" width="1792" height="32.5" /></mxCell><mxCell id="n9" parent="1" edge="1" style="fontFamily=Apple SD Gothic Neo;edgeStyle=none;rounded=0;strokeColor=#CDD6DE;strokeWidth=2;endArrow=none;endFill=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1213" y="285" /><mxPoint as="targetPoint" x="1213" y="852" /><Array as="points" /></mxGeometry></mxCell><mxCell id="n10" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;구조 설계에서 어려운 점&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=29;fontColor=#18232E;fontStyle=1;"><mxGeometry as="geometry" x="1260" y="291" width="596" height="37.7" /></mxCell><mxCell id="n11" parent="1" edge="1" style="fontFamily=Apple SD Gothic Neo;edgeStyle=none;rounded=0;strokeColor=#2858A5;strokeWidth=2;endArrow=none;endFill=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="64" y="875" /><mxPoint as="targetPoint" x="1856" y="875" /><Array as="points" /></mxGeometry></mxCell><mxCell id="n12" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;설계 과제&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=28;fontColor=#B63732;fontStyle=1;"><mxGeometry as="geometry" x="64" y="906" width="165" height="36.4" /></mxCell><mxCell id="n13" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;서로 얽힌 의미를 통합 생산할 것인가, 기능별 생산자가 협력할 것인가?&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=30;fontColor=#18232E;fontStyle=1;"><mxGeometry as="geometry" x="240" y="901" width="1616" height="39.0" /></mxCell><mxCell id="n14" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;A 통합 의미 생산 / C 여섯 기능의 의미 생산과 코드 조정&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=24;fontColor=#2858A5;fontStyle=0;"><mxGeometry as="geometry" x="240" y="949" width="1616" height="31.200000000000003" /></mxCell><mxCell id="n15" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;품질 쟁점: 의미 정확성·누락 방지와 부분 판단의 조정·추론 비용&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=20;fontColor=#5F6B77;fontStyle=0;"><mxGeometry as="geometry" x="64" y="1018" width="1260" height="26.0" /></mxCell><mxCell id="n16" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;구조 후보 / 미선정 / 미측정&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=right;verticalAlign=top;spacing=0;fontSize=20;fontColor=#5F6B77;fontStyle=0;"><mxGeometry as="geometry" x="1376" y="1018" width="480" height="26.0" /></mxCell><mxCell id="n17" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;“보고서는 PDF로, 메일에는 그 보고서의 결론을 넣어줘.”&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=28;fontColor=#18232E;fontStyle=1;"><mxGeometry as="geometry" x="64" y="288" width="1120" height="36.4" /></mxCell><mxCell id="n18" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;정정  “메일에는 결론 대신 표만 넣어줘.”&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=28;fontColor=#B63732;fontStyle=1;"><mxGeometry as="geometry" x="64" y="333" width="1120" height="36.4" /></mxCell><mxCell id="n19" parent="1" vertex="1" value="" style="fontFamily=Apple SD Gothic Neo;rounded=0;fillColor=white;strokeColor=#CDD6DE;strokeWidth=1.7;dashed=1;"><mxGeometry as="geometry" x="64" y="402" width="1110" height="363" /></mxCell><mxCell id="n20" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3000000000000003;&quot;&gt;Request Interpreter&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=26;fontColor=#18232E;fontStyle=1;"><mxGeometry as="geometry" x="88" y="416" width="1060" height="33.800000000000004" /></mxCell><mxCell id="n21" parent="1" vertex="1" value="" style="fontFamily=Apple SD Gothic Neo;shape=note;size=18;fillColor=#F2F6FA;strokeColor=#CDD6DE;strokeWidth=1.7;"><mxGeometry as="geometry" x="88" y="476" width="330" height="106" /></mxCell><mxCell id="n22" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;F1 요청 의도&lt;br&gt;목표와 PDF 조건&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=24;fontColor=#18232E;fontStyle=0;"><mxGeometry as="geometry" x="104" y="489" width="290" height="62.400000000000006" /></mxCell><mxCell id="n23" parent="1" vertex="1" value="" style="fontFamily=Apple SD Gothic Neo;shape=note;size=18;fillColor=#F2F6FA;strokeColor=#CDD6DE;strokeWidth=1.7;"><mxGeometry as="geometry" x="452" y="476" width="330" height="106" /></mxCell><mxCell id="n24" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;F2 지칭 대상&lt;br&gt;보고서의 결론 / 표&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=24;fontColor=#18232E;fontStyle=0;"><mxGeometry as="geometry" x="468" y="489" width="290" height="62.400000000000006" /></mxCell><mxCell id="n25" parent="1" vertex="1" value="" style="fontFamily=Apple SD Gothic Neo;shape=note;size=18;fillColor=#F2F6FA;strokeColor=#CDD6DE;strokeWidth=1.7;"><mxGeometry as="geometry" x="816" y="476" width="330" height="106" /></mxCell><mxCell id="n26" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;F3 대화·Task 연결&lt;br&gt;보고서 / 메일 후보&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=24;fontColor=#18232E;fontStyle=0;"><mxGeometry as="geometry" x="832" y="489" width="290" height="62.400000000000006" /></mxCell><mxCell id="n27" parent="1" vertex="1" value="" style="fontFamily=Apple SD Gothic Neo;shape=note;size=18;fillColor=#F2F6FA;strokeColor=#CDD6DE;strokeWidth=1.7;"><mxGeometry as="geometry" x="88" y="628" width="330" height="106" /></mxCell><mxCell id="n28" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;F4 요청 간 관계&lt;br&gt;어느 결과를 사용할까&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=24;fontColor=#18232E;fontStyle=0;"><mxGeometry as="geometry" x="104" y="641" width="290" height="62.400000000000006" /></mxCell><mxCell id="n29" parent="1" vertex="1" value="" style="fontFamily=Apple SD Gothic Neo;shape=note;size=18;fillColor=#F2F6FA;strokeColor=#CDD6DE;strokeWidth=1.7;"><mxGeometry as="geometry" x="452" y="628" width="330" height="106" /></mxCell><mxCell id="n30" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;F5 정정 범위&lt;br&gt;교체할 내용과 유지 조건&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=24;fontColor=#18232E;fontStyle=0;"><mxGeometry as="geometry" x="468" y="641" width="290" height="62.400000000000006" /></mxCell><mxCell id="n31" parent="1" vertex="1" value="" style="fontFamily=Apple SD Gothic Neo;shape=note;size=18;fillColor=#F2F6FA;strokeColor=#CDD6DE;strokeWidth=1.7;"><mxGeometry as="geometry" x="816" y="628" width="330" height="106" /></mxCell><mxCell id="n32" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;F6 처리 방향&lt;br&gt;직접 응답 / 위임 / 확인&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=24;fontColor=#18232E;fontStyle=0;"><mxGeometry as="geometry" x="832" y="641" width="290" height="62.400000000000006" /></mxCell><mxCell id="n33" parent="1" edge="1" style="fontFamily=Apple SD Gothic Neo;edgeStyle=none;rounded=0;strokeColor=#2858A5;strokeWidth=2;endArrow=none;endFill=0;dashed=1;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="418" y="529" /><mxPoint as="targetPoint" x="452" y="529" /><Array as="points" /></mxGeometry></mxCell><mxCell id="n34" parent="1" edge="1" style="fontFamily=Apple SD Gothic Neo;edgeStyle=none;rounded=0;strokeColor=#2858A5;strokeWidth=2;endArrow=none;endFill=0;dashed=1;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="782" y="529" /><mxPoint as="targetPoint" x="816" y="529" /><Array as="points" /></mxGeometry></mxCell><mxCell id="n35" parent="1" edge="1" style="fontFamily=Apple SD Gothic Neo;edgeStyle=none;rounded=0;strokeColor=#2858A5;strokeWidth=2;endArrow=none;endFill=0;dashed=1;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="253" y="582" /><mxPoint as="targetPoint" x="253" y="628" /><Array as="points" /></mxGeometry></mxCell><mxCell id="n36" parent="1" edge="1" style="fontFamily=Apple SD Gothic Neo;edgeStyle=none;rounded=0;strokeColor=#2858A5;strokeWidth=2;endArrow=none;endFill=0;dashed=1;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="617" y="582" /><mxPoint as="targetPoint" x="617" y="628" /><Array as="points" /></mxGeometry></mxCell><mxCell id="n37" parent="1" edge="1" style="fontFamily=Apple SD Gothic Neo;edgeStyle=none;rounded=0;strokeColor=#2858A5;strokeWidth=2;endArrow=none;endFill=0;dashed=1;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="981" y="582" /><mxPoint as="targetPoint" x="981" y="628" /><Array as="points" /></mxGeometry></mxCell><mxCell id="n38" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3000000000000003;&quot;&gt;메일 내용·결과 의존은 변경 / 보고서의 PDF 조건은 유지&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=26;fontColor=#2858A5;fontStyle=1;"><mxGeometry as="geometry" x="64" y="794" width="1120" height="33.800000000000004" /></mxCell><mxCell id="n39" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;F1~F6은 공통 판단 기능이며, 고정 실행 순서나 모델 호출 수가 아니다.&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=22;fontColor=#5F6B77;fontStyle=0;"><mxGeometry as="geometry" x="64" y="834" width="1120" height="28.6" /></mxCell><mxCell id="n40" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;01  Task 연결도 판단 결과&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=28;fontColor=#2858A5;fontStyle=1;"><mxGeometry as="geometry" x="1260" y="364" width="596" height="36.4" /></mxCell><mxCell id="n41" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;어느 업무인지 미리 정해 두면&lt;br&gt;새 요청·직접 대화를 놓친다.&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=25;fontColor=#18232E;fontStyle=0;"><mxGeometry as="geometry" x="1260" y="411" width="596" height="70" /></mxCell><mxCell id="n42" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;02  부분 의미의 상호 의존&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=28;fontColor=#2858A5;fontStyle=1;"><mxGeometry as="geometry" x="1260" y="515" width="596" height="36.4" /></mxCell><mxCell id="n43" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;대상이 바뀌면 관계와 정정 범위도&lt;br&gt;다시 판단해야 할 수 있다.&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=25;fontColor=#18232E;fontStyle=0;"><mxGeometry as="geometry" x="1260" y="562" width="596" height="70" /></mxCell><mxCell id="n44" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;03  집중 판단과 전체 일관성&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=28;fontColor=#2858A5;fontStyle=1;"><mxGeometry as="geometry" x="1260" y="666" width="596" height="36.4" /></mxCell><mxCell id="n45" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;기능별 집중은 개선의 후보지만,&lt;br&gt;불일치·왕복·맥락 중복도 생긴다.&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=25;fontColor=#18232E;fontStyle=0;"><mxGeometry as="geometry" x="1260" y="713" width="596" height="70" /></mxCell></root></mxGraphModel></diagram></mxfile>

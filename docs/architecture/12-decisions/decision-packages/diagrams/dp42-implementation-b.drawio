ase P2" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;fontSize=21;fontColor=#233247;fontStyle=0;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="555" y="1248" width="234" height="30.45" /></mxCell><mxCell id="note27" value="actual receipt" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;fontSize=21;fontColor=#233247;fontStyle=0;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="551" y="1446" width="318" height="30.45" /></mxCell><mxCell id="note28" value="ReleaseAndReconcile + K1" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;fontSize=21;fontColor=#A65E2E;fontStyle=0;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="2100" y="976" width="528" height="30.45" /></mxCell><mxCell id="note29" value="AcceptanceReceipt / HELD" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;fontSize=21;fontColor=#A65E2E;fontStyle=0;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="2100" y="1098" width="528" height="30.45" /></mxCell><mxCell id="note30" value="Hold / session / sequence → ACK" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;fontSize=21;fontColor=#A65E2E;fontStyle=0;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="2110" y="1269" width="675" height="30.45" /></mxCell><mxCell id="note31" value="claim(K1)" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;fontSize=21;fontColor=#233247;fontStyle=0;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="3008" y="1019" width="213" height="30.45" /></mxCell><mxCell id="note32" value="CAS 결과" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;fontSize=21;fontColor=#233247;fontStyle=0;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="3008" y="1069" width="150" height="30.45" /></mxCell><mxCell id="note33" value="CAS 확정 뒤 send(K1)" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;fontSize=21;fontColor=#233247;fontStyle=0;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="2990" y="678" width="381" height="30.45" /></mxCell><mxCell id="note34" value="외부 receipt / event" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;fontSize=21;fontColor=#233247;fontStyle=0;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="3380" y="1064" width="402" height="30.45" /></mxCell><mxCell id="note35" value="inbox 저장 뒤 source event" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;fontSize=21;fontColor=#233247;fontStyle=0;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="2970" y="1344" width="507" height="30.45" /></mxCell><mxCell id="note36" value="내구 event / cursor / 재전달" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;fontSize=21;fontColor=#A65E2E;fontStyle=0;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="2105" y="1552" width="507" height="30.45" /></mxCell><mxCell id="note37" value="UNKNOWN은 외부 상태 확인" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;fontSize=21;fontColor=#233247;fontStyle=0;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="3140" y="1629" width="381" height="30.45" /></mxCell><mxCell id="note38" value="same K1 조회 / cursor 재결합" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;fontSize=21;fontColor=#A65E2E;fontStyle=0;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="1980" y="1619" width="507" height="30.45" /></mxCell><mxCell id="note39" value="D1 의도 / D2 접수 / D3 외부 확인" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;fontSize=21;fontColor=#A65E2E;fontStyle=0;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="1310" y="1689" width="528" height="30.45" /></mxCell><mxCell id="note40" value="D4 actual receipt" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;fontSize=21;fontColor=#233247;fontStyle=0;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="760" y="1689" width="381" height="30.45" /></mxCell><mxCell id="note41" value="W1 접수 / W2 CAS / W3 fact" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;fontSize=21;fontColor=#A65E2E;fontStyle=0;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="2375" y="1689" width="528" height="30.45" /></mxCell><mxCell id="note42" value="I1 외부 raw inbox" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;fontSize=21;fontColor=#233247;fontStyle=0;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="3160" y="1689" width="339" height="30.45" /></mxCell><mxCell id="note43" value="실선 → 호출 / 명령     점선 → 반환 / 확인 사실     둥근 상자 = 내부 Module     원통 = 내구 상태 (RAM은 별도 표시)" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;fontSize=24;fontColor=#233247;fontStyle=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="2026" width="1992" height="34.8" /></mxCell><mxCell id="note44" value="상태 저장선은 각 Component의 repository 접근이다. 저장소 안의 원통은 의미 owner를 바꾸지 않는다. 번호별 호출과 확정 순서는 다음 흐름도에서 펼친다." style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;fontSize=24;fontColor=#596A7C;fontStyle=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="2068" width="2328" height="34.8" /></mxCell><mxCell id="note45" value="업무 W2는 대화 D2 반영을 기다리지 않는다. 외부 접수와 사용자 실제 전달은 별도 사실이다." style="text;html=0;align=right;verticalAlign=top;whiteSpace=wrap;spacing=0;fontSize=23;fontColor=#A65E2E;fontStyle=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="2533" y="2108" width="1243" height="33.35" /></mxCell></root></mxGraphModel></diagram></mxfile>

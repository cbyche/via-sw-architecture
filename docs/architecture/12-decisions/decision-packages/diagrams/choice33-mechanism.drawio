<mxfile host="app.diagrams.net" type="device"><diagram id="choice33-mechanism" name="여러 업무의 대화 정확성을 위한 협력 — 중앙 해석과 업무별 대화 처리"><mxGraphModel page="1" pageWidth="2560" pageHeight="2260" grid="1" gridSize="8"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="e1" value="" style="rounded=1;arcSize=4;fillColor=#263445;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="0" y="0" width="2560" height="9" /></mxCell><mxCell id="e8" value="" style="rounded=1;arcSize=4;fillColor=white;strokeColor=#C7D1DD;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="345" width="1184" height="245" /></mxCell><mxCell id="e9" value="" style="rounded=1;arcSize=4;fillColor=#195FBD;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="345" width="8" height="245" /></mxCell><mxCell id="e13" value="" style="rounded=1;arcSize=4;fillColor=white;strokeColor=#C7D1DD;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="650" width="1184" height="245" /></mxCell><mxCell id="e14" value="" style="rounded=1;arcSize=4;fillColor=#195FBD;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="650" width="8" height="245" /></mxCell><mxCell id="e18" value="" style="rounded=1;arcSize=4;fillColor=white;strokeColor=#C7D1DD;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="955" width="1184" height="245" /></mxCell><mxCell id="e19" value="" style="rounded=1;arcSize=4;fillColor=#195FBD;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="955" width="8" height="245" /></mxCell><mxCell id="e23" value="" style="rounded=1;arcSize=4;fillColor=white;strokeColor=#C7D1DD;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="1260" width="1184" height="245" /></mxCell><mxCell id="e24" value="" style="rounded=1;arcSize=4;fillColor=#195FBD;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="1260" width="8" height="245" /></mxCell><mxCell id="e28" value="" style="rounded=1;arcSize=4;fillColor=white;strokeColor=#C7D1DD;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="1565" width="1184" height="245" /></mxCell><mxCell id="e29" value="" style="rounded=1;arcSize=4;fillColor=#195FBD;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="1565" width="8" height="245" /></mxCell><mxCell id="e34" value="" style="rounded=1;arcSize=4;fillColor=white;strokeColor=#C7D1DD;" vertex="1" parent="1"><mxGeometry as="geometry" x="1312" y="345" width="1184" height="245" /></mxCell><mxCell id="e35" value="" style="rounded=1;arcSize=4;fillColor=#087A53;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="1312" y="345" width="8" height="245" /></mxCell><mxCell id="e39" value="" style="rounded=1;arcSize=4;fillColor=white;strokeColor=#C7D1DD;" vertex="1" parent="1"><mxGeometry as="geometry" x="1312" y="650" width="1184" height="245" /></mxCell><mxCell id="e40" value="" style="rounded=1;arcSize=4;fillColor=#087A53;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="1312" y="650" width="8" height="245" /></mxCell><mxCell id="e44" value="" style="rounded=1;arcSize=4;fillColor=white;strokeColor=#C7D1DD;" vertex="1" parent="1"><mxGeometry as="geometry" x="1312" y="955" width="1184" height="245" /></mxCell><mxCell id="e45" value="" style="rounded=1;arcSize=4;fillColor=#087A53;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="1312" y="955" width="8" height="245" /></mxCell><mxCell id="e49" value="" style="rounded=1;arcSize=4;fillColor=white;strokeColor=#C7D1DD;" vertex="1" parent="1"><mxGeometry as="geometry" x="1312" y="1260" width="1184" height="245" /></mxCell><mxCell id="e50" value="" style="rounded=1;arcSize=4;fillColor=#087A53;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="1312" y="1260" width="8" height="245" /></mxCell><mxCell id="e54" value="" style="rounded=1;arcSize=4;fillColor=white;strokeColor=#C7D1DD;" vertex="1" parent="1"><mxGeometry as="geometry" x="1312" y="1565" width="1184" height="245" /></mxCell><mxCell id="e55" value="" style="rounded=1;arcSize=4;fillColor=#087A53;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="1312" y="1565" width="8" height="245" /></mxCell><mxCell id="e6" style="edgeStyle=none;rounded=0;strokeColor=#C7D1DD;strokeWidth=2;endArrow=none;endFill=0;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="64" y="202" /><mxPoint as="targetPoint" x="2496" y="202" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e12" style="edgeStyle=none;rounded=0;strokeColor=#195FBD;strokeWidth=2;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="656" y="590" /><mxPoint as="targetPoint" x="656" y="650" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e17" style="edgeStyle=none;rounded=0;strokeColor=#195FBD;strokeWidth=2;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="656" y="895" /><mxPoint as="targetPoint" x="656" y="955" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e22" style="edgeStyle=none;rounded=0;strokeColor=#195FBD;strokeWidth=2;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="656" y="1200" /><mxPoint as="targetPoint" x="656" y="1260" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e27" style="edgeStyle=none;rounded=0;strokeColor=#195FBD;strokeWidth=2;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="656" y="1505" /><mxPoint as="targetPoint" x="656" y="1565" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e38" style="edgeStyle=none;rounded=0;strokeColor=#087A53;strokeWidth=2;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1904" y="590" /><mxPoint as="targetPoint" x="1904" y="650" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e43" style="edgeStyle=none;rounded=0;strokeColor=#087A53;strokeWidth=2;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1904" y="895" /><mxPoint as="targetPoint" x="1904" y="955" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e48" style="edgeStyle=none;rounded=0;strokeColor=#087A53;strokeWidth=2;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1904" y="1200" /><mxPoint as="targetPoint" x="1904" y="1260" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e53" style="edgeStyle=none;rounded=0;strokeColor=#087A53;strokeWidth=2;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1904" y="1505" /><mxPoint as="targetPoint" x="1904" y="1565" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e59" style="edgeStyle=none;rounded=0;strokeColor=#C7D1DD;strokeWidth=2;endArrow=none;endFill=0;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="64" y="2120" /><mxPoint as="targetPoint" x="2496" y="2120" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e2" value="VIA  /  ARCHITECTURE REVIEW" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=18;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="42" width="309.32" height="30.3" /></mxCell><mxCell id="e3" value="04-33  /  STAGE 04" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=18;fontStyle=1;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2287.12" y="42" width="208.88" height="30.3" /></mxCell><mxCell id="e4" value="여러 업무의 대화 정확성을 위한 협력&lt;br&gt;중앙 해석과 업무별 대화 처리" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=34;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="75" width="623.4" height="94" /></mxCell><mxCell id="e5" value="실제 자료를 사용한 설계 추적 / 본문 §4.1 / 모델 실행 또는 정확도 측정 결과가 아님" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=22;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="166" width="954.44" height="35.7" /></mxCell><mxCell id="e7" value="A  중앙이 전체 대화 해석" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=28;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="250" width="364.16" height="43.800000000000004" /></mxCell><mxCell id="e10" value="1. 실제로 제시된 두 질문" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=26;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="92" y="365" width="338.72" height="41.1" /></mxCell><mxCell id="e11" value="중앙 대화 상태: 보고서 qR=형식 질문, 메일 qM=본문 질문. 이전에 제시한 결론 R.result@4." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=23;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="92" y="430" width="1085.32" height="39" /></mxCell><mxCell id="e15" value="2. “보고서는 PDF로, 메일에는 그 결론”" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=26;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="92" y="670" width="529.56" height="41.1" /></mxCell><mxCell id="e16" value="Request Interpreter가 두 업무 근거와 원문을 함께 읽고 qR=PDF,&lt;br&gt;qM.content=R.result@4를 제안." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=23;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="92" y="735" width="800.58" height="72" /></mxCell><mxCell id="e20" value="3. 결론 참조를 연결" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=26;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="92" y="975" width="270.6" height="41.1" /></mxCell><mxCell id="e21" value="전체 제안에서 두 대상과 관계 검사. Context Manager로 현재 자료 확인." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=23;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="92" y="1040" width="861.76" height="39" /></mxCell><mxCell id="e25" value="4. 채택 직전 메일 질문 취소가 확인됨" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=26;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="92" y="1280" width="500.96" height="41.1" /></mxCell><mxCell id="e26" value="Task Manager의 qM 버전 변경 확인. Request Controller가 아직 보내지 않은 qM 답&lt;br&gt;적용을 보류." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=23;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="92" y="1345" width="1017.7" height="72" /></mxCell><mxCell id="e30" value="5. 현재 검사 후 가능한 부분 적용" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=26;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="92" y="1585" width="448.96" height="41.1" /></mxCell><mxCell id="e31" value="qR/자료/권한 검사 후 독립적인 PDF 선택만 저장/전달. M의 옛 답변은 보내지 않고 질문 종료 안내." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=23;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="92" y="1650" width="1146.5" height="39" /></mxCell><mxCell id="e32" value="A도 업무별 버전 검사/부분 진행 가능. B만의 결과라고 주장하지 않음.&lt;br&gt;B의 차이는 상태 전이 작성자와 참조 협력. 모델/DB/프로세스 격리 아님." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="84" y="1925" width="726.4" height="60.0" /></mxCell><mxCell id="e33" value="B  업무 대화 actor가 협력" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=28;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1312" y="250" width="394.96" height="43.800000000000004" /></mxCell><mxCell id="e36" value="1. 실제로 제시된 두 질문" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=26;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1340" y="365" width="338.72" height="41.1" /></mxCell><mxCell id="e37" value="보고서 actor: qR / R.result@4. 메일 actor: qM. Task Manager가 외부&lt;br&gt;질문/결과 사실의 원본." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=23;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1340" y="430" width="905.0" height="72" /></mxCell><mxCell id="e41" value="2. “보고서는 PDF로, 메일에는 그 결론”" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=26;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1340" y="670" width="529.56" height="41.1" /></mxCell><mxCell id="e42" value="보고서 actor → Dialogue Coordinator: qR=PDF, export=R.result@4.&lt;br&gt;메일 actor → Dialogue Coordinator: qM, need=보고서 결론." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=23;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1340" y="735" width="889.82" height="72" /></mxCell><mxCell id="e46" value="3. 결론 참조를 연결" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=26;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1340" y="975" width="270.6" height="41.1" /></mxCell><mxCell id="e47" value="Dialogue Coordinator → 메일 actor: R.result@4 전달. 메일 actor가 허용&lt;br&gt;근거/질문 의미 확인 후 자기 변경 재제안. 중앙의 본문 재작성 없음." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=23;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1340" y="1040" width="942.26" height="72" /></mxCell><mxCell id="e51" value="4. 채택 직전 메일 질문 취소가 확인됨" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=26;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1340" y="1280" width="500.96" height="41.1" /></mxCell><mxCell id="e52" value="Task Manager → 메일 actor: qM 종료. 메일 actor 상태 버전 변경. Dialogue&lt;br&gt;Coordinator가 옛 M 제안의 채택을 거절." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=23;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1340" y="1345" width="954.22" height="72" /></mxCell><mxCell id="e56" value="5. 현재 검사 후 가능한 부분 적용" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=26;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1340" y="1585" width="448.96" height="41.1" /></mxCell><mxCell id="e57" value="같은 guard 후 Dialogue Coordinator가 유효한 R 제안만 저장/전달하고 actor에 통지.&lt;br&gt;M은 현재 질문 종료 상태를 알림." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=23;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1340" y="1650" width="1043.92" height="72" /></mxCell><mxCell id="e58" value="A도 업무별 버전 검사/부분 진행 가능. B만의 결과라고 주장하지 않음.&lt;br&gt;B의 차이는 상태 전이 작성자와 참조 협력. 모델/DB/프로세스 격리 아님." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1332" y="1925" width="726.4" height="60.0" /></mxCell><mxCell id="e60" value="검정 = 공통 / 파랑 = A 고유 / 초록 = B 고유 / 색은 우위가 아님" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=19;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="2138" width="651.72" height="31.650000000000002" /></mxCell><mxCell id="e61" value="실선 → 요청/전달 / 점선 → 반환/확인" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=18;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2149.24" y="2138" width="346.76" height="30.3" /></mxCell><mxCell id="e62" value="제목 상자 = Component / 내부 둥근 상자 = Module / 원통 = 저장 / 접힌 종이 = 자료 / 육각형 = 연동 대상" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=17;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="2176" width="962.38" height="28.950000000000003" /></mxCell><mxCell id="e63" value="예시의 입력/근거는 양안에 동일. 실제 사용 빈도, 정확도와 시간 이익은 미측정." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=17;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="2212" width="682.56" height="28.950000000000003" /></mxCell></root></mxGraphModel></diagram></mxfile>

alue="호출을 끝내고 다시 시작하는가, 같은 실행을 이어가는가?" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#233247;fontSize=42;fontFamily=Arial;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="92" width="1182.32" height="62.7" /></mxCell><mxCell id="e5" value="위에서 아래로 시간 진행. 화살표는 실제 송수신자, 점선은 반환. 모델 연산과 VIA의 확정 권한을 구별한다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5E6D80;fontSize=24;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="159" width="1280.48" height="38.400000000000006" /></mxCell><mxCell id="e8" value="COMMON / ①~⑤ 최초 기본 Context" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#233247;fontSize=18;fontFamily=Arial;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="88" y="259" width="325.52" height="30.3" /></mxCell><mxCell id="e9" value="양안 동일" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5E6D80;fontSize=16;fontFamily=Arial;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2390.08" y="260" width="81.92" height="27.6" /></mxCell><mxCell id="e15" value="① 최종 입력" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#233247;fontSize=18;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="566" y="307" width="113.48" height="30.3" /></mxCell><mxCell id="e17" value="② Context 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#233247;fontSize=18;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1150" y="307" width="155.6" height="30.3" /></mxCell><mxCell id="e19" value="③ 원본 읽기" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#233247;fontSize=18;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1746" y="307" width="113.48" height="30.3" /></mxCell><mxCell id="e21" value="④ 원문 + revision" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#233247;fontSize=18;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1750" y="399" width="189.08" height="30.3" /></mxCell><mxCell id="e23" value="⑤ Context + receipt" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#233247;fontSize=18;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1130" y="425" width="220.04" height="30.3" /></mxCell><mxCell id="e24" value="기본 준비는 발화 중 시작할 수 있다. 양안은 같은 최종 입력, 허용 scope와 총예산에서 출발한다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5E6D80;fontSize=20;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="88" y="462" width="980.8" height="33.0" /></mxCell><mxCell id="e26" value="T / 호출 종료와 재호출" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#233247;fontSize=28;fontFamily=Arial;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="88" y="574" width="336.1599999999999
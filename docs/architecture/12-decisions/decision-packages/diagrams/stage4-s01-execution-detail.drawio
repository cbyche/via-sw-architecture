=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="1937" width="1156.04" height="30.3" /></mxCell><mxCell id="e111" value="설계 탐색  /  미채택 대안  /  미측정" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5E6D80;fontSize=17;fontFamily=Arial;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2157.52" y="1938" width="338.48" height="28.950000000000003" /></mxCell></root></mxGraphModel></diagram></mxfile>

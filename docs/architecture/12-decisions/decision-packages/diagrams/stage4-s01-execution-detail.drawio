y" x="1688.0" y="835" width="202.48" height="28.950000000000003" /></mxCell><mxCell id="e82" value="⑧ READ_REQUIRED + handle" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#233247;fontSize=17;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1688.0" y="910" width="260.96" height="28.950000000000003" /></mxCell><mxCell id="e84" value="⑨ 추가 읽기 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=17;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1688.0" y="985" width="152.16" height="28.950000000000003" /></mxCell><mxCell id="e86" value="⑩ 권한 검사 후 조회 위임" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#233247;fontSize=17;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1912.0" y="1060" width="224.24" height="28.950000000000003" /></mxCell><mxCell id="e88" value="⑪~⑫ 원본 조회와 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#233247;fontSize=17;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2008.0" y="1136" width="190.24" height="28.950000000000003" /></mxCell><mxCell id="e90" value="⑬ 근거 + receipt" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#233247;fontSize=17;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1912.0" y="1210" width="168.48" height="28.950000000000003" /></mxCell><mxCell id="e92" value="⑭ 근거 반환" style="text;
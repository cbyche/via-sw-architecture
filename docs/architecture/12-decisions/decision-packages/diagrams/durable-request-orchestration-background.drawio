<mxfile host="app.diagrams.net" type="device"><diagram name="대기와 재개 · 대화가 끊겨도 요청의 진행 관계는 이어져야 한다  |  배경" id="durable-request-orchestration-background"><mxGraphModel page="1" pageWidth="2560" pageHeight="1440" grid="1" gridSize="10"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="challenge" value="" style="rounded=1;arcSize=8;html=1;fillColor=#FFFFFF;strokeColor=#171717;strokeWidth=2.5;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="48" y="1170" width="2464" height="170" /></mxCell><mxCell id="challenge-title" value="Architecture Challenge" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;fontColor=#171717;fontSize=20;fontStyle=1;fontFamily=Arial;align=left;verticalAlign=top;spacing=0;connectable=0;" vertex="1" parent="challenge"><mxGeometry as="geometry" x="16" y="8" width="2432" height="27" /></mxCell><mxCell id="challenge-text-0" value="Request Controller가 진행·대기·재개를 직접 관리할 것인가, 별도 workflow 실행체가 continuation을 소유하고 owner들을 호출할 것인가?" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;fontColor=#171717;fontSize=20;fontStyle=0;fontFamily=Arial;align=left;verticalAlign=top;spacing=0;connectable=0;" vertex="1" parent="challenge"><mxGeometry as="geometry" x="16" y="44" width="2432" height="27" /></mxCell><mxCell id="scenario" value="" style="rounded=1;arcSize=8;html=1;fillColor=#FFFFFF;strokeColor=#171717;strokeWidth=2.5;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="48" y="142" width="2464" height="104" /></mxCell><mxCell id="scenario-title" value="사용자 상황" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;fontColor=#171717;fontSize=20;fontStyle=1;fontFamily=Arial;align=left;verticalAlign=top;spacing=0;connectable=0;" vertex="1" parent="scenario"><mxGeometry as="geometry" x="16" y="8" width="2432" height="27" /></mxCell><mxCell id="scenario-text-0" value="“이 표로 보고서를 만들고 끝나면 메일을 준비해줘.” 수신인 질문에 답하기 전에 다른 업무로 전환하고 VIA가 재시작된다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;fontColor=#171717;fontSize=20;fontStyle=0;fontFamily=Arial;align=left;verticalAlign=top;spacing=0;connectable=0;" vertex="1" parent="scenario"><mxGeometry as="geometry" x="16" y="44" width="2432" height="27" /></mxCell><mxCell id="pressure0" value="" style="rounded=1;arcSize=8;html=1;fillColor=#FFFFFF;strokeColor=#171717;strokeWidth=2.5;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="48" y="925" width="792" height="205" /></mxCell><mxCell id="pressure0-title" value="왜 VIA에 중요한가" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;fontColor=#171717;fontSize=20;fontStyle=1;fontFamily=Arial;align=left;verticalAlign=top;spacing=0;connectable=0;" vertex="1" parent="pressure0"><mxGeometry as="geometry" x="16" y="8" width="760" height="27" /></mxCell><mxCell id="pressure0-text-0" value="긴 Agent 업무와 짧은 사용자 대화가 겹친다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;fontColor=#171717;fontSize=20;fontStyle=0;fontFamily=Arial;align=left;verticalAlign=top;spacing=0;connectable=0;" vertex="1" parent="pressure0"><mxGeometry as="geometry" x="16" y="44" width="760" height="27" /></mxCell><mxCell id="pressure0-text-1" value="잘못된 재개는 옛 요청·다른 질문을 실행한다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;fontColor=#171717;fontSize=20;fontStyle=0;fontFamily=Arial;align=left;verticalAlign=top;spacing=0;connectable=0;" vertex="1" parent="pressure0"><mxGeometry as="geometry" x="16" y="69" width="760" height="27" /></mxCell><mxCell id="pressure0-text-2" value="재시작 후도 동일 대화와 업무 관계를 이어야 한다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;fontColor=#171717;fontSize=20;fontStyle=0;fontFamily=Arial;align=left;verticalAlign=top;spacing=0;connectable=0;" vertex="1" parent="pressure0"><mxGeometry as="geometry" x="16" y="94" width="760" height="27" /></mxCell><mxCell id="pressure1" value="" style="rounded=1;arcSize=8;html=1;fillColor=#FFFFFF;strokeColor=#171717;strokeWidth=2.5;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="884" y="925" width="792" height="205" /></mxCell><mxCell id="pressure1-title" value="왜 Architecture 문제인가" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;fontColor=#171717;fontSize=20;fontStyle=1;fontFamily=Arial;align=left;verticalAlign=top;spacing=0;connectable=0;" vertex="1" parent="pressure1"><mxGeometry as="geometry" x="16" y="8" width="760" height="27" /></mxCell><mxCell id="pressure1-text-0" value="진행 상태를 domain controller가 직접 소유할지," style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;fontColor=#171717;fontSize=20;fontStyle=0;fontFamily=Arial;align=left;verticalAlign=top;spacing=0;connectable=0;" vertex="1" parent="pressure1"><mxGeometry as="geometry" x="16" y="44" width="760" height="27" /></mxCell><mxCell id="pressure1-text-1" value="별도 실행체에 continuation을 맡길지 결정한다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;fontColor=#171717;fontSize=20;fontStyle=0;fontFamily=Arial;align=left;verticalAlign=top;spacing=0;connectable=0;" vertex="1" parent="pressure1"><mxGeometry as="geometry" x="16" y="69" width="760" height="27" /></mxCell><mxCell id="pressure1-text-2" value="상태·수명·호출·버전 계약의 주체가 바뀐다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;fontColor=#171717;fontSize=20;fontStyle=0;fontFamily=Arial;align=left;verticalAlign=top;spacing=0;connectable=0;" vertex="1" parent="pressure1"><mxGeometry as="geometry" x="16" y="94" width="760" height="27" /></mxCell><mxCell id="pressure2" value="" style="rounded=1;arcSize=8;html=1;fillColor=#FFFFFF;strokeColor=#171717;strokeWidth=2.5;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1720" y="925" width="792" height="205" /></mxCell><mxCell id="pressure2-title" value="공정한 대안의 조건" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;fontColor=#171717;fontSize=20;fontStyle=1;fontFamily=Arial;align=left;verticalAlign=top;spacing=0;connectable=0;" vertex="1" parent="pressure2"><mxGeometry as="geometry" x="16" y="8" width="760" height="27" /></mxCell><mxCell id="pressure2-text-0" value="양안 모두 durable wait·중복 방지·KV 해제를 갖춘다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;fontColor=#171717;fontSize=20;fontStyle=0;fontFamily=Arial;align=left;verticalAlign=top;spacing=0;connectable=0;" vertex="1" parent="pressure2"><mxGeometry as="geometry" x="16" y="44" width="760" height="27" /></mxCell><mxCell id="pressure2-text-1" value="별도 서버나 자동 병렬화의 효과를 주장하지 않는다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;fontColor=#171717;fontSize=20;fontStyle=0;fontFamily=Arial;align=left;verticalAlign=top;spacing=0;connectable=0;" vertex="1" parent="pressure2"><mxGeometry as="geometry" x="16" y="69" width="760" height="27" /></mxCell><mxCell id="pressure2-text-2" value="Agent의 업무 planning을 VIA로 옮기지 않는다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;fontColor=#171717;fontSize=20;fontStyle=0;fontFamily=Arial;align=left;verticalAlign=top;spacing=0;connectable=0;" vertex="1" parent="pressure2"><mxGeometry as="geometry" x="16" y="94" width="760" height="27" /></mxCell><mxCell id="e00" value="" style="rounded=1;arcSize=8;html=1;fillColor=#FFFFFF;strokeColor=#171717;strokeWidth=2.5;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="330" y="380" width="490" height="130" /></mxCell><mxCell id="e00-title" value="복합 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;fontColor=#171
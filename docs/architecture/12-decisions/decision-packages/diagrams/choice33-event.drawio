<Array as="points" /></mxGeometry></mxCell><mxCell id="e44" style="edgeStyle=none;rounded=0;strokeColor=#087A53;strokeWidth=2;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1904" y="890" /><mxPoint as="targetPoint" x="1904" y="955" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e49" style="edgeStyle=none;rounded=0;strokeColor=#087A53;strokeWidth=2;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1904" y="1180" /><mxPoint as="targetPoint" x="1904" y="1245" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e54" style="edgeStyle=none;rounded=0;strokeColor=#087A53;strokeWidth=2;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1904" y="1470" /><mxPoint as="targetPoint" x="1904" y="1535" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e60" style="edgeStyle=none;rounded=0;strokeColor=#C7D1DD;strokeWidth=2;endArrow=none;endFill=0;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="64" y="2120" /><mxPoint as="targetPoint" x="2496" y="2120" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e2" value="VIA  /  ARCHITECTURE REVIEW" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=18;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="42" width="309.32" height="30.3" /></mxCell><mxCell id="e3" value="04-33  /  STAGE 04" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=18;fontStyle=1;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2287.12" y="42" width="208.88" height="30.3" /></mxCell><mxCell id="e4" value="여러 업무의 대화 정확성을 위한 협력&lt;br&gt;중앙 해석과 업무별 대화 처리" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=34;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="75" width="623.4" height="94" /></mxCell><mxCell id="e5" value="같은 사건의 1~5단계 / 본문 §4와 대응 / 시간축은 측정 비율이 아님" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=22;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="166" width="759.52" height="35.7" /></mxCell><mxCell id="e7" value="공통 입력과 끝점은 유지한다. 각 칸은 사건 설명이며 Component 또는 process 배치를 뜻하지 않는다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=23;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="238" width="1186.06" height="37.05" /></mxCell><mxCell id="e8" value="A  중앙이 전체 대화 해석" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=28;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="300" width="364.16" height="43.800000000000004" /></mxCell><mxCell id="e11" value="1. 두 업무 질문과 실제 게시" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=27;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="92" y="393" width="395.18" height="42.45" /></mxCell><mxCell id="e12" value="Task Manager → Request Controller: 질문 / 실제 게시 기록" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=23;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="92" y="458" width="762.4" height="38" /></mxCell><mxCell id="e16" value="2. 복합 후속 발화 해석" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=27;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="92" y="683" width="324.44" height="42.45" /></mxCell><mxCell id="e17" value="Request Interpreter → [요청] / ← [반환] Model Access: 관련 업무 공동&lt;br&gt;해석" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=23;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="92" y="748" width="922.48" height="70" /></mxCell><mxCell id="e21" value="3. 관계와 상태 변경 제안" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=27;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="92" y="973" width="351.44" height="42.45" /></mxCell><mxCell id="e22" value="Request Interpreter → Request Controller: 전체 관계" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=23;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="92" y="1038" width="713.18" height="38" /></mxCell><mxCell id="e26" value="4. 현재 조건 검사 후 적용" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=27;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="92" y="1263" width="368.18" height="42.45" /></mxCell><mxCell id="e27" value="Request Controller: 중앙 상태와 명령 intent 확정" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=23;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="92" y="1328" width="642.8" height="38" /></mxCell><mxCell id="e31" value="5. 외부 적용과 사용자 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=27;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="92" y="1553" width="378.44" height="42.45" /></mxCell><mxCell id="e32" value="Task Manager → [요청] / ← [반환] Agent Gateway → [요청] / ← [반환]&lt;br&gt;Agent / 실제 상태 전달" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=23;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="92" y="1618" width="905.0" height="70" /></mxCell><mxCell id="e33" value="같은 정상 사건의 흐름. 실패/철회/재시작은 본문 §6.&lt;br&gt;표시/생성 완료와 실제 청취, 접수와 업무 완료를 구별한다.&lt;br&gt;구조의 유리한 조건과 반증은 본문 §8~9에서 검토한다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=22;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="84" y="1870" width="650.4" height="95.10000000000001" /></mxCell><mxCell id="e34" value="B  업무 대화 actor가 협력" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=28;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1312" y="300" width="394.96" height="43.800000000000004" /></mxCell><mxCell id="e37" value="1. 두 업무 질문과 실제 게시" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=27;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1340" y="393" width="395.18" height="42.45" /></mxCell><mxCell id="e38" value="Task Dialogue Runtime → 각 actor: 같은 질문/실제 게시 사건" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=23;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1340" y="458" width="774.36" height="38" /></mxCell><mxCell id="e42" value="2. 복합 후속 발화 해석" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=27;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1340" y="683" width="324.44" height="42.45" /></mxCell><mxCell id="e43" value="Dialogue Coordinator → actor → [요청] / ← [반환] Request&lt;br&gt;Interpreter: 로컬 의미 제안" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=23;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1340" y="748" width="784.48" height="70" /></mxCell><mxCell id="e47" value="3. 관계와 상태 변경 제안" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=27;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1340" y="973" width="351.44" height="42.45" /></mxCell><mxCell id="e48" value="actor → [요청] / ← [반환] Dialogue Coordinator: 담당 절, 결론 참조&lt;br&gt;요청/반환과 재제안" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=23;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1340" y="1038" width="888.44" height="70" /></mxCell><mxCell id="e52" value="4. 현재 조건 검사 후 적용" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=27;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1340" y="1263" width="368.18" height="42.45" /></mxCell><mxCell id="e53" value="같은 guard, Dialogue Coordinator: actor 예상 버전과 채택 변경 확정" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=23;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1340" y="1328" width="877.4" height="38" /></mxCell><mxCell id="e57" value="5. 외부 적용과 사용자 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=27;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1340" y="1553" width="378.44" height="42.45" /></mxCell><mxCell id="e58" value="동일. actor에는 적용 완료 및 실제 전달 사건 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=23;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1340" y="1618" width="598.64" height="38" /></mxCell><mxCell id="e59" value="같은 정상 사건의 흐름. 실패/철회/재시작은 본문 §6.&lt;br&gt;표시/생성 완료와 실제 청취, 접수와 업무 완료를 구별한다.&lt;br&gt;구조의 유리한 조건과 반증은 본문 §8~9에서 검토한다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=22;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1332" y="1870" width="650.4" height="95.10000000000001" /></mxCell><mxCell id="e61" value="검정 = 공통 / 파랑 = A 고유 / 초록 = B 고유 / 색은 우위가 아님" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=19;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="2138" width="651.72" height="31.650000000000002" /></mxCell><mxCell id="e62" value="실선 → 요청/전달 / 점선 → 반환/확인" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=18;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2149.24" y="2138" width="346.76" height="30.3" /></mxCell><mxCell id="e63" value="제목 상자 = Component / 내부 둥근 상자 = Module / 원통 = 저장 / 접힌 종이 = 자료 / 육각형 = 연동 대상" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=17;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="2176" width="962.38" height="28.950000000000003" /></mxCell><mxCell id="e64" value="실제 소요 시간/성능을 표시하지 않는다. 요청과 반환의 송수신 책임은 각 단계와 본문 표에 명시한다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=17;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="2212" width="856.64" height="28.950000000000003" /></mxCell></root></mxGraphModel></diagram></mxfile>

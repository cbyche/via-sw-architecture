y" x="302.4" y="415" width="231.2" height="34" /></mxCell><mxCell id="e16" value="Request&lt;br&gt;Interpreter" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=20;fontStyle=1;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="583.8" y="415" width="144.4" height="62" /></mxCell><mxCell id="e19" value="State Store" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=20;fontStyle=1;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="821.8" y="415" width="144.4" height="34" /></mxCell><mxCell id="e22" value="Agent Gateway" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=20;fontStyle=1;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1047.4" y="415" width="169.2" height="34" /></mxCell><mxCell id="e24" value="1  보고서 qR=형식?, 메일 qM=본문?; 실제 게시 연결" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="74" y="580" width="570.38" height="34.35" /></mxCell><mxCell id="e26" value="2  “보고서는 PDF, 메일에는 그 결론” 전체 해석 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="74" y="691" width="573.32" height="34.35" /></mxCell><mxCell id="e28" value="qR=PDF; qM.content=R.result@4 제안" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="74" y="802" width="440.6" height="34.35" /></mxCell><mxCell id="e30" value="3  두 절의 관계/질문 버전/결론 참조 확인" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="74" y="913" width="453.2" height="34.35" /></mxCell><mxCell id="e32" value="4  현재 검사 후 두 변경 + 전송 intent를 원자 저장" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="74" y="1024" width="570.38" height="34.35" /></mxCell><mxCell id="e34" value="채택 결과 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="74" y="1135" width="160.04" height="34.35" /></mxCell><mxCell id="e36" value="5  채택된 각 업무의 답변 전달" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="74" y="1246" width="330.14" height="34.35" /></mxCell><mxCell id="e38" value="접수/결과 반환; 사용자 전달은 공통 응답 경로" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="74" y="1357" width="490.16" height="34.35" /></mxCell><mxCell id="e41" value="별도 변형: 위 흐름의 채택 전에 qM 취소가 도착" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="74" y="1468" width="508.22" height="34.35" /></mxCell><mxCell id="e43" value="옛 qM 답 거절; 독립 qR은 진행, 결합 조건이면 함께 보류" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="74" y="1579" width="615.32" height="34.35" /></mxCell><mxCell id="e45" value="읽을 결론: 업무 간 생략/교차 참조를 한 번에 해석" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=22;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="74" y="2070" width="562.4" height="35.7" /></mxCell><mxCell id="e46" value="대가: 중앙이 모든 대화 전이 규칙을 관리" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="74" y="2115" width="435.14" height="34.35" /></mxCell><mxCell id="e47" value="B  업무별 처리자가 상태를 제안" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=30;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1312" y="285" width="479.6" height="46.5" /></mxCell><mxCell id="e48" value="위에서 아래로 읽기. 가로 화살표의 시작/끝이 실제 송신자/수신자." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1312" y="345" width="664.4" height="33.0" /></mxCell><mxCell id="e50" value="Dialogue&lt;br&gt;Coordinator" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=20;fontStyle=1;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1355.8" y="415" width="144.4" height="62" /></mxCell><mxCell id="e53" value="보고서 대화 actor" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=20;fontStyle=1;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1568.6" y="415" width="194.8" height="34" /></mxCell><mxCell id="e56" value="메일 대화 actor" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=20;fontStyle=1;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1816.6" y="415" width="174.8" height="34" /></mxCell><mxCell id="e59" value="Request Controller" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=20;fontStyle=1;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2026.4" y="415" width="231.2" height="34" /></mxCell><mxCell id="e62" value="State Store" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=20;fontStyle=1;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2307.8" y="415" width="144.4" height="34" /></mxCell><mxCell id="e64" value="1  같은 원문/버전 + 보고서의 허용 맥락" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1322" y="580" width="432.2" height="34.35" /></mxCell><mxCell id="e66" value="2  같은 원문/버전 + 메일의 허용 맥락" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1322" y="691" width="411.2" height="34.35" /></mxCell><mxCell id="e68" value="qR=PDF 변경 제안; 확정 결론 R.result@4 내보냄" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1322" y="802" width="538.46" height="34.35" /></mxCell><mxCell id="e70" value="내가 담당할 메일 절; 보고서 결론 참조 필요" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1322" y="913" width="469.16" height="34.35" /></mxCell><mxCell id="e72" value="3  허용된 결론 참조 전달 → actor가 본문 변경 재제안" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1322" y="1024" width="586.34" height="34.35" /></mxCell><mxCell id="e74" value="qM.content=R.result@4 + 예상 버전" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1322" y="1135" width="417.5" height="34.35" /></mxCell><mxCell id="e76" value="4  원문 절/관계/현재 질문/Task/권한 검사 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1322" y="1246" width="518.3" height="34.35" /></mxCell><mxCell id="e78" value="채택 허용 또는 변경된 의존 집합 거절" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1322" y="1357" width="401.12" height="34.35" /></mxCell><mxCell id="e80" value="5  actor가 제안한 상태/intent를 원자 저장" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1322" y="1468" width="486.38" height="34.35" /></mxCell><mxCell id="e82" value="채택된 버전/명령 intent 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1322" y="1579" width="327.2" height="34.35" /></mxCell><mxCell id="e84" value="저장 성공 후 채택 통지; 메일 actor에도 통지" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1322" y="1690" width="492.26" height="34.35" /></mxCell><mxCell id="e87" value="별도 변형: 위 흐름의 채택 전 qM 취소 → 옛 제안 거절" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1322" y="1801" width="581.3" height="34.35" /></mxCell><mxCell id="e89" value="읽을 결론: 업무별 대화 규칙/사건 처리를 해당 actor가 소유" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=22;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1322" y="2070" width="674.6" height="35.7" /></mxCell><mxCell id="e90" value="대가: 참가 누락/제안 충돌/참조 왕복/모델 경합" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1322" y="2115" width="503.18" height="34.35" /></mxCell><mxCell id="e91" value="생략한 공통 연동: 추론은 Model Access의 한 벌 Omni; 업무 실행은 Task Manager/Agent Gateway가 Downstream Agent에 위임." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="2200" width="1285.94" height="31.650000000000002" /></mxCell><mxCell id="e92" value="실선 = 요청/전달, 점선 = 결과. 별도 언급 없는 참여자는 논리 책임. 시간 간격은 성능 수치가 아닌 사건 순서. 수작업 설계 추적, 미측정." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="2240" width="1323.18" height="31.650000000000002" /></mxCell></root></mxGraphModel></diagram></mxfile>

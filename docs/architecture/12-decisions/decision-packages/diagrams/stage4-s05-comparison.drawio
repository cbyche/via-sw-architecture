27" value="일반 경로: 외부 자료 등이 필요할 때" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="114" y="1478" width="338.12" height="30.3" /></mxCell><mxCell id="e29" value="일반 경로: 해석과 응답 제안 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="649" y="1495" width="308.96" height="30.3" /></mxCell><mxCell id="e35" value="7 보류 해제 지시" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1037" y="1934" width="160.64" height="30.3" /></mxCell><mxCell id="e37" value="5 응답 허용" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="810" y="1459" width="113.48" height="30.3" /></mxCell><mxCell id="e39" value="8 Text 게시" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="905" y="1089" width="122.12" height="30.3" /></mxCell><mxCell id="e41" value="일반 응답: 검사한 음성" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1004" y="1910" width="214.64" height="30.3" /></mxCell><mxCell id="e43" value="8 실제 전달 기록" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1002" y="1500" width="160.64" height="30.3" /></mxCell><mxCell id="e49" value="모델 해석 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="121" y="1920" width="138.32" height="30.3" /></mxCell><mxCell id="e52" value="일반 응답: 승인된 Text" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="772" y="1928" width="223.28" height="30.3" /></mxCell><mxCell id="e54" value="일반 응답: 음성 결과" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1025" y="1973" width="196.64" height="30.3" /></mxCell><mxCell id="e56" value="1 원음으로 미리 생성" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="113" y="1860" width="196.64" height="30.3" /></mxCell><mxCell id="e58" value="2 보류 음성 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="798" y="1952" width="160.64" height="30.3" /></mxCell><mxCell id="e60" value="3 제안과 실행 ID" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="587" y="1124" width="164.96" height="30.3" /></mxCell><mxCell id="e62" value="직접 허용" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="585" y="1288" width="91.16" height="30.3" /></mxCell><mxCell id="e68" value="남는 기능, 이동하는 경로, 포기하는 기능" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=21;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="88" y="2507" width="435.14" height="34.35" /></mxCell><mxCell id="e69" value="T: 자체 지식 질문의 음성은 먼저 준비할 수 있다. 허용 전에는 재생하지 않는다.&lt;br&gt;일반 해석과 Text 기반 음성 생성은 양안 공통이다. A의 해석기에 S2S 기능이 옮겨진 것이 아니다.&lt;br&gt;Text는 승인되면 음성 생성 완료를 기다리지 않고 게시할 수 있다. 실제 전달 기록은 별도다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="88" y="2548" width="1034.48" height="99" /></mxCell><mxCell id="e70" value="자료, 화면이나 이전 업무가 필요하면 T도 일반 해석 경로로 보낸다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#895914;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="88" y="2654" width="609.92" height="30.3" /></mxCell><mxCell id="e72" value="A" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=white;fontSize=27;fontStyle=1;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1323.63" y="574" width="24.74" height="42.45" /></mxCell><mxCell id="e73" value="모든 요청 해석 → Text 승인 → 음성" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=28;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1380" y="566" width="513.6800000000001" height="43.800000000000004" /></mxCell><mxCell id="e74" value="제한 기능 탐색안 / 일반 경로로 응답, 직접 S2S는 없음" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1380" y="606" width="506.24" height="30.3" /></mxCell><mxCell id="e76" value="VIA SOFTWARE" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=18;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1334" y="681" width="141.92" height="30.3" /></mxCell><mxCell id="e77" value="비교에 필요한 책임만 표시" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=16;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2260.24" y="683" width="213.76" height="27.6" /></mxCell><mxCell id="e81" value="직접 음성을 미리 만들거나 보류하지 않는다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=22;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1378" y="963" width="485.84" height="35.7" /></mxCell><mxCell id="e83" value="모든 입력을 아래 일반 해석으로 전달&lt;br&gt;직접 경로를 따로 판단하지 않음" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=22;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1376" y="1297" width="406.2" height="65.4" /></mxCell><mxCell id="e86" value="1 정규 입력 전달" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1388" y="1068" width="160.64" height="30.3" /></mxCell><mxCell id="e91" value="2 모든 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1362" y="1478" width="113.48" height="30.3" /></mxCell><mxCell id="e93" value="3 해석과 응답 제안 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1897" y="1495" width="225.8" height="30.3" /></mxCell><mxCell id="e97" value="직접 응답 해제 단계 없음" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2024" y="1851" width="257.6" height="33.0" /></mxCell><mxCell id="e99" value="4 응답 허용" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2058" y="1459" width="113.48" height="30.3" /></mxCell><mxCell id="e101" value="5 Text 먼저 게시" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2153" y="1089" width="169.28" height="30.3" /></mxCell><mxCell id="e103" value="8 검사한 음성 전달" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2252" y="1910" width="178.64" height="30.3" /></mxCell><mxCell id="e105" value="8 실제 전달 기록" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2250" y="1500" width="160.64" height="30.3" /></mxCell><mxCell id="e107" value="직접 생성 경로 없음" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1374" y="2159" width="205.2" height="33.0" /></mxCell><mxCell id="e111" value="모델 해석 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1369" y="1920" width="138.32" height="30.3" /></mxCell><mxCell id="e114" value="6 승인된 Text" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2020" y="1928" width="140.12" height="30.3" /></mxCell><mxCell id="e116" value="7 음성 결과" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2273" y="1973" width="113.48" height="30.3" /></mxCell><mxCell id="e122" value="남는 기능, 이동하는 경로, 포기하는 기능" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=21;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1336" y="2507" width="435.14" height="34.35" /></mxCell><mxCell id="e123" value="A: 음성 응답은 계속 제공한다. 모든 입력은 Request Interpreter를 거친다.&lt;br&gt;일반 해석과 Text 기반 음성 생성은 양안 공통이다. A의 해석기에 S2S 기능이 옮겨진 것이 아니다.&lt;br&gt;Text는 승인되면 음성 생성 완료를 기다리지 않고 게시할 수 있다. 실제 전달 기록은 별도다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1336" y="2548" width="1034.48" height="99" /></mxCell><mxCell id="e124" value="직접 S2S 기능은 미지원. 입력 해석 뒤 음성을 생성하므로 실행 의존성과 지연이 달라진다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#895914;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1336" y="2654" width="809.72" height="30.3" /></mxCell><mxCell id="e126" value="색:  검정 = 공통     파랑 = T 전용     초록 = A/B 전용" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=19;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="2752" width="584.84" height="31.650000000000002" /></mxCell><mxCell id="e127" value="실선 → 요청/전달     점선 → 결과/복원" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=18;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2126.92" y="2752" width="369.08" height="30.3" /></mxCell><mxCell id="e128" value="모양:  제목 칸이 있는 박스 = Component   |   내부 둥근 박스 = Module   |   원통 = 저장소   |   접힌 종이 = 자료   |   육각형 = 연동 대상/모델" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=17;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="2790" width="1347.26" height="28.950000000000003" /></mxCell><mxCell id="e129" value="S2S는 음성 입력에서 직접 음성 답변을 만드는 경로다. 검정 해석 모듈은 공통이며 초록은 A의 요청 처리 경로다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=17;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="2830" width="953.88" height="28.950000000000003" /></mxCell><mxCell id="e130" value="탐색안 / 미채택 / 미측정" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=17;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2271.76" y="2830" width="224.24" height="28.950000000000003" /></mxCell><mxCell id="e132" value="두 안의 공통 시작 / 아래에는 같은 책임을 방안별로 펼쳐 표시" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=20;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="90" y="240" width="624.4" height="33.0" /></mxCell><mxCell id="e136" value="Speech Input Worker" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=18;fontStyle=0;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1158.98" y="319" width="220.04" height="30.3" /></mxCell><mxCell id="e140" value="원음 도착" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="450" y="318" width="91.16" height="30.3" /></mxCell><mxCell id="e142" value="원음과 시각 전달" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="942" y="318" width="156.32" height="30.3" /></mxCell><mxCell id="e144" value="인식 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1434" y="318" width="91.16" height="30.3" /></mxCell><mxCell id="e145" value="입력과 반환의 상세 순서는 아래 화살표와 실행 순서 그림에서 확인한다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="90" y="525" width="641.6" height="30.3" /></mxCell><mxCell id="e147" value="문장과 발화 시각" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1360" y="405" width="156.32" height="30.3" /></mxCell><mxCell id="e149" value="인식 근거 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="870" y="446" width="138.32" height="30.3" /></mxCell><mxCell id="e151" value="현재 입력 버전과 정규 문장 전달" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1300" y="486" width="297.8" height="30.3" /></mxCell></root></mxGraphModel></diagram></mxfile>

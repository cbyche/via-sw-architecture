r=#195FBD;fontSize=18;fontFamily=Arial;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="89" y="1249" width="393.2" height="30.3" /></mxCell><mxCell id="e46" value="현재 질문의 일반 지식만 사용. 개인 자료, 화면, Task나 과거 대화는 Core로 보낸다.&lt;br&gt;Request Controller의 허용 뒤 Response Manager가 Interaction Manager에 release한다.&lt;br&gt;생성된 음성, 게시 기록, 사용자가 실제로 들은 범위를 구분한다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#233247;fontSize=22;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="89" y="1287" width="1084.24" height="105" /></mxCell><mxCell id="e47" value="정규 전사와 현재 revision 확인은 직접 경로에도 필요하다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#956016;fontSize=18;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="89" y="1399" width="546.56" height="30.3" /></mxCell><mxCell id="e49" value="A" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=white;fontSize=27;fontFamily=Arial;fontStyle=1;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1323.63" y="246" width="24.74" height="42.45" /></mxCell><mxCell id="e50" value="Core 공통 경로 + SpeechRender" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#233247;fontSize=27;fontFamily=Arial;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1380" y="237" width="467.53999999999996" height="42.45" /></mxCell><mxCell id="e51" value="제한 기능 탐색안 / S2S 직접 기능 미지원" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5E6D80;fontSize=18;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1380" y="276" width="382.76" height="30.3" /></mxCell><mxCell id="e53" value="VIA SOFTWARE" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#233247;fontSize=18;fontFamily=Arial;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1336" y="353" width="141.92000000000002" height="30.3" /></mxCell><mxCell id="e54" value="논리적 책임 경계" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5E6D80;fontSize=16;fontFamily=Arial;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2332.16" y="354" width="139.84" height="27.6" /></mxCell><mxCell id="e61" value="① 정규 입력" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#233247;fontSize=18;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1742" y="407" width="113.48" height="30.3" /></mxCell><mxCell id="e63" value="② 모든 요청 해석" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=18;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2074" y="534" width="160.64" height="30.3" /></mxCell><mxCell id="e65" value="③ 제안 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#233247;fontSize=18;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2263" y="585" width="113.48" height="30.3" /></mxCell><mxCell id="e67" value="④ 게시 허용" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#233247;fontSize=18;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2292" y="788" width="113.48" height="30.3" /></mxCell><mxCell id="e69" value="⑤ Text&lt;br&gt;⑧ Voice" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#233247;fontSize=18;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1916" y="751" width="86.12" height="54.6" /></mxCell><mxCell id="e73" value="공유 weights 한 벌 / Voice와 semantic session 분리&lt;br&gt;Interaction Manager가 실제 표시, 재생과 local stop 소유" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5E6D80;fontSize=20;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1758" y="1076" width="642.0" height="60.0" /></mxCell><mxCell id="e75" value="제거되는 경로" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5E6D80;fontSize=18;fontFamily=Arial;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1367" y="589" width="127.16" height="30.3" /></mxCell><mxCell id="e76" value="VoiceProposal 직접 admission&lt;br&gt;speculative S2S generation&lt;br&gt;전용 보류 handle과 전환 상태" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5E6D80;fontSize=23;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1367" y="634" width="396.24" height="117" /></mxCell><mxCell id="e78" value="⑥ 승인 Text → SpeechRender" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=18;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1726" y="841" width="289.52" height="30.3" /></mxCell><mxCell id="e80" value="⑦ 음성 결과 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=18;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1739" y="956" width="160.64" height="30.3" /></mxCell><mxCell id="e83" value="DESIGN FOCUS  /  생성 경로 단순화와 기능 손실" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=18;fontFamily=Arial;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1337" y="1249" width="458.36" height="30.3" /></mxCell><mxCell id="e84" value="자체 지식 질문도 Request Interpreter를 거친다. Text는 음성 생성 전에 게시할 수 있다.&lt;br&gt;Response Manager → Model Access → 공유 Omni SpeechRender → 음성 결과 반환&lt;br&gt;출력 epoch, 실제 전달 receipt와 Task 후속 연결은 계속 유지한다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#233247;fontSize=22;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1337" y="1287" width="1027.04" height="105" /></mxCell><mxCell id="e85" value="Core 부하와 SpeechRender 의존성이 늘 수 있다. S2S와 동등한 기능으로 표시하지 않는다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#956016;fontSize=18;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1337" y="1399" width="833.12" height="30.3" /></mxCell><mxCell id="e87" value="범례" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5E6D80;fontSize=17;fontFamily=Arial;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="1552" width="42" height="28.950000000000003" /></mxCell><mxCell id="e89" value="호출 / 전달" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5E6D80;fontSize=17;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="190" y="1551" width="107.62" height="28.950000000000003" /></mxCell><mxCell id="e91" value="결과 / 복원" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5E6D80;fontSize=17;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="405" y="1551" width="107.62" height="28.950000000000003" /></mxCell><mxCell id="e93" value="구조 차이 또는 확대 대상" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5E6D80;fontSize=17;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="597" y="1551" width="220.16" height="28.950000000000003" /></mxCell><mxCell id="e94" value="외부 책임 경계 ≠ 원격 배치  |  모델은 on-device 의존성" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5E6D80;fontSize=17;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1020" y="1551" width="511.88" height="28.950000000000003" /></mxCell><mxCell id="e95" value="양안의 공통 semantic 모델 호출은 생략했다. 모든 모델 연동은 Model Access를 통하며 확대 표시는 추가 인스턴스가 아니다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5E6D80;fontSize=18;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="1597" width="1140.92" height="30.3" /></mxCell><mxCell id="e96" value="설계 탐색  /  미채택 대안  /  미측정" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5E6D80;fontSize=17;fontFamily=Arial;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2157.52" y="1598" width="338.48" height="28.950000000000003" /></mxCell></root></mxGraphModel></diagram></mxfile>

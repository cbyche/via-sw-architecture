<mxfile host="app.diagrams.net" type="device"><diagram id="via-common-request-background" name="말과 화면, 이전 업무를 섞은 요청"><mxGraphModel page="1" pageWidth="1920" pageHeight="1080" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="via-common-request-background-1" parent="1" vertex="1" value="말과 화면, 이전 업무를 섞은 요청" style="fontFamily=Calibri;fontSize=40.0;fontColor=#000000;fontStyle=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="60" y="30" width="1040" height="60" /></mxCell><mxCell id="via-common-request-background-2" parent="1" edge="1" style="edgeStyle=none;rounded=0;strokeColor=#A6A6A6;strokeWidth=1.5;endArrow=none;endFill=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="52" y="104" /><mxPoint as="targetPoint" x="1872" y="104" /><Array as="points" /></mxGeometry></mxCell><mxCell id="via-common-request-background-3" parent="1" edge="1" style="edgeStyle=none;rounded=0;strokeColor=#A6A6A6;strokeWidth=1.5;endArrow=none;endFill=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="52" y="908" /><mxPoint as="targetPoint" x="1868" y="908" /><Array as="points" /></mxGeometry></mxCell><mxCell id="via-common-request-background-4" parent="1" vertex="1" value="설계 질문" style="fontFamily=Calibri;fontSize=30.666666666666668;fontColor=#C00000;fontStyle=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="52" y="935" width="180" height="50" /></mxCell><mxCell id="via-common-request-background-5" parent="1" vertex="1" value="이 연결을 유지하며 새 입력, 과거 맥락과 업무를 어떻게 다룰까?" style="fontFamily=Calibri;fontSize=30.666666666666668;fontColor=#000000;fontStyle=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="260" y="932" width="1608" height="100" /></mxCell><mxCell id="via-common-request-background-6" parent="1" vertex="1" value="“이 표를 아까 보고서에 넣어줘.&lt;br&gt;아니, 두 번째 표만. 메일은 보내지 말고.”" style="fontFamily=Calibri;fontSize=36.0;fontColor=#000000;fontStyle=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="52" y="150" width="1816" height="110" /></mxCell><mxCell id="via-common-request-background-7" parent="1" vertex="1" value="화면에서 가리킨 자료" style="fontFamily=Calibri;fontSize=29.333333333333332;fontColor=#000000;fontStyle=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="52" y="292" width="568" height="52" /></mxCell><mxCell id="via-common-request-background-8" parent="1" vertex="1" value="앞서 진행한 업무" style="fontFamily=Calibri;fontSize=29.333333333333332;fontColor=#000000;fontStyle=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="676" y="292" width="568" height="52" /></mxCell><mxCell id="via-common-request-background-9" parent="1" vertex="1" value="바꾼 부분과 유지할 조건" style="fontFamily=Calibri;fontSize=29.333333333333332;fontColor=#000000;fontStyle=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="1300" y="292" width="568" height="52" /></mxCell><mxCell id="via-common-request-background-10" parent="1" vertex="1" value="첫 번째 표" style="fontFamily=Calibri;fontSize=29.333333333333332;fontColor=#000000;fontStyle=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=0;shape=rect;fillColor=#F2F2F2;strokeColor=#A6A6A6;strokeWidth=2;spacing=14;"><mxGeometry as="geometry" x="80" y="365" width="504" height="72" /></mxCell><mxCell id="via-common-request-background-11" parent="1" vertex="1" value="두 번째 표" style="fontFamily=Calibri;fontSize=29.333333333333332;fontColor=#000000;fontStyle=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=0;shape=rect;fillColor=#FFFFFF;strokeColor=#00889A;strokeWidth=2;spacing=14;"><mxGeometry as="geometry" x="80" y="460" width="504" height="72" /></mxCell><mxCell id="via-common-request-background-12" parent="1" vertex="1" value="보고서 작성 업무" style="fontFamily=Calibri;fontSize=29.333333333333332;fontColor=#000000;fontStyle=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=0;shape=rect;fillColor=#FFFFFF;strokeColor=#A6A6A6;strokeWidth=2;spacing=14;"><mxGeometry as="geometry" x="704" y="365" width="504" height="72" /></mxCell><mxCell id="via-common-request-background-13" parent="1" vertex="1" value="메일 초안 업무" style="fontFamily=Calibri;fontSize=29.333333333333332;fontColor=#000000;fontStyle=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=0;shape=rect;fillColor=#FFFFFF;strokeColor=#A6A6A6;strokeWidth=2;spacing=14;"><mxGeometry as="geometry" x="704" y="460" width="504" height="72" /></mxCell><mxCell id="via-common-request-background-14" parent="1" vertex="1" value="표는 두 번째만&lt;br&gt;메일 발송 금지 유지" style="fontFamily=Calibri;fontSize=32.0;fontColor=#000000;fontStyle=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="1328" y="372" width="504" height="150" /></mxCell><mxCell id="via-common-request-background-15" parent="1" edge="1" style="edgeStyle=none;rounded=0;strokeColor=#00889A;strokeWidth=2.5;endArrow=open;endFill=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="332" y="560" /><mxPoint as="targetPoint" x="332" y="598" /><Array as="points" /></mxGeometry></mxCell><mxCell id="via-common-request-background-16" parent="1" edge="1" style="edgeStyle=none;rounded=0;strokeColor=#00889A;strokeWidth=2.5;endArrow=open;endFill=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="956" y="560" /><mxPoint as="targetPoint" x="956" y="598" /><Array as="points" /></mxGeometry></mxCell><mxCell id="via-common-request-background-17" parent="1" edge="1" style="edgeStyle=none;rounded=0;strokeColor=#00889A;strokeWidth=2.5;endArrow=open;endFill=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1580" y="560" /><mxPoint as="targetPoint" x="1580" y="598" /><Array as="points" /></mxGeometry></mxCell><mxCell id="via-common-request-background-18" parent="1" vertex="1" value="실제 자료와 범위" style="fontFamily=Calibri;fontSize=32.0;fontColor=#000000;fontStyle=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="52" y="615" width="568" height="52" /></mxCell><mxCell id="via-common-request-background-19" parent="1" vertex="1" value="수정할 보고서 업무" style="fontFamily=Calibri;fontSize=32.0;fontColor=#000000;fontStyle=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="676" y="615" width="568" height="52" /></mxCell><mxCell id="via-common-request-background-20" parent="1" vertex="1" value="정정 범위와 기존 조건" style="fontFamily=Calibri;fontSize=32.0;fontColor=#000000;fontStyle=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="1300" y="615" width="568" height="52" /></mxCell><mxCell id="via-common-request-background-21" parent="1" vertex="1" value="잘못 연결하면 다른 자료를 넣거나, 금지한 메일을 보내게 됩니다." style="fontFamily=Calibri;fontSize=30.666666666666668;fontColor=#000000;fontStyle=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="52" y="714" width="1816" height="50" /></mxCell><mxCell id="via-common-request-background-22" parent="1" vertex="1" value="VIA는 대상과 업무 연결, 정정 범위를 함께 판단하고 기존 조건을 보존해야 합니다." style="fontFamily=Calibri;fontSize=29.333333333333332;fontColor=#000000;fontStyle=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="52" y="786" width="1816" height="50" /></mxCell><mxCell id="via-common-request-background-23" parent="1" vertex="1" value="보고서를 어떻게 작성할지 추론하고 실제로 만드는 일은 Downstream Agent가 맡습니다." style="fontFamily=Calibri;fontSize=25.333333333333332;fontColor=#000000;fontStyle=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="52" y="843" width="1816" height="46" /></mxCell></root></mxGraphModel></diagram></mxfile>

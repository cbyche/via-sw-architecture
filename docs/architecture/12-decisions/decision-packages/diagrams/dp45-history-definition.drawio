<mxfile host="app.diagrams.net" type="device"><diagram id="dp45-history-definition" name="과거 이력의 범위와 현재 Context"><mxGraphModel page="1" pageWidth="2560" pageHeight="1440" grid="1" gridSize="8"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="e1" value="" style="rounded=1;arcSize=4;fillColor=#263445;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="0" y="0" width="2560" height="9" /></mxCell><mxCell id="e7" value="" style="rounded=1;arcSize=4;fillColor=white;strokeColor=#C7D1DD;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="240" width="760" height="910" /></mxCell><mxCell id="e10" value="" style="rounded=1;arcSize=4;fillColor=white;strokeColor=#C7D1DD;" vertex="1" parent="1"><mxGeometry as="geometry" x="900" y="240" width="760" height="910" /></mxCell><mxCell id="e13" value="" style="rounded=1;arcSize=4;fillColor=white;strokeColor=#C7D1DD;" vertex="1" parent="1"><mxGeometry as="geometry" x="1736" y="240" width="760" height="910" /></mxCell><mxCell id="e6" style="edgeStyle=none;rounded=0;strokeColor=#C7D1DD;strokeWidth=2;endArrow=none;endFill=0;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="64" y="202" /><mxPoint as="targetPoint" x="2496" y="202" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e27" style="edgeStyle=none;rounded=0;strokeColor=#C7D1DD;strokeWidth=2;endArrow=none;endFill=0;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="64" y="1202" /><mxPoint as="targetPoint" x="2496" y="1202" /><Array as="points" /></mxGeometry></mxCell><mxCell id="input" value="사용자 입력&lt;br&gt;Request Controller: 질문 / 지시 / 확인 답변" style="shape=note;size=20;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fillColor=#F7F9FC;strokeColor=#263445;fontColor=#263445;strokeWidth=1.7;" vertex="1" parent="1"><mxGeometry as="geometry" x="88" y="382" width="712" height="120" /></mxCell><mxCell id="request" value="요청의 해석과 변경&lt;br&gt;Request Controller: 채택 의미 / 정정 revision" style="shape=note;size=20;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fillColor=#F7F9FC;strokeColor=#263445;fontColor=#263445;strokeWidth=1.7;" vertex="1" parent="1"><mxGeometry as="geometry" x="88" y="524" width="712" height="120" /></mxCell><mxCell id="work" value="업무 연결과 수신 사건&lt;br&gt;Task Manager: 위임 / receipt / 결과 version" style="shape=note;size=20;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fillColor=#F7F9FC;strokeColor=#263445;fontColor=#263445;strokeWidth=1.7;" vertex="1" parent="1"><mxGeometry as="geometry" x="88" y="666" width="712" height="120" /></mxCell><mxCell id="response" value="응답 준비와 실제 전달&lt;br&gt;Response Manager: 원문 / Text와 Voice 범위" style="shape=note;size=20;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fillColor=#F7F9FC;strokeColor=#263445;fontColor=#263445;strokeWidth=1.7;" vertex="1" parent="1"><mxGeometry as="geometry" x="88" y="808" width="712" height="120" /></mxCell><mxCell id="source" value="사용 자료와 결과 참조&lt;br&gt;Context Manager의 읽기 receipt / 채택 근거" style="shape=note;size=20;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fillColor=#F7F9FC;strokeColor=#263445;fontColor=#263445;strokeWidth=1.7;" vertex="1" parent="1"><mxGeometry as="geometry" x="88" y="950" width="712" height="120" /></mxCell><mxCell id="derived" value="요약 / 검색 색인 / 과거 관계&lt;br&gt;원본 ID와 revision / 구간 / 생성 방식&lt;br&gt;파생값의 불확실성과 생산 범위" style="shape=note;size=20;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fillColor=#F7F9FC;strokeColor=#263445;fontColor=#263445;strokeWidth=1.7;" vertex="1" parent="1"><mxGeometry as="geometry" x="924" y="382" width="712" height="190" /></mxCell><mxCell id="memory" value="User Memory는 별도 원본&lt;br&gt;명시적으로 저장한 선호 / routine / stable fact&lt;br&gt;과거 반복만으로 선호 등록하지 않음" style="shape=note;size=20;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fillColor=#F7F9FC;strokeColor=#263445;fontColor=#263445;strokeWidth=1.7;" vertex="1" parent="1"><mxGeometry as="geometry" x="924" y="848" width="712" height="185" /></mxCell><mxCell id="context" value="R23에 필요한 자료&lt;br&gt;실제 설명 E20[0:52] 원문&lt;br&gt;제품 비교 D21 개정 2 참조&lt;br&gt;견적 D22 개정 1 참조&lt;br&gt;출처 / 유효성 / 읽은 범위 / 누락" style="shape=note;size=20;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fillColor=#F7F9FC;strokeColor=#263445;fontColor=#263445;strokeWidth=1.7;" vertex="1" parent="1"><mxGeometry as="geometry" x="1760" y="382" width="712" height="246" /></mxCell><mxCell id="e2" value="VIA  /  ARCHITECTURE REVIEW" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=18;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="42" width="309.32" height="30.3" /></mxCell><mxCell id="e3" value="DP-45  /  STAGE 04" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=18;fontStyle=1;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2287.12" y="42" width="208.88" height="30.3" /></mxCell><mxCell id="e4" value="과거 이력의 범위와 현재 Context" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=42;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="87" width="714.44" height="62.7" /></mxCell><mxCell id="e5" value="과거 이력 = VIA를 통해 이미 수신하거나 처리하거나 전달한 내용의 원본 기록. 진행 중 업무에도 이력이 있다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=23;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="151" width="1264.72" height="37.05" /></mxCell><mxCell id="e8" value="1 원본 과거 이력" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=30;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="88" y="262" width="262.4" height="46.5" /></mxCell><mxCell id="e9" value="A와 B에 같은 기록을 제공" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=23;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="88" y="313" width="300.56" height="37.05" /></mxCell><mxCell id="e11" value="2 재사용을 위한 파생 자료" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=30;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="924" y="262" width="401.0" height="46.5" /></mxCell><mxCell id="e12" value="원본과 dependency를 가진 가공 정보" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=23;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="924" y="313" width="437.64" height="37.05" /></mxCell><mxCell id="e14" value="3 현재 요청의 Context" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=30;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1760" y="262" width="362.6" height="46.5" /></mxCell><mxCell id="e15" value="이번 목적과 권한에 맞춘 근거 묶음" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=23;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1760" y="313" width="401.3" height="37.05" /></mxCell><mxCell id="e22" value="A: 필요할 때 조합, 유효 cache 재사용&lt;br&gt;B: 공통 관계를 생산 / 게시 / 유지&lt;br&gt;원본 사실과 현재 의미의 권위는 공통" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=25;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="928" y="622" width="500.0" height="135" /></mxCell><mxCell id="e25" value="이번 조건과 Task 연결은 지금 판단&lt;br&gt;Request Interpreter: 의미 제안&lt;br&gt;Request Controller: 확인 / 채택&lt;br&gt;Downstream Agent: 기준 적용 / 제안서 작성" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=24;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1764" y="677" width="566.24" height="198" /></mxCell><mxCell id="e26" value="당시 기록 ≠ 지금 상태&lt;br&gt;생성된 설명 ≠ 실제 전달한 설명&lt;br&gt;결과 참조 ≠ 결과 본문 전체 보관" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=24;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1764" y="938" width="400.16" height="132" /></mxCell><mxCell id="e28" value="과거 동의는 현재 권한이 아니다. 원본 수정 / 삭제 / 철회와 채널별 전달 범위를 확인한다.&lt;br&gt;PC 자료 전체와 Agent 내부 기록은 포함하지 않는다. 파생 기억은 원본을 대신하는 새로운 업무 권위가 아니다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=24;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="1234" width="1325.12" height="92" /></mxCell><mxCell id="e29" value="접힌 종이 = 자료의 종류. 세 열은 설명 구분이며 새 Component나 세 개의 물리 DB가 아니다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=22;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="1357" width="1041.56" height="35.7" /></mxCell></root></mxGraphModel></diagram></mxfile>

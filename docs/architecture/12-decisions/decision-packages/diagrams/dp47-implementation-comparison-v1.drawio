or=white;fontColor=#195FBD;fontSize=44;fontStyle=1;align=left;spacing=0;"><mxGeometry as="geometry" x="80" y="464" width="484" height="57.2" /></mxCell><mxCell id="note3" parent="1" vertex="1" value="B  후보 생산과 결합" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=44;fontStyle=1;align=left;spacing=0;"><mxGeometry as="geometry" x="1990" y="464" width="528" height="57.2" /></mxCell><mxCell id="note4" parent="1" vertex="1" value="비동기 workflow / 단일 binding aggregate" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#111111;fontSize=32;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="570" y="476" width="1120" height="41.6" /></mxCell><mxCell id="note5" parent="1" vertex="1" value="Fork–Join + feedback / 생산자별 repository" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#111111;fontSize=32;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="2510" y="476" width="1216" height="41.6" /></mxCell><mxCell id="note6" parent="1" vertex="1" value="2  실행 지시" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=32;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="480" y="825" width="256" height="41.6" /></mxCell><mxCell id="note7" parent="1" vertex="1" value="3  원본 read 및 공동 의미 판단" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=32;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="480" y="1056" width="672" height="41.6" /></mxCell><mxCell id="note8" parent="1" vertex="1" value="4  TryApply / 현재 revision만 게시" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#111111;fontSize=32;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="1175" y="1056" width="928" height="41.6" /></mxCell><mxCell id="note9" parent="1" vertex="1" value="직접 target 생산과 binding 갱신이 하나의 의미 책임" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=35;fontStyle=1;align=left;spacing=0;"><mxGeometry as="geometry" x="480" y="1397" width="1225" height="45.5" /></mxCell><mxCell id="note10" parent="1" vertex="1" value="2  생산 job dispatch / 자원이 허용하면 병행" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=32;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="2390" y="825" width="1024" height="41.6" /></mxCell><mxCell id="note11" parent="1" vertex="1" value="3  역할별 원본 해석" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=32;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="2390" y="1038" width="384" height="41.6" /></mxCell><mxCell id="note12" parent="1" vertex="1" value="4  생산자별 게시 후 완료 통지" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#111111;fontSize=32;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="2390" y="1300" width="576" height="41.6" /></mxCell><mxCell id="note13" parent="1" vertex="1" value="5  호환 snapshot + 응답/deadline으로 결합 지시" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=31;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="2010" y="1509" width="1116" height="40.300000000000004" /></mxCell><mxCell id="note14" parent="1" vertex="1" value="6  후보 부족: 완료 inbox로 Rejudge 반환, Coordinator가 원 producer에 재지시" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#B63732;fontSize=30;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="2010" y="1714" width="1800" height="39.0" /></mxCell><mxCell id="note15" parent="1" vertex="1" value="공통 정정: BeginRevision(r2)와 TryApply/TryPublish가 같은 RevisionGate 사용 / 늦은 r1은 상태 반영 전 거절" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#111111;fontSize=32;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="90" y="1786" width="2720" height="41.6" /></mxCell><mxCell id="note16" parent="1" vertex="1" value="사각형: 실행 코드   칸 상자: bounded RAM FIFO   겹친 카드: RAM data model   접힌 종이: DTO   원통: 영속 DB" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#111111;fontSize=32;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="60" y="2058" width="2688" height="41.6" /></mxCell><mxCell id="note17" parent="1" vertex="1" value="실선: 작업 전달   점선: 완료 반환   회색: 상태 접근   빨강: 재판단   /   설계 가정, 미구현, 미측정" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#111111;fontSize=30;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="60" y="2110" width="1950" height="39.0" /></mxCell></root></mxGraphModel></diagram></mxfile>

lAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="166" width="883.16" height="35.7" /></mxCell><mxCell id="e7" value="A  조회/추론 loop로 전체 의미 제안" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=30;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="285" width="561.2" height="46.5" /></mxCell><mxCell id="e9" value="초기 안내는 같은 범위. 관련 업무는 미결정; 모든 과거 자료를 넣지 않음." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="94" y="580" width="741.6" height="33.0" /></mxCell><mxCell id="e12" value="관련 기록 조회" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="749" y="651" width="138.32" height="30.3" /></mxCell><mxCell id="e14" value="이전 의미/질문" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="749" y="718" width="138.32" height="30.3" /></mxCell><mxCell id="e19" value="1  원문/초기 안내 또는 읽기 결과로 추론" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="129" y="803" width="378.44" height="30.3" /></mxCell><mxCell id="e21" value="추가 조회 요청&lt;br&gt;의미/자료/Task&lt;br&gt;결과로 다시 추론" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="84" y="840" width="156.32" height="78.9" /></mxCell><mxCell id="e23" value="2  목표/대상/조건/업무 관계의 완성안" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="459" y="1260" width="349.28" height="30.3" /></mxCell><mxCell id="e25" value="수정 가능 오류&lt;br&gt;근거 내 재생성&lt;br&gt;횟수 제한" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="144" y="1260" width="138.32" height="78.9" /></mxCell><mxCell id="e29" value="추론 입력" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="879" y="1150" width="91.16" height="30.3" /></mxCell><mxCell id="e31" value="결과" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1079" y="1195" width="44.0" height="30.3" /></mxCell><mxCell id="e33" value="모델 입력" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="724" y="1075" width="91.16" height="30.3" /></mxCell><mxCell id="e35" value="모델 결과" style="text;html=1;whiteSpace=nowrap;
eColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="129" y="1430" width="375.92" height="30.3" /></mxCell><mxCell id="e40" value="자료 조회" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="799" y="1383" width="91.16" height="30.3" /></mxCell><mxCell id="e42" value="근거/변경" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="829" y="1460" width="91.16" height="30.3" /></mxCell><mxCell id="e44" value="Task 조회" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="799" y="1683" width="99.8" height="30.3" /></mxCell><mxCell id="e46" value="사실/변경" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="829" y="1760" width="91.16" height="30.3" /></mxCell><mxCell id="e47" value="같은 Controller가 근거 수집&lt;br&gt;초기 해석 전 / 근거 변경 시&lt;br&gt;최종 실행 전 현재 검사" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="874" y="1200" width="294.14" height="82.95" /></mxCell><mxCell id="e50" value="채택 의미/질문/실제 게시 기록 저장" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="864" y="1830" width="326.96" height="30.3" /></mxCell><mxCell id="e51" value="위와 아래 원통은 같은 상태&lt;br&gt;Controller 소유, State Store 보관" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="874" y="2010" width="359.0" height="54.6" /></mxCell><mxCell id="e54" value="미해결: 질문 전달 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="119" y="1795" width="214.64" height="30.3" /></mxCell><mxCell id="e56" value="실제 게시 기록 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="539" y="1845" width="185.48" height="30.3" /></mxCell><mxCell id="e57" value="Response Manager → Interaction Manager: 질문 표시/음성; 실제 게시 기록 반환&lt;br&gt;사용자 답변은 Interaction Manager → 상단 Request Controller로 새 입력" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="94" y="2010" width="784.52" height="54.6" /></mxCell><mxCell id="e59" value="유리: 자유로운 새 의도를 전체 맥락에서 다시 구성&lt;br&gt;대가: 앞선 조건 누락을 검증해야 함; 관련 근거 재해석&lt;br&gt;선택: 짧거나 표현 범위가 넓은 대화" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=23;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="79" y="2125" width="633.6" height="123" /></mxCell><mxCell id="e60" value="B  의미 상태에 변경을 적용" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=30;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1312" y="285" width="419.6" height="46.5" /></mxCell><mxCell id="e62" value="입력: Interaction Manager의 새 발화. 새 업무/보완 여부도 해석 대상." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1342" y="340" width="752.4" height="33.0" /></mxCell><mxCell id="e67" value="추론 입력" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2127" y="740" width="91.16" height="30.3" /></mxCell><mxCell id="e69" value="결과" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2327" y="785" width="44.0" height="30.3" /></mxCell><mxCell id="e71" value="모델 입력" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1972" y="625" width="91.16" height="30.3" /></mxCell><mxCell id="e73" value="모델 결과" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1972" y="670" width="91.16" height="30.3" /></mxCell><mxCell id="e75" value="1  원문 + 관계 후보. Workspace 요약을 조회해 해석" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1377" y="560" width="494.36" height="30.3" /></mxCell><mxCell id="e81" value="2  새 목표 생성 / 기존 목표의 후보 제한 / 조건 교체" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1377" y="825" width="499.4" height="30.3" /></mxCell><mxCell id="e83" value="의미/질문 조회" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1347" y="905" width="138.32" height="30.3" /></mxCell><mxCell id="e85" value="읽기 전용 요약" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1347" y="785" width="138.32" height="30.3" /></mxCell><mxCell id="e87" value="채택한 변경만 적용" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1462" y="1235" width="174.32" height="30.3" /></mxCell><mxCell id="e89" value="이전 버전" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1822" y="1290" width="91.16" height="30.3" /></mxCell><mxCell id="e91" value="3  후보/제약" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1962" y="1060" width="124.64" height="30.3" /></mxCell><mxCell id="e93" value="관계/미해결" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1962" y="1170" width="109.16" height="30.3" /></mxCell><mxCell id="e94" value="적용기와 Engine: 코드/명시 규칙&lt;br&gt;말뜻 해석: Interpreter의 Omni&lt;br&gt;상태 소유: Workspace Component" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2122" y="1240" width="325.52" height="78.9" /></mxCell><mxCell id="e97" value="4  의미/질문/근거 버전" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1367" y="1530" width="218.96" height="30.3" /></mxCell><mxCell id="e99" value="채택/실제 게시 기록" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1787" y="1600" width="185.48" height="30.3" /></mxCell><mxCell id="e103" value="자료 조회" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2032" y="1422" width="91.16" height="30.3" /></mxCell><mxCell id="e105" value="근거/변경" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2052" y="1500" width="91.16" height="30.3" /></mxCell><mxCell id="e107" value="Task 조회" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2082" y="1702" width="99.8" height="30.3" /></mxCell><mxCell id="e109" value="사실/변경" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2102" y="1780" width="91.16" height="30.3" /></mxCell><mxCell id="e110" value="의미 구성 중 조회/변경 구독: Workspace&lt;br&gt;실행 직전 검사: Request Controller&lt;br&gt;원본 소유자는 양안 모두 동일" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2122" y="1850" width="384.56" height="78.9" /></mxCell><mxCell id="e113" value="미해결: 질문 전달 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1367" y="1795" width="214.64" height="30.3" /></mxCell><mxCell id="e115" value="실제 게시 기록 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1787" y="1845" width="185.48" height="30.3" /></mxCell><mxCell id="e116" value="Response Manager → Interaction Manager: 질문 표시/음성; 실제 게시 기록 반환&lt;br&gt;사용자 답변은 Interaction Manager → 상단 Request Controller로 새 입력" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1342" y="2010" width="784.52" height="54.6" /></mxCell><mxCell id="e118" value="유리: 명시한 조건을 유지하며 필요한 관계만 갱신&lt;br&gt;대가: 변경 언어/의존성 설계; 표현 밖 뜻은 질문&lt;br&gt;선택: 여러 번 보완하고 조건을 이어가는 대화" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=23;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1327" y="2125" width="567.82" height="123" /></mxCell><mxCell id="e119" value="공통 마무리: Request Controller 현재 검사 → Task Manager → Agent Gateway → Downstream Agent" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=22;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="2270" width="1201.72" height="35.7" /></mxCell><mxCell id="e120" value="접수/결과 반환 → Response Manager → Interaction Manager의 실제 표시/음성. 미해결이면 실행 대신 질문." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=22;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="2310" width="1245.28" height="35.7" /></mxCell><mxCell id="e121" value="검정: 공통 / 파랑: A 고유 / 초록: B 고유. 실선: 요청/전달 / 점선: 결과. 네모: 이름 / 원통: 상태 / 육각형: 외부 의존." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="2370" width="1205.76" height="31.650000000000002" /></mxCell><mxCell id="e122" value="같은 이름의 반복 상자는 동일 Component. 비교 부분의 책임을 펼친 그림. 별도 process 표기가 없으면 논리 분해. 모델 가중치는 한 벌; 이익은 조건부 설계 가설, 미측정." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="2410" width="1644.66" height="31.650000000000002" /></mxCell></root></mxGraphModel></diagram></mxfile>

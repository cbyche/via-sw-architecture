=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="166" width="883.16" height="35.7" /></mxCell><mxCell id="e7" value="A  매번 완성 의미를 생성" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=30;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="285" width="389.6" height="46.5" /></mxCell><mxCell id="e9" value="입력: Interaction Manager의 새 발화. 새 업무/보완 여부도 해석 대상." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="94" y="340" width="752.4" height="33.0" /></mxCell><mxCell id="e12" value="관련 기록 조회" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="749" y="411" width="138.32" height="30.3" /></mxCell><mxCell id="e14" value="이전 의미/질문" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="749" y="478" width="138.32" height="30.3" /></mxCell><mxCell id="e19" value="1  원문 + 관련 기록/근거. 새 업무이면 기존 조건 미승계" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="129" y="563" width="524.24" height="30.3" /></mxCell><mxCell id="e21" value="2  목표/대상/조건/업무 관계의 완성안" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackg
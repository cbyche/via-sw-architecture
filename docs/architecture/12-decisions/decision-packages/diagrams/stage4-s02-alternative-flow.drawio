targetPoint" x="1280" y="2211" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e74" style="edgeStyle=none;rounded=0;strokeColor=#263445;strokeWidth=2;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1280" y="2285" /><mxPoint as="targetPoint" x="1280" y="2305" /><Array as="points"><mxPoint x="1325" y="2285" /><mxPoint x="1325" y="2305" /></Array></mxGeometry></mxCell><mxCell id="e77" style="edgeStyle=none;rounded=0;strokeColor=#C7D1DD;strokeWidth=2;endArrow=none;endFill=0;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="64" y="2604" /><mxPoint as="targetPoint" x="2496" y="2604" /><Array as="points" /></mxGeometry></mxCell><mxCell id="produce-actor3" value="공유 Omni&lt;br&gt;화면 분석" style="shape=hexagon;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=19;fontStyle=1;fillColor=#F7F9FC;strokeColor=#263445;fontColor=#263445;strokeWidth=1.7;" vertex="1" parent="1"><mxGeometry as="geometry" x="2225" y="320" width="230" height="104" /></mxCell><mxCell id="query-actor6" value="공유 Omni&lt;br&gt;의미 해석" style="shape=hexagon;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=19;fontStyle=1;fillColor=#F7F9FC;strokeColor=#263445;fontColor=#263445;strokeWidth=1.7;" vertex="1" parent="1"><mxGeometry as="geometry" x="2225" y="1168" width="230" height="104" /></mxCell><mxCell id="e2" value="VIA  /  ARCHITECTURE REVIEW" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=18;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="42" width="309.32" height="30.3" /></mxCell><mxCell id="e3" value="S-02 / A 실행  /  STAGE 04" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=18;fontStyle=1;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2206.48" y="42" width="289.52" height="30.3" /></mxCell><mxCell id="e4" value="A: 같은 화면 관측에서 추가 해석 자료를 생산한다" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=42;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="87" width="1040.36" height="62.7" /></mxCell><mxCell id="e5" value="생산 흐름과 요청 흐름은 병행한다. 준비된 정보가 없거나 불확실하면 원래 화면 기록을 조회한다. 두 흐름은 각각 1부터 읽는다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=23;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="151" width="1457.46" height="37.05" /></mxCell><mxCell id="e8" value="배경 생산 / Interaction Manager의 새 화면 기록 알림" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=26;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="88" y="258" width="755.24" height="41.1" /></mxCell><mxCell id="e18" value="1. 변경 알림과 허용된 화면 근거 참조 전달" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="232" y="446" width="439.6" height="33.0" /></mxCell><mxCell id="e20" value="2. 변경 범위, 현재 권한과 처리 예산 확인" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="982" y="524" width="432.0" height="33.0" /></mxCell><mxCell id="e22" value="3. 이미지 해석이 필요한 경우에만 분석 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="939" y="594" width="447.2" height="33.0" /></mxCell><mxCell id="e24" value="4. 항목 위치, 종류와 변경 관계 후보 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1645" y="668" width="432.0" height="33.0" /></mxCell><mxCell id="e26" value="5. 분석 후보 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1645" y="742" width="190.0" height="33.0" /></mxCell><mxCell id="e28" value="6. 분석 결과 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="939" y="816" width="190.0" height="33.0" /></mxCell><mxCell id="e30" value="7. 원래 화면과 캡처 시각 연결 → 검증 후 보관" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="982" y="894" width="476.8" height="33.0" /></mxCell><mxCell id="e31" value="앱의 구조 정보로 충분하면 모델 요청과 4~6을 생략한다. 발화 시작을 기다리지 않으며 단순 포인터 이동마다 모델을 호출하지 않는다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="88" y="983" width="1255.16" height="31.650000000000002" /></mxCell><mxCell id="e33" value="요청 처리 / 발화 당시 대상 정보가 필요한 입력" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=26;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="88" y="1106" width="621.08" height="41.1" /></mxCell><mxCell id="e49" value="1. 인식 문장, 입력 버전과 당시 근거 참조 전달" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="232" y="1294" width="484.4" height="33.0" /></mxCell><mxCell id="e51" value="2. 허용 근거 구성 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="939" y="1368" width="242.4" height="33.0" /></mxCell><mxCell id="e53" value="3. 발화 시간과 창, 문서에 맞는 대상 정보 조회" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="585" y="1442" width="484.4" height="33.0" /></mxCell><mxCell id="e55" value="4. 항목, 변경 관계, 분석 범위와 준비 상태 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="585" y="1516" width="496.8" height="33.0" /></mxCell><mxCell id="e57" value="5. 미준비, 불확실 또는 원래 이미지가 필요하면 당시 기록 조회" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="232" y="1590" width="636.8" height="33.0" /></mxCell><mxCell id="e59" value="6. 보관 범위의 화면과 조작 기록 반환 / 5를 생략하면 함께 생략" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="232" y="1664" width="654.0" height="33.0" /></mxCell><mxCell id="e61" value="7. 현재 원문과 권한 확인 후 Context 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="939" y="1738" width="446.4" height="33.0" /></mxCell><mxCell id="e63" value="8. 입력과 Context로 해석 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1292" y="1812" width="329.2" height="33.0" /></mxCell><mxCell id="e65" value="9. 발화의 대상 역할과 의도 해석 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1645" y="1886" width="387.2" height="33.0" /></mxCell><mxCell id="e67" value="10. 모델 입력 전달" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1999" y="1960" width="202.4" height="33.0" /></mxCell><mxCell id="e69" value="11. 해석 결과 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1999" y="2034" width="202.4" height="33.0" /></mxCell><mxCell id="e71" value="12. 결과 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1645" y="2108" width="150.0" height="33.0" /></mxCell><mxCell id="e73" value="13. 의미 제안 또는 확인 필요성 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1292" y="2182" width="379.6" height="33.0" /></mxCell><mxCell id="e75" value="14. 현재 입력과 근거 검증 → 확정 또는 보류" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1335" y="2260" width="456.8" height="33.0" /></mxCell><mxCell id="e76" value="추가 해석 자료는 사용자 의도를 확정하지 않는다. 생산 완료를 무한 대기하지 않으며 없는 과거는 확인 질문으로 처리한다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="88" y="2349" width="1151.04" height="31.650000000000002" /></mxCell><mxCell id="e78" value="색:  검정 = 공통     파랑 = T 전용     초록 = A/B 전용" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=19;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="2622" width="584.84" height="31.650000000000002" /></mxCell><mxCell id="e79" value="실선 → 요청/전달     점선 → 결과/복원" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=18;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2126.92" y="2622" width="369.08" height="30.3" /></mxCell><mxCell id="e80" value="모양:  제목 칸이 있는 박스 = Component   |   내부 둥근 박스 = Module   |   원통 = 저장소   |   접힌 종이 = 자료   |   육각형 = 연동 대상/모델" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=17;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="2660" width="1347.26" height="28.950000000000003" /></mxCell><mxCell id="e81" value="A는 보강 방향 미정인 후보로 유지한다. 조기 실행은 A만의 차이가 아니며, 추가 자료의 정확성과 시간 및 자원 이익은 미확인이다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=17;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="2700" width="1100.42" height="28.950000000000003" /></mxCell><mxCell id="e82" value="탐색안 / 미채택 / 미측정" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=17;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2271.76" y="2700" width="224.24" height="28.950000000000003" /></mxCell></root></mxGraphModel></diagram></mxfile>

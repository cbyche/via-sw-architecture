edgeStyle=none;rounded=0;strokeColor=#195FBD;strokeWidth=2;endArrow=open;endFill=0;dashed=1;exitX=1.0;exitY=0.7857142857142857;exitPerimeter=0;entryX=1.0;entryY=0.22413793103448276;entryPerimeter=0;"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint as="point" x="3758" y="1237.5" /><mxPoint as="point" x="3758" y="1698" /><mxPoint as="point" x="1794" y="1698" /><mxPoint as="point" x="1794" y="503" /><mxPoint as="point" x="1728" y="503" /><mxPoint as="point" x="1728" y="682.5" /></Array></mxGeometry></mxCell><mxCell id="note0" parent="1" vertex="1" value="VIA / DP-44 / 구현을 가정한 실행 구조" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=26;fontStyle=1;align=left;spacing=0;"><mxGeometry as="geometry" x="64" y="19" width="702" height="33.800000000000004" /></mxCell><mxCell id="note1" parent="1" vertex="1" value="문서 설계안 / A/B 미선정 / 제품 실행과 측정 없음" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=24;fontStyle=0;align=right;spacing=0;"><mxGeometry as="geometry" x="3032" y="21" width="744" height="31.200000000000003" /></mxCell><mxCell id="note2" parent="1" vertex="1" value="A: 중앙 Dispatcher가 완료를 회수하고 다음 실행을 지시" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=43;fontStyle=1;align=left;spacing=0;"><mxGeometry as="geometry" x="64" y="69" width="1548" height="55.9" /></mxCell><mxCell id="note3" parent="1" vertex="1" value="같은 기능과 공통 실행 기반. 차이는 완료의 수신자, 다음 실행의 결정 코드, Job과 대기 조건의 소유 위치다." style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=29;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="64" y="143" width="1827" height="37.7" /></mxCell><mxCell id="note4" parent="1" vertex="1" value="release" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=21;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="3630" y="444" width="147" height="27.3" /></mxCell><mxCell id="note5" parent="1" vertex="1" value="ActualReceipt" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=21;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="3550" y="759" width="273" height="27.3" /></mxCell><mxCell id="note6" parent="1" vertex="1" value="같은 정정: R1 rev1의 전체 요약 Job J1 실행 중 → “아니, 결론만” → R1 rev2 채택. J1은 취소 요청 뒤에도 늦게 완료할 수 있다." style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=27;fontStyle=1;align=left;spacing=0;"><mxGeometry as="geometry" x="64" y="1713" width="2322" height="35.1" /></mxCell><mxCell id="note7" parent="1" vertex="1" value="실행 가정: 공통 bounded async executor와 blocking worker pool. 각 Pump는 자기 상태를 순차 갱신하고 긴 Job을 기다리지 않는다." style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=25;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="64" y="2005" width="2375" height="32.5" /></mxCell><mxCell id="note8" parent="1" vertex="1" value="검정 실선 = 직접 호출 / dequeue    파랑 실선 = enqueue    파랑 점선 = 완료 callback의 enqueue    빨강 점선 = 제어 / 취소    회색 점선 = 상태 읽기와 갱신" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=23;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="64" y="2047" width="2622" height="29.900000000000002" /></mxCell><mxCell id="note9" parent="1" vertex="1" value="칸이 있는 박스 = queue    둥근 박스 = 코드    원통 = RAM 상태 또는 DURABLE 기록    접힌 문서 = immutable 메시지. Port는 typed 계약이며 queue와 구별한다." style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=23;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="64" y="2087" width="2645" height="29.900000000000002" /></mxCell><mxCell id="note10" parent="1" vertex="1" value="Context Manager, Policy Manager, State Store, Model Access 및 Agent Gateway의 공통 계약 유지. 별도 thread / process 수와 라이브러리는 미선정." style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=none;fontColor=#758294;fontSize=22;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="64" y="2123" width="2640" height="28.6" /></mxCell><mxCell id="note11" parent="1" vertex="1" value="A의 후속 실행 권한" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=28;fontStyle=1;align=left;spacing=0;"><mxGeometry as="geometry" x="2520" y="672" width="308" height="36.4" /></mxCell><mxCell id="note12" parent="1" vertex="1" value="완료와 조건은 중앙에 반환한다.&lt;br&gt;Response Composer는 Job을 실행하고&lt;br&gt;Publication Control은 최종 게시만 맡는다." style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=25;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="2520" y="725" width="800" height="97.5" /></mxCell><mxCell id="note13" parent="1" vertex="1" value="대기 / 정정 / 늦은 완료의 연결은&lt;br&gt;Dialogue Progress State와&lt;br&gt;Job Index를 갱신하는 중앙 코드에 있다." style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=25;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="2520" y="935" width="650" height="97.5" /></mxCell><mxCell id="note14" parent="1" vertex="1" value="InterpretAsync / cancel(handle)" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=21;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="645" y="1249" width="651" height="27.3" /></mxCell><mxCell id="note15" parent="1" vertex="1" value="JobDone: MeaningProposal" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=21;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="675" y="794" width="504" height="27.3" /></mxCell><mxCell id="note16" parent="1" vertex="1" value="Prepare Job" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=21;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="1750" y="584" width="231" height="27.3" /></mxCell><mxCell id="note17" parent="1" vertex="1" value="Cancel(J1)" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#B63732;fontSize=21;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="1810" y="774" width="210" height="27.3" /></mxCell><mxCell id="note18" parent="1" vertex="1" value="PublishRequest: 중앙이 지시" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=21;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="2700" y="484" width="462" height="27.3" /></mxCell><mxCell id="note19" parent="1" vertex="1" value="JobDone: candidate ref" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=21;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="2030" y="479" width="462" height="27.3" /></mxCell><mxCell id="note20" parent="1" vertex="1" value="확인된 TaskEvent" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=21;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="645" y="839" width="273" height="27.3" /></mxCell><mxCell id="note21" parent="1" vertex="1" value="InputReady" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=21;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="1190" y="464" width="210" height="27.3" /></mxCell><mxCell id="note22" parent="1" vertex="1" value="InputStarted" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#B63732;fontSize=21;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="670" y="454" width="252" height="27.3" /></mxCell><mxCell id="note23" parent="1" vertex="1" value="채택한 Invalidate / 관련 게시 hold" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#B63732;fontSize=21;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="2600" y="544" width="567" height="27.3" /></mxCell><mxCell id="note24" parent="1" vertex="1" value="durable Presented → 중앙 focus 갱신" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=21;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="2370" y="1687" width="651" height="27.3" /></mxCell></root></mxGraphModel></diagram></mxfile>

445;fontColor=#263445;strokeWidth=1.7;" vertex="1" parent="rm"><mxGeometry as="geometry" x="40" y="660" width="540" height="120" /></mxCell><mxCell id="outbox" value="Publication Outbox (내구 원본)&lt;br&gt;publication ID / 실제 전달 범위" style="shape=cylinder;size=14;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fillColor=#F7F9FC;strokeColor=#263445;fontColor=#263445;strokeWidth=1.7;" vertex="1" parent="rm"><mxGeometry as="geometry" x="40" y="800" width="540" height="105" /></mxCell><mxCell id="control_q" value="Control Lane (RAM)&lt;br&gt;onset / hold / invalidate&lt;br&gt;일반 event와 분리 수용" style="shape=cylinder;size=14;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fillColor=#F7F9FC;strokeColor=#263445;fontColor=#263445;strokeWidth=1.7;fillColor=#FFF0DD;strokeColor=#B8753F;" vertex="1" parent="rc"><mxGeometry as="geometry" x="40" y="90" width="280" height="125" /></mxCell><mxCell id="event_q" value="Event Mailbox (RAM)&lt;br&gt;Input / Task / JobDone&lt;br&gt;receipt / 우선순위 + seq" style="shape=cylinder;size=14;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fillColor=#F7F9FC;strokeColor=#263445;fontColor=#263445;strokeWidth=1.7;fillColor=#FFF0DD;strokeColor=#B8753F;" vertex="1" parent="rc"><mxGeometry as="geometry" x="360" y="90" width="280" height="125" /></mxCell><mxCell id="dispatcher" value="Dialogue Dispatcher&lt;br&gt;Pump → 짧은 Handle(event)&lt;br&gt;채택 / 유효성 / 다음 Job 지시" style="rounded=1;arcSize=15;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fillColor=#F7F9FC;strokeColor=#263445;fontColor=#263445;strokeWidth=1.7;fillColor=#FFF0DD;strokeColor=#B8753F;" vertex="1" parent="rc"><mxGeometry as="geometry" x="110" y="310" width="460" height="130" /></mxCell><mxCell id="progress" value="Dialogue Progress State&lt;br&gt;RAM / waiting IDs&lt;br&gt;후속 실행 / 후보 참조&lt;br&gt;확정 원본은 복제하지 않음" style="shape=cylinder;size=14;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fillColor=#F7F9FC;strokeColor=#263445;fontColor=#263445;strokeWidth=1.7;fillColor=#FFF0DD;strokeColor=#B8753F;" vertex="1" parent="rc"><mxGeometry as="geometry" x="40" y="615" width="280" height="190" /></mxCell><mxCell id="jobs" value="Job Index (RAM)&lt;br&gt;job ID / Request revision&lt;br&gt;source refs / cancel handle&lt;br&gt;RUNNING → terminal" style="shape=cylinder;size=14;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fillColor=#F7F9FC;strokeColor=#263445;fontColor=#263445;strokeWidth=1.7;fillColor=#FFF0DD;strokeColor=#B8753F;" vertex="1" parent="rc"><mxGeometry as="geometry" x="360" y="615" width="280" height="190" /></mxCell><mxCell id="candidate" value="Prepared Candidate (RAM)&lt;br&gt;내용 / 음성 / 시작 source refs&lt;br&gt;중앙에는 이 자료의 참조를 반환" style="shape=cylinder;size=14;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fillColor=#F7F9FC;strokeColor=#263445;fontColor=#263445;strokeWidth=1.7;" vertex="1" parent="rm"><mxGeometry as="geometry" x="40" y="290" width="540" height="140" /></mxCell><mxCell id="e2" value="VIA  /  ARCHITECTURE REVIEW" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=18;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="42" width="309.32" height="30.3" /></mxCell><mxCell id="e3" value="DP-44  /  STAGE 04" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=18;fontStyle=1;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2287.12" y="42" width="208.88" height="30.3" /></mxCell><mxCell id="e4" value="A 구현 구조&lt;br&gt;완료를 중앙에 반환하고 다음 작업을 지시" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=34;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="75" width="691.4" height="94" /></mxCell><mxCell id="e5" value="대기열 + 짧은 Dispatcher 루프 + 비동기 Job. priority queue의 순서와 실행 중 작업의 취소는 별도다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=22;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="166" width="1193.8" height="35.7" /></mxCell><mxCell id="e12" value="같은 Context Manager / 의미 API" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="114" y="593" width="336.68" height="30.3" /></mxCell><mxCell id="e23" value="capture / ASR는 계속 진행&lt;br&gt;전사 확정 ≠ 의미 해소&lt;br&gt;발화 감지 ≠ Task 취소&lt;br&gt;새 입력은 미전송 효과 hold" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=22;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2068" y="545" width="322.6" height="166" /></mxCell><mxCell id="e24" value="8 허용 release를 실제 전달&lt;br&gt;9 receipt는 전달 이후 생성" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2068" y="775" width="311.24" height="78" /></mxCell><mxCell id="e30" value="8 release" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1953" y="966" width="108.44" height="30.3" /></mxCell><mxCell id="e32" value="9" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1950" y="1143" width="20.4" height="33.0" /></mxCell><mxCell id="e33" value="State Store: 각 owner의 확정 기록 저장" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="1215" width="397.52" height="30.3" /></mxCell><mxCell id="e35" value="공통 실행 기반: bounded async executor + blocking worker pool. Module마다 전용 thread나 process를 두지 않는다.&lt;br&gt;짧은 제어 루프는 긴 API 작업을 기다리지 않는다. 취소는 먼저 결과를 무효화하고 provider에 중단을 요청한다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=23;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="1274" width="1482.76" height="84" /></mxCell><mxCell id="e36" value="직각 = Component  /  둥근 박스 = 코드 Module  /  원통 = Queue 또는 상태  /  살구색 = A/B 실행 조직의 차이" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="1365" width="1194.8" height="33.0" /></mxCell><mxCell id="e37" value="실선 → 요청 / 자료 전달    점선 → 완료 / 확정 사실 반환    번호는 본문 실행 표와 대응" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="1400" width="831.32" height="30.3" /></mxCell><mxCell id="e38" value="구현을 가정한 설계안 / 미선정 / 미측정" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=18;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2128.7200000000003" y="1400" width="367.28" height="30.3" /></mxCell><mxCell id="e46" value="1 onset / 제어 event" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="900" y="211" width="234.48" height="31.650000000000002" /></mxCell><mxCell id="e48" value="1 확정 Input" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1470" y="235" width="140.24" height="31.650000000000002" /></mxCell><mxCell id="e50" value="1 확인된 질문 / 결과 / 상태" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="112" y="805" width="270.44" height="30.3" /></mxCell><mxCell id="e53" value="2 우선 처리 / fairness" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="803" y="546" width="248.92" height="31.650000000000002" /></mxCell><mxCell id="e55" value="3 InterpretAsync 시작" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="620" y="750" width="246.26" height="31.650000000000002" /></mxCell><mxCell id="e57" value="4 JobDone → Mailbox" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="605" y="338" width="231.82" height="31.650000000000002" /></mxCell><mxCell id="e59" value="5 Prepare / cancel → / 6 JobDone ←" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1390" y="740" width="408.52" height="31.650000000000002" /></mxCell><mxCell id="e63" value="7 유효 후보의 게시 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1390" y="815" width="250.0" height="33.0" /></mxCell><mxCell id="e64" value="준비 완료만으로 재생하지 않음" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1390" y="858" width="320.06" height="34.35" /></mxCell><mxCell id="e67" value="짧은 루프에서 조회 / 갱신" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="729" y="840" width="243.8" height="30.3" /></mxCell><mxCell id="e69" value="채택한 취소 / 변경 명령" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="114" y="1040" width="225.8" height="30.3" /></mxCell><mxCell id="e71" value="10 내구 Presented → Request Controller 질문 focus" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="708" y="1223" width="537.56" height="30.3" /></mxCell></root></mxGraphModel></diagram></mxfile>

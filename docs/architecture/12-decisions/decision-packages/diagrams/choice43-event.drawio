648" y="1338" /><mxPoint as="targetPoint" x="1648" y="1358" /><Array as="points"><mxPoint x="1703" y="1338" /><mxPoint x="1703" y="1358" /></Array></mxGeometry></mxCell><mxCell id="e2" value="VIA / 43 / A 통합 판단 · C 기능별 판단" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=24;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="24" width="521.6" height="38.400000000000006" /></mxCell><mxCell id="e3" value="설계 후보 / 미선정 / 미측정" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=24;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2143.84" y="24" width="352.16" height="38.400000000000006" /></mxCell><mxCell id="e4" value="같은 정정: 누가 바꾸고, 무엇을 보존하며, 어디로 재판단을 돌리는가?" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=41;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="72" width="1420.04" height="61.35" /></mxCell><mxCell id="e5" value="이미 채택된 조건: 보고서 PDF / 메일에 보고서 결론. 새 입력: “메일에는 결론 대신 표만 넣어줘.”" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=28;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="140" width="1394.0" height="43.800000000000004" /></mxCell><mxCell id="e6" value="보고서·메일은 데이터 예시다. R/M 연결이나 표 대상이 모호하면 후보를 유지하고 추가 근거/확인을 요청한다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=25;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="184" width="1352.5" height="39.75" /></mxCell><mxCell id="e7" value="A  같은 결과, 다른 의미 생산 책임" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=32;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="250" width="570.56" height="49.2" /></mxCell><mxCell id="e9" value="Request&lt;br&gt;Controller" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=24;fontStyle=1;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="125.6" y="333" width="156.8" height="66" /></mxCell><mxCell id="e12" value="Integrated Semantic&lt;br&gt;Interpreter" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=24;fontStyle=1;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="508.64" y="333" width="290.72" height="66" /></mxCell><mxCell id="e15" value="Interpretation&lt;br&gt;Attempt State" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=24;fontStyle=1;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="995.84" y="333" width="216.32" height="66" /></mxCell><mxCell id="e17" value="1  새 원문 + 이전 의미 + Task 후보 + 표 근거" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=27;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="69" y="446" width="569.2" height="37.05" /></mxCell><mxCell id="e19" value="2  F1~F6 전체 제안: 메일 내용만 교체 / PDF 유지" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=27;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="69" y="586" width="606.46" height="37.05" /></mxCell><mxCell id="e21" value="현재 제안·근거 / 수정 이력 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=27;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="69" y="726" width="383.82" height="37.05" /></mxCell><mxCell id="e23" value="3  새 통합 의미와 근거 / 경쟁 후보가 있으면 미해결" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=27;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="69" y="866" width="616.12" height="37.05" /></mxCell><mxCell id="e25" value="4  현재 검사 → State Store 채택 → 공통 위임/응답" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=27;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="69" y="1006" width="626.24" height="37.05" /></mxCell><mxCell id="e27" value="5  뒤늦은 새 근거: 영향을 받은 의미만 재판단" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=27;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="69" y="1146" width="541.6" height="37.05" /></mxCell><mxCell id="e29" value="부분 수정 또는 새 전체 제안 / 필요한 확인 질문" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=27;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="69" y="1286" width="564.6" height="37.05" /></mxCell><mxCell id="e31" value="C  같은 결과, 다른 의미 생산 책임" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#7446A4;fontSize=32;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1306" y="250" width="570.56" height="49.2" /></mxCell><mxCell id="e33" value="Request&lt;br&gt;Controller" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#7446A4;fontSize=22;fontStyle=1;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1333.8" y="333" width="144.4" height="66" /></mxCell><mxCell id="e36" value="Interpretation&lt;br&gt;Coordinator" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#7446A4;fontSize=22;fontStyle=1;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1548.52" y="333" width="198.96" height="66" /></mxCell><mxCell id="e39" value="Referent&lt;br&gt;Resolver" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#7446A4;fontSize=22;fontStyle=1;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1831.44" y="333" width="117.12" height="66" /></mxCell><mxCell id="e42" value="Request Revision&lt;br&gt;Interpreter" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#7446A4;fontSize=22;fontStyle=1;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2018.88" y="333" width="226.24" height="66" /></mxCell><mxCell id="e45" value="Request Relation&lt;br&gt;Interpreter" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#7446A4;fontSize=22;fontStyle=1;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2260.88" y="333" width="226.24" height="66" /></mxCell><mxCell id="e47" value="1  같은 입력/근거 / F1 의도·F3 연결·F6 방향도 유효성 확인" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#7446A4;fontSize=27;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1311" y="446" width="721.46" height="37.05" /></mxCell><mxCell id="e49" value="2  F2: 표 후보 + 원문 + 관련 자료" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#7446A4;fontSize=27;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1311" y="531" width="428.9" height="37.05" /></mxCell><mxCell id="e51" value="표 참조의 새 제안 / 불명확하면 후보 유지" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#7446A4;fontSize=27;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1311" y="616" width="490.08" height="37.05" /></mxCell><mxCell id="e53" value="F5: 이전 의미 + F1/F3/F4/F2 참조 → 교체 범위 판단" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#7446A4;fontSize=27;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1311" y="701" width="640.5" height="37.05" /></mxCell><mxCell id="e55" value="메일 내용 조건 교체 / 보고서 PDF 조건 보존" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#7446A4;fontSize=27;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1311" y="786" width="524.12" height="37.05" /></mxCell><mxCell id="e57" value="F4: 새 표 참조 + F5 변경 → 의존 관계 갱신" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#7446A4;fontSize=27;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1311" y="871" width="526.42" height="37.05" /></mxCell><mxCell id="e59" value="결론 의존 제거 / 표 의존 생성" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#7446A4;fontSize=27;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1311" y="956" width="360.82" height="37.05" /></mxCell><mxCell id="e61" value="3  유효한 F1~F6 제안 참조를 결합해 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#7446A4;fontSize=27;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1311" y="1041" width="492.38" height="37.05" /></mxCell><mxCell id="e63" value="4  같은 현재 검사/채택. 필수 의미 미해결이면 보류" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#7446A4;fontSize=27;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1311" y="1126" width="601.86" height="37.05" /></mxCell><mxCell id="e65" value="5  새 근거로 대상 충돌: 원 생산자 F2에 재판단 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#7446A4;fontSize=27;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1311" y="1211" width="621.64" height="37.05" /></mxCell><mxCell id="e67" value="영향받은 F4/F5/F6 재판단 / 중앙에서 값 덮기 금지" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#7446A4;fontSize=27;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1311" y="1296" width="604.16" height="37.05" /></mxCell><mxCell id="e69" value="공통 예외와 경계" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=29;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="1450" width="246.96" height="45.150000000000006" /></mxCell><mxCell id="e70" value="새 입력은 관련 미전송 의도를 보류. 전송 후에는 실제 외부 접수/실행 확인 없이 취소 완료나 rollback을 주장하지 않는다.&lt;br&gt;철회/삭제: 관련 근거·전체/부분 제안·모델 Context/KV의 신규 사용을 차단. 이미 제공한 정보의 소급 회수는 보장하지 않는다.&lt;br&gt;실패/재시작: 내구 채택 기록과 외부 Task 사실을 복원. 임시 제안은 재검증/재계산하며 이전 명령을 중복 실행하지 않는다.&lt;br&gt;C의 F1/F3/F6과 원장은 메인에 표시. 이 보충 사건도는 정정으로 변하는 F2/F5/F4를 확대하며 고정 실행 순서를 뜻하지 않는다.&lt;br&gt;모든 의미 추론은 Model Access의 공유 Omni. 외부 업무 계획·도구 선택·실행은 Downstream Agent 책임." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=25;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="1500" width="1600.5" height="206" /></mxCell><mxCell id="e71" value="실선 = 요청/전달 · 점선 화살표 = 결과 반환. 메인 비교는 choice43-structure.svg. 두 안 모두 설계 후보이며 미측정." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=22;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="1730" width="1361.44" height="35.7" /></mxCell></root></mxGraphModel></diagram></mxfile>

;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=39;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="80" y="253" width="279.44" height="58.650000000000006" /></mxCell><mxCell id="e9" value="VIA Core process" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=28;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="120" y="385" width="285.76" height="43.800000000000004" /></mxCell><mxCell id="e14" value="같은 VIA 업무 계약" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=25;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="480" y="522" width="251.0" height="39.75" /></mxCell><mxCell id="e15" value="대화 코드 유지 가능" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=29;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="130" y="747" width="293.94" height="45.150000000000006" /></mxCell><mxCell id="e16" value="연동·수신 경로 변경" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=29;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="680" y="747" width="293.94" height="45.150000000000006" /></mxCell><mxCell id="e17" value="일반 protocol 변경은 양안 모두 국소화 가능" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=29;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="880" width="665.72" height="45.150000000000006" /></mxCell><mxCell id="e18" value="차이가 남는 조건" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=28;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="950" width="238.72" height="43.800000000000004" /></mxCell><mxCell id="e19" value="Core process 재시작이 필요한 갱신이면&lt;br&gt;대화 owner와 업무 owner가 함께 멈춤.&lt;br&gt;worker·동적 교체로 줄이는 혼합안도 검토." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=29;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="1000" width="629.76" height="150" /></mxCell><mxCell id="e20" value="B  독립 서비스" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=39;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1330" y="253" width="299.72" height="58.650000000000006" /></mxCell><mxCell id="e23" value="대화 서비스 process" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=28;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1370" y="385" width="304.24" height="43.800000000000004" /></mxCell><mxCell id="e24" value="업무 서비스 process" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=28;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1910" y="385" width="304.24" height="43.800000000000004" /></mxCell><mxCell id="e29" value="같은 VIA 업무 계약" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=25;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1730" y="522" width="251.0" height="39.75" /></mxCell><mxCell id="e30" value="대화 코드 유지 가능" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=29;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1380" y="747" width="293.94" height="45.150000000000006" /></mxCell><mxCell id="e31" value="연동·수신 경로 변경" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=29;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1930" y="747" width="293.94" height="45.150000000000006" /></mxCell><mxCell id="e32" value="일반 protocol 변경은 양안 모두 국소화 가능" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=29;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1350" y="880" width="665.72" height="45.150000000000006" /></mxCell><mxCell id="e33" value="차이가 남는 조건" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=28;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1350" y="950" width="238.72" height="43.800000000000004" /></mxCell><mxCell id="e34" value="공개 계약이 호환되면 업무 서비스만 갱신.&lt;br&gt;대화 서비스는 유지하며 업무 요청은 보류 가능.&lt;br&gt;새 승인 의미 등 계약 변화는 양쪽으로 전파." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=29;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1350" y="1000" width="684.86" height="150" /></mxCell><mxCell id="e35" value="V-08  변경 범위 감소는 조건부  /  독립 갱신의 이익을 변경 요소 수 우위로 바꾸어 말하지 않는다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=30;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="80" y="1234" width="1504.4" height="46.5" /></mxCell><mxCell id="e37" value="검정: 공통  ·  파랑: A  ·  초록: B     실선: 요청·변경  /  점선 화살표: 반환·조회 결과" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=28;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="1360" width="1096.36" height="37.05" /></mxCell><mxCell id="e38" value="검정: 유지하는 기능·계약 / 색: 각 안의 실행 경계와 변경 대상. 색은 우열이나 측정 점수가 아님" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=21;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1471.6" y="1399" width="1024.4" height="34.35" /></mxCell></root></mxGraphModel></diagram></mxfile>

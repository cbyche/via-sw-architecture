ontSize=18;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="42" width="309.32" height="30.3" /></mxCell><mxCell id="e3" value="S-05 / 실행 순서  /  STAGE 04" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=18;fontStyle=1;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2181.64" y="42" width="314.36" height="30.3" /></mxCell><mxCell id="e4" value="음성을 허가 전에 준비할 것인가, 허가한 Text에서 만들 것인가" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=42;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="87" width="1312.52" height="62.7" /></mxCell><mxCell id="e5" value="공통 음성 수집과 정규 인식 뒤의 비교. 직접 경로의 음성은 허가 전까지 사용자에게 들리지 않는다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=23;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="151" width="1133.16" height="37.05" /></mxCell><mxCell id="e8" value="T의 직접 응답 / 자체 지식 질문이며 현재 입력 검사를 통과한 경우" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=26;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="88" y="258" width="867.56" height="41.1" /></mxCell><mxCell id="e17" value="직접 경로에서 호출 없음" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=18;fontStyle=0;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1805.26" y="352" width="221.48" height="30.3" /></mxCell><mxCell id="e21" value="1. 원음 전달 → 직접 음성 후보 준비 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="232" y="446" width="424.4" height="33.0" /></mxCell><mxCell id="e23" value="2. 공유 Omni에 직접 음성 후보 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="656" y="520" width="376.8" height="33.0" /></mxCell><mxCell id="e25" value="3. 후보와 보류 음성 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="656" y="594" width="262.4" height="33.0" /></mxCell><mxCell id="e27" value="4. 후보와 보류 실행 ID 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="232" y="668" width="299.6" height="33.0" /></mxCell><mxCell id="e29" value="5. 정규 문장, 입력 버전과 후보 전달" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="232" y="742" width="379.6" height="33.0" /></mxCell><mxCell id="e31" value="6. 문장 일치, 자료와 업무 의존성 검사" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1547" y="820" width="399.6" height="33.0" /></mxCell><mxCell id="e33" value="7. 직접 응답 게시 허용" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1504" y="890" width="242.4" height="33.0" /></mxCell><mxCell id="e35" value="8. 해당 Text 게시와 보류 음성 재생 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="232" y="964" width="429.2" height="33.0" /></mxCell><mxCell id="e37" value="9. 실제 표시와 들린 범위 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="232" y="1038" width="314.8" height="33.0" /></mxCell><mxCell id="e38" value="6이 불분명하면 같은 Request를 아래 일반 경로로 보낸다. 허용 전 재생은 금지한다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="88" y="1131" width="806.38" height="31.650000000000002" /></mxCell><mxCell id="e40" value="T의 일반 경로와 A의 모든 요청 / 직접 후보를 사용하지 않는 경우" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=26;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="88" y="1254" width="857.68" height="41.1" /></mxCell><mxCell id="e54" value="1. 확정 입력과 기본 Context 해석 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1504" y="1442" width="414.0" height="33.0" /></mxCell><mxCell id="e56" value="2. 의미 해석 모델 호출 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="656" y="1516" width="294.8" height="33.0" /></mxCell><mxCell id="e58" value="3. 공유 Omni에 의미 해석 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="656" y="1590" width="324.4" height="33.0" /></mxCell><mxCell id="e60" value="4. 해석 결과 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="656" y="1664" width="190.0" height="33.0" /></mxCell><mxCell id="e62" value="5. 모델 결과 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="656" y="1738" width="190.0" height="33.0" /></mxCell><mxCell id="e64" value="6. 의미와 답변 제안 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1504" y="1812" width="262.4" height="33.0" /></mxCell><mxCell id="e66" value="7. 현재 입력을 확인해 Text 게시 허용" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1504" y="1886" width="396.8" height="33.0" /></mxCell><mxCell id="e68" value="8. 허용된 Text 표시 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="232" y="1960" width="272.0" height="33.0" /></mxCell><mxCell id="e70" value="9. 허용된 Text의 음성 생성 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="656" y="2034" width="344.4" height="33.0" /></mxCell><mxCell id="e72" value="10. 공유 Omni에 음성 생성 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="656" y="2108" width="336.8" height="33.0" /></mxCell><mxCell id="e74" value="11. 음성 결과 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="656" y="2182" width="202.4" height="33.0" /></mxCell><mxCell id="e76" value="12. 음성 결과 반환 / 문장 대응 검사" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="656" y="2256" width="384.4" height="33.0" /></mxCell><mxCell id="e78" value="13. 검사한 음성 재생 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="232" y="2330" width="274.8" height="33.0" /></mxCell><mxCell id="e80" value="14. 실제 들린 범위 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="232" y="2404" width="254.8" height="33.0" /></mxCell><mxCell id="e81" value="승인된 Text는 조건이 맞으면 음성 생성을 기다리지 않고 게시한다. A에는 직접 S2S 기능이 없다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="88" y="2497" width="924.94" height="31.650000000000002" /></mxCell><mxCell id="e83" value="색:  검정 = 공통     파랑 = T 전용     초록 = A/B 전용" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=19;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="2872" width="584.84" height="31.650000000000002" /></mxCell><mxCell id="e84" value="실선 → 요청/전달     점선 → 결과/복원" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=18;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2126.92" y="2872" width="369.08" height="30.3" /></mxCell><mxCell id="e85" value="모양:  제목 칸이 있는 박스 = Component   |   내부 둥근 박스 = Module   |   원통 = 저장소   |   접힌 종이 = 자료   |   육각형 = 연동 대상/모델" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=17;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="2910" width="1347.26" height="28.950000000000003" /></mxCell><mxCell id="e86" value="S2S 직접 경로는 이번 발화만을 보는 제한 기능이다. 일반 경로는 자료 기반 답변과 업무 위임을 계속 지원한다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=17;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="2950" width="943.34" height="28.950000000000003" /></mxCell><mxCell id="e87" value="탐색안 / 미채택 / 미측정" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=17;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2271.76" y="2950" width="224.24" height="28.950000000000003" /></mxCell></root></mxGraphModel></diagram></mxfile>

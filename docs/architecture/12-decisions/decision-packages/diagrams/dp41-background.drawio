<mxfile host="app.diagrams.net" type="device"><diagram id="dp41-background" name="04-41 요청 의미 해결 제어"><mxGraphModel dx="1920" dy="1080" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n1" parent="1" vertex="1" value="" style="fontFamily=Apple SD Gothic Neo;rounded=0;fillColor=white;strokeColor=none;strokeWidth=1.7;"><mxGeometry as="geometry" x="0" y="0" width="1920" height="1080" /></mxCell><mxCell id="n2" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;VIA SOFTWARE ARCHITECTURE / DP 배경&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=20;fontColor=#087E8B;fontStyle=1;"><mxGeometry as="geometry" x="64" y="25" width="1250" height="26.0" /></mxCell><mxCell id="n3" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;04-41&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=right;verticalAlign=top;spacing=0;fontSize=20;fontColor=#5F6B77;fontStyle=0;"><mxGeometry as="geometry" x="1576" y="25" width="280" height="26.0" /></mxCell><mxCell id="n4" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;04-41. 요청 의미 해결 제어&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=46;fontColor=#18232E;fontStyle=1;"><mxGeometry as="geometry" x="64" y="65" width="1780" height="59.800000000000004" /></mxCell><mxCell id="n5" parent="1" edge="1" style="fontFamily=Apple SD Gothic Neo;edgeStyle=none;rounded=0;strokeColor=#CDD6DE;strokeWidth=2;endArrow=none;endFill=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="64" y="127" /><mxPoint as="targetPoint" x="1856" y="127" /><Array as="points" /></mxGeometry></mxCell><mxCell id="n6" parent="1" vertex="1" value="" style="fontFamily=Apple SD Gothic Neo;rounded=0;fillColor=#FFF4A8;strokeColor=none;strokeWidth=1.7;"><mxGeometry as="geometry" x="64" y="151" width="1792" height="52" /></mxCell><mxCell id="n7" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;사용자의 말만으로는 실제 대상과 업무를 확정할 수 없다&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=31;fontColor=#18232E;fontStyle=1;"><mxGeometry as="geometry" x="82" y="158" width="1756" height="40.300000000000004" /></mxCell><mxCell id="n8" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;VIA는 화면·대화·업무 근거를 조회해 요청을 정리하고, 실제 업무 수행은 Downstream Agent에 위임한다.&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=25;fontColor=#5F6B77;fontStyle=0;"><mxGeometry as="geometry" x="64" y="220" width="1792" height="32.5" /></mxCell><mxCell id="n9" parent="1" edge="1" style="fontFamily=Apple SD Gothic Neo;edgeStyle=none;rounded=0;strokeColor=#CDD6DE;strokeWidth=2;endArrow=none;endFill=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1213" y="285" /><mxPoint as="targetPoint" x="1213" y="852" /><Array as="points" /></mxGeometry></mxCell><mxCell id="n10" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;구조 설계에서 어려운 점&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=29;fontColor=#18232E;fontStyle=1;"><mxGeometry as="geometry" x="1260" y="291" width="596" height="37.7" /></mxCell><mxCell id="n11" parent="1" edge="1" style="fontFamily=Apple SD Gothic Neo;edgeStyle=none;rounded=0;strokeColor=#2858A5;strokeWidth=2;endArrow=none;endFill=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="64" y="875" /><mxPoint as="targetPoint" x="1856" y="875" /><Array as="points" /></mxGeometry></mxCell><mxCell id="n12" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;설계 과제&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=28;fontColor=#B63732;fontStyle=1;"><mxGeometry as="geometry" x="64" y="906" width="165" height="36.4" /></mxCell><mxCell id="n13" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;다음 조회와 최종 대상·Task 결합을 누가 결정할 것인가?&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=30;fontColor=#18232E;fontStyle=1;"><mxGeometry as="geometry" x="240" y="901" width="1616" height="39.0" /></mxCell><mxCell id="n14" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;A 모델 중심 ReAct / B 모델의 요청 틀을 코드가 해결&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=24;fontColor=#2858A5;fontStyle=0;"><mxGeometry as="geometry" x="240" y="949" width="1616" height="31.200000000000003" /></mxCell><mxCell id="n15" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;품질 쟁점: 정확성·기능 지원 범위와 조회/해석 왕복 시간&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=20;fontColor=#5F6B77;fontStyle=0;"><mxGeometry as="geometry" x="64" y="1018" width="1260" height="26.0" /></mxCell><mxCell id="n16" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;구조 후보 / 미선정 / 미측정&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=right;verticalAlign=top;spacing=0;fontSize=20;fontColor=#5F6B77;fontStyle=0;"><mxGeometry as="geometry" x="1376" y="1018" width="480" height="26.0" /></mxCell><mxCell id="n17" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;“이 표를 아까 보고서에 넣고, 메일은 초안만 만들어.”&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=29;fontColor=#18232E;fontStyle=1;"><mxGeometry as="geometry" x="64" y="288" width="1120" height="37.7" /></mxCell><mxCell id="n18" parent="1" vertex="1" value="" style="fontFamily=Apple SD Gothic Neo;shape=note;size=18;fillColor=#F2F6FA;strokeColor=#CDD6DE;strokeWidth=1.7;"><mxGeometry as="geometry" x="64" y="347" width="510" height="97" /></mxCell><mxCell id="n19" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;화면 근거: 사용자가 가리킨 표&lt;br&gt;업무 근거: 보고서 Task가 두 개&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=25;fontColor=#18232E;fontStyle=0;"><mxGeometry as="geometry" x="80" y="360" width="470" height="65.0" /></mxCell><mxCell id="n20" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;대상·업무는 아직 미확정&lt;br&gt;‘초안만’ 조건도 함께 보존&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=25;fontColor=#B63732;fontStyle=0;"><mxGeometry as="geometry" x="665" y="359" width="475" height="65.0" /></mxCell><mxCell id="n21" parent="1" vertex="1" value="" style="fontFamily=Apple SD Gothic Neo;rounded=0;fillColor=white;strokeColor=#18232E;strokeWidth=1.7;"><mxGeometry as="geometry" x="180" y="491" width="370" height="72" /></mxCell><mxCell id="n22" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3000000000000003;&quot;&gt;Request Interpreter&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=center;verticalAlign=top;spacing=0;fontSize=26;fontColor=#18232E;fontStyle=1;"><mxGeometry as="geometry" x="188.0" y="510.0" width="354" height="33.800000000000004" /></mxCell><mxCell id="n23" parent="1" vertex="1" value="" style="fontFamily=Apple SD Gothic Neo;rounded=0;fillColor=white;strokeColor=#18232E;strokeWidth=1.7;"><mxGeometry as="geometry" x="767" y="491" width="370" height="72" /></mxCell><mxCell id="n24" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3000000000000003;&quot;&gt;Context Manager&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=center;verticalAlign=top;spacing=0;fontSize=26;fontColor=#18232E;fontStyle=1;"><mxGeometry as="geometry" x="775.0" y="510.0" width="354" height="33.800000000000004" /></mxCell><mxCell id="n25" parent="1" vertex="1" value="" style="fontFamily=Apple SD Gothic Neo;rounded=0;fillColor=white;strokeColor=#18232E;strokeWidth=1.7;"><mxGeometry as="geometry" x="767" y="708" width="370" height="72" /></mxCell><mxCell id="n26" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3000000000000003;&quot;&gt;Task Manager&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=center;verticalAlign=top;spacing=0;fontSize=26;fontColor=#18232E;fontStyle=1;"><mxGeometry as="geometry" x="775.0" y="727.0" width="354" height="33.800000000000004" /></mxCell><mxCell id="n27" parent="1" edge="1" style="fontFamily=Apple SD Gothic Neo;edgeStyle=none;rounded=0;strokeColor=#5F6B77;strokeWidth=2;endArrow=open;endFill=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourceP
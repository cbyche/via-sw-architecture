lor=#2858A5;fontStyle=0;"><mxGeometry as="geometry" x="552" y="573" width="225" height="27.3" /></mxCell><mxCell id="n34" parent="1" edge="1" style="fontFamily=Apple SD Gothic Neo;edgeStyle=none;rounded=0;strokeColor=#18232E;strokeWidth=2;endArrow=open;endFill=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="490" y="563" /><mxPoint as="targetPoint" x="767" y="734" /><Array as="points"><mxPoint x="490" y="734" /></Array></mxGeometry></mxCell><mxCell id="n35" parent="1" vertex="1" value="" style="fontFamily=Apple SD Gothic Neo;rounded=0;fillColor=white;strokeColor=none;strokeWidth=1.7;"><mxGeometry as="geometry" x="495" y="690" width="260" height="31.3" /></mxCell><mxCell id="n36" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;3 기존 업무 후보 조회&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=21;fontColor=#18232E;fontStyle=0;"><mxGeometry as="geometry" x="500" y="692" width="250" height="27.3" /></mxCell><mxCell id="n37" parent="1" edge="1" style="fontFamily=Apple SD Gothic Neo;edgeStyle=none;rounded=0;strokeColor=#2858A5;strokeWidth=2;endArrow=open;endFill=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="767" y="764" /><mxPoint as="targetPoint" x="420" y="563" /><Array as="points"><mxPoint x="420" y="764" /></Array></mxGeometry></mxCell><mxCell id="n38" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3000000000000003;&quot;&gt;해석이 조회 범위를 정하고&lt;br&gt;조회 결과가 해석을 바꾼다&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=26;fontColor=#2858A5;fontStyle=1;"><mxGeometry as="geometry" x="70" y="646" width="365" height="67.60000000000001" /></mxCell><mxCell id="n39" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;완성 의미도 현재 입력·자료·질문·권한 검사 후 채택한다.&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=25;fontColor=#5F6B77;fontStyle=0;"><mxGeometry as="geometry" x="64" y="809" width="1120" height="32.5" /></mxCell><mxCell id="n40" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;해석·조회 의존을 보여주는 도식이며, 두 안의 호출 구조는 설계 페이지에서 비교한다.&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=20;fontColor=#5F6B77;fontStyle=0;"><mxGeometry as="geometry" x="64" y="846" width="1120" height="26.0" /></mxCell><mxCell id="n41" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;01  해석과 조회의 상호 의존&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=28;fontColor=#2858A5;fontStyle=1;"><mxGeometry as="geometry" x="1260" y="364" width="596" height="36.4" /></mxCell><mxCell id="n42" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;읽기 전에 필요한 자료를&lt;br&gt;전부 정하기 어렵다.&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=25;fontColor=#18232E;fontStyle=0;"><mxGeometry as="geometry" x="1260" y="411" width="596" height="70" /></mxCell><mxCell id="n43" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;02  잘못된 결합의 실제 피해&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=28;fontColor=#2858A5;fontStyle=1;"><mxGeometry as="geometry" x="1260" y="515" width="596" height="36.4" /></mxCell><mxCell id="n44" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;다른 표나 Task를 고르면&lt;br&gt;Agent에 다른 일을 시킨다.&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=25;fontColor=#18232E;fontStyle=0;"><mxGeometry as="geometry" x="1260" y="562" width="596" height="70" /></mxCell><mxCell id="n45" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;03  통제와 표현 범위의 긴장&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=28;fontColor=#2858A5;fontStyle=1;"><mxGeometry as="geometry" x="1260" y="666" width="596" height="36.4" /></mxCell><mxCell id="n46" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;모델 반복에는 범위·종료 통제,&lt;br&gt;코드 해결에는 표현 한계가 따른다.&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=25;fontColor=#18232E;fontStyle=0;"><mxGeometry as="geometry" x="1260" y="713" width="596" height="70" /></mxCell></root></mxGraphModel></diagram></mxfile>

ent="1"><mxGeometry as="geometry" x="120" y="564" width="185.48" height="30.3" /></mxCell><mxCell id="e31" value="Context Manager 내부" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5E6D80;fontSize=16;fontFamily=Arial;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="499.28" y="565" width="198.72" height="27.6" /></mxCell><mxCell id="e35" value="① 이름, 기간, Task 단서" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=18;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="504" y="512" width="238.76" height="30.3" /></mxCell><mxCell id="e37" value="② 기존 후보 조회" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#233247;fontSize=18;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="426" y="745" width="160.64" height="30.3" /></mxCell><mxCell id="e40" value="별도 embedding model 없음&lt;br&gt;별도 의미 색인 generation 없음" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5E6D80;fontSize=21;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="112" y="1070" width="358.28" height="62.7" /></mxCell><mxCell id="e43" value="DESIGN FOCUS  /  원문 검증" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=18;fontFamily=Arial;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="89" y="1219" width="280.88" height="30.3" /></mxCell><mxCell id="e44" value="후보 발견 → 원본 읽기 → Context Manager의 identity와 권한 확인&
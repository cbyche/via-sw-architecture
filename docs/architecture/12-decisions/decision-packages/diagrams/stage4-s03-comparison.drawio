al;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1719" y="717" width="66.32" height="30.3" /></mxCell><mxCell id="e82" value="③ 게시" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=16;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1634" y="768" width="59.84" height="27.6" /></mxCell><mxCell id="e84" value="① 변경과 삭제 수집" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=18;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1772" y="1015" width="178.64" height="30.3" /></mxCell><mxCell id="e91" value="② embedding 생성" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=17;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1356" y="952" width="168.48" height="28.950000000000003" /></mxCell><mxCell id="e94" value="DESIGN FOCUS  /  색인 수명과 권위 분리" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=18;fontFamily=Arial;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1337" y="1219" width="393.2" height="30.3" /></mxCell><mxCell id="e95" value="Indexing Worker → Embedding Runtime → 완성 generation 원자 게시&lt;br&gt;검색 후보는 권위 원본이 아니다. ⑧~⑩ 현재 원문을 다시 읽어 검증한다.&lt;br&gt;삭제와 철회는 검색, 늦은 색인 작업과 파생 저장까지 전파한다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#233247;fontSize=22;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1337" y="1257" width="835.64" height="105" /></mxCell><mxCell id="e96" value="추가 helper의 weights, 갱신과 재구축 비용. cold start에는 기존 조회 경로를 유지한다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#956016;fontSize=18;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1337" y="1369" width="841.76" height="30.3" /></mxCell><mxCell id="e98" value="범례" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5E6D80;fontSize=17;fontFamily=Arial;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="1552" width="42.0" height="28.950000000000003" /></mxCell><mxCell id="e100" value="호출 / 전달" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5E6D80;fontSize=17;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="190" y="1551" width="107.62" height="28.950000000000003" /></mxCell><mxCell id="e102" value="결과 / 복원" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5E6D80;fontSize=17;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="405" y="1551" width="107.62" height="28.950000000000003" /></mxCell><mxCell id="e104" value="구조 차이 또는 확대 대상" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5E6D80;fontSize=17;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="597" y="1551" width="220.16" height="28.950000000000003" /></mxCell><mxCell id="e105" value="외부 책임 경계 ≠ 원격 배치  |  모델은 on-device 의존성" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5E6D80;fontSize=17;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1020" y="1551" width="511.88" height="28.950000000000003" /></mxCell><mxCell id="e106" value="확대 영역은 논리 서브시스템이다. 별도 서버 배포를 뜻하지 않으며, 검색 결과 1위도 실행 권한이 아니다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5E6D80;fontSize=18;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="1597" width="946.88" height="30.3" /></mxCell><mxCell id="e107" value="설계 탐색  /  미채택 대안  /  미측정" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5E6D80;fontSize=17;fontFamily=Arial;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2157.52" y="1598" width="338.48" height="28.950000000000003" /></mxCell></root></mxGraphModel></diagram></mxfile>

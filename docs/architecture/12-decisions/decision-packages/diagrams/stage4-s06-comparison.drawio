keColor=#263445;fontColor=#263445;strokeWidth=1.7;" vertex="1" parent="0-ma"><mxGeometry as="geometry" x="624" y="222" width="448" height="76" /></mxCell><mxCell id="0-omni" value="Omni Adapter&lt;br&gt;음성/의미 역할별 모델 호출" style="rounded=1;arcSize=15;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fillColor=#F7F9FC;strokeColor=#263445;fontColor=#263445;strokeWidth=1.7;" vertex="1" parent="0-ma"><mxGeometry as="geometry" x="624" y="382" width="448" height="93" /></mxCell><mxCell id="0-asrmodel" value="Streaming ASR 모델" style="shape=hexagon;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fillColor=#EEF4FF;strokeColor=#195FBD;fontColor=#195FBD;strokeWidth=1.7;" vertex="1" parent="1"><mxGeometry as="geometry" x="118" y="2010" width="456" height="88" /></mxCell><mxCell id="0-omnimodel" value="공유 Omni 모델 / 한 벌" style="shape=hexagon;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fillColor=#F7F9FC;strokeColor=#263445;fontColor=#263445;strokeWidth=1.7;" vertex="1" parent="1"><mxGeometry as="geometry" x="689" y="2010" width="505" height="88" /></mxCell><mxCell id="1-capture" value="원음 수집 / 즉시 재생 중단" style="rounded=1;arcSize=15;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fillColor=#F7F9FC;strokeColor=#263445;fontColor=#263445;strokeWidth=1.7;" vertex="1" parent="1-im"><mxGeometry as="geometry" x="32" y="114" width="414" height="63" /></mxCell><mxCell id="1-normalize" value="전사와 시간 근거를 입력에 연결" style="rounded=1;arcSize=15;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fillColor=#F7F9FC;strokeColor=#263445;fontColor=#263445;strokeWidth=1.7;" vertex="1" parent="1-im"><mxGeometry as="geometry" x="660" y="114" width="432" height="63" /></mxCell><mxCell id="1-record" value="정규 입력 기록 + 누락 구간" style="shape=note;size=20;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fillColor=#F7F9FC;stro
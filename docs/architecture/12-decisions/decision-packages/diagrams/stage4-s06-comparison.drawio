 y="114" width="432" height="63" /></mxCell><mxCell id="1-record" value="정규 입력 기록 + 누락 구간" style="shape=note;size=20;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fillColor=#F7F9FC;strokeColor=#263445;fontColor=#263445;strokeWidth=1.7;" vertex="1" parent="1-im"><mxGeometry as="geometry" x="660" y="213" width="432" height="65" /></mxCell><mxCell id="1-scheduler" value="공유 작업 대기열과 실행 배분" style="rounded=1;arcSize=15;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fillColor=#F7F9FC;strokeColor=#263445;fontColor=#263445;strokeWidth=1.7;" vertex="1" parent="1-ma"><mxGeometry as="geometry" x="624" y="222" width="448" height="76" /></mxCell><mxCell id="1-omni" value="Omni Adapter&lt;br&gt;음성/의미 역할별 모델 호출" style="rounded=1;arcSize=15;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fillColor=#F7F9FC;strokeColor=#263445;fontColor=#263445;strokeWidth=1.7;" vertex="1" parent="1-ma"><mxGeometry as="geometry" x="624" y="382" width="448" height="93" /></mxCell><mxCell id="1-native" value="Native Evidence Adapter&lt;br&gt;전사, 시각과 수정 알림 변환" style="rounded=1;arcSize=15;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fillColor=#EDF9F2;strokeColor=#087A53;fontColor=#087A53;strokeWidth=1.7;" vertex="1" parent="1-ma"><mxGeometry as="geometry" x="624" y="593" width="448" height="100" /></mxCell><mxCell id="1-omnimodel" value="공유 Omni 모델 / 한 벌" style="shape=hexagon;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fillColor=#F7F9FC;strokeColor=#263445;fontColor=#263445;strokeWidth=1.7;" vertex="1" parent="1"><mxGeometry as="geometry" x="1937" y="1790" width="505" height="88" /></mxCell><mxCell id="e2" value="VIA  /  ARCHITECTURE REVIEW" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=18;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="42" width="309.32" height="30.3" /></mxCell><mxCell id="e3" value="S-06  /  STAGE 04" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=18;fontStyle=1;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2298.28" y="42" width="197.72" height="30.3" /></mxCell><mxCell id="e4" value="인식 전용 실행을 둘 것인가, 공유 모델에서 인식까지 수행할 것인가?" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=42;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="87" width="1428.44" height="62.7" /></mxCell><mxCell id="e5" value="A의 인식 책임은 사라지지 않는다. Omni의 음성 실행과 새 결과 변환 모듈로 옮겨가며 같은 추론 자원과 장애에 의존한다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=23;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="151" width="1385.24" height="37.05" /></mxCell><mxCell id="e8" value="T" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=white;fontSize=27;fontStyle=1;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="75.63" y="244" width="24.74" height="42.45" /></mxCell><mxCell id="e9" value="독립 ASR 인식 + 공유 Omni" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=28;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="132" y="236" width="401.68" height="43.800000000000004" /></mxCell><mxCell id="e10" value="실제 target / 인식 실행과 모델을 따로 유지" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="132" y="276" width="416.24" height="30.3" /></mxCell><mxCell id="e12" value="VIA SOFTWARE" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=18;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="86" y="351" width="141.92" height="30.3" /></mxCell><mxCell id="e13" value="비교에 필요한 책임만 표시" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=16;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1012.24" y="353" width="213.76" height="27.6" /></mxCell><mxCell id="e21" value="Speech Input Worker" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=18;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="140" y="985" width="220.04" height="30.3" /></mxCell><mxCell id="e22" value="독립 process" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=16;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="432.64" y="987" width="119.36" height="27.6" /></mxCell><mxCell id="e24" value="Shared Inference Service" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=18;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="711" y="985" width="275.84" height="30.3" /></mxCell><mxCell id="e25" value="공유 추론 process" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=16;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1010.72" y="987" width="161.28" height="27.6" /></mxCell><mxCell id="e30" value="① 같은 원음" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="136" y="759" width="113.48" height="30.3" /></mxCell><mxCell id="e33" value="전사와 시각" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="148" y="1370" width="109.16" height="30.3" /></mxCell><mxCell id="e35" value="③ 인식 근거 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="397" y="713" width="160.64" height="30.3" /></mxCell><mxCell id="e41" value="② 원음" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="703" y="770" width="66.32" height="30.3" /></mxCell><mxCell id="e42" value="Omni는 음성 응답과 의미 해석을 담당&lt;br&gt;ASR와 중요한 결과 충돌은 보존" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="729" y="1450" width="379.6" height="60.0" /></mxCell><mxCell id="e44" value="④ 해석 결과" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="977" y="713" width="113.48" height="30.3" /></mxCell><mxCell id="e53" value="Omni가 멈췄을 때의 실제 차이" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=21;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="88" y="1967" width="322.16" height="34.35" /></mxCell><mxCell id="e54" value="T: 녹음은 계속되고 독립 ASR는 인식 근거를 계속 만들 수 있다. 의미 해석과 음성 생성은 멈춘다.&lt;br&gt;정규 입력 기록은 Interaction Manager 소유다. Request Controller가 입력 버전 변경을 최종 제어한다.&lt;br&gt;모델은 VIA 밖의 책임이지만 PC 안에서 실행한다. Component 경계와 process 경계를 구별한다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="88" y="2008" width="1149.98" height="99" /></mxCell><mxCell id="e55" value="추가 모델과 인식 전용 CPU 비용. process 분리가 전력과 메모리 대역폭까지 격리하지는 않는다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#895914;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="88" y="2114" width="869.84" height="30.3" /></mxCell><mxCell id="e57" value="A" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=white;fontSize=27;fontStyle=1;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1323.63" y="244" width="24.74" height="42.45" /></mxCell><mxCell id="e58" value="공유 Omni가 인식 근거까지 생산" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=28;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1380" y="236" width="454.88" height="43.800000000000004" /></mxCell><mxCell id="e59" value="탐색안 / 전용 ASR 제거, 공유 추론에 인식 결합" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1380" y="276" width="441.08" height="30.3" /></mxCell><mxCell id="e61" value="VIA SOFTWARE" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=18;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1334" y="351" width="141.92" height="30.3" /></mxCell><mxCell id="e62" value="비교에 필요한 책임만 표시" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=16;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2260.24" y="353" width="213.76" height="27.6" /></mxCell><mxCell id="e70" value="제거되는 인식 전용 실행" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#C7D1DD;fontSize=18;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1388" y="985" width="221.48" height="30.3" /></mxCell><mxCell id="e71" value="A에는 없음" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=16;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1708.16" y="987" width="91.84" height="27.6" /></mxCell><mxCell id="e73" value="Shared Inference Service" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=18;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1959" y="985" width="275.84" height="30.3" /></mxCell><mxCell id="e74" value="공유 추론 process" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=16;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2258.72" y="987" width="161.28" height="27.6" /></mxCell><mxCell id="e75" value="Speech Input Worker 없음&lt;br&gt;인식 전용 대기열 없음&lt;br&gt;Streaming ASR 가중치 없음" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=23;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1397" y="1090" width="339.2" height="99.15" /></mxCell><mxCell id="e76" value="인식은 오른쪽 공유 모델이 수행한다.&lt;br&gt;초록 모듈은 그 결과를 변환한다.&lt;br&gt;없는 시간 정보를 만들어내지는 않는다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1397" y="1335" width="390.0" height="87.0" /></mxCell><mxCell id="e82" value="① 원음 / 인식도 같은 모델이 처리" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1951" y="770" width="313.28" height="30.3" /></mxCell><mxCell id="e85" value="모델이 생산한 인식 결과" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1966" y="1367" width="221.48" height="30.3" /></mxCell><mxCell id="e87" value="② 인식 근거 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2205" y="713" width="160.64" height="30.3" /></mxCell><mxCell id="e93" value="Omni가 멈췄을 때의 실제 차이" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=21;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1336" y="1967" width="322.16" height="34.35" /></mxCell><mxCell id="e94" value="A: 녹음은 계속되지만 인식, 의미 해석과 음성 생성이 함께 멈춘다.&lt;br&gt;정규 입력 기록은 Interaction Manager 소유다. Request Controller가 입력 버전 변경을 최종 제어한다.&lt;br&gt;모델은 VIA 밖의 책임이지만 PC 안에서 실행한다. Component 경계와 process 경계를 구별한다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1336" y="2008" width="1149.98" height="99" /></mxCell><mxCell id="e95" value="Omni의 전사, 발화 시각과 동시 인식 지원은 미확인. 녹음 지속을 인식 성공으로 보지 않는다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#895914;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1336" y="2114" width="843.2" height="30.3" /></mxCell><mxCell id="e97" value="색:  검정 = 공통     파랑 = T 전용     초록 = A/B 전용" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=19;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="2222" width="584.84" height="31.650000000000002" /></mxCell><mxCell id="e98" value="실선 → 요청/전달     점선 → 결과/복원" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=18;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2126.92" y="2222" width="369.08" height="30.3" /></mxCell><mxCell id="e99" value="모양:  제목 칸이 있는 박스 = Component   |   내부 둥근 박스 = Module   |   원통 = 저장소   |   접힌 종이 = 자료   |   육각형 = 연동 대상/모델" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=17;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="2260" width="1347.26" height="28.950000000000003" /></mxCell><mxCell id="e100" value="ASR는 음성을 글자로 바꾸는 인식이다. A는 모델 결과 변환을 추가하며 인식도 공통 실행 배분과 같은 모델에 의존한다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=17;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="2300" width="1004.88" height="28.950000000000003" /></mxCell><mxCell id="e101" value="탐색안 / 미채택 / 미측정" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=17;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2271.76" y="2300" width="224.24" height="28.950000000000003" /></mxCell></root></mxGraphModel></diagram></mxfile>

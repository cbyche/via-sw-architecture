=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2223" y="894" width="209.6" height="30.3" /></mxCell><mxCell id="e71" value="제거되는 독립 인식 경로" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5E6D80;fontSize=18;fontFamily=Arial;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1403" y="667" width="221.48" height="30.3" /></mxCell><mxCell id="e72" value="Speech Input Worker&lt;br&gt;Streaming ASR weights&lt;br&gt;독립 인식 실행 예산" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5E6D80;fontSize=23;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1403" y="709" width="307.46" height="117" /></mxCell><mxCell id="e73" value="Native Evidence Adapter가 모델의 event를 변환한다.&lt;br&gt;모델이 제공하지 않는 시각 근거를 만들 수는 없다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#956016;fontSize=18;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1378" y="1077" width="527.12" height="54.6" /></mxCell><mxCell id="e74" value="모델 내부 구현 / 학습은 VIA 책임 밖. 두 모델 모두 PC 안에 배치될 수 있다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5E6D80;fontSize=17;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1367" y="994" width="675.42" height="28.950000000000003" /></mxCell><mxCell id="e77" value="DESIGN FOCUS  /  장애 경계 확대: 같은 runtime 의존" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=18;fontFamily=Arial;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1337" y="1249" width="522.8" height="30.3" /></mxCell><mxCell id="e78" value="capture 지속 | recognition과 의미 처리가 함께 중단 | 유한 backlog 이후 gap&lt;br&gt;③ Interaction Manager가 native 근거를 정규 입력 기록에 연결한다.&lt;br&gt;동시 인식, partial/final, 시각 및 취소 계약이 실제로 제공되어야 한다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#233247;fontSize=22;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1337" y="1287" width="932.88" height="105" /></mxCell><mxCell id="e79" value="native capability는 미확인. 인식이 멎은 동안 녹음만 계속된 것을 기능 성공으로 세지 않는다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#956016;fontSize=18;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1337" y="1399" width="882.8" height="30.3" /></mxCell><mxCell id="e81" value="범례" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5E6D80;fontSize=17;fontFamily=Arial;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="1552" width="42" height="28.950000000000003" /></mxCell><mxCell id="e83" value="호출 / 전달" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5E6D80;fontSize=17;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="190" y="1551" width="107.62" height="28.950000000000003" /></mxCell><mxCell id="e85" value="결과 / 복원" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5E6D80;fontSize=17;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="405" y="1551" width="107.62" height="28.950000000000003" /></mxCell><mxCell id="e87" value="구조 차이 또는 확대 대상" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5E6D80;fontSize=17;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="597" y="1551" width="220.16" height="28.950000000000003" /></mxCell><mxCell id="e88" value="외부 책임 경계 ≠ 원격 배치  |  모델은 on-device 의존성" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5E6D80;fontSize=17;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1020" y="1551" width="511.88" height="28.950000000000003" /></mxCell><mxCell id="e89" value="Model Access는 client, worker adapter와 공유 추론 scheduler를 아우른다. 모델 자체와 VIA의 연동 코드를 구별한다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5E6D80;fontSize=18;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="1597" width="1134.44" height="30.3" /></mxCell><mxCell id="e90" value="설계 탐색  /  미채택 대안  /  미측정" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5E6D80;fontSize=17;fontFamily=Arial;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2157.52" y="1598" width="338.48" height="28.950000000000003" /></mxCell></root></mxGraphModel></diagram></mxfile>

<mxfile host="app.diagrams.net" type="device"><diagram name="복구 원본 · 다시 켜지는 것과 업무를 올바르게 이어가는 것은 다르다  |  배경" id="recovery-state-source-background"><mxGraphModel page="1" pageWidth="2560" pageHeight="1440" grid="1" gridSize="10"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="challenge" value="" style="rounded=1;arcSize=8;html=1;fillColor=#FFFFFF;strokeColor=#171717;strokeWidth=2.5;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="48" y="1170" width="2464" height="170" /></mxCell><mxCell id="challenge-title" value="Architecture Challenge" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;fontColor=#171717;fontSize=20;fontStyle=1;fontFamily=Arial;align=left;verticalAlign=top;spacing=0;connectable=0;" vertex="1" parent="challenge"><mxGeometry as="geometry" x="16" y="8" width="2432" height="27" /></mxCell><mxCell id="challenge-text-0" value="운영 상태를 현재 owner 기록에서 복원할 것인가, 확정 domain 이력에서 검증된 checkpoint와 tail로 재구성할 것인가?" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;fontColor=#171717;fontSize=20;fontStyle=0;fontFamily=Arial;align=left;verticalAlign=top;spacing=0;connectable=0;" vertex="1" parent="challenge"><mxGeometry as="geometry" x="16" y="44" width="2432" height="27" /></mxCell><mxCell id="scenario" value="" style="rounded=1;arcSize=8;html=1;fillColor=#FFFFFF;strokeColor=#171717;strokeWidth=2.5;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="48" y="142" width="2464" height="104" /></mxCell><mxCell id="scenario-title" value="사용자 상황" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;fontColor=#171717;fontSize=20;fontStyle=1;fontFamily=Arial;align=left;verticalAlign=top;spacing=0;connectable=0;" vertex="1" parent="scenario"><mxGeometry as="geometry" x="16" y="8" width="2432" height="27" /></mxCell><mxCell id="scenario-text-0" value="취소 command 전송 직후 ACK가
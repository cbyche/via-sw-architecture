<mxfile host="app.diagrams.net" type="device"><diagram id="screen-voice-grounding-background" name="화면과 음성 지칭의 결합 (문제)"><mxGraphModel page="1" pageWidth="1920" pageHeight="1080" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="screen-voice-grounding-background-1" parent="1" vertex="1" value="화면과 음성 지칭의 결합 (문제)" style="fontFamily=Calibri;fontSize=40.0;fontColor=#000000;fontStyle=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="60" y="30" width="1040" height="60" /></mxCell><mxCell id="screen-voice-grounding-background-2" parent="1" edge="1" style="edgeStyle=none;rounded=0;strokeColor=#A6A6A6;strokeWidth=1.5;endArrow=none;endFill=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="52" y="104" /><mxPoint as="targetPoint" x="1872" y="104" /><Array as="points" /></mxGeometry></mxCell><mxCell id="screen-voice-grounding-background-3" parent="1" edge="1" style="edgeStyle=none;rounded=0;strokeColor=#A6A6A6;strokeWidth=1.5;endArrow=none;endFill=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="52" y="908" /><mxPoint as="targetPoint" x="1868" y="908" /><Array as="points" /></mxGeometry></mxCell><mxCell id="screen-voice-grounding-background-4" parent="1" vertex="1" value="설계 질문" style="fontFamily=Calibri;fontSize=30.666666666666668;fontColor=#C00000;fontStyle=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="52" y="935" width="180" height="50" /></mxCell><mxCell id="screen-voice-grounding-background-5" parent="1" vertex="1" value="말과 손동작을 당시 화면에 연결해,&lt;br&gt;사용자가 뜻한 대상을 어떻게 찾을까?" style="fontFamily=Calibri;fontSize=30.666666666666668;fontColor=#000000;fontStyle=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="260" y="932" width="1608" height="100" /></mxCell><mxCell id="screen-voice-grounding-background-6" parent="1" vertex="1" value="첫 표를 가리켜 “이 표와…”라고 말하고, 화면을 바꿔 “…저 표를 비교해줘”라고 이어 갑니다." style="fontFamily=Calibri;fontSize=32.0;fontColor=#000000;fontStyle=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="52" y="149" width="1816" height="63" /></mxCell><mxCell id="screen-voice-grounding-background-7" parent="1" vertex="1" value="말하는 순간 1" style="fontFamily=Calibri;fontSize=30.666666666666668;fontColor=#000000;fontStyle=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="52" y="252" width="568" height="52" /></mxCell><mxCell id="screen-voice-grounding-background-8" parent="1" vertex="1" value="말하는 순간 2" style="fontFamily=Calibri;fontSize=30.666666666666668;fontColor=#000000;fontStyle=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="676" y="252" width="568" height="52" /></mxCell><mxCell id="screen-voice-grounding-background-9" parent="1" vertex="1" value="전사가 도착한 순간" style="fontFamily=Calibri;fontSize=30.666666666666668;fontColor=#000000;fontStyle=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="1300" y="252" width="568" height="52" /></mxCell><mxCell id="screen-voice-grounding-background-10" parent="1" vertex="1" value="문서 A의 화면" style="fontFamily=Calibri;fontSize=26.666666666666668;fontColor=#000000;fontStyle=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;shape=rect;fillColor=#F2F2F2;strokeColor=#A6A6A6;strokeWidth=2;spacing=14;"><mxGeometry as="geometry" x="52" y="325" width="568" height="54" /></mxCell><mxCell id="screen-voice-grounding-background-11" parent="1" vertex="1" value="문서 B의 화면" style="fontFamily=Calibri;fontSize=26.666666666666668;fontColor=#000000;fontStyle=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;shape=rect;fillColor=#F2F2F2;strokeColor=#A6A6A6;strokeWidth=2;spacing=14;"><mxGeometry as="geometry" x="676" y="325" width="568" height="54" /></mxCell><mxCell id="screen-voice-grounding-background-12" parent="1" vertex="1" value="현재 문서 B의 화면" style="fontFamily=Calibri;fontSize=26.666666666666668;fontColor=#000000;fontStyle=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;shape=rect;fillColor=#F2F2F2;strokeColor=#A6A6A6;strokeWidth=2;spacing=14;"><mxGeometry as="geometry" x="1300" y="325" width="568" height="54" /></mxCell><mxCell id="screen-voice-grounding-background-13" parent="1" vertex="1" value="첫 표" style="fontFamily=Calibri;fontSize=33.333333333333336;fontColor=#000000;fontStyle=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=0;shape=rect;fillColor=#FFFFFF;strokeColor=#00889A;strokeWidth=2;spacing=14;"><mxGeometry as="geometry" x="80" y="405" width="512" height="153" /></mxCell><mxCell id="screen-voice-grounding-background-14" parent="1" vertex="1" value="둘째 표" style="fontFamily=Calibri;fontSize=29.333333333333332;fontColor=#000000;fontStyle=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=0;shape=rect;fillColor=#FFFFFF;strokeColor=#00889A;strokeWidth=2;spacing=14;"><mxGeometry as="geometry" x="704" y="399" width="512" height="81" /></mxCell><mxCell id="screen-voice-grounding-background-15" parent="1" vertex="1" value="아래 표" style="fontFamily=Calibri;fontSize=29.333333333333332;fontColor=#000000;fontStyle=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=0;shape=rect;fillColor=#FFFFFF;strokeColor=#A6A6A6;strokeWidth=2;spacing=14;"><mxGeometry as="geometry" x="704" y="515" width="512" height="81" /></mxCell><mxCell id="screen-voice-grounding-background-16" parent="1" vertex="1" value="둘째 표" style="fontFamily=Calibri;fontSize=29.333333333333332;fontColor=#000000;fontStyle=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=0;shape=rect;fillColor=#FFFFFF;strokeColor=#A6A6A6;strokeWidth=2;spacing=14;"><mxGeometry as="geometry" x="1328" y="399" width="512" height="81" /></mxCell><mxCell id="screen-voice-grounding-background-17" parent="1" vertex="1" value="정정한 아래 표&lt;br&gt;선택 범위" style="fontFamily=Calibri;fontSize=26.666666666666668;fontColor=#000000;fontStyle=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=0;shape=rect;fillColor=#FFFFFF;strokeColor=#00889A;strokeWidth=2;spacing=14;"><mxGeometry as="geometry" x="1328" y="515" width="512" height="81" /></mxCell><mxCell id="screen-voice-grounding-background-18" parent="1" edge="1" style="edgeStyle=none;rounded=0;strokeColor=#00889A;strokeWidth=2.5;endArrow=open;endFill=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="149" y="578" /><mxPoint as="targetPoint" x="230" y="505" /><Array as="points"><mxPoint x="193" y="552" /></Array></mxGeometry></mxCell><mxCell id="screen-voice-grounding-background-19" parent="1" edge="1" style="edgeStyle=none;rounded=0;strokeColor=#00889A;strokeWidth=2.5;endArrow=open;endFill=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="690" y="500" /><mxPoint as="targetPoint" x="760" y="445" /><Array as="points"><mxPoint x="725" y="470" /></Array></mxGeometry></mxCell><mxCell id="screen-voice-grounding-background-20" parent="1" edge="1" style="edgeStyle=none;rounded=0;strokeColor=#00889A;strokeWidth=2.5;endArrow=open;endFill=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1315" y="610" /><mxPoint as="targetPoint" x="1385" y="555" /><Array as="points"><mxPoint x="1350" y="585" /></Array></mxGeometry></mxCell><mxCell id="screen-voice-grounding-background-21" parent="1" vertex="1" value="pointer로 첫 표 지시" style="fontFamily=Calibri;fontSize=25.333333333333332;fontColor=#000000;fontStyle=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="80" y="602" width="512" height="44" /></mxCell><mxCell id="screen-voice-grounding-background-22" parent="1" vertex="1" value="다른 창의 표로 이동" style="fontFamily=Calibri;fontSize=25.333333333333332;fontColor=#000000;fontStyle=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="704" y="619" width="512" height="44" /></mxCell><mxCell id="screen-voice-grounding-background-23" parent="1" vertex="1" value="첫 표는 이미 보이지 않음" style="fontFamily=Calibri;fontSize=25.333333333333332;fontColor=#000000;fontStyle=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="1328" y="619" width="512" height="44" /></mxCell><mxCell id="screen-voice-grounding-background-24" parent="1" edge="1" style="edgeStyle=none;rounded=0;strokeColor=#A6A6A6;strokeWidth=2.5;endArrow=open;endFill=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="620" y="479" /><mxPoint as="targetPoint" x="656" y="479" /><Array as="points" /></mxGeometry></mxCell><mxCell id="screen-voice-grounding-background-25" parent="1" edge="1" style="edgeStyle=none;rounded=0;strokeColor=#A6A6A6;strokeWidth=2.5;endArrow=open;endFill=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1244" y="479" /><mxPoint as="targetPoint" x="1280" y="479" /><Array as="points" /></mxGeometry></mxCell><mxCell id="screen-voice-grounding-background-26" parent="1" vertex="1" value="“아니, 여기.”로 정정하면 선택 범위와 바꿀 지칭도 다시 연결해야 합니다." style="fontFamily=Calibri;fontSize=30.666666666666668;fontColor=#000000;fontStyle=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="52" y="700" width="1816" height="54" /></mxCell><mxCell id="screen-voice-grounding-background-27" parent="1" vertex="1" value="근거: 말한 구간, 당시 화면, pointer 경로와 선택 범위" style="fontFamily=Calibri;fontSize=29.333333333333332;fontColor=#000000;fontStyle=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="52" y="766" width="1816" height="50" /></mxCell><mxCell id="screen-voice-grounding-background-28" parent="1" vertex="1" value="마지막 화면만 쓰면 첫 표를 잃고, 시각이 겹친다는 이유만으로 대상을 정하면 틀릴 수 있습니다." style="fontFamily=Calibri;fontSize=29.333333333333332;fontColor=#000000;fontStyle=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="52" y="837" width="1816" height="58" /></mxCell><mxCell id="screen-voice-grounding-background-29" parent="1" vertex="1" value="DP-47 초기 문제 그림 / 현재 두 대안은 본문 참조" style="fontFamily=Calibri;fontSize=22.666666666666668;fontColor=#000000;fontStyle=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;text;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="52" y="1034" width="1816" height="30" /></mxCell></root></mxGraphModel></diagram></mxfile>

 y="1132" width="215.06" height="34.35" /></mxCell><mxCell id="e38" value="실제 게시 구간 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="74" y="1224" width="215.06" height="34.35" /></mxCell><mxCell id="e40" value="실제 게시 기록 전달" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="74" y="1316" width="215.06" height="34.35" /></mxCell><mxCell id="e42" value="실제 질문을 본 뒤 “오른쪽 표”" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="74" y="1408" width="330.14" height="34.35" /></mxCell><mxCell id="e44" value="질문 + 보완 + 이전 조건으로 재해석 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="74" y="1500" width="440.18" height="34.35" /></mxCell><mxCell id="e46" value="새 완성안 P2: source=R@7, send=false" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="74" y="1592" width="456.56" height="34.35" /></mxCell><mxCell id="e48" value="4  자료가 바뀌면 현재 근거로 재검증/재해석" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="74" y="1684" width="469.16" height="34.35" /></mxCell><mxCell id="e50" value="현재 조건을 만족하는 의미 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="74" y="1776" width="333.08" height="34.35" /></mxCell><mxCell id="e52" value="5  현재 검사 후 명령 채택; 발송 명령은 만들지 않음" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="74" y="1868" width="563.24" height="34.35" /></mxCell><mxCell id="e54" value="읽을 결론: 자유로운 새 의도를 전체 맥락에서 다시 구성" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=22;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="74" y="2070" width="614.76" height="35.7" /></mxCell><mxCell id="e55" value="대가: 앞선 조건 누락을 검증해야 함; 관련 근거 재해석" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="74" y="2115" width="579.2" height="34.35" /></mxCell><mxCell id="e56" value="B  의미 상태에 변경을 적용" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=30;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1312" y="285" width="419.6" height="46.5" /></mxCell><mxCell id="e57" value="위에서 아래로 읽기. 가로 화살표의 시작/끝이 실제 송신자/수신자." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1312" y="345" width="664.4" height="33.0" /></mxCell><mxCell id="e59" value="Request Controller" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=20;fontStyle=1;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1312.4" y="415" width="231.2" height="34" /></mxCell><mxCell id="e62" value="Request&lt;br&gt;Interpreter" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=20;fontStyle=1;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1593.8" y="415" width="144.4" height="62" /></mxCell><mxCell id="e65" value="Meaning Workspace" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=20;fontStyle=1;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1794.6" y="415" width="218.8" height="34" /></mxCell><mxCell id="e68" value="Semantic&lt;br&gt;Constraint Engine" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=20;fontStyle=1;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2032.6" y="415" width="218.8" height="62" /></mxCell><mxCell id="e71" value="Response Manager" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=20;fontStyle=1;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2276.8" y="415" width="206.4" height="34" /></mxCell><mxCell id="e73" value="1  같은 원문 + 명시적인 연결 후보" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1322" y="580" width="377.18" height="34.35" /></mxCell><mxCell id="e75" value="관련 의미/질문과 허용된 근거 요약 조회" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1322" y="661" width="422.12" height="34.35" /></mxCell><mxCell id="e77" value="읽기 전용 요약 반환; 독립 요청에 기존 조건 상속 금지" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1322" y="742" width="579.2" height="34.35" /></mxCell><mxCell id="e79" value="목표 추가, 표 후보 L/R, 메일 발송 금지 후보" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1322" y="823" width="492.26" height="34.35" /></mxCell><mxCell id="e81" value="2  현재 후보/제약/근거 버전으로 관계 계산 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1322" y="904" width="516.2" height="34.35" /></mxCell><mxCell id="e83" value="표 대상 미해결; 발송 금지 유지" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1322" y="985" width="338.12" height="34.35" /></mxCell><mxCell id="e85" value="3  미해결 필드/질문 제안 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1322" y="1066" width="330.14" height="34.35" /></mxCell><mxCell id="e87" value="현재 질문 확인 후 게시 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1322" y="1147" width="304.1" height="34.35" /></mxCell><mxCell id="e89" value="Interaction Manager에서 받은 실제 게시 기록" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1322" y="1228" width="517.46" height="34.35" /></mxCell><mxCell id="e91" value="실제 게시 기록을 질문/의미 버전에 연결" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1322" y="1309" width="422.12" height="34.35" /></mxCell><mxCell id="e93" value="실제 질문을 본 뒤 같은 “오른쪽 표”" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1322" y="1390" width="385.16" height="34.35" /></mxCell><mxCell id="e95" value="NARROW(q1, R@7, expected=12)" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1322" y="1471" width="372.56" height="34.35" /></mxCell><mxCell id="e97" value="대상 후보만 제한; send=false는 변경하지 않음" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1322" y="1552" width="510.32" height="34.35" /></mxCell><mxCell id="e99" value="관계 해 또는 충돌/미해결 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1322" y="1633" width="325.1" height="34.35" /></mxCell><mxCell id="e101" value="4  자료 변경: 의존 후보 무효화/재조회/재평가" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1322" y="1714" width="495.2" height="34.35" /></mxCell><mxCell id="e103" value="현재 의미와 근거 버전 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1322" y="1795" width="291.08" height="34.35" /></mxCell><mxCell id="e105" value="5  현재 검사 후 명령 채택; 외부 승인과 의미 해는 별개" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1322" y="1876" width="597.26" height="34.35" /></mxCell><mxCell id="e107" value="읽을 결론: 명시한 조건을 유지하며 필요한 관계만 갱신" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=22;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1322" y="2070" width="601.12" height="35.7" /></mxCell><mxCell id="e108" value="대가: 변경 언어/의존성 설계; 표현 밖 뜻은 질문" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1322" y="2115" width="516.2" height="34.35" /></mxCell><mxCell id="e109" value="생략한 공통 연동: 추론은 Model Access의 한 벌 Omni; 업무 실행은 Task Manager/Agent Gateway가 Downstream Agent에 위임." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="2200" width="1285.94" height="31.650000000000002" /></mxCell><mxCell id="e110" value="실선 = 요청/전달, 점선 = 결과. 별도 언급 없는 참여자는 논리 책임. 시간 간격은 성능 수치가 아닌 사건 순서. 수작업 설계 추적, 미측정." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="2240" width="1323.18" height="31.650000000000002" /></mxCell></root></mxGraphModel></diagram></mxfile>

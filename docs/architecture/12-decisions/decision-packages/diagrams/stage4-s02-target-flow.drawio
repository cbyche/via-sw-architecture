<mxfile host="app.diagrams.net" type="device"><diagram id="stage4-s02-target-flow" name="T: 당시 화면 근거를 조회하고 요청에 맞게 해석한다"><mxGraphModel page="1" pageWidth="2560" pageHeight="1600" grid="1" gridSize="8"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="e1" value="" style="rounded=1;arcSize=4;fillColor=#263445;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="0" y="0" width="2560" height="9" /></mxCell><mxCell id="e7" value="" style="rounded=1;arcSize=4;fillColor=#FAFBFD;strokeColor=#C7D1DD;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="240" width="2432" height="1178" /></mxCell><mxCell id="target-actor0" value="Interaction&lt;br&gt;Manager" style="swimlane;html=1;startSize=62;horizontal=1;align=left;spacingLeft=18;fontSize=17;fontStyle=1;fillColor=white;swimlaneFillColor=white;strokeColor=#263445;fontColor=#263445;strokeWidth=2.2;collapsible=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="105" y="320" width="230" height="104" /></mxCell><mxCell id="target-actor2" value="Context Manager" style="swimlane;html=1;startSize=62;horizontal=1;align=left;spacingLeft=18;fontSize=17;fontStyle=1;fillColor=white;swimlaneFillColor=white;strokeColor=#263445;fontColor=#263445;strokeWidth=2.2;collapsible=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="812" y="320" width="230" height="104" /></mxCell><mxCell id="target-actor3" value="Request&lt;br&gt;Controller" style="swimlane;html=1;startSize=62;horizontal=1;align=left;spacingLeft=18;fontSize=17;fontStyle=1;fillColor=white;swimlaneFillColor=white;strokeColor=#263445;fontColor=#263445;strokeWidth=2.2;collapsible=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1165" y="320" width="230" height="104" /></mxCell><mxCell id="target-actor4" value="Request&lt;br&gt;Interpreter" style="swimlane;html=1;startSize=62;horizontal=1;align=left;spacingLeft=18;fontSize=17;fontStyle=1;fillColor=white;swimlaneFillColor=white;strokeColor=#263445;fontColor=#263445;strokeWidth=2.2;collapsib
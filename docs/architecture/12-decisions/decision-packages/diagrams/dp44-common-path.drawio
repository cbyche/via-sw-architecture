X=0.7333333333333333;exitY=1.0;exitPerimeter=0;entryX=0.7333333333333333;entryY=0.0;entryPerimeter=0;" edge="1" parent="1" source="im" target="user"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="504.0" y="870" /><mxPoint as="targetPoint" x="504.0" y="990" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e38" style="edgeStyle=none;rounded=0;strokeColor=#263445;strokeWidth=2;endArrow=open;endFill=0;dashed=1;exitX=0.8;exitY=1.0;exitPerimeter=0;entryX=0.9213483146067416;entryY=1.0;entryPerimeter=0;" edge="1" parent="1" source="im" target="rm"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="544.0" y="870" /><mxPoint as="targetPoint" x="2440.0" y="870" /><Array as="points"><mxPoint x="544" y="890" /><mxPoint x="2440" y="890" /></Array></mxGeometry></mxCell><mxCell id="e40" style="edgeStyle=none;rounded=0;strokeColor=#263445;strokeWidth=2;endArrow=open;endFill=0;dashed=1;exitX=0.0;exitY=0.75;exitPerimeter=0;entryX=1.0;entryY=0.75;entryPerimeter=0;" edge="1" parent="1" source="rm" target="rc"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1784" y="730.0" /><mxPoint as="targetPoint" x="1624" y="730.0" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e42" style="edgeStyle=none;rounded=0;strokeColor=#C7D1DD;strokeWidth=2;endArrow=none;endFill=0;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="64" y="1255" /><mxPoint as="targetPoint" x="2496" y="1255" /><Array as="points" /></mxGeometry></mxCell><mxCell id="user" value="사용자&lt;br&gt;말하기 / 듣기 / 읽기" style="shape=hexagon;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fillColor=#F7F9FC;strokeColor=#263445;fontColor=#263445;strokeWidth=1.7;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="990" width="600" height="175" /></mxCell><mxCell id="agent" value="Downstream Agent&lt;br&gt;비동기 질문 / 결과" style="shape=hexagon;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fillColor=#F7F9FC;strokeColor=#263445;fontColor=#263445;strokeWidth=1.7;" vertex="1" parent="1"><mxGeometry as="geometry" x="2140" y="1020" width="356" height="140" /></mxCell><mxCell id="e2" value="VIA  /  ARCHITECTURE REVIEW" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=18;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="42" width="309.32" height="30.3" /></mxCell><mxCell id="e3" value="DP-44  /  STAGE 04" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=18;fontStyle=1;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2287.12" y="42" width="208.88" height="30.3" /></mxCell><mxCell id="e4" value="DP-44의 공통 대화 경로와 A/B 비교 범위" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=42;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="87" width="876.56" height="62.7" /></mxCell><mxCell id="e5" value="핵심은 Interaction Manager, Request Controller, Response Manager의 협력. 업무 사실 확인과 업무 제어는 양안 공통이다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=23;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="151" width="1529.68" height="37.05" /></mxCell><mxCell id="e10" value="계속 듣기와 입력 취득&lt;br&gt;입력 시작 알림과 전사 전달&lt;br&gt;발화 중 끼어들면 즉시 중단&lt;br&gt;허용된 Text와 음성 실제 전달&lt;br&gt;실제 전달 범위 확인" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=28;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="104" y="410" width="426.88" height="296" /></mxCell><mxCell id="e11" value="입력 해석 요청과 의미 채택&lt;br&gt;대화, Request와 질문 연결&lt;br&gt;정정 범위와 미전송 hold&lt;br&gt;채택한 입력을 후속 실행에 연결&lt;br&gt;Task Manager와 업무 제어" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=28;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="864" y="410" width="441.44" height="296" /></mxCell><mxCell id="e12" value="응답 내용과 음성 준비&lt;br&gt;대기 후보의 게시 차례 관리&lt;br&gt;현재성, 권한과 중복 최종 검사&lt;br&gt;Interaction Manager에 release&lt;br&gt;실제 전달 기록의 내구 저장" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=27;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1824" y="410" width="486.98" height="296" /></mxCell><mxCell id="e17" value="업무 원본 확인과 저장&lt;br&gt;질문 / 결과 / command 상태" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=23;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="894" y="1080" width="345.64" height="76" /></mxCell><mxCell id="e18" value="외부 사건 접수&lt;br&gt;명령 전달" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=23;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1640" y="1080" width="174.52" height="76" /></mxCell><mxCell id="e20" value="1 발화" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="916" width="72.8" height="33.0" /></mxCell><mxCell id="e22" value="2 입력&lt;br&gt;onset / 전사" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="682" y="541" width="147.2" height="60.0" /></mxCell><mxCell id="e25" value="3 접수" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2043" y="1058" width="66.32" height="30.3" /></mxCell><mxCell id="e26" value="3 확인" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1496" y="1058" width="66.32" height="30.3" /></mxCell><mxCell id="e28" value="4 확인 사실" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1326" y="916" width="113.48" height="30.3" /></mxCell><mxCell id="e30" value="공통 업무 명령" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="887" y="916" width="138.32" height="30.3" /></mxCell><mxCell id="e31" value="Request Controller ↔ Task Manager: A/B 공통" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="864" y="1223" width="531.6" height="33.0" /></mxCell><mxCell id="e33" value="5 채택 입력&lt;br&gt;허용 Notice" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1640" y="541" width="134.8" height="60.0" /></mxCell><mxCell id="e35" value="6 내용 / 음성 / release → 실제 출력" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=22;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="922" y="220" width="443.16" height="35.7" /></mxCell><mxCell id="e37" value="7 실제 전달" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="440" y="916" width="125.2" height="33.0" /></mxCell><mxCell id="e39" value="8 actual receipt / 내구 저장" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1500" y="893" width="303.2" height="30.3" /></mxCell><mxCell id="e41" value="8 Presented&lt;br&gt;질문 focus" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1640" y="741" width="130.76" height="54.6" /></mxCell><mxCell id="e43" value="A/B 차이: 입력과 확인된 업무 사건으로 시작한 이해 / 준비 / 게시의 완료, 대기, 정정과 취소를 누가 이어가는가.&lt;br&gt;Request Interpreter, Context Manager, Policy Manager, State Store, Model Access의 공통 기능은 아래 상세 구조에서 유지한다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=23;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="1277" width="1648.36" height="84" /></mxCell><mxCell id="e44" value="직각 = Component  /  육각형 = 사용자 또는 외부 Agent  /  실선 = 입력 및 요청  /  점선 = 확인된 사건과 전달 사실" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="1377" width="1235.6" height="33.0" /></mxCell><mxCell id="e45" value="공통 계약 설명 / A/B 미선정 / 미측정" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=18;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2138.08" y="1410" width="357.92" height="30.3" /></mxCell></root></mxGraphModel></diagram></mxfile>

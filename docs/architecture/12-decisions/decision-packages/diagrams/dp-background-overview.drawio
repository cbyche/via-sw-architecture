;fontColor=#5F6B77;fontStyle=1;"><mxGeometry as="geometry" x="1080" y="295" width="410" height="28.6" /></mxCell><mxCell id="n21" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;음성 종료&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=22;fontColor=#5F6B77;fontStyle=1;"><mxGeometry as="geometry" x="1540" y="295" width="160" height="28.6" /></mxCell><mxCell id="n22" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;돌아옴&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=22;fontColor=#5F6B77;fontStyle=1;"><mxGeometry as="geometry" x="1730" y="295" width="120" height="28.6" /></mxCell><mxCell id="n23" parent="1" edge="1" style="fontFamily=Apple SD Gothic Neo;edgeStyle=none;rounded=0;strokeColor=#CDD6DE;strokeWidth=1.7;endArrow=open;endFill=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="220" y="330" /><mxPoint as="targetPoint" x="1850" y="330" /><Array as="points" /></mxGeometry></mxCell><mxCell id="n24" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;사용자&lt;br&gt;입력·대화&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=25;fontColor=#18232E;fontStyle=1;"><mxGeometry as="geometry" x="64" y="359" width="140" height="65.0" /></mxCell><mxCell id="n25" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.2962962962962963;&quot;&gt;“이 표를 제안서에 넣고,&lt;br&gt;공유 메일은 초안만&lt;br&gt;만들어줘.”&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=27;fontColor=#18232E;fontStyle=1;"><mxGeometry as="geometry" x="225" y="358" width="400" height="105" /></mxCell><mxCell id="n26" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;화면의 표를 가리킴&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=22;fontColor=#5F6B77;fontStyle=0;"><mxGeometry as="geometry" x="225" y="470" width="400" height="28.6" /></mxCell><mxCell id="n27" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.2962962962962963;&quot;&gt;“잠깐, 가격은&lt;br&gt;비교에서 빼줘.”&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=27;fontColor=#18232E;fontStyle=1;"><mxGeometry as="geometry" x="670" y="358" width="390" height="70" /></mxCell><mxCell id="n28" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.2916666666666667;&quot;&gt;메일 업무의 질문&lt;br&gt;“수신자는 누구인가요?”&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=24;fontColor=#18232E;fontStyle=0;"><mxGeometry as="geometry" x="735" y="468" width="330" height="62" /></mxCell><mxCell id="n29" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.36;&quot;&gt;“지난번 네가 설명한 기준으로,&lt;br&gt;제품 비교 결과와 견적도&lt;br&gt;반영해줘.”&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=25;fontColor=#18232E;fontStyle=1;"><mxGeometry as="geometry" x="1080" y="358" width="410" height="102" /></mxCell><mxCell id="n30" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3333333333333333;&quot;&gt;대화는&lt;br&gt;끝나도…&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=24;fontColor=#5F6B77;fontStyle=0;"><mxGeometry as="geometry" x="1530" y="362" width="150" height="64" /></mxCell><mxCell id="n31" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3333333333333333;&quot;&gt;같은 업무의&lt;br&gt;진행·결과&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=24;fontColor=#18232E;fontStyle=0;"><mxGeometry as="geometry" x="1710" y="390" width="170" height="64" /></mxCell><mxCell id="n32" parent="1" edge="1" style="fontFamily=Apple SD Gothic Neo;edgeStyle=none;rounded=0;strokeColor=#CDD6DE;strokeWidth=1.7;endArrow=none;endFill=0;dashed=1;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1540" y="456" /><mxPoint as="targetPoint" x="1540" y="890" /><Array as="points" /></mxGeometry></mxCell><mxCell id="n33" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;VIA&lt;br&gt;처리·연결&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=25;fontColor=#18232E;fontStyle=1;"><mxGeometry as="geometry" x="64" y="590" width="140" height="65.0" /></mxCell><mxCell id="n34" parent="1" edge="1" style="fontFamily=Apple SD Gothic Neo;edgeStyle=none;rounded=0;strokeColor=#CDD6DE;strokeWidth=7;endArrow=none;endFill=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="225" y="580" /><mxPoint as="targetPoint" x="1850" y="580" /><Array as="points" /></mxGeometry></mxCell><mxCell id="n35" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.36;&quot;&gt;표의 대상 확인 · 업무 구분&lt;br&gt;메일은 초안만 조건 유지&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=25;fontC
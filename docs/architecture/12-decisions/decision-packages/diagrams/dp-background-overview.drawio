lor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=22;fontColor=#5F6B77;fontStyle=0;"><mxGeometry as="geometry" x="770" y="224" width="500" height="28.6" /></mxCell><mxCell id="n11" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;견적 Agent의 확인된 결과&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=24;fontColor=#18232E;fontStyle=1;"><mxGeometry as="geometry" x="1340" y="188" width="500" height="31.200000000000003" /></mxCell><mxCell id="n12" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;견적 · 결과 참조 / 필요한 발췌&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=22;fontColor=#5F6B77;fontStyle=0;"><mxGeometry as="geometry" x="1340" y="224" width="500" height="28.6" /></mxCell><mxCell id="n13" parent="1" edge="1" style="fontFamily=Apple SD Gothic Neo;edgeStyle=none;rounded=0;strokeColor=#5F6B77;strokeWidth=1.7;endArrow=none;endFill=0;dashed=1;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="435" y="257" /><mxPoint as="targetPoint" x="1355" y="275" /><Array as="points"><mxPoint x="435" y="275" /></Array></mxGeometry></mxCell><mxCell id="n14" parent="1" edge="1" style="fontFamily=Apple SD Gothic Neo;edgeStyle=none;rounded=0;strokeColor=#5F6B77;strokeWidth=1.7;endArrow=none;endFill=0;dashed=1;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="985" y="257" /><mxPoint as="targetPoint" x="1355" y="275" /><Array as="points"><mxPoint x="985" y="275" /></Array></mxGeometry></mxCell><mxCell id="n15" parent="1" edge="1" style="fontFamily=Apple SD Gothic Neo;edgeStyle=none;rounded=0;strokeColor=#5F6B77;strokeWidth=1.7;endArrow=none;endFill=0;dashed=1;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="15
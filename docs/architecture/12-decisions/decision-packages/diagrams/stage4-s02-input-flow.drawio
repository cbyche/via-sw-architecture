0" y="976" /><mxPoint as="targetPoint" x="220" y="1510" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e25" style="edgeStyle=none;rounded=0;strokeColor=#C7D1DD;strokeWidth=1;endArrow=none;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="644" y="976" /><mxPoint as="targetPoint" x="644" y="1510" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e27" style="edgeStyle=none;rounded=0;strokeColor=#C7D1DD;strokeWidth=1;endArrow=none;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1068" y="976" /><mxPoint as="targetPoint" x="1068" y="1510" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e29" style="edgeStyle=none;rounded=0;strokeColor=#C7D1DD;strokeWidth=1;endArrow=none;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1492" y="976" /><mxPoint as="targetPoint" x="1492" y="1510" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e31" style="edgeStyle=none;rounded=0;strokeColor=#C7D1DD;strokeWidth=1;endArrow=none;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1916" y="976" /><mxPoint as="targetPoint" x="1916" y="1510" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e33" style="edgeStyle=none;rounded=0;strokeColor=#C7D1DD;strokeWidth=1;endArrow=none;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="2340" y="976" /><mxPoint as="targetPoint" x="2340" y="1510" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e34" style="edgeStyle=none;rounded=0;strokeColor=#263445;strokeWidth=2;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="220" y="1027" /><mxPoint as="targetPoint" x="644" y="1027" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e36" style="edgeStyle=none;rounded=0;strokeColor=#263445;strokeWidth=2;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="644" y="1101" /><mxPoint as="targetPoint" x="1068" y="1101" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e38" style="edgeStyle=none;rounded=0;strokeColor=#263445;strokeWidth=2;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1068" y="1175" /><mxPoint as="targetPoint" x="1492" y="1175" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e40" style="edgeStyle=none;rounded=0;strokeColor=#263445;strokeWidth=2;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1492" y="1249" /><mxPoint as="targetPoint" x="1068" y="1249" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e42" style="edgeStyle=none;rounded=0;strokeColor=#263445;strokeWidth=2;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1068" y="1323" /><mxPoint as="targetPoint" x="644" y="1323" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e44" style="edgeStyle=none;rounded=0;strokeColor=#263445;strokeWidth=2;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="644" y="1397" /><mxPoint as="targetPoint" x="1916" y="1397" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e46" style="edgeStyle=none;rounded=0;strokeColor=#263445;strokeWidth=2;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1916" y="1471" /><mxPoint as="targetPoint" x="2340" y="1471" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e49" style="edgeStyle=none;rounded=0;strokeColor=#C7D1DD;strokeWidth=2;endArrow=none;endFill=0;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="64" y="1954" /><mxPoint as="targetPoint" x="2496" y="1954" /><Array as="points" /></mxGeometry></mxCell><mxCell id="screen-actor0" value="OS와 앱" style="shape=hexagon;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=19;fontStyle=1;fillColor=#F7F9FC;strokeColor=#263445;fontColor=#263445;strokeWidth=1.7;" vertex="1" parent="1"><mxGeometry as="geometry" x="105" y="320" width="230" height="104" /></mxCell><mxCell id="voice-actor0" value="마이크" style="shape=hexagon;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=19;fontStyle=1;fillColor=#F7F9FC;strokeColor=#263445;fontColor=#263445;strokeWidth=1.7;" vertex="1" parent="1"><mxGeometry as="geometry" x="105" y="872" width="230" height="104" /></mxCell><mxCell id="voice-actor2" value="Speech Input Worker&lt;br&gt;인식 실행 경계" style="shape=hexagon;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=19;fontStyle=1;fillColor=#F7F9FC;strokeColor=#263445;fontColor=#263445;strokeWidth=1.7;" vertex="1" parent="1"><mxGeometry as="geometry" x="953" y="872" width="230" height="104" /></mxCell><mxCell id="voice-actor3" value="Streaming ASR&lt;br&gt;인식 모델" style="shape=hexagon;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=19;fontStyle=1;fillColor=#F7F9FC;strokeColor=#263445;fontColor=#263445;strokeWidth=1.7;" vertex="1" parent="1"><mxGeometry as="geometry" x="1377" y="872" width="230" height="104" /></mxCell><mxCell id="voice-actor5" value="공유 Omni&lt;br&gt;음성 처리" style="shape=hexagon;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=19;fontStyle=1;fillColor=#F7F9FC;strokeColor=#263445;fontColor=#263445;strokeWidth=1.7;" vertex="1" parent="1"><mxGeometry as="geometry" x="2225" y="872" width="230" height="104" /></mxCell><mxCell id="e2" value="VIA  /  ARCHITECTURE REVIEW" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=18;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="42" width="309.32" height="30.3" /></mxCell><mxCell id="e3" value="S-02 / 공통 입력  /  STAGE 04" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=18;fontStyle=1;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2181.64" y="42" width="314.36" height="30.3" /></mxCell><mxCell id="e4" value="화면 변화와 사용자 음성은 서로 다른 경로로 들어온다" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=42;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="87" width="1114.28" height="62.7" /></mxCell><mxCell id="e5" value="T와 A의 공통 입력. 위아래 흐름은 병행하며 각 흐름의 번호는 독립적이다. 모델은 연동 대상이고 원격 배치를 뜻하지 않는다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=23;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="151" width="1425.72" height="37.05" /></mxCell><mxCell id="e8" value="화면 수집 / 입력 활성 + 수집 권한이 있을 때" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=26;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="88" y="258" width="601.32" height="41.1" /></mxCell><mxCell id="e14" value="1. 화면 변경과 사용자 조작 알림 구독" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="232" y="446" width="387.2" height="33.0" /></mxCell><mxCell id="e16" value="2. 변경 알림 또는 주기 수집 → 화면 이미지와 조작 정보 확보" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="232" y="520" width="621.6" height="33.0" /></mxCell><mxCell id="e18" value="3. 화면 기록 관리자가 발생 시각과 함께 보관" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1770" y="598" width="459.6" height="33.0" /></mxCell><mxCell id="e19" value="같은 화면은 참조 재사용. A는 새 기록이 준비되면 Screen Grounding Service에 알린다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="88" y="687" width="869.08" height="31.650000000000002" /></mxCell><mxCell id="e21" value="음성 입력 / 사용자가 말할 때" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=26;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="88" y="810" width="390.72" height="41.1" /></mxCell><mxCell id="e35" value="1. 음성 도착 → 발화 시작 감지, 관련 화면 기록 유지, Request Controller에 시작 알림" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="232" y="998" width="914.4" height="33.0" /></mxCell><mxCell id="e37" value="2. 연속 음성 전달" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="656" y="1072" width="190.0" height="33.0" /></mxCell><mxCell id="e39" value="3. 음성 인식 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1080" y="1146" width="190.0" height="33.0" /></mxCell><mxCell id="e41" value="4. 인식 문장, 수정과 발화 시간 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1080" y="1220" width="379.6" height="33.0" /></mxCell><mxCell id="e43" value="5. 인식 근거 전달 → 입력 시각 연결기가 당시 화면과 연결" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="656" y="1294" width="589.2" height="33.0" /></mxCell><mxCell id="e45" value="6. 같은 음성 참조 전달 / 2~5와 병행" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="656" y="1368" width="389.2" height="33.0" /></mxCell><mxCell id="e47" value="7. 공유 Omni 음성 처리 / ASR 완료를 기다리지 않음" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1928" y="1442" width="543.6" height="33.0" /></mxCell><mxCell id="e48" value="1의 발화 시작은 ASR 문장이 나온 뒤가 아니다. S2S 결과와 불일치 처리는 별도 응답 계약을 따른다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="88" y="1535" width="955.72" height="31.650000000000002" /></mxCell><mxCell id="e50" value="색:  검정 = 공통     파랑 = T 전용     초록 = A/B 전용" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=19;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="1972" width="584.84" height="31.650000000000002" /></mxCell><mxCell id="e51" value="실선 → 요청/전달     점선 → 결과/복원" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=18;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2126.92" y="1972" width="369.08" height="30.3" /></mxCell><mxCell id="e52" value="모양:  제목 칸이 있는 박스 = Component   |   내부 둥근 박스 = Module   |   원통 = 저장소   |   접힌 종이 = 자료   |   육각형 = 연동 대상/모델" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=17;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="2010" width="1347.26" height="28.950000000000003" /></mxCell><mxCell id="e53" value="화면 수집은 발화 조각마다 시작되지 않는다. 관련 기록 유지와 시간 연결은 Interaction Manager의 서로 다른 내부 책임이다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=17;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="2050" width="1084.44" height="28.950000000000003" /></mxCell><mxCell id="e54" value="탐색안 / 미채택 / 미측정" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=17;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2271.76" y="2050" width="224.24" height="28.950000000000003" /></mxCell></root></mxGraphModel></diagram></mxfile>

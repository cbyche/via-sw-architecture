<mxfile host="app.diagrams.net" type="device"><diagram id="stage4-s02-input-flow" name="화면 변화와 사용자 음성은 서로 다른 경로로 들어온다"><mxGraphModel page="1" pageWidth="2560" pageHeight="2100" grid="1" gridSize="8"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="e1" value="" style="rounded=1;arcSize=4;fillColor=#263445;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="0" y="0" width="2560" height="9" /></mxCell><mxCell id="e7" value="" style="rounded=1;arcSize=4;fillColor=#FAFBFD;strokeColor=#C7D1DD;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="240" width="2432" height="512" /></mxCell><mxCell id="e20" value="" style="rounded=1;arcSize=4;fillColor=#FAFBFD;strokeColor=#C7D1DD;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="792" width="2432" height="808" /></mxCell><mxCell id="screen-actor1" value="Interaction Manager" style="swimlane;html=1;startSize=62;horizontal=1;align=left;spacingLeft=18;fontSize=17;fontStyle=1;fillColor=white;swimlaneFillColor=white;strokeColor=#263445;fontColor=#263445;strokeWidth=2.2;collapsible=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2225" y="320" width="230" height="104" /></mxCell><mxCell id="voice-actor1" value="Interaction&lt;br&gt;Manager" style="swimlane;html=1;startSize=62;horizontal=1;align=left;spacingLeft=18;fontSize=17;fontStyle=1;fillColor=white;swimlaneFillColor=white;strokeColor=#263445;fontColor=#263445;strokeWidth=2.2;collapsible=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="529" y="872" width="230" height="104" /></mxCell><mxCell id="voice-actor4" value="Model Access" style="swimlane;html=1;startSize=62;horizontal=1;align=left;spacingLeft=18;fontSize=17;fontStyle=1;fillColor=white;swimlaneFillColor=white;strokeColor=#263445;fontColor=#263445;strokeWidth=2.2;collapsible=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1801" y="872" width="230" height="104" /></mxCell><mxCell id="e6" style="edgeStyle=none;rounded=0;strokeColor=#C7D1DD;strokeWidth=2;endAr
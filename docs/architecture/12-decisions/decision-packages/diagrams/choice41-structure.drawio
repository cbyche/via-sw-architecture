mxGeometry as="geometry" x="2117" y="2590" width="138.32" height="30.3" /></mxCell><mxCell id="e157" value="접수/결과" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2322" y="2640" width="91.16" height="30.3" /></mxCell><mxCell id="e161" value="5  미해결이면 질문 / 8  확인된 상태 전달" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1377" y="2320" width="393.92" height="30.3" /></mxCell><mxCell id="e163" value="실제 게시 기록" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1732" y="2470" width="138.32" height="30.3" /></mxCell><mxCell id="e165" value="6  사용자 답변은 새 입력" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1327" y="2410" width="236.96" height="30.3" /></mxCell><mxCell id="e167" value="질문/응답 Text와 음성" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1377" y="2720" width="212.12" height="30.3" /></mxCell><mxCell id="e169" value="실제 전달 구간" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1732" y="2800" width="138.32" height="30.3" /></mxCell><mxCell id="e170" value="B: 코드가 틀을 해결. 표현 밖 관계는 질문/미지원으로 반환.&lt;br&gt;현재 권한은 Policy Manager에 확인. 응답 추론은 Model Access 경유.&lt;br&gt;채택 기록은 State Store 보관. 이 공통 왕복은 사건도에서 펼침." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1342" y="2990" width="705.3" height="99" /></mxCell><mxCell id="e171" value="검정: 공통 / 파랑: A / 초록: B. 네모: Component/Module 이름." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="3200" width="625.76" height="30.3" /></mxCell><mxCell id="e172" value="실선: 요청/전달 / 점선: 반환. 원통: 상태. 별도 process 가정 없음." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="3235" width="647.0" height="30.3" /></mxCell><mxCell id="e173" value="같은 이름은 동일 인스턴스. 그림은 설계안이며 구현/측정 결과가 아님." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="3270" width="634.76" height="30.3" /></mxCell></root></mxGraphModel></diagram></mxfile>

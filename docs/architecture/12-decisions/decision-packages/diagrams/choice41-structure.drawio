=14;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=21;fontStyle=1;fillColor=white;strokeColor=#000000;fontColor=#000000;strokeWidth=1.3;" vertex="1" parent="Bfinish"><mxGeometry as="geometry" x="30" y="67" width="290" height="64" /></mxCell><mxCell id="Bagent" value="Downstream Agent" style="shape=hexagon;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=25;fontStyle=1;fillColor=white;strokeColor=#000000;fontColor=#000000;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry as="geometry" x="2173" y="1280" width="290" height="62" /></mxCell><mxCell id="e206" value="" style="shape=cylinder;size=14;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fillColor=white;strokeColor=#000000;fontColor=#000000;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry as="geometry" x="925" y="1373" width="130" height="28" /></mxCell><mxCell id="e229" value="" style="shape=hexagon;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=25;fontStyle=1;fillColor=white;strokeColor=#000000;fontColor=#000000;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry as="geometry" x="1530" y="1380" width="60" height="28" /></mxCell><mxCell id="e231" value="" style="shape=note;size=20;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=25;fontStyle=1;fillColor=white;strokeColor=#000000;fontColor=#000000;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry as="geometry" x="600" y="1373" width="160" height="28" /></mxCell><mxCell id="e2" value="VIA / 04-41 / 다음 조회와 의미 생산의 판단 주체" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#000000;fontSize=26;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="25" width="600.94" height="37.05" /></mxCell><mxCell id="e3" value="설계 비교 · 미선정 · 미측정" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#000000;fontSize=26;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2158.18" y="25" width="337.82" height="37.05" /></mxCell><mxCell id="e4" value="모델이 근거를 읽고 전체 의미를 판단할까, 코드가 요청 틀의 항목을 해결할까?" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=40;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="65" width="1545.6" height="60.0" /></mxCell><mxCell id="e5" value="“이 표를 아까 보고서에 넣고, 메일은 보내지 말고 결과를 바탕으로 초안만 만들어.”" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=28;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="122" width="1164.4" height="43.800000000000004" /></mxCell><mxCell id="e6" value="Task1: 예산 보고서 / Task2: 실적 보고서 → 확인 질문 → “예산 보고서” 답변 → Task1 연결 / 보고서 결과로 메일 초안" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#000000;fontSize=24;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="162" width="1469.6" height="38.400000000000006" /></mxCell><mxCell id="e7" value="조회 전 정답 업무는 미정 / VIA는 기기 내, 모델은 클라우드 / 같은 Component의 반복 표기는 같은 인스턴스 / 데이터는 설명용 예시" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#000000;fontSize=17;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="196" width="1145.98" height="28.950000000000003" /></mxCell><mxCell id="e9" value="A  모델이 조회 선택 → 근거로 재판단 → 전체 의미 제안" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#000000;fontSize=27;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="80" y="231" width="755.36" height="42.45" /></mxCell><mxCell id="e18" value="실제 의미 판단: 클라우드 LLM" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#000000;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="925" y="550" width="277.28" height="30.3" /></mxCell><mxCell id="e19" value="코드/모델 구분은 책임의 구분" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#000000;fontSize=17;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="925" y="578" width="254.16" height="28.950000000000003" /></mxCell><mxCell id="e20" value="Interaction Manager:&lt;br&gt;로컬 VAD·지속 입력 / 시점 연결" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#000000;fontSize=15;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="925" y="626" width="251.0" height="46" /></mxCell><mxCell id="e22" value="발화·근거·버전" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#000000;fontSize=17;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="419" y="263" width="131.07999999999998" height="28.950000000000003" /></mxCell><mxCell id="e28" value="추론 요청 / 모델 결과" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#000000;fontSize=17;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="925" y="435" width="196.7" height="28.950000000000003" /></mxCell><mxCell id="e34" value="VIA 코드: 모델 제안을 실행·제한" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="180" y="426" width="323.02" height="31.650000000000002" /></mxCell><mxCell id="e39" value="1  모델의 다음 읽기 선택" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#B8753F;fontSize=22;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="500" y="515" width="287.84" height="35.7" /></mxCell><mxCell id="e41" value="3  근거로 모델 재판단" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#B8753F;fontSize=22;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="490" y="750" width="252.2" height="35.7" /></mxCell><mxCell id="e43" value="교환 데이터 예시 · 조회 요청 (ReadRequest)" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#000000;fontSize=12.090909090909092;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="512" y="549" width="290.92727272727274" height="22.322727272727274" /></mxCell><mxCell id="e44" value="업무 조회 도구&lt;br&gt;조건: “아까 보고서”" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="512" y="574" width="199.9" height="53.12" /></mxCell><mxCell id="e46" value="교환 데이터 예시 · 조회 결과 (EvidenceBundle)" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#000000;fontSize=12.938689217758986;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent
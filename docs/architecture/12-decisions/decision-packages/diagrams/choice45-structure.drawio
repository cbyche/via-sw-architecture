<mxfile host="app.diagrams.net" type="device"><diagram id="choice45-structure" name="04-45. VIA 과거 근거의 요청별 구성과 공통 생산/조회"><mxGraphModel dx="1920" dy="1080" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n1" parent="1" vertex="1" value="" style="fontFamily=Apple SD Gothic Neo;rounded=0;fillColor=white;strokeColor=none;strokeWidth=1.7;"><mxGeometry as="geometry" x="0" y="0" width="1920" height="1080" /></mxCell><mxCell id="n2" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;VIA SOFTWARE ARCHITECTURE / DP 설계 비교&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=19;fontColor=#087E8B;fontStyle=1;"><mxGeometry as="geometry" x="40" y="22" width="1300" height="24.7" /></mxCell><mxCell id="n3" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;구조 비교 / 장단점 / QA Trade-off&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=right;verticalAlign=top;spacing=0;fontSize=19;fontColor=#5F6B77;fontStyle=0;"><mxGeometry as="geometry" x="1430" y="22" width="450" height="24.7" /></mxCell><mxCell id="n4" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;04-45. VIA 과거 근거의 요청별 구성과 공통 생산/조회&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=39;fontColor=#18232E;fontStyle=1;"><mxGeometry as="geometry" x="40" y="65" width="1840" height="50.7" /></mxCell><mxCell id="n5" parent="1" edge="1" style="fontFamily=Apple SD Gothic Neo;edgeStyle=none;rounded=0;strokeColor=#CDD6DE;strokeWidth=2;endArrow=none;endFill=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint"
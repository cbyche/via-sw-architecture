99998" height="17.1675" /></mxCell><mxCell id="n233" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.17;&quot;&gt;좌우 칸: 배치용 레이아웃&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=12.75;fontColor=#000000;fontStyle=0;"><mxGeometry as="geometry" x="1547.5" y="817.25" width="315.0" height="14.9175" /></mxCell><mxCell id="n234" parent="1" vertex="1" value="" style="fontFamily=Apple SD Gothic Neo;rounded=0;fillColor=white;strokeColor=none;strokeWidth=1.7;"><mxGeometry as="geometry" x="1546.0" y="843.5" width="187.62" height="17.1675" /></mxCell><mxCell id="n235" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.17;&quot;&gt;실행 / 서비스 경계 추가 없음&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=12.75;fontColor=#000000;fontStyle=0;"><mxGeometry as="geometry" x="1547.5" y="844.25" width="315.0" height="14.9175" /></mxCell><mxCell id="n236" parent="1" edge="1" style="fontFamily=Apple SD Gothic Neo;edgeStyle=none;rounded=0;strokeColor=#C7D1DD;strokeWidth=1;endArrow=none;endFill=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="40" y="878" /><mxPoint as="targetPoint" x="1880" y="878" /><Array as="points" /></mxGeometry></mxCell><mxCell id="n237" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;첫 요청: A 필요한 원본 구성 / B 지원 범위 미게시면 생산 후 재조회. 반복: A warm cache / B 유효 게시 재사용.&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=19;fontColor=#263445;fontStyle=0;"><mxGeometry as="geometry" x="40" y="899" width="1840" height="24.7" /></mxCell><mxCell id="n238" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;정정: 영향 자료 사용부터 fence → 부분 갱신. 미지원: 반복 생산으로 해결하지 않음. 직접 원본 조합 우회는 명시 B+.&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=18;fontColor=#263445;fontStyle=0;"><mxGeometry as="geometry" x="40" y="932" width="1840" height="23.400000000000002" /></mxCell><mxCell id="n239" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;Memory1은 실제 전달된 예외 문구 한 구간. 전체 평가 기준을 모두 생산한 예가 아니므로 Bundle1은 PARTIAL, Coverage에 gap.&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=17;fontColor=#263445;fontStyle=0;"><mxGeometry as="geometry" x="40" y="965" width="1840" height="22.1" /></mxCell><mxCell id="n240" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;비용: 현재 판단은 공통 / 생산·갱신·미사용·retry·stale 청구 포함. cloud weights/KV는 PC RAM에 포함하지 않음.&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=17;fontColor=#263445;fontStyle=0;"><mxGeometry as="geometry" x="40" y="999" width="1840" height="22.1" /></mxCell><mxCell id="n241" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;큰 박스: Component / 안의 Module·State: owner 소속. Source View Cache는 공통. 서비스·process 분리를 이 그림에서 선택하지 않음.&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=16;fontColor=#5B697B;fontStyle=0;"><mxGeometry as="geometry" x="40" y="1044" width="1840" height="20.8" /></mxCell></root></mxGraphModel></diagram></mxfile>

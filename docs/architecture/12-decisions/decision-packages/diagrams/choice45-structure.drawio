ometry as="geometry" x="28" y="84" width="384" height="90" /></mxCell><mxCell id="Baccess" value="Model Access" style="shape=hexagon;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=25;fontStyle=1;fillColor=#F7F9FC;strokeColor=#263445;fontColor=#263445;strokeWidth=1.7;" vertex="1" parent="1"><mxGeometry as="geometry" x="1776" y="1310" width="300" height="62" /></mxCell><mxCell id="Bomni" value="Shared Omni" style="shape=hexagon;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=25;fontStyle=1;fillColor=#F7F9FC;strokeColor=#263445;fontColor=#263445;strokeWidth=1.7;" vertex="1" parent="1"><mxGeometry as="geometry" x="2196" y="1310" width="300" height="62" /></mxCell><mxCell id="e2" value="VIA / 45 / MEMORY AND CONTEXT" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=23;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="24" width="421.54" height="37.05" /></mxCell><mxCell id="e3" value="설계 후보 / 미선정 / 미측정" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=23;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2158.18" y="24" width="337.82" height="37.05" /></mxCell><mxCell id="e4" value="과거 근거를 요청마다 조합할 것인가, 공통 기억으로 유지할 것인가?" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=40;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="70" width="1336.0" height="60.0" /></mxCell><mxCell id="e5" value="같은 현재 요청 R9   “지난번에 내가 고친 표현 방식으로 이번 보고서도 정리해줘.”" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=30;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="131" width="1242.8" height="46.5" /></mxCell><mxCell id="e6" value="같은 이력: D2 보고서 → R7 “짧은 문장, 결론 먼저” → 수정 결과 D3 → 실제 제시 P4. 이 사례의 재사용은 선호 저장이 아니다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=25;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="178" width="1603.0" height="39.75" /></mxCell><mxCell id="e8" value="A  원본 서비스 조합" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=35;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="242" width="361.5" height="53.25" /></mxCell><mxCell id="e9" value="B  공유 파생 기억 저장소" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=35;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1340" y="242" width="453.2" height="53.25" /></mxCell><mxCell id="e10" value="요청의 질문 → 원본별 읽기 → 이번 요청의 근거 묶음" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=25;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="291" width="653.5" height="39.75" /></mxCell><mxCell id="e11" value="확정된 변경 → 출처 있는 과거 관계 게시 → 여러 요청이 읽기" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=25;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1340" y="291" width="759.5" height="39.75" /></mxCell><mxCell id="e13" value="R7 원문 / 정정 관계" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#5B697B;fontSize=23;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="415.12" width="245.82" height="37.05" /></mxCell><mxCell id="e15" value="P4 실제 전달 기록" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#5B697B;fontSize=23;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="470" y="415.12" width="217.3" height="37.05" /></mxCell><mxCell id="e17" value="D2 → D3 확정 결과" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#5B697B;fontSize=23;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="840" y="415.12" width="228.34" height="37.05" /></mxCell><mxCell id="e19" value="R7 원문 / 정정 관계" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#5B697B;fontSize=23;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1376" y="415.12" width="245.82" height="37.05" /></mxCell><mxCell id="e21" value="P4 실제 전달 기록" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#5B697B;fontSize=23;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1746" y="415.12" width="217.3" height="37.05" /></mxCell><mxCell id="e23" value="D2 → D3 확정 결과" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#5B697B;fontSize=23;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2116" y="415.12" width="228.34" height="37.05" /></mxCell><mxCell id="e35" value="읽기 범위, 질문, 권한 →" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=24;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="90" y="523.16" width="304.16" height="38.400000000000006" /></mxCell><mxCell id="e36" value="← 원문 / 버전 / 누락 범위" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=24;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="730" y="598.64" width="333.92" height="38.400000000000006" /></mxCell><mxCell id="e38" value="읽기 / 오류 무효화" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=24;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="138" y="737.02" width="235.52" height="38.400000000000006" /></mxCell><mxCell id="e41" value="이번 요청에 결합" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=24;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="815" y="737.02" width="205.76" height="38.400000000000006" /></mxCell><mxCell id="e42" value="원본별 요약, 색인, cache / 배경 갱신 가능" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=22;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="116" y="863.56" width="498.6" height="31" /></mxCell><mxCell id="e43" value="R9의 근거 / 요청 범위" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=22;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="
8" y="995.0" /></Array></mxGeometry></mxCell><mxCell id="wire48" source="input_handler" target="task_command" edge="1" parent="1" style="edgeStyle=none;rounded=0;strokeColor=#263445;strokeWidth=2;endArrow=open;endFill=0;exitX=0.0;exitY=0.7857142857142857;exitPerimeter=0;entryX=1.0;entryY=0.5;entryPerimeter=0;"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint as="point" x="610" y="1237.5" /><mxPoint as="point" x="610" y="1187.5" /></Array></mxGeometry></mxCell><mxCell id="wire49" source="pub_handler" target="input_data" edge="1" parent="1" style="edgeStyle=none;rounded=0;strokeColor=#195FBD;strokeWidth=2;endArrow=open;endFill=0;dashed=1;exitX=1.0;exitY=0.7857142857142857;exitPerimeter=0;entryX=0.0;entryY=0.5;entryPerimeter=0;"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint as="point" x="3758" y="1237.5" /><mxPoint as="point" x="3758" y="1698" /><mxPoint as="point" x="598" y="1698" /><mxPoint as="point" x="598" y="850" /></Array></mxGeometry></mxCell><mxCell id="wire50" source="pub_handler" target="join_condition" edge="1" parent="1" style="edgeStyle=none;rounded=0;strokeColor=#195FBD;strokeWidth=2;endArrow=open;endFill=0;dashed=1;exitX=1.0;exitY=0.8714285714285714;exitPerimeter=0;entryX=1.0;entryY=0.7727272727272727;entryPerimeter=0;"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint as="point" x="3738" y="1252.5" /><mxPoint as="point" x="3738" y="1718" /><mxPoint as="point" x="3090" y="1718" /><mxPoint as="point" x="3090" y="880" /></Array></mxGeometry></mxCell><mxCell id="note0" parent="1" vertex="1" value="VIA / DP-44 / 구현을 가정한 실행 구조" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=26;fontStyle=1;align=left;spacing=0;"><mxGeometry as="geometry" x="64" y="19" width="702" height="33.800000000000004" /></mxCell><mxCell id="note1" parent="1" vertex="1" value="문서 설계안 / A/B 미선정 / 제품 실행과 측정 없음" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=24;fontStyle=0;align=right;spacing=0;"><mxGeometry as="geometry" x="3032" y="21" width="744" height="31.200000000000003" /></mxCell><mxCell id="note2" parent="1" vertex="1" value="B: 각 Stage가 자기 완료를 처리하고 고정 채널로 후속 실행을 연결" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=43;fontStyle=1;align=left;spacing=0;"><mxGeometry as="geometry" x="64" y="69" width="1720" height="55.9" /></mxCell><mxCell id="note3" parent="1" vertex="1" value="같은 기능과 공통 실행 기반. 차이는 완료의 수신자, 다음 실행의 결정 코드, Job과 대기 조건의 소유 위치다." style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=29;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="64" y="143" width="1827" height="37.7" /></mxCell><mxCell id="note4" parent="1" vertex="1" value="release" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=21;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="3630" y="444" width="147" height="27.3" /></mxCell><mxCell id="note5" parent="1" vertex="1" value="ActualReceipt" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=21;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="3550" y="759" width="273" height="27.3" /></mxCell><mxCell id="note6" parent="1" vertex="1" value="같은 정정: R1 rev1의 전체 요약 Job J1 실행 중 → “아니, 결론만” → R1 rev2 채택. J1은 취소 요청 뒤에도 늦게 완료할 수 있다." style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=27;fontStyle=1;align=left;spacing=0;"><mxGeometry as="geometry" x="64" y="1713" width="2322" height="35.1" /></mxCell><mxCell id="note7" parent="1" vertex="1" value="실행 가정: 공통 bounded async executor와 blocking worker pool. 각 Pump는 자기 상태를 순차 갱신하고 긴 Job을 기다리지 않는다." style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=25;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="64" y="2005" width="2375" height="32.5" /></mxCell><mxCell id="note8" parent="1" vertex="1" value="검정 실선 = 직접 호출 / dequeue    파랑 실선 = enqueue    파랑 점선 = 완료 callback의 enqueue    빨강 점선 = 제어 / 취소    회색 점선 = 상태 읽기와 갱신" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=23;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="64" y="2047" width="2622" height="29.900000000000002" /></mxCell><mxCell id="note9" parent="1" vertex="1" value="칸이 있는 박스 = queue    둥근 박스 = 코드    원통 = RAM 상태 또는 DURABLE 기록    접힌 문서 = immutable 메시지. Port는 typed 계약이며 queue와 구별한다." style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=23;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="64" y="2087" width="2645" height="29.900000000000002" /></mxCell><mxCell id="note10" parent="1" vertex="1" value="Context Manager, Policy Manager, State Store, Model Access 및 Agent Gateway의 공통 계약 유지. 별도 thread / process 수와 라이브러리는 미선정." style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=none;fontColor=#758294;fontSize=22;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="64" y="2123" width="2640" height="28.6" /></mxCell><mxCell id="note11" parent="1" vertex="1" value="InterpretAsync / cancel own handle" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=21;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="650" y="1257" width="714" height="27.3" /></mxCell><mxCell id="note12" parent="1" vertex="1" value="own JobDone" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=21;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="600" y="904" width="231" height="27.3" /></mxCell><mxCell id="note13" parent="1" vertex="1" value="own JobDone" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=21;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="2290" y="1499" width="231" height="27.3" /></mxCell><mxCell id="note14" parent="1" vertex="1" value="Candidate{ID, rev, refs}" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=21;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="2460" y="569" width="504" height="27.3" /></mxCell><mxCell id="note15" parent="1" vertex="1" value="eligible만 PublishRequest" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=21;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="2810" y="584" width="504" height="27.3" /></mxCell><mxCell id="note16" parent="1" vertex="1" value="adopted input → prepare port" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=21;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="1820" y="769" width="588" height="27.3" /></mxCell><mxCell id="note17" parent="1" vertex="1" value="조건은 별도 queue에 fan-out" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=21;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="2530" y="769" width="441" height="27.3" /></mxCell><mxCell id="note18" parent="1" vertex="1" value="InputReady" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=21;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="650" y="769" width="210" height="27.3" /></mxCell><mxCell id="note19" parent="1" vertex="1" value="ConfirmedTaskEvent" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=21;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="1270" y="769" width="378" height="27.3" /></mxCell><mxCell id="note20" parent="1" vertex="1" value="InputStarted fan-out: local stop 후 각 Control Queue에 복사" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#B63732;fontSize=20;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="1380" y="445" width="1080" height="26.0" /></mxCell><mxCell id="note21" parent="1" vertex="1" value="채택된 Invalidate: ID / revision / scope를 각 consumer에 전달" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#B63732;fontSize=20;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="2210" y="465" width="1060" height="26.0" /></mxCell><mxCell id="note22" parent="1" vertex="1" value="durable Presented → Input Resolution Stage의 focus 처리" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=21;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="1820" y="1687" width="1092" height="27.3" /></mxCell><mxCell id="note23" parent="1" vertex="1" value="과거 확정 delivery snapshot" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=21;fontStyle=0;align=left;spacing=0;"><mxGeometry as=
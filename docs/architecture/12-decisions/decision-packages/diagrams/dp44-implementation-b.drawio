r;verticalAlign=middle;fontSize=20;fontStyle=1;fillColor=#F7F9FC;strokeColor=#263445;fontColor=#263445;strokeWidth=1.7;fillColor=#FFF0DD;strokeColor=#B8753F;" vertex="1" parent="rm"><mxGeometry as="geometry" x="40" y="255" width="240" height="120" /></mxCell><mxCell id="condition_q" value="Condition Queue&lt;br&gt;admission / source&lt;br&gt;settled / past delivery" style="shape=cylinder;size=14;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fillColor=#F7F9FC;strokeColor=#263445;fontColor=#263445;strokeWidth=1.7;fillColor=#FFF0DD;strokeColor=#B8753F;" vertex="1" parent="rm"><mxGeometry as="geometry" x="340" y="255" width="240" height="120" /></mxCell><mxCell id="join" value="Publication Join&lt;br&gt;ID / revision이 맞는 입력끼리 조건 검사" style="rounded=1;arcSize=15;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fillColor=#F7F9FC;strokeColor=#263445;fontColor=#263445;strokeWidth=1.7;fillColor=#FFF0DD;strokeColor=#B8753F;" vertex="1" parent="rm"><mxGeometry as="geometry" x="40" y="425" width="540" height="90" /></mxCell><mxCell id="publication_window" value="Publication Window (RAM)&lt;br&gt;candidate별 필수 참조 / 대기 / 폐기" style="shape=cylinder;size=14;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fillColor=#F7F9FC;strokeColor=#263445;fontColor=#263445;strokeWidth=1.7;fillColor=#FFF0DD;strokeColor=#B8753F;" vertex="1" parent="rm"><mxGeometry as="geometry" x="40" y="535" width="540" height="115" /></mxCell><mxCell id="e2" value="VIA  /  ARCHITECTURE REVIEW" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=18;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="42" width="309.32" height="30.3" /></mxCell><mxCell id="e3" value="DP-44  /  STAGE 04" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=18;fontStyle=1;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2287.12" y="42" width="208.88" height="30.3" /></mxCell><mxCell id="e4" value="B 구현 구조&lt;br&gt;Stage의 산출물을 다음 소비자의 입력으로 연결" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=34;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="75" width="796.8" height="94" /></mxCell><mxCell id="e5" value="고정 typed-channel wiring + Stage별 짧은 Pump + 국소 Job/Window. 모든 완료를 회수하는 중앙 Dispatcher는 없다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=22;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="166" width="1383.88" height="35.7" /></mxCell><mxCell id="e12" value="같은 Context Manager / 의미 API" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="114" y="593" width="336.68" height="30.3" /></mxCell><mxCell id="e23" value="capture / ASR는 계속 진행&lt;br&gt;전사 확정 ≠ 의미 해소&lt;br&gt;발화 감지 ≠ Task 취소&lt;br&gt;새 입력은 미전송 효과 hold" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=22;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2068" y="545" width="322.6" height="166" /></mxCell><mxCell id="e24" value="8 허용 release를 실제 전달&lt;br&gt;9 receipt는 전달 이후 생성" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2068" y="775" width="311.24" height="78" /></mxCell><mxCell id="e30" value="8 release" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1953" y="966" width="108.44" height="30.3" /></mxCell><mxCell id="e32" value="9" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1950" y="1143" width="20.4" height="33.0" /></mxCell><mxCell id="e33" value="State Store: 각 owner의 확정 기록 저장" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="1215" width="397.52" height="30.3" /></mxCell><mxCell id="e35" value="공통 실행 기반: bounded async executor + blocking worker pool. Module마다 전용 thread나 process를 두지 않는다.&lt;br&gt;짧은 제어 루프는 긴 API 작업을 기다리지 않는다. 취소는 먼저 결과를 무효화하고 provider에 중단을 요청한다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=23;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="1274" width="1482.76" height="84" /></mxCell><mxCell id="e36" value="직각 = Component  /  둥근 박스 = 코드 Module  /  원통 = Queue 또는 상태  /  살구색 = A/B 실행 조직의 차이" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" 
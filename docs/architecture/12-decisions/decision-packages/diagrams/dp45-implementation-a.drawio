verflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=28;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="64" y="140" width="1413.6" height="36.4" /></mxCell><mxCell id="note4" parent="1" vertex="1" value="입력 등록" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=21;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="390" y="430" width="105.86" height="27.3" /></mxCell><mxCell id="note5" parent="1" vertex="1" value="0  허용된 현재 요청에서 조회 시작" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=24;fontStyle=1;align=left;spacing=0;"><mxGeometry as="geometry" x="64" y="958" width="430.88" height="31.2" /></mxCell><mxCell id="note6" parent="1" vertex="1" value="현재 요청 해석" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=21;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="365" y="1249" width="161.72" height="27.3" /></mxCell><mxCell id="note7" parent="1" vertex="1" value="공통 후속: 의미 제안 → 현재 검사 → 채택" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=24;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="64" y="1460" width="534.56" height="31.2" /></mxCell><mxCell id="note8" parent="1" vertex="1" value="위임은 채택 후에만 수행" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=26;fontStyle=1;align=left;spacing=0;"><mxGeometry as="geometry" x="64" y="1934" width="319.48" height="33.8" /></mxCell><mxCell id="note9" parent="1" vertex="1" value="Task Manager → Agent Gateway&lt;br&gt;→ Downstream Agent: 제안서 작성" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=24;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="64" y="1979" width="468.8" height="62.4" /></mxCell><mxCell id="note10" parent="1" vertex="1" value="실선 = 요청 / 점선 파랑 = 완료 / 빨강 = 사용 차단 / 회색 = 상태 접근. 선 교차는 접속점이 아니다." style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=24;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="64" y="2082" width="1275.2" height="31.2" /></mxCell><mxCell id="note11" parent="1" vertex="1" value="양안 공통: 로컬 VIA, owner별 State Store 저장, bounded async executor. 상자 수는 thread / process / DB 제품 수가 아니다." style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=24;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="64" y="2121" width="1755.2" height="31.2" /></mxCell><mxCell id="note12" parent="1" vertex="1" value="1  Query" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=21;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="678" y="1147" width="118.88" height="27.3" /></mxCell><mxCell id="note13" parent="1" vertex="1" value="2 시작" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=21;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="1342" y="1147" width="77.72" height="27.3" /></mxCell><mxCell id="note14" parent="1" vertex="1" value="3 cache 조회 / 검증한 항목 저장" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=21;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="1120" y="840" width="377.18" height="27.3" /></mxCell><mxCell id="note15" parent="1" verte
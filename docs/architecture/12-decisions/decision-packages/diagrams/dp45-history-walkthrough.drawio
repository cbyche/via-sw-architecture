"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1662" y="1012.0" /><mxPoint as="targetPoint" x="2267.0" y="734" /><Array as="points"><mxPoint x="1696" y="1012" /><mxPoint x="1696" y="783" /><mxPoint x="2267" y="783" /></Array></mxGeometry></mxCell><mxCell id="e38" style="edgeStyle=none;rounded=0;strokeColor=#263445;strokeWidth=2;endArrow=open;endFill=0;dashed=1;exitX=0.5290322580645161;exitY=1.0;exitPerimeter=0;entryX=1.0;entryY=0.5660377358490566;entryPerimeter=0;" edge="1" parent="1" source="Breader" target="Bri"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="2276.0" y="734" /><mxPoint as="targetPoint" x="1662" y="1026.0" /><Array as="points"><mxPoint x="2276" y="797" /><mxPoint x="1710" y="797" /><mxPoint x="1710" y="1026" /></Array></mxGeometry></mxCell><mxCell id="e43" style="edgeStyle=none;rounded=0;strokeColor=#C7D1DD;strokeWidth=2;endArrow=none;endFill=0;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="64" y="1262" /><mxPoint as="targetPoint" x="2496" y="1262" /><Array as="points" /></mxGeometry></mxCell><mxCell id="Aoriginal" value="같은 원본: Request Controller의 입력 / 채택 기록&lt;br&gt;Response Manager: E20 원문 / P20 실제 전달[0:52]&lt;br&gt;Task Manager: T21 → D21 개정 2 / T22 → D22 개정 1" style="shape=note;size=20;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fillColor=#F7F9FC;strokeColor=#263445;fontColor=#263445;strokeWidth=1.7;" vertex="1" parent="1"><mxGeometry as="geometry" x="84" y="298" width="1130" height="136" /></mxCell><mxCell id="Acomposer" value="Context Composer&lt;br&gt;2 원본 후보 읽기 / 유효 cache / 이번 조합" style="rounded=1;arcSize=15;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fillColor=#F7F9FC;strokeColor=#263445;fontColor=#263445;strokeWidth=1.7;fillColor=#FFF0DD;strokeColor=#B8753F;" vertex="1" parent="Acm"><mxGeometry as="geometry" x="40" y="116" width="660" height="110" /></mxCell><mxCell id="Acache" value="Source View Cache&lt;br&gt;검증한 자료 재사용" style="shape=cylinder;size=14;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fillColor=#F7F9FC;strokeColor=#263445;fontColor=#263445;strokeWidth=1.7;" vertex="1" parent="Acm"><mxGeometry as="geometry" x="40" y="344" width="310" height="100" /></mxCell><mxCell id="Aset" value="Request Evidence Set&lt;br&gt;이번 query의 근거" style="shape=cylinder;size=14;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fillColor=#F7F9FC;strokeColor=#263445;fontColor=#263445;strokeWidth=1.7;fillColor=#FFF0DD;strokeColor=#B8753F;" vertex="1" parent="Acm"><mxGeometry as="geometry" x="390" y="344" width="310" height="100" /></mxCell><mxCell id="Boriginal" value="같은 원본: Request Controller의 입력 / 채택 기록&lt;br&gt;Response Manager: E20 원문 / P20 실제 전달[0:52]&lt;br&gt;Task Manager: T21 → D21 개정 2 / T22 → D22 개정 1" style="shape=note;size=20;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fillColor=#F7F9FC;strokeColor=#263445;fontColor=#263445;strokeWidth=1.7;" vertex="1" parent="1"><mxGeometry as="geometry" x="1332" y="298" width="1130" height="136" /></mxCell><mxCell id="Bpublisher" value="Memory Publisher&lt;br&gt;2 관계 생산 / 검증" style="rounded=1;arcSize=15;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fillColor=#F7F9FC;strokeColor=#263445;fontColor=#263445;strokeWidth=1.7;fillColor=#FFF0DD;strokeColor=#B8753F;" vertex="1" parent="Bcm"><mxGeometry as="geometry" x="40" y="116" width="310" height="110" /></mxCell><mxCell id="Breader" value="Evidence Reader&lt;br&gt;4 게시 근거 조회" style="rounded=1;arcSize=15;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fillColor=#F7F9FC;strokeColor=#263445;fontColor=#263445;strokeWidth=1.7;fillColor=#FFF0DD;strokeColor=#B8753F;" vertex="1" parent="Bcm"><mxGeometry as="geometry" x="390" y="116" width="310" height="110" /></mxCell><mxCell id="Brepo" value="Episodic Memory Repository&lt;br&gt;PRESENTS / HAS_RESULT / EXPLAINS_ITEM&lt;br&gt;3 관계와 Coverage를 같은 개정으로 게시" style="shape=cylinder;size=14;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fillColor=#F7F9FC;strokeColor=#263445;fontColor=#263445;strokeWidth=1.7;fillColor=#FFF0DD;strokeColor=#B8753F;" vertex="1" parent="Bcm"><mxGeometry as="geometry" x="40" y="312" width="660" height="160" /></mxCell><mxCell id="e2" value="VIA  /  ARCHITECTURE REVIEW" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=18;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="42" width="309.32" height="30.3" /></mxCell><mxCell id="e3" value="DP-45  /  STAGE 04" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=18;fontStyle=1;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2287.12" y="42" width="208.88" height="30.3" /></mxCell><mxCell id="e4" value="같은 과거 기록을 이번 요청의 근거로 만드는 두 구조" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=42;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="87" width="1098.32" height="62.7" /></mxCell><mxCell id="e5" value="R23: “지난번 설명한 평가 기준으로 제품 비교와 견적을 이번 제안서에 반영해줘.” 후보 ID는 조회 후 발견한다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=23;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="151" width="1284.5" height="37.05" /></mxCell><mxCell id="e7" value="A 원본 서비스 조합형" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=32;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="236" width="343.36" height="49.2" /></mxCell><mxCell id="e11" value="현재 R23 / 허용 범위&lt;br&gt;후보 발견 / 추가 조회&lt;br&gt;현재 조건과 Task 의미 제안" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=22;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="104" y="989" width="315.12" height="105" /></mxCell><mxCell id="e16" value="원본 port의 검색 / 범위 읽기 / 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="809" y="463" width="351.08" height="30.3" /></mxCell><mxCell id="e21" value="1 현재 조회 → / 3 Bundle 반환 ←" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="86" y="741" width="363.6" height="33.0" /></mxCell><mxCell id="e22" value="필요한 원본을 추가 조회 / 누락 해결&lt;br&gt;요청별 구성 책임은 Composer에 유지" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=22;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="516" y="978" width="413.68" height="78" /></mxCell><mxCell id="e23" value="현재 조회가 원본 조합을 시작&lt;br&gt;조건부 의미 가공: Model Access&lt;br&gt;→ 같은 클라우드 의미 LLM&lt;br&gt;현재 해석 호출도 양안에 유지" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="86" y="564" width="363.32" height="150" /></mxCell><mxCell id="e24" value="같은 반환: 실제 설명[0:52] + 제품/견적 결과 참조 + 출처 / revision / 누락&lt;br&gt;이 예시에는 REVISES가 없다. 정정 채택 후에만 추가한다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=23;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="84" y="1163" width="938.58" height="78" /></mxCell><mxCell id="e25" value="B 공통 파생 기억 저장소형" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=32;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1312" y="236" width="427.2" height="49.2" /></mxCell><mxCell id="e29" value="현재 R23 / 허용 범위&lt;br&gt;후보 발견 / 추가 조회&lt;br&gt;현재 조건과 Task 의미 제안" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=22;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1352" y="989" width="315.12" height="105" /></mxCell><mxCell id="e34" value="1 확정 변경 → 원본 읽기" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1337" y="463" width="267.14" height="34.35" /></mxCell><mxCell id="e39" value="4 현재 조회 → / 5 Bundle 반환 ←" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1337" y="741" width="363.6" height="33.0" /></mxCell><mxCell id="e40" value="원문 locator / 권한 / revision 확인&lt;br&gt;미생산: 생산 / 게시 후 Reader 재조회&lt;br&gt;표현 미지원: 제한 또는 명시 B+" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=22;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1764" y="1000" width="453.72" height="108" /></mxCell><mxCell id="e41" value="과거 생산과 현재 조회는 다른 시작점&lt;br&gt;조건부 의미 가공: Model Access&lt;br&gt;→ 같은 클라우드 의미 LLM&lt;br&gt;현재 해석 호출도 양안에 유지" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1334" y="564" width="388.1" height="150" /></mxCell><mxCell id="e42" value="같은 반환: 실제 설명[0:52] + 제품/견적 결과 참조 + 출처 / revision / 누락&lt;br&gt;이 예시에는 REVISES가 없다. 정정 채택 후에만 추가한다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=23;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1332" y="1163" width="938.58" height="78" /></mxCell><mxCell id="e44" value="공통 후속: Request Interpreter의 현재 의미 제안 → Request Controller의 채택 → Task Manager / Agent Gateway의 위임&lt;br&gt;기준 적용과 제안서 작성은 Downstream Agent가 수행. 입력은 생산 대기를 하지 않는다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=24;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="1288" width="1591.52" height="84" /></mxCell><mxCell id="e45" value="검정 = 공통, 살구색 = 구성 / 생산 / 읽기 책임의 차이. 화살표는 왕복 읽기의 시작 경로를 축약. 설계 예시 / 미선정 / 미측정." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="1380" width="1361.66" height="34.35" /></mxCell></root></mxGraphModel></diagram></mxfile>

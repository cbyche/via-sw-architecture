<mxfile host="app.diagrams.net" type="device"><diagram id="dp46-background" name="46의 문제 | 말한 당시 화면과 행동, 과거 설명과 업무 결과를 함께 연결"><mxGraphModel page="1" pageWidth="2560" pageHeight="1440" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="h" value="관련 과거 원본" parent="1" vertex="1" style="html=1;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1.6;fontFamily=Apple SD Gothic Neo;fontColor=#111111;rounded=0;arcSize=10;dashed=1;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacingLeft=15;spacingTop=8;"><mxGeometry as="geometry" x="40" y="140" width="2480" height="250" /></mxCell><mxCell id="ex" value="C20 / E20 / P20&lt;br&gt;평가 기준 설명 원문&lt;br&gt;실제 전달한 범위" parent="h" vertex="1" style="html=1;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1.6;fontFamily=Apple SD Gothic Neo;fontColor=#111111;shape=note;size=18;fontSize=21;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=0;spacingTop=0;"><mxGeometry as="geometry" x="40" y="80" width="740" height="130" /></mxCell><mxCell id="p" value="T21 / D21@v2&lt;br&gt;제품 비교의 확인된 결과 참조&lt;br&gt;Agent 내부 자료 전체 아님" parent="h" vertex="1" style="html=1;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1.6;fontFamily=Apple SD Gothic Neo;fontColor=#111111;shape=note;size=18;fontSize=21;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=0;spacingTop=0;"><mxGeometry as="geometry" x="850" y="80" width="740" height="130" /></mxCell><mxCell id="q" value="T22 / D22@v1&lt;br&gt;견적의 확인된 결과 참조&lt;br&gt;현재 표와 동일하다고 미리 확정하지 않음" parent="h" vertex="1" style="html=1;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1.6;fontFamily=Apple SD Gothic Neo;fontColor=#111111;shape=note;size=18;fontSize=21;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=0;spacingTop=0;"><mxGeometry as="geometry" x="1660" y="80" width="740" height="130" /></mxCell><mxCell id="w" value="W46: 같은 음성과 관측 원본 window" parent="1" vertex="1" style="html=1;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1.6;fontFamily=Apple SD Gothic Neo;fontColor=#111111;rounded=0;arcSize=10;dashed=1;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacingLeft=15;spacingTop=8;"><mxGeometry as="geometry" x="40" y="445" width="2480" height="480" /></mxCell><mxCell id="a" value="a: “이 표와”&lt;br&gt;가능한 acoustic span / sample 범위" parent="w" vertex="1" style="html=1;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1.6;fontFamily=Apple SD Gothic Neo;fontColor=#111111;shape=note;size=18;fontSize=21;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=0;spacingTop=0;"><mxGeometry as="geometry" x="40" y="65" width="700" height="95" /></mxCell><mxCell id="b" value="b: “저 표를 아까 네가 설명한 기준으로…”&lt;br&gt;가능한 acoustic span / sample 범위" parent="w" vertex="1" style="html=1;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1.6;fontFamily=Apple SD Gothic Neo;fontColor=#111111;shape=note;size=18;fontSize=21;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=0;spacingTop=0;"><mxGeometry as="geometry" x="980" y="65" width="700" height="95" /></mxCell><mxCell id="s1" value="S1 / P1&lt;br&gt;첫 viewport의 표, pointer/선택/drag 경로&lt;br&gt;capture interval / 좌표계 / 오차" parent="w" vertex="1" style="html=1;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1.6;fontFamily=Apple SD Gothic Neo;fontColor=#111111;shape=note;size=18;fontSize=21;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=0;spacingTop=0;"><mxGeometry as="geometry" x="40" y="245" width="700" height="120" /></mxCell><mxCell id="change" value="스크롤 /&lt;br&gt;창 전환" parent="w" vertex="1" style="html=1;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1.6;fontFamily=Apple SD Gothic Neo;fontColor=#111111;shape=note;size=18;fontSize=21;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=0;spacingTop=0;"><mxGeometry as="geometry" x="770" y="265" width="170" height="75" /></mxCell><mxCell id="s2" value="S2 / P2&lt;br&gt;바뀐 viewport의 표와 당시 pointer/선택&lt;br&gt;capture interval / 좌표계 / 오차" parent="w" vertex="1" style="html=1;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1.6;fontFamily=Apple SD Gothic Neo;fontColor=#111111;shape=note;size=18;fontSize=21;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=0;spacingTop=0;"><mxGeometry as="geometry" x="980" y="245" width="700" height="120" /></mxCell><mxCell id="tr" value="u46@r1 → r2&lt;br&gt;전사는 화면 변경 뒤 도착/정정 가능&lt;br&gt;provider item ↔ local sample mapping&lt;br&gt;span timing 미제공이면 unknown" parent="w" vertex="1" style="html=1;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1.6;fontFamily=Apple SD Gothic Neo;fontColor=#111111;shape=note;size=18;fontSize=21;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=0;spacingTop=0;"><mxGeometry as="geometry" x="1800" y="65" width="620" height="190" /></mxCell><mxCell id="input" value="현재 u46&lt;br&gt;“이 표와 저 표를 아까 기준으로 비교해서 제안서 초안을 만들어줘. 메일은 보내지 마.”&lt;br&gt;지칭, 과거 설명 연결, Task 관계, 위임과 금지 조건이 아직 잠정 상태" parent="1" vertex="1" style="html=1;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1.6;fontFamily=Apple SD Gothic Neo;fontColor=#111111;shape=note;size=18;fontSize=21;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=0;spacingTop=0;"><mxGeometry as="geometry" x="80" y="980" width="1430" height="170" /></mxCell><mxCell id="out" value="채택 뒤의 R46 / 필요 시 T46&lt;br&gt;관련 근거와 조건을 연결해 외부 Agent에 위임&lt;br&gt;비교 분석과 제안서 작성은 Agent 책임" parent="1" vertex="1" style="html=1;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1.6;fontFamily=Apple SD Gothic Neo;fontColor=#111111;shape=note;size=18;fontSize=21;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=0;spacingTop=0;"><mxGeometry as="geometry" x="1720" y="980" width="740" height="170" /></mxCell><mxCell id="e0" edge="1" parent="1" source="a" target="s1" style="edgeStyle=none;rounded=0;strokeColor=#333333;strokeWidth=1.6;endArrow=open;endFill=0;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="e1" edge="1" parent="1" source="b" target="s2" style="edgeStyle=none;rounded=0;strokeColor=#333333;strokeWidth=1.6;endArrow=open;endFill=0;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="e2" edge="1" parent="1" source="s1" target="change" style="edgeStyle=none;rounded=0;strokeColor=#333333;strokeWidth=1.6;endArrow=open;endFill=0;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5333333333333333;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="e3" edge="1" parent="1" source="change" target="s2" style="edgeStyle=none;rounded=0;strokeColor=#333333;strokeWidth=1.6;endArrow=open;endFill=0;exitX=1.0;exitY=0.5333333333333333;entryX=0.0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="e4" edge="1" parent="1" source="b" target="tr" style="edgeStyle=none;rounded=0;strokeColor=#333333;strokeWidth=1.6;endArrow=open;endFill=0;exitX=1.0;exitY=0.5263157894736842;entryX=0.0;entryY=0.2631578947368421;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="e5" edge="1" parent="1" source="input" target="out" style="edgeStyle=none;rounded=0;strokeColor=#333333;strokeWidth=1.6;endArrow=open;endFill=0;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="t0" vertex="1" parent="1" value="46의 문제 | 말한 당시 화면과 행동, 과거 설명과 업무 결과를 함께 연결" style="text;html=1;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;overflow=visible;fillColor=#FFFFFF;strokeColor=none;fontSize=36;fontStyle=1;fontFamily=Apple SD Gothic Neo;"><mxGeometry as="geometry" x="40" y="20" width="2480" height="46.800000000000004" /></mxCell><mxCell id="t1" vertex="1" parent="1" value="사용자 발화 뒤에 전사가 도착해도, 마지막 화면 하나나 전사 도착 시각으로 앞선 지칭을 대체할 수 없다" style="text;html=1;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;overflow=visible;fillColor=#FFFFFF;strokeColor=none;fontSize=24;fontStyle=0;fontFamily=Apple SD Gothic Neo;"><mxGeometry as="geometry" x="40" y="75" width="2480" height="31.200000000000003" /></mxCell><mxCell id="t2" vertex="1" parent="1" value="음성/화면/행동 순서와 오차를 보존 → 시간 관계 후보 구성 → 현재 Request Interpreter가 지칭과 Task 관계 판단&lt;br&gt;VAD는 발화 경계만 제공. 단어 시각 미지원/gap/원본 만료는 양안 같은 한계. 시각 overlap이 의도 정답은 아님." style="text;html=1;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;overflow=visible;fillColor=#FFFFFF;strokeColor=none;fontSize=24;fontStyle=0;fontFamily=Apple SD Gothic Neo;"><mxGeometry as="geometry" x="90" y="830" width="2360" height="62.400000000000006" /></mxCell><mxCell id="t3" vertex="1" parent="1" value="후속 u47: “두 번째 표 대신 새 견적으로 다시 만들어줘. 메일은 계속 보내지 마.”&lt;br&gt;u46 전사 정정은 같은 입력 revision. u47은 별도 입력이며 현재 의미가 채택돼야 수정 범위가 정해진다.&lt;br&gt;이 그림은 공통 문제와 원본을 설명한다. A/B의 관계 구성과 게시/조회는 MAIN에서 비교한다." style="text;html=1;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;overflow=visible;fillColor=#FFFFFF;strokeColor=none;fontSize=27;fontStyle=0;fontFamily=Apple SD Gothic Neo;"><mxGeometry as="geometry" x="80" y="1210" width="2370" height="105.3" /></mxCell></root></mxGraphModel></diagram></mxfile>

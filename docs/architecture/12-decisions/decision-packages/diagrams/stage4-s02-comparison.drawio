;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="750" y="748" width="252.44" height="30.3" /></mxCell><mxCell id="e35" value="해당 시간의 기록 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="584" y="755" width="203.48" height="30.3" /></mxCell><mxCell id="e37" value="근거 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="594" y="856" width="91.16" height="30.3" /></mxCell><mxCell id="e39" value="시간 연결" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="751" y="908" width="91.16" height="30.3" /></mxCell><mxCell id="e40" value="음성 인식과 병행 S2S의 송수신 경로는 공통 입력 흐름도에 펼친다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="122" y="1145" width="636.14" height="31.650000000000002" /></mxCell><mxCell id="e41" value="별도 화면 대상 생산 Component는 없다.&lt;br&gt;요청에 필요한 화면, UI 구조와 원문을 준비하고&lt;br&gt;Request Interpreter가 대상과 의도를 제안한다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=25;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="144" y="1320" width="639.5" height="132" /></mxCell><mxCell id="e42" value="T도 UI 구조와 기존 cache를 사용한다.&lt;br&gt;매번 이미지를 처음부터 분석한다고 가정하지 않는다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=23;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="144" y="1520" width="599.56" height="82" /></mxCell><mxCell id="e48" value="당시 기록 조회" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="128" y="1744" width="138.32" height="30.3" /></mxCell><mxCell id="e55" value="근거 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="129" y="2004" width="91.16" height="30.3" /></mxCell><mxCell id="e57" value="근거 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="394" y="2004" width="91.16" height="30.3" /></mxCell><mxCell id="e59" value="해석 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="630" y="2116" width="91.16" height="30.3" /></mxCell><mxCell id="e61" value="의미 제안" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="630" y="2210" width="91.16" height="30.3" /></mxCell><mxCell id="e63" value="의미 해석 호출" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="742" y="2004" width="138.32" height="30.3" /></mxCell><mxCell id="e65" value="결과" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1061" y="2004" width="44.0" height="30.3" /></mxCell><mxCell id="e69" value="공통: 모호하면 질문 또는 선택 요청. 최종 확정은 Request Controller가 담당한다.&lt;br&gt;A는 분석 결과가 준비됐어도 정확성을 보장하지 않는다. 원래 기록과 현재 권한을 확인한다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="128" y="2502" width="856.92" height="68" /></mxCell><mxCell id="e71" value="A" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=white;fontSize=27;fontStyle=1;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1323.63" y="244" width="24.74" height="42.45" /></mxCell><mxCell id="e72" value="화면 대상 생산과 요청 처리 분리" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=28;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1380" y="236" width="458.8" height="43.800000000000004" /></mxCell><mxCell id="e73" value="탐색안 / 생산 작업, 대상 기록과 준비 상태 관리" style="text;html=1;whit
ontStyle=0;fontFamily=Arial;align=left;verticalAlign=top;spacing=0;connectable=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="954" y="1195" width="1586" height="25" /></mxCell><mxCell id="2-note-0" value="④ Context Manager가 현재 source와 권한을 다시 확인한다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;fontColor=#1458C0;fontSize=18;fontStyle=0;fontFamily=Arial;align=left;verticalAlign=top;spacing=0;connectable=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1790" y="1167" width="750" height="25" /></mxCell><mxCell id="2-note-1" value="제한: 선택 밖의 연속 지칭과 과거 복수 지칭은 미지원" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;fontColor=#1458C0;fontSize=18;fontStyle=0;fontFamily=Arial;align=left;verticalAlign=top;spacing=0;connectable=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1790" y="1195" width="750" height="25" /></mxCell><mxCell id="common-0" value="공통 후속: Context Manager → Request Controller로 근거와 receipt 반환 → 입력과 예산 결합 → Request Interpreter 호출." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;fontColor=#171717;fontSize=20;fontStyle=0;fontFamily=Arial;align=left;verticalAlign=top;spacing=0;connectable=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="48" y="1360" width="2492" height="27" /></mxCell></root></mxGraphModel></diagram></mxfile>

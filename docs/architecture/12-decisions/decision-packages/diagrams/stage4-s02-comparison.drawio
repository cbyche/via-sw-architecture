g=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2298.28" y="42" width="197.72" height="30.3" /></mxCell><mxCell id="e4" value="화면 대상을 요청할 때 파악할 것인가, 미리 파악해둘 것인가?" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=42;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="87" width="1276.4" height="62.7" /></mxCell><mxCell id="e5" value="공통 관측은 유지한다. A는 요청과 독립적인 분석 작업과 화면 대상 기록을 소유한다. 번호가 있는 실행 흐름은 별도 그림에서 본다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=23;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="151" width="1494.72" height="37.05" /></mxCell><mxCell id="e8" value="T" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=white;fontSize=27;fontStyle=1;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="75.63" y="244" width="24.74" height="42.45" /></mxCell><mxCell id="e9" value="요청에 필요한 당시 화면 해석" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=28;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="132" y="236" width="413.44" height="43.800000000000004" /></mxCell><mxCell id="e10" value="실제 target / UI 정보와 기존 cache도 활용" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="132" y="276" width="422.36" height="30.3" /></mxCell><mxCell id="e14" value="VIA SOFTWARE" style="text;html=1;whiteSpace=nowrap;overflow=visible;stro
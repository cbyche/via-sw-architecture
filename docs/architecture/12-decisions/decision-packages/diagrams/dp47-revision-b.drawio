000000000003" /></mxCell><mxCell id="note12" parent="1" vertex="1" value="D8  ReadSnapshot → Binding Work Queue: m3@v1,t0@v1" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=24;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="998" y="766.9230769230769" width="1200" height="31.200000000000003" /></mxCell><mxCell id="note13" parent="1" vertex="1" value="D9  Completion Inbox: Rejudge(Screen, peer=m3@v1)" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#B63732;fontSize=24;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="998" y="820.7692307692307" width="1176" height="31.200000000000003" /></mxCell><mxCell id="note14" parent="1" vertex="1" value="D10  Screen Work Queue: 두 extent 필요 / 원본 확대 read" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=24;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="998" y="874.6153846153846" width="1152" height="31.200000000000003" /></mxCell><mxCell id="note15" parent="1" vertex="1" value="D11  gate → t7,t8@v2 게시 / source + m3@v1 의존" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=24;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="2278" y="928.4615384615385" width="1032" height="31.200000000000003" /></mxCell><mxCell id="note16" parent="1" vertex="1" value="D12  Completion Inbox: CandidatePublished(t7,t8@v2)" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=24;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="998" y="982.3076923076923" width="1224" height="31.200000000000003" /></mxCell><mxCell id="note17" parent="1" vertex="1" value="D13  Binding Work Queue: 새 read-set → M 재결합" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=24;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="998" y="1036.1538461538462" width="1032" height="31.200000000000003" /></mxCell><mxCell id="note18" parent="1" vertex="1" value="D14  Completion Inbox: Ready(binding r1) / job 회수" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=24;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="998" y="1090.0" width="1176" height="31.200000000000003" /></mxCell><mxCell id="note19" parent="1" vertex="1" value="D15  TryApplyBinding 성공 → r1 proposal / read-set 동봉" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=24;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="358" y="1143.8461538461538" width="1224" height="31.200000000000003" /></mxCell><mxCell id="note20" parent="1" vertex="1" value="D16  Screen Work Queue: r1 추가 coverage job g1b 진행" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=24;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="998" y="1197.6923076923076" width="1176" height="31.200000000000003" /></mxCell><mxCell id="note21" parent="1" vertex="1" value="D17  BeginRevision(r2) fence + hold → Control Inbox" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#B63732;fontSize=24;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="358" y="1251.5384615384614" width="1224" height="31.200000000000003" /></mxCell><mxCell id="note22" parent="1" vertex="1" value="D18  Speech Work Queue: r2 “아래 것만” / prior + peer" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=24;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="998" y="1305.3846153846152" width="1176" height="31.200000000000003" /></mxCell><mxCell id="note23" parent="1" vertex="1" value="D19  gate → m4@v2: lower / 앞의 두 자료 유지 후보" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=24;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="1638" y="1359.2307692307693" width="960" height="31.200000000000003" /></mxCell><mxCell id="note24" parent="1" vertex="1" value="D20  Completion Inbox: CandidatePublished(m4@v2)" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=24;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="998" y="1413.076923076923" width="1152" height="31.200000000000003" /></mxCell><mxCell id="note25" parent="1" vertex="1" value="D21  Screen Work Queue: g2 / m4@v2 의존 재검토" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=24;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="998" y="1466.923076923077" width="984" height="31.200000000000003" /></mxCell><mxCell id="note26" parent="1" vertex="1" value="D22  g1b late done: gate에서 거절 → Completion Inbox stale" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#B63732;fontSize=24;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="998" y="1520.7692307692307" width="1296" height="31.200000000000003" /></mxCell><mxCell id="note27" parent="1" vertex="1" value="D23  gate → g2 t8@v3 / extent 재사용 + 새 peer 의존" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=24;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="2278" y="1574.6153846153845" width="1080" height="31.200000000000003" /></mxCell><mxCell id="note28" parent="1" vertex="1" value="D24  Completion Inbox: CandidatePublished(t8@v3)" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=24;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="998" y="1628.4615384615386" width="1152" height="31.200000000000003" /></mxCell><mxCell id="note29" parent="1" vertex="1" value="D25  Binding Work Queue: m4@v2,t8@v3 + prior → M" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=24;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="998" y="1682.3076923076924" width="1152" height="31.200000000000003" /></mxCell><mxCell id="note30" parent="1" vertex="1" value="D26  Completion Inbox: Ready(binding r2) / job 회수" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=24;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="998" y="1736.1538461538462" width="1176" height="31.200000000000003" /></mxCell><mxCell id="note31" parent="1" vertex="1" value="D27  TryApplyBinding 성공 → r2 proposal / 최신 read-set" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=24;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="358" y="1790.0" width="1224" height="31.200000000000003" /></mxCell><mxCell id="note32" parent="1" vertex="1" value="B: D9–D13은 후보 확장 왕복이다. r2는 D18–D25의 후보 갱신과 새 read-set 결합을 거친다." style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=26;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="60" y="1884" width="1612" height="33.800000000000004" /></mxCell><mxCell id="note33" parent="1" vertex="1" value="공통: 결과 대기 중 capture / 전사 / local stop은 계속된다. Request Controller가 최신 revision, 사용권, 근거와 base version을 검사한다." style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=24;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="60" y="1941" width="2544" height="31.200000000000003" /></mxCell><mxCell id="note34" parent="1" vertex="1" value="채택 뒤에는 전체 요청 해석과 admission을 거쳐 응답 / 업무로 연결한다. 일부 지칭 실패는 해당 범위를 질문하며 앞의 의미를 임의 확정하지 않는다." style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=24;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="60" y="1991" width="2088" height="31.200000000000003" /></mxCell><mxCell id="note35" parent="1" vertex="1" value="R/M = 구조도의 같은 read/model adapter / gate 안에는 await 없음 / B의 각 worker 내부 R/M 왕복은 축약 / 실행 trace와 성능 측정 아님" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#758294;fontSize=23;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="60" y="2042" width="2323" height="29.900000000000002" /></mxCell><mxCell id="note36" parent="1" vertex="1" value="실선: 요청 / 파랑 점선: 결과 / 빨강 점선: 정정과 무효화 / 회색 점선: 상태 게시 / 실행 trace가 아닌 같은 사건의 설계 예시" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#758294;fontSize=23;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="60" y="2097" width="1794" height="29.900000000000002" /></mxCell></root></mxGraphModel></diagram></mxfile>

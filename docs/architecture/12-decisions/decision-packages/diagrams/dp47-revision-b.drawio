278" y="982" width="1152" height="31.200000000000003" /></mxCell><mxCell id="note14" parent="1" vertex="1" value="D10  완료 통지 후 새 read-set(m3@v1,t7,t8@v2) → 재결합" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=24;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="998" y="1056" width="1080" height="31.200000000000003" /></mxCell><mxCell id="note15" parent="1" vertex="1" value="D11  b3={t7,t8} 잠정 제안 / candidate versions와 raw refs" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=24;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="358" y="1130" width="1248" height="31.200000000000003" /></mxCell><mxCell id="note16" parent="1" vertex="1" value="D12  r1의 추가 coverage 확인 job g1b 시작, 결과 대기" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=24;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="998" y="1204" width="984" height="31.200000000000003" /></mxCell><mxCell id="note17" parent="1" vertex="1" value="D13  r2 “아래 것만” / hold / 옛 generation fence + cancel" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#B63732;fontSize=24;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="358" y="1278" width="1248" height="31.200000000000003" /></mxCell><mxCell id="note18" parent="1" vertex="1" value="D14  r2 원음/전사 + prior / 정정 후보 생산 → Model Access" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=24;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="998" y="1352" width="1128" height="31.200000000000003" /></mxCell><mxCell id="note19" parent="1" vertex="1" value="D15  m4@v2: lower / KEEP 앞의 두 자료 / raw와 peer refs" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=24;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="1638" y="1426" width="1176" height="31.200000000000003" /></mxCell><mxCell id="note20" parent="1" vertex="1" value="D16  새 g2: m4@v2에 따른 target 검토 / 유효 원본 재사용" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=24;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="998" y="1500" width="1008" height="31.200000000000003" /></mxCell><mxCell id="note21" parent="1" vertex="1" value="D17  g1b late done: expected generation 불일치 → 미게시" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#B63732;fontSize=24;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="998" y="1574" width="1176" height="31.200000000000003" /></mxCell><mxCell id="note22" parent="1" vertex="1" value="D18  g2: lower=t8@v3 / extent 재사용 / peer m4@v2 갱신" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=24;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="2278" y="1648" width="1176" height="31.200000000000003" /></mxCell><mxCell id="note23" parent="1" vertex="1" value="D19  m4@v2,t8@v3와 유지 binding read-set → 부분 재결합" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=24;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="998" y="1722" width="1104" height="31.200000000000003" /></mxCell><mxCell id="note24" parent="1" vertex="1" value="D20  r2 제안: KEEP b1,b2 / REPLACE b3 / stale read-set 거절" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=24;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="358" y="1796" width="1320" height="31.200000000000003" /></mxCell><mxCell id="note25" parent="1" vertex="1" value="B: 후보가 없으면 D7–D10을 거친다. r2는 D14–D19의 생산자별 갱신과 새 read-set 결합을 거친다." style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=26;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="60" y="1884" width="1690" height="33.800000000000004" /></mxCell><mxCell id="note26" parent="1" vertex="1" value="공통: 결과 대기 중 capture / 전사 / local stop은 계속된다. Request Controller가 최신 revision, 사용권, 근거와 base version을 검사한다." style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=24;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="60" y="1941" width="2544" height="31.200000000000003" /></mxCell><mxCell id="note27" parent="1" vertex="1" value="채택 뒤에는 전체 요청 해석과 admission을 거쳐 응답 / 업무로 연결한다. 일부 지칭 실패는 해당 범위를 질문하며 앞의 의미를 임의 확정하지 않는다." style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=24;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="60" y="1991" width="2088" height="31.200000000000003" /></mxCell><mxCell id="note28" parent="1" vertex="1" value="B 모델 왕복과 candidate 완료 통지는 메시지에 축약했다. 구조도에서 실제 호출과 반환을 표시한다. D 간격과 병행 정도는 성능 주장이 아니다." style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#758294;fontSize=23;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="60" y="2042" width="1932" height="29.900000000000002" /></mxCell><mxCell id="note29" parent="1" vertex="1" value="실선: 요청 / 파랑 점선: 결과 / 빨강 점선: 정정과 무효화 / 회색 점선: 상태 게시 / 실행 trace가 아닌 같은 사건의 설계 예시" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#758294;fontSize=23;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="60" y="2097" width="1794" height="29.900000000000002" /></mxCell></root></mxGraphModel></diagram></mxfile>

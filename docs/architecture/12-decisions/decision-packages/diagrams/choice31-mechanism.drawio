<mxfile host="app.diagrams.net" type="device"><diagram id="choice31-mechanism" name="요청 이해의 정확성을 위한 의미 구성 — 요청별 생성과 지속 의미 작업공간"><mxGraphModel page="1" pageWidth="2560" pageHeight="2260" grid="1" gridSize="8"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="e1" value="" style="rounded=1;arcSize=4;fillColor=#263445;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="0" y="0" width="2560" height="9" /></mxCell><mxCell id="e8" value="" style="rounded=1;arcSize=4;fillColor=white;strokeColor=#C7D1DD;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="345" width="1184" height="245" /></mxCell><mxCell id="e9" value="" style="rounded=1;arcSize=4;fillColor=#195FBD;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="345" width="8" height="245" /></mxCell><mxCell id="e13" value="" style="rounded=1;arcSize=4;fillColor=white;strokeColor=#C7D1DD;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="650" width="1184" height="245" /></mxCell><mxCell id="e14" value="" style="rounded=1;arcSize=4;fillColor=#195FBD;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="650" width="8" height="245" /></mxCell><mxCell id="e18" value="" style="rounded=1;arcSize=4;fillColor=white;strokeColor=#C7D1DD;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="955" width="1184" height="245" /></mxCell><mxCell id="e19" value="" style="rounded=1;arcSize=4;fillColor=#195FBD;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="955" width="8" height="245" /></mxCell><mxCell id="e23" value="" style="rounded=1;arcSize=4;fillColor=white;strokeColor=#C7D1DD;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="1260" width="1184" height="245" /></mxCell><mxCell id="e24" value="" style="rounded=1;arcSize=4;fillColor=#195FBD;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="1260" width="8" height="245" /></mxCell><mxCell id="e28" value="" style="rounded=1;arcSize=4;fillColor=white;strokeColor=#C7D1DD;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="1565" width="1184" height="245" /></mxCell><mxCell id="e29" value="" style="rounded=1;arcSize=4;fillColor=#195FBD;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="1565" width="8" height="245" /></mxCell><mxCell id="e34" value="" style="rounded=1;arcSize=4;fillColor=white;strokeColor=#C7D1DD;" vertex="1" parent="1"><mxGeometry as="geometry" x="1312" y="345" width="1184" height="245" /></mxCell><mxCell id="e35" value="" style="rounded=1;arcSize=4;fillColor=#087A53;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="1312" y="345" width="8" height="245" /></mxCell><mxCell id="e39" value="" style="rounded=1;arcSize=4;fillColor=white;strokeColor=#C7D1DD;" vertex="1" parent="1"><mxGeometry as="geometry" x="1312" y="650" width="1184" height="245" /></mxCell><mxCell id="e40" value="" style="rounded=1;arcSize=4;fillColor=#087A53;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="1312" y="650" width="8" height="245" /></mxCell><mxCell id="e44" value="" style="rounded=1;arcSize=4;fillColor=white;strokeColor=#C7D1DD;" vertex="1" parent="1"><mxGeometry as="geometry" x="1312" y="955" width="1184" height="245" /></mxCell><mxCell id="e45" value="" style="rounded=1;arcSize=4;fillColor=#087A53;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="1312" y="955" width="8" height="245" /></mxCell><mxCell id="e49" value="" style="rounded=1;arcSize=4;fillColor=white;strokeColor=#C7D1DD;" vertex="1" parent="1"><mxGeometry as="geometry" x="1312" y="1260" width="1184" height="245" /></mxCell><mxCell id="e50" value="" style="rounded=1;arcSize=4;fillColor=#087A53;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="1312" y="1260" width="8" height="245" /></mxCell><mxCell id="e54" value="" style="rounded=1;arcSize=4;fillColor=white;strokeColor=#C7D1DD;" vertex="1" parent="1"><mxGeometry as="geometry" x="1312" y="1565" width="1184" height="245" /></mxCell><mxCell id="e55" value="" style="rounded=1;arcSize=4;fillColor=#087A53;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="1312" y="1565" width="8" height="245" /></mxCell><mxCell id="e6" style="edgeStyle=none;rounded=0;strokeColor=#C7D1DD;strokeWidth=2;endArrow=none;endFill=0;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="64" y="202" /><mxPoint as="targetPoint" x="2496" y="202" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e12" style="edgeStyle=none;rounded=0;strokeColor=#195FBD;strokeWidth=2;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="656" y="590" /><mxPoint as="targetPoint" x="656" y="650" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e17" style="edgeStyle=none;rounded=0;strokeColor=#195FBD;strokeWidth=2;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="656" y="895" /><mxPoint as="targetPoint" x="656" y="955" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e22" style="edgeStyle=none;rounded=0;strokeColor=#195FBD;strokeWidth=2;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="656" y="1200" /><mxPoint as="targetPoint" x="656" y="1260" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e27" style="edgeStyle=none;rounded=0;strokeColor=#195FBD;strokeWidth=2;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="656" y="1505" /><mxPoint as="targetPoint" x="656" y="1565" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e38" style="edgeStyle=none;rounded=0;strokeColor=#087A53;strokeWidth=2;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1904" y="590" /><mxPoint as="targetPoint" x="1904" y="650" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e43" style="edgeStyle=none;rounded=0;strokeColor=#087A53;strokeWidth=2;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1904" y="895" /><mxPoint as="targetPoint" x="1904" y="955" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e48" style="edgeStyle=none;rounded=0;strokeColor=#087A53;strokeWidth=2;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1904" y="1200" /><mxPoint as="targetPoint" x="1904" y="1260" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e53" style="edgeStyle=none;rounded=0;strokeColor=#087A53;strokeWidth=2;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1904" y="1505" /><mxPoint as="targetPoint" x="1904" y="1565" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e59" style="edgeStyle=none;rounded=0;strokeColor=#C7D1DD;strokeWidth=2;endArrow=none;endFill=0;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="64" y="2120" /><mxPoint as="targetPoint" x="2496" y="2120" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e2" value="VIA  /  ARCHITECTURE REVIEW" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=18;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="42" width="309.32" height="30.3" /></mxCell><mxCell id="e3" value="04-31  /  STAGE 04" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=18;fontStyle=1;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2287.12" y="42" width="208.88" height="30.3" /></mxCell><mxCell id="e4" value="요청 이해의 정확성을 위한 의미 구성&lt;br&gt;요청별 생성과 지속 의미 작업공간" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=34;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="75" width="623.4" height="94" /></mxCell><mxCell id="e5" value="실제 자료를 사용한 설계 추적 / 본문 §4.1 / 모델 실행 또는 정확도 측정 결과가 아님" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=22;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="166" width="954.44" height="35.7" /></mxCell><mxCell id="e7" value="A  요청별 완성 의미 생성" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=28;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="250" width="364.16" height="43.800000000000004" /></mxCell><mxCell id="e10" value="1. u1: 작년 표 / 메일은 초안만" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=26;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="92" y="365" width="435.44" height="41.1" /></mxCell><mxCell id="e11" value="Request Interpreter가 완성 P1 생성: source=L/R, year=2025,&lt;br&gt;send=false. Request Controller가 질문 q1 게시 요청." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=23;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="92" y="430" width="807.48" height="72" /></mxCell><mxCell id="e15" value="2. u2: “오른쪽 것”" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=26;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="92" y="670" width="273.2" height="41.1" /></mxCell><mxCell id="e16" value="Request Interpreter가 P1/질문/원문으로 전체 P2 재생성: source=R@7,&lt;br&gt;year=2025, send=false. 기존 조건과 비교 검사." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=23;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="92" y="735" width="882.92" height="72" /></mxCell><mxCell id="e20" value="3. u3: “표는 올해 것, 메일은 그대로”" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=26;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="92" y="975" width="519.6800000000001" height="41.1" /></mxCell><mxCell id="e21" value="같은 재조회에서 올해 표 S@8 확인. Request Interpreter가 P3 생성: source=S@8,&lt;br&gt;year=2026, send=false. 조건 검증." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=23;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="92" y="1040" width="1008.96" height="72" /></mxCell><mxCell id="e25" value="4. 새로 선택한 S@8 삭제" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=26;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="92" y="1280" width="335.08" height="41.1" /></mxCell><mxCell id="e26" value="Context Manager의 근거 확인에서 삭제 발견. Request Controller가 해당 제안 보류,&lt;br&gt;새 대상 해석/질문 요청." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=23;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="92" y="1345" width="1035.18" height="72" /></mxCell><mxCell id="e30" value="5. q1의 옛 답변이 늦게 도착" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=26;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="92" y="1585" width="387.08" height="41.1" /></mxCell><mxCell id="e31" value="Request Controller가 현재 질문/입력 버전 확인. 옛 답으로 새 대상을 확정하지 않음." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=23;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="92" y="1650" width="1025.06" height="39" /></mxCell><mxCell id="e32" value="A도 기존 조건을 검사할 수 있음. B의 이익은 올바른 변경만 적용하는 경로.&lt;br&gt;잘못된 변경 해석은 B도 실패. 외부 실행 승인/동의는 같은 별도 검사." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="84" y="1925" width="754.0" height="60.0" /></mxCell><mxCell id="e33" value="B  지속 의미 작업공간" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=28;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1312" y="250" width="318.8" height="43.800000000000004" /></mxCell><mxCell id="e36" value="1. u1: 작년 표 / 메일은 초안만" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=26;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1340" y="365" width="435.44" height="41.1" /></mxCell><mxCell id="e37" value="Meaning Workspace: c1=year 2025, c2=send false, source=L/R.&lt;br&gt;Semantic Constraint Engine이 미해결 source를 반환, q1 게시." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=23;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1340" y="430" width="849.34" height="72" /></mxCell><mxCell id="e41" value="2. u2: “오른쪽 것”" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=26;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1340" y="670" width="273.2" height="41.1" /></mxCell><mxCell id="e42" value="Request Interpreter: NARROW(q1,{R@7}) 제안. Meaning Workspace가&lt;br&gt;q1 버전 검사 후 source만 변경. c1/c2 유지." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=23;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1340" y="735" width="889.82" height="72" /></mxCell><mxCell id="e46" value="3. u3: “표는 올해 것, 메일은 그대로”" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=26;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1340" y="975" width="519.6800000000001" height="41.1" /></mxCell><mxCell id="e47" value="Request Interpreter: REPLACE(c1,2025→2026). Meaning&lt;br&gt;Workspace가 같은 재조회로 S@8 후보 평가. c2는 변경 대상이 아님." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=23;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1340" y="1040" width="801.5" height="72" /></mxCell><mxCell id="e51" value="4. 새로 선택한 S@8 삭제" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=26;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1340" y="1280" width="335.08" height="41.1" /></mxCell><mxCell id="e52" value="Context Manager가 무효 근거 반환. Meaning Workspace가 S@8의 의존 후보 제거.&lt;br&gt;Engine 재평가. 메일 조건 c2 유지." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=23;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1340" y="1345" width="994.7" height="72" /></mxCell><mxCell id="e56" value="5. q1의 옛 답변이 늦게 도착" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=26;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1340" y="1585" width="387.08" height="41.1" /></mxCell><mxCell id="e57" value="Meaning Workspace가 expected 버전과 q1 수명 검사. 옛 변경 적용 거절. 현재 질문에&lt;br&gt;다시 연결." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=23;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1340" y="1650" width="1038.4" height="72" /></mxCell><mxCell id="e58" value="A도 기존 조건을 검사할 수 있음. B의 이익은 올바른 변경만 적용하는 경로.&lt;br&gt;잘못된 변경 해석은 B도 실패. 외부 실행 승인/동의는 같은 별도 검사." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1332" y="1925" width="754.0" height="60.0" /></mxCell><mxCell id="e60" value="검정 = 공통 / 파랑 = A 고유 / 초록 = B 고유 / 색은 우위가 아님" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=19;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="2138" width="651.72" height="31.650000000000002" /></mxCell><mxCell id="e61" value="실선 → 요청/전달 / 점선 → 반환/확인" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=18;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2149.24" y="2138" width="346.76" height="30.3" /></mxCell><mxCell id="e62" value="제목 상자 = Component / 내부 둥근 상자 = Module / 원통 = 저장 / 접힌 종이 = 자료 / 육각형 = 연동 대상" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=17;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="2176" width="962.38" height="28.950000000000003" /></mxCell><mxCell id="e63" value="예시의 입력/근거는 양안에 동일. 실제 사용 빈도, 정확도와 시간 이익은 미측정." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=17;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="2212" width="682.56" height="28.950000000000003" /></mxCell></root></mxGraphModel></diagram></mxfile>

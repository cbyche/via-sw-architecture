=1;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;fontSize=16;fontStyle=0;fontFamily=Apple SD Gothic Neo;"><mxGeometry as="geometry" x="95" y="350" width="465" height="20.8" /></mxCell><mxCell id="t4" vertex="1" parent="1" value="공통: 허용된 과거 원문/결과 refs" style="text;html=1;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;fontSize=18;fontStyle=0;fontFamily=Apple SD Gothic Neo;"><mxGeometry as="geometry" x="685" y="345" width="505" height="23.400000000000002" /></mxCell><mxCell id="t5" vertex="1" parent="1" value="원본 변화: revision/cache 유효성 갱신&lt;br&gt;조회/index/prefetch/cache는 허용&lt;br&gt;공통 관계 게시가 정상 read의 필수 단계는 아님" style="text;html=1;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;fontSize=18;fontStyle=0;fontFamily=Apple SD Gothic Neo;"><mxGeometry as="geometry" x="95" y="595" width="470" height="70.2" /></mxCell><mxCell id="t6" vertex="1" parent="1" value="과거 원문/실제 전달/확인 결과를 보존&lt;br&gt;공통 과거 관계 게시가 정상 read의 필수 단계는 아님" style="text;html=1;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;fontSize=18;fontStyle=0;fontFamily=Apple SD Gothic Neo;"><mxGeometry as="geometry" x="685" y="620" width="510" height="46.800000000000004" /></mxCell><mxCell id="t7" vertex="1" parent="1" value="1 TemporalQuery Q1(W46/r1/a,b) ←" style="text;html=1;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;fontSize=18;fontStyle=0;fontFamily=Apple SD Gothic Neo;"><mxGeometry as="geometry" x="100" y="957" width="455" height="23.400000000000002" /></mxCell><mxCell id="t8" vertex="1" parent="1" value="2 Resolver가 필요한 원본/span을 read" style="text;html=1;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;fontSize=20;fontStyle=0;fontFamily=Apple SD Gothic Neo;"><mxGeometry as="geometry" x="95" y="553" width="460" height="26.0" /></mxCell><mxCell id="t9" vertex="1" parent="1" value="3 이번 Q1의 시간 후보 구성" style="text;html=1;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;fontSize=20;fontStyle=0;fontFamily=Apple SD Gothic Neo;"><mxGeometry as="geometry" x="100" y="930" width="455" height="26.0" /></mxCell><mxCell id="t10" vertex="1" parent="1" value="4 Composer가 과거 owner read/필요한 가공" style="text;html=1;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;fontSize=20;fontStyle=0;fontFamily=Apple SD Gothic Neo;"><mxGeometry as="geometry" x="685" y="575" width="510" height="26.0" /></mxCell><mxCell id="t11" vertex="1" parent="1" value="5 Q1과 과거 read를 이번 Set46에 조합" style="text;html=1;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;fontSize=20;fontStyle=0;fontFamily=Apple SD Gothic Neo;"><mxGeometry as="geometry" x="685" y="930" width="510" height="26.0" /></mxCell><mxCell id="t12" vertex="1" parent="1" value="6 필요한 read/결합 또는 유효 cache → Bundle&lt;br&gt;source r2: 영향 Q1/Set46 무효화 후 필요한 재구성" style="text;html=1;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;fontSize=20;fontStyle=0;fontFamily=Apple SD Gothic Neo;"><mxGeometry as="geometry" x="675" y="1190" width="540" height="52.0" /></mxCell><mxCell id="t13" vertex="1" parent="1" value="현재 지칭/Task의 의미 제안과 채택은 공통. 숫자는 기능 식별이며 고정 scheduling이 아님." style="text;html=1;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;fontSize=20;fontStyle=0;fontFamily=Apple SD Gothic Neo;"><mxGeometry as="geometry" x="40" y="1330" width="1190" height="26.0" /></mxCell><mxCell id="t14" vertex="1" parent="1" value="B  공통 관계 생산/조회" style="text;html=1;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;overflow=visible;fillColor=none;
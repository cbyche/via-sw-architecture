Perimeter=0;"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint as="point" x="1506" y="1027.5" /><mxPoint as="point" x="1506" y="998.0" /></Array></mxGeometry></mxCell><mxCell id="wire33" source="joint" target="joint_m" edge="1" parent="1" style="edgeStyle=none;rounded=0;strokeColor=#263445;strokeWidth=2;endArrow=open;endFill=0;startArrow=open;startFill=0;exitX=1.0;exitY=0.5432432432432432;exitPerimeter=0;entryX=0.0;entryY=0.5;entryPerimeter=0;"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint as="point" x="2890" y="1035.5" /><mxPoint as="point" x="2890" y="1059" /><mxPoint as="point" x="2870" y="1059" /><mxPoint as="point" x="2870" y="1063.0" /></Array></mxGeometry></mxCell><mxCell id="note0" parent="1" vertex="1" value="VIA / DP-47 / 구현 수준 상세 설계" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=26;fontStyle=1;align=left;spacing=0;"><mxGeometry as="geometry" x="60" y="22" width="650" height="33.800000000000004" /></mxCell><mxCell id="note1" parent="1" vertex="1" value="설계 가정 / 제품 미구현 / 모델 호출과 측정 없음" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=23;fontStyle=0;align=right;spacing=0;"><mxGeometry as="geometry" x="3113" y="25" width="667" height="29.900000000000002" /></mxCell><mxCell id="note2" parent="1" vertex="1" value="A / 하나의 공동 해석 workflow가 원본에서 binding을 직접 갱신한다" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=43;fontStyle=1;align=left;spacing=0;"><mxGeometry as="geometry" x="60" y="67" width="1935" height="55.9" /></mxCell><mxCell id="note3" parent="1" vertex="1" value="1 입력 등록 → 2 작업 전달 → 3 원본 조회 → 4 의미 처리 → 5 조건부 게시 → 6 다음 실행 → 7 제안 → 8 채택" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=27;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="60" y="139" width="1944" height="35.1" /></mxCell><mxCell id="note4" parent="1" vertex="1" value="STYLE  Layered application + asynchronous workflow / Ports &amp;amp; Adapters / 단일 binding aggregate" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=29;fontStyle=1;align=left;spacing=0;"><mxGeometry as="geometry" x="60" y="196" width="2668" height="37.7" /></mxCell><mxCell id="note5" parent="1" vertex="1" value="1 입력/전사 revision 등록 / capture는 의미 처리와 병행" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=23;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="60" y="1259" width="920" height="29.900000000000002" /></mxCell><mxCell id="note6" parent="1" vertex="1" value="사각형 = 실행 코드   칸이 있는 상자 = RAM queue   겹친 카드 = RAM data model   원통 = 영속 DB   접힌 종이 = immutable DTO" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=24;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="900" y="2080" width="2304" height="31.200000000000003" /></mxCell><mxCell id="note7" parent="1" vertex="1" value="검정 양방향 = async 호출/반환   파랑 → = P2P enqueue/dispatch   파랑 점선 = 완료   빨강 = 재판단/정정   회색 = 상태 read/write / 별도 bus와 pub/sub 없음" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#758294;fontSize=23;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="60" y="2122" width="2737" height="29.900000000000002" /></mxCell><mxCell id="note8" parent="1" vertex="1" value="R 태그 = 이 adapter의 readAsync 호출/반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=25;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="1560" y="560" width="825" height="32.5" /></mxCell><mxCell id="note9" parent="1" vertex="1" value="M 태그 = 이 adapter의 invokeAsync 호출/반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=25;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="2290" y="560" width="875" height="32.5" /></mxCell><mxCell id="note10" parent="1" vertex="1" value="원본 → 의미 모델의 직접 binding → 하나의 binding aggregate" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=28;fontStyle=1;align=left;spacing=0;"><mxGeometry as="geometry" x="1550" y="1167" width="1288" height="36.4" /></mxCell><mxCell id="note11" parent="1" vertex="1" value="상태 lock 안에서는&lt;br&gt;await / 모델 호출을 하지 않는다&lt;br&gt;추가 판단도 같은 workflow로 복귀" style="text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=23;fontStyle=0;align=left;spacing=0;"><mxGeometry as="geometry" x="930" y="1677" width="506" height="89.7" /></mxCell></root></mxGraphModel></diagram></mxfile>

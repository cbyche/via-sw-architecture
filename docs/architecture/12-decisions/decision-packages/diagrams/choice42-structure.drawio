tml=0;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;fontSize=21;fontColor=#A65E2E;fontStyle=0;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="2960" y="1244" width="507" height="30.45" /></mxCell><mxCell id="note53" value="5  claim / CAS ↔" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;fontSize=21;fontColor=#233247;fontStyle=0;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="2970" y="1429" width="360" height="30.45" /></mxCell><mxCell id="note54" value="5  CAS 성공 뒤 send(K1)" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;fontSize=21;fontColor=#233247;fontStyle=0;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="3115" y="700" width="444" height="30.45" /></mxCell><mxCell id="note55" value="6  외부 receipt / event" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;fontSize=21;fontColor=#233247;fontStyle=0;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="3430" y="1269" width="465" height="30.45" /></mxCell><mxCell id="note56" value="6  내구 event / D3" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;fontSize=21;fontColor=#A65E2E;fontStyle=0;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="2960" y="1299" width="360" height="30.45" /></mxCell><mxCell id="note57" value="7  확인 사실 게시 허용" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;fontSize=21;fontColor=#233247;fontStyle=0;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="2055" y="1174" width="318" height="30.45" /></mxCell><mxCell id="note58" value="7  release(P2)" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;fontSize=21;fontColor=#233247;fontStyle=0;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="2055" y="1619" width="318" height="30.45" /></mxCell><mxCell id="note59" value="8  실제 표시 / audible range" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;fontSize=21;fontColor=#233247;fontStyle=0;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="3270" y="1619" width="528" height="30.45" /></mxCell><mxCell id="note60" value="same K1 조회 / 재결합" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;fontSize=21;fontColor=#A65E2E;fontStyle=0;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="2955" y="1564" width="360" height="30.45" /></mxCell><mxCell id="note61" value="접수 receipt / event outbox도 W1/W3에 함께 저장" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;fontSize=20;fontColor=#596A7C;fontStyle=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="3120" y="1951" width="804" height="29.0" /></mxCell><mxCell id="note62" value="UNKNOWN → 외부 조회" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;fontSize=21;fontColor=#233247;fontStyle=0;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="3425" y="774" width="339" height="30.45" /></mxCell><mxCell id="note63" value="W1 뒤 D2 전: 업무는 접수 완료, 대화는 접수 대기일 수 있음" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;fontSize=25;fontColor=#A65E2E;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="2040" y="2000" width="949" height="36.25" /></mxCell><mxCell id="note64" value="W2 전송은 D2와 독립. 응답 유실은 같은 K1 조회 / cursor 재결합." style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;fontSize=24;fontColor=#596A7C;fontStyle=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="2040" y="2041" width="1080" height="34.8" /></mxCell><mxCell id="note65" value="실선 = 호출 / 저장   점선 = 반환 사실   ↔ = 조회와 응답 축약   둥근 상자 = 내부 Module   원통 = 상태   살구색 = 확정 / 인계 차이" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;fontSize=23;fontColor=#233247;fontStyle=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="2097" width="2094" height="33.35" /></mxCell><mxCell id="note66" value="1~8은 양안 공통 처리 단계. 로컬 접수 ≠ 외부 접수 ≠ 사용자 실제 전달. B 우위와 A/B 선정 없음." style="text;html=0;align=right;verticalAlign=top;whiteSpace=wrap;spacing=0;fontSize=22;fontColor=#233247;fontStyle=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="2410" y="2130" width="1366" height="31.9" /></mxCell></root></mxGraphModel></diagram></mxfile>

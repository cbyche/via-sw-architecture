cing=0;fontSize=26;fontColor=#233247;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="24" width="726" height="37.699999999999996" /></mxCell><mxCell id="note1" value="설계 제안 / 제품 구현과 측정 없음 / A/B 미선정" style="text;html=0;align=right;verticalAlign=top;whiteSpace=wrap;spacing=0;fontSize=24;fontColor=#233247;fontStyle=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="3032" y="26" width="744" height="34.8" /></mxCell><mxCell id="note2" value="대화와 업무 상태를 함께 확정할 것인가, 각자 확정하고 연결할 것인가" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;fontSize=44;fontColor=#233247;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="74" width="1696" height="63.8" /></mxCell><mxCell id="note3" value="같은 사례: 실제 제시된 Q1 “상반기로 할까요?” → u2 “응, 상반기로” → K1 외부 접수 확인 → P2 실제 전달" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;fontSize=27;fontColor=#233247;fontStyle=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="148" width="1860" height="39.15" /></mxCell><mxCell id="note4" value="A  통합 Core / 관련 owner 변경의 공동 확정" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;fontSize=34;fontColor=#A65E2E;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="80" y="206" width="1078" height="49.3" /></mxCell><mxCell id="note5" value="공통 수명  C1 대화 전환 뒤에도 T1 업무와 X1 외부 실행은 지속" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;fontSize=26;fontColor=#596A7C;fontStyle=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="80" y="269" width="1038" height="37.699999999999996" /></mxCell><mxCell id="note6" value="R1 위임 → Q1 질문 / P1 실제 제시 → R2 답변 → R3 수정 / X2" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;fontSize=25;fontColor=#596A7C;fontStyle=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="80" y="310" width="1149" height="36.25" /></mxCell><mxCell id="note7" value="R2 요청 처리가 끝나도 T1은 유지. 아래 상태 owner와 연결한다." style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;fontSize=24;fontColor=#596A7C;fontStyle=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="80" y="351" width="984" height="34.8" /></mxCell><mxCell id="note8" value="onset" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;fontSize=21;fontColor=#233247;fontStyle=0;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="535" y="505" width="129" height="30.45" /></mxCell><mxCell id="note9" value="output epoch / 즉시 stop" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;fontSize=21;fontColor=#233247;fontStyle=0;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="1070" y="544" width="486" height="30.45" /></mxCell><mxCell id="note10" value="공통 API 의존성: 클라우드 모델 / 근거 / 현재 권한" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;fontSize=20;fontColor=#596A7C;fontStyle=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="120" y="390" width="664" height="29.0" /></mxCell><mxCell id="note11" value="4  A1: R2 관계 + Q1 v8 + K1 + gate" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;fontSize=21;fontColor=#A65E2E;fontStyle=0;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="580" y="1661" width="696" height="30.45" /></mxCell><mxCell id="note12" value="5  A2 CAS / 6  A3 사실 적용" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;fontSize=21;fontColor=#233247;fontStyle=0;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="1210" y="1661" width="507" height="30.45" /></mxCell><mxCell id="n
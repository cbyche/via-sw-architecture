"2495" y="1210" /></Array></mxGeometry></mxCell><mxCell id="2-edge-release-label" value="현재 admission과 내구 원장 뒤 전달" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;fontColor=#171717;fontSize=19;fontStyle=0;fontFamily=Arial;align=left;verticalAlign=top;spacing=0;connectable=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1810" y="1091" width="620" height="26" /></mxCell><mxCell id="title-0" value="S-04  |  대기와 재개의 권위 원본을 선택한다" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;fontColor=#171717;fontSize=38;fontStyle=1;fontFamily=Arial;align=left;verticalAlign=top;spacing=0;connectable=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="48" y="20" width="2492" height="45" /></mxCell><mxCell id="subtitle-0" value="T와 A는 내구 대기 복구 / B는 대기 graph 복구 포기, Task와 command 원장은 유지" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;fontColor=#171717;fontSize=22;fontStyle=0;fontFamily=Arial;align=left;verticalAlign=top;spacing=0;connectable=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="48" y="82" width="2492" height="29" /></mxCell><mxCell id="footer-0" value="VIA / Stage 4 / 구조 탐색, 미채택 대안 / 구현 및 측정 결과 아님" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;fontColor=#171717;fontSize=18;fontStyle=0;fontFamily=Arial;align=left;verticalAlign=top;spacing=0;connectable=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="48" y="1396" width="2492" height="25" /></mxCell><mxCell id="panel-title0-0" value="T  실제 reviewed target" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;fontColor=#171717;fontSize=28;fontStyle=1;fontFamily=Arial;align=left;verticalAlign=top;spacing=0;connectable=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="72" y="187" width="2468" height="35" /></mxCell><mxCell id="panel-title1-0" value="A  대안 구조" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeCol
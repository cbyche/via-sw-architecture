287.12" y="42" width="208.88" height="30.3" /></mxCell><mxCell id="e4" value="음성 대화의 반응성과 정정 정확성을 위한 실행&lt;br&gt;발화 단위와 연속 수정" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=34;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="75" width="780.48" height="94" /></mxCell><mxCell id="e5" value="“이 표를 보내…” → “아니, 설명만 해줘” → 준비는 재사용할 수 있지만 보내기는 실행 금지" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=22;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="166" width="990.08" height="35.7" /></mxCell><mxCell id="e7" value="A  확정 발화부터 처리" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=30;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="285" width="341.0" height="46.5" /></mxCell><mxCell id="e9" value="공통: Streaming ASR 연속 수신; 음성 끼어들기는 먼저 재생 중단" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="94" y="350" width="706.46" height="34.35" /></mxCell><mxCell id="e15" value="1  발화가 확정되면 전체 입력 전달" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="129" y="625" width="320.12" height="30.3" /></mxCell><mxCell id="e17" value="2  근거 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="704" y="750" width="124.64" height="30.3" /></mxCell><mxCell id="e19" value="근거/버전 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="704" y="880" width="138.32" height="30.3" /></mxCell><mxCell id="e21" value="3  확정 발화/근거로 의미 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="129" y="980" width="284.12" height="30.3" /></mxCell><mxCell id="e23" value="의미 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="449" y="1050" width="91.16" height="30.3" /></mxCell><mxCell id="e25" value="4  현재 검사 후 응답 허용" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="129" y="1410" width="248.12" height="30.3" /></mxCell><mxCell id="e26" value="부분 전사는 수신만 유지&lt;br&gt;발화 확정 뒤 의미 처리&lt;br&gt;후속 정정은 새 요청으로" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="864" y="1130" width="257.06" height="91.05000000000001" /></mxCell><mxCell id="e27" value="Request Interpreter/Response Manager → Model Access → 공유 Omni&lt;br&gt;5  Response Manager → Interaction Manager: 음성/Text; 실제 전달 구간 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=20;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="94" y="1770" width="865.2" height="60.0" /></mxCell><mxCell id="e29" value="유리: 최종 발화만 처리해 추론 낭비를 줄임&lt;br&gt;대가: 발화 종료 뒤 읽기/해석/응답 준비 대기&lt;br&gt;선택: 짧은 발화나 추론 자원이 부족한 환경" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=23;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="79" y="2125" width="527.34" height="123" /></mxCell><mxCell id="e30" value="B  잠정 작업을 수정하며 처리" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=30;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1312" y="285" width="449.6" height="46.5" /></mxCell><mxCell id="e32" value="공통: Streaming ASR 연속 수신; 음성 끼어들기는 먼저 재생 중단" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=21;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1342" y="350" width="706.46" height="34.35" /></mxCell><mxCell id="e41" value="1  부분 발화 + 수정 버전" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1377" y="595" width="241.28" height="30.3" /></mxCell><mxCell id="e43" value="2  잠정 의미" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2112" y="755" width="124.64" height="30.3" /></mxCell><mxCell id="e45" value="결과/버전" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2122" y="990" width="91.16" height="30.3" /></mxCell><mxCell id="e47" value="2  허용 읽기" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2112" y="1045" width="124.64" height="30.3" /></mxCell><mxCell id="e49" value="결과/버전" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2122" y="1280" width="91.16" height="30.3" /></mxCell><mxCell id="e51" value="2  응답 준비" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2112" y="1365" width="124.64" height="30.3" /></mxCell><mxCell id="e53" value="결과/버전" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2122" y="1600" width="91.16" height="30.3" /></mxCell><mxCell id="e55" value="3  정정: 관련 결과 폐기/재배정" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1402" y="1130" width="295.28" height="30.3" /></mxCell><mxCell id="e57" value="4  유효 결과 + 확정 입력" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1377" y="1620" width="241.28" height="30.3" /></mxCell><mxCell id="e59" value="5  현재 검사 뒤 게시 허용" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=18;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2032" y="1680" width="248.12" height="30.3" /></mxCell><mxCell id="e60" value="추론은 같은 Model Access/Omni; 실제 출력은 Interaction Manager, 외부 실행은 별도 승인" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1342" y="1890" width="922.66" height="31.650000000000002" /></mxCell><mxCell id="e62" value="유리: 발화 중 준비; 정정 뒤 유효한 읽기 재사용&lt;br&gt;대가: 취소 낭비/버전 누락/공유 모델 backlog&lt;br&gt;선택: 긴 발화에서 재사용 가능한 준비가 많을 때" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=23;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1327" y="2125" width="564.6" height="123" /></mxCell><mxCell id="e63" value="공통 마무리: Request Controller 현재 검사 → Task Manager → Agent Gateway → Downstream Agent" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=22;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="2270" width="1201.72" height="35.7" /></mxCell><mxCell id="e64" value="접수/결과 반환 → Response Manager → Interaction Manager의 실제 표시/음성. 미해결이면 실행 대신 질문." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=22;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="2310" width="1245.28" height="35.7" /></mxCell><mxCell id="e65" value="검정: 공통 / 파랑: A 고유 / 초록: B 고유. 실선: 요청/전달 / 점선: 결과. 네모: 이름 / 원통: 상태 / 육각형: 외부 의존." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="2370" width="1205.76" height="31.650000000000002" /></mxCell><mxCell id="e66" value="같은 이름의 반복 상자는 동일 Component. 비교 부분의 책임을 펼친 그림. 별도 process 표기가 없으면 논리 분해. 모델 가중치는 한 벌; 이익은 조건부 설계 가설, 미측정." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="2410" width="1644.66" height="31.650000000000002" /></mxCell></root></mxGraphModel></diagram></mxfile>

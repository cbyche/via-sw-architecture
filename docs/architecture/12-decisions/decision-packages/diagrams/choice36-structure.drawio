p;align=center;verticalAlign=middle;fontSize=28;fontStyle=1;fillColor=#F7F9FC;strokeColor=#263445;fontColor=#263445;strokeWidth=1.7;" vertex="1" parent="1"><mxGeometry as="geometry" x="145" y="1080" width="415" height="64" /></mxCell><mxCell id="Aomni" value="공유 Omni" style="shape=hexagon;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=28;fontStyle=1;fillColor=#F7F9FC;strokeColor=#263445;fontColor=#263445;strokeWidth=1.7;" vertex="1" parent="1"><mxGeometry as="geometry" x="735" y="1080" width="465" height="64" /></mxCell><mxCell id="Bos" value="OS 접근 제어" style="shape=hexagon;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=28;fontStyle=1;fillColor=#F7F9FC;strokeColor=#263445;fontColor=#263445;strokeWidth=1.7;" vertex="1" parent="1"><mxGeometry as="geometry" x="1350" y="985" width="445" height="64" /></mxCell><mxCell id="Bsource" value="OS 자료원" style="shape=hexagon;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=28;fontStyle=1;fillColor=#F7F9FC;strokeColor=#263445;fontColor=#263445;strokeWidth=1.7;" vertex="1" parent="1"><mxGeometry as="geometry" x="1350" y="1080" width="445" height="64" /></mxCell><mxCell id="Bomni" value="공유 Omni" style="shape=hexagon;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=28;fontStyle=1;fillColor=#F7F9FC;strokeColor=#263445;fontColor=#263445;strokeWidth=1.7;" vertex="1" parent="1"><mxGeometry as="geometry" x="1980" y="1080" width="470" height="64" /></mxCell><mxCell id="e2" value="VIA / ARCHITECTURE COMPARISON" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=28;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="26" width="421.54" height="37.05" /></mxCell><mxCell id="e3" value="36 / 설계 비교" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=28;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2310.44" y="26" width="185.56" height="37.05" /></mxCell><mxCell id="e4" value="처리 코드가 검사를 우회할 때, 무엇이 접근을 막는가?" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=48;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="74" width="1283.84" height="70.80000000000001" /></mxCell><mxCell id="e5" value="같은 정상 사용: 허용한 보고서 D7만 읽고 요약한다. 다른 파일이나 메일은 이번 요청 범위 밖이다." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=29;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="142" width="1422.62" height="45.150000000000006" /></mxCell><mxCell id="e7" value="공통 보호선" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=28;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="214" width="165.36" height="43.800000000000004" /></mxCell><mxCell id="e8" value="동의, 범위, 철회, 외부 제공 검사. 잘못된 모델 제안도 검사한다. 위험한 connector의 기존 격리는 양안 유지." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=27;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="290" y="214" width="1509.2" height="42.45" /></mxCell><mxCell id="e9" value="추가로 비교할 위협" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=27;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="259" width="257.48" height="42.45" /></mxCell><mxCell id="e10" value="자료 조립/입력 구성 코드 자체의 침해. 모델의 오해와 구별하며 Broker, OS, 공유 모델 침해는 보호 범위 밖." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=27;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="380" y="259" width="1492.46" height="42.45" /></mxCell><mxCell id="e12" value="A  권한을 가진 코드가 정책 준수" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=38;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="80" y="323" width="628.92" height="57.300000000000004" /></mxCell><mxCell id="e13" value="B  처리 권한 제거 + 접근 중개" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=38;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1330" y="323" width="600.04" height="57.300000000000004" /></mxCell><mxCell id="e15" value="신뢰 Core process / 처리 코드도 실제 자료 권한 보유" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=26;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="396" width="736.52" height="41.1" /></mxCell><mxCell id="e25" value="허용 범위" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=26;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="142" y="542" width="128.12" height="41.1" /></mxCell><mxCell id="e27" value="1  입력 / 4  제안 검사" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=26;fontStyle=0;al
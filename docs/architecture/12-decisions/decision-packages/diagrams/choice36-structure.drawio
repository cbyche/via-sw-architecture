strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=26;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1365" y="753" width="254.48" height="41.1" /></mxCell><mxCell id="e68" value="2  handle로 읽기 / 자료 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=24;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1355" y="919" width="384.32" height="38.400000000000006" /></mxCell><mxCell id="e71" value="3  모델 job / 결과" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=25;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1380" y="684" width="263.0" height="39.75" /></mxCell><mxCell id="e73" value="요청별 handle도 Broker 발급" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=24;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1375" y="717" width="375.2" height="38.400000000000006" /></mxCell><mxCell id="e75" value="정책/현재 요청 확인" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=24;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2070" y="702" width="244.64" height="38.400000000000006" /></mxCell><mxCell id="e78" value="허용한 모델 호출" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=26;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1995" y="862" width="222.24" height="41.1" /></mxCell><mxCell id="e84" value="직접 파일/망 우회 → OS 거절" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#B23C35;fontSize=25;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1345" y="964" width="372.5" height="39.75" /></mxCell><mxCell id="e86" value="D7 읽기 / 내용 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#087A53;fontSize=24;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1855" y="1036" width="256.15999999999997" height="38.400000000000006" /></mxCell><mxCell id="e89" value="추론 / 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#263445;fontSize=26;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2250" y="1029" width="160.36" height="41.1" /></mxCell><mxCell id="e91" value="범위 밖 요청은 Broker 거절" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#B23C35;fontSize=24;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1995" y="812" width="348.8" height="38.400000000000006" /></mxCell><mxCell id="e93" value="공통 반환: Request Controller가 현재 검사 → Response Manager / Interaction Manager가 요약 전달. 외부 인계는 Agent Gateway 검사." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#263445;fontSize=25;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="80" y="1180" width="1850.5" height="39.75" /></mxCell><mxCell id="e94" value="A: 공유 호출과 기존 선택적 격리 활용&lt;br&gt;잔여 위험을 수용할 수 있는 보호 수준일 때 후보" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#195FBD;fontSize=27;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="80" y="1228" width="654.92" height="90" /></mxCell><mxCell id="e95" value="B: 범위 밖 접근 제한 ↔ IPC/권한 수명/OS 대응 비용&lt;br&gt;이 처리 코드의 침해 격리가 필수이면 A는 부적격" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#087A53;fontSize=27;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1330" y="1228" width="731.06" height="90" /></mxCell><mxCell id="e97" value="실선: 요청   점선: 반환   점선 외곽: process 경계   빨강: 우회 시도/거절" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=28;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="1372" width="913.28" height="37.05" /></mxCell><mxCell id="e98" value="B는 자료 조립/입력 구성 코드의 우회를 제한. OS 강제, 지연과 자원 효과는 검증 전. / 미선정" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=28;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1401.02" y="1405" width="1094.98" height="37.05" /></mxCell></root></mxGraphModel></diagram></mxfile>

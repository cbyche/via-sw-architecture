650000000000002" /></mxCell><mxCell id="e175" value="승인된 내용의 음성 rendering 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="709" y="4291" width="351.14" height="31.650000000000002" /></mxCell><mxCell id="e177" value="cloud voice 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="709" y="4350" width="187.36" height="31.650000000000002" /></mxCell><mxCell id="e179" value="음성 결과" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="709" y="4409" width="95.78" height="31.650000000000002" /></mxCell><mxCell id="e181" value="음성/전사 결과" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="709" y="4468" width="145.56" height="31.650000000000002" /></mxCell><mxCell id="e183" value="게시 허용 Text/음성. 접수 상태를 작업 완료로 꾸미지 않음" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="145" y="4527" width="571.92" height="31.650000000000002" /></mxCell><mxCell id="e185" value="실제 표시·재생·중단 receipt" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="145" y="4586" width="289.58" height="31.650000000000002" /></mxCell><mxCell id="e187" value="실제 게시 기록 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="333" y="4645" width="195.34" height="31.650000000000002" /></mxCell><mxCell id="e189" value="모든 Component와 상태 권한은 local VIA / 모델은 외부 cloud dependency / Task 계획·실행은 외부 Agent 책임." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="4792" width="1144.58" height="31.650000000000002" /></mxCell><mxCell id="e190" value="B Engine과 구조화기는 Request Interpreter 내부 Module. 해석 상태는 임시이며 채택·질문 원본의 owner는 RC." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="4832" width="1119.12" height="31.650000000000002" /></mxCell><mxCell id="e191" value="사각=Component / 육각=외부 모델·Agent / 실선=요청·전달 / 점선=반환. 호출 분기는 조건부, 수·시간은 측정값 아님." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="4872" width="1144.2" height="31.650000000000002" /></mxCell></root></mxGraphModel></diagram></mxfile>

 근거/Task/질문 버전 제안" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="333" y="2993" width="412.7" height="31.650000000000002" /></mxCell><mxCell id="e133" value="현재 자료/실행 인계 권한 검사" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="333" y="3052" width="294.9" height="31.650000000000002" /></mxCell><mxCell id="e135" value="현재 허용 또는 거절" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="333" y="3111" width="195.34" height="31.650000000000002" /></mxCell><mxCell id="e137" value="사용한 자료 버전의 현재 유효성 확인" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="333" y="3170" width="351.9" height="31.650000000000002" /></mxCell><mxCell id="e139" value="유효/변경/철회 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="333" y="3229" width="195.34" height="31.650000000000002" /></mxCell><mxCell id="e141" value="Task/질문의 현재 상태 확인" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="333" y="3288" width="273.24" height="31.650000000000002" /></mxCell><mxCell id="e143" value="현재 상태와 버전" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="333" y="3347" width="164.56" height="31.650000000000002" /></mxCell><mxCell id="e145" value="현재 입력·자료·Task·질문 검사. 불일치면 인계 보류/재평가" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="333" y="3406" width="571.92" height="31.650000000000002" /></mxCell><mxCell id="e147" value="RC 의미·질문 관계·근거·revision 레코드 durable 저장 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="333" y="3465" width="599.28" height="31.650000000000002" /></mxCell><mxCell id="e149" value="저장 성공/실패; RI Engine이 원본/별도 채택 상태를 저장하지 않음" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="333" y="3524" width="649.82" height="31.650000000000002" /></mxCell><mxCell id="e151" value="저장 성공 시 의미 채택; 실패는 게시/인계 보류" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="333" y="3583" width="456.02" height="31.650000000000002" /></mxCell><mxCell id="e153" va
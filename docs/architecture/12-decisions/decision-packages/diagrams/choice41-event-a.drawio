" height="31.650000000000002" /></mxCell><mxCell id="e77" value="현재 질문/입력 확인 후 게시 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="355" y="1518" width="325.68" height="31.650000000000002" /></mxCell><mxCell id="e79" value="질문 Text에 대응하는 음성 생성 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="765" y="1577" width="361.02" height="31.650000000000002" /></mxCell><mxCell id="e81" value="분리된 응답 세션에서 질문 음성 생성" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="765" y="1636" width="351.9" height="31.650000000000002" /></mxCell><mxCell id="e83" value="질문 음성 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="765" y="1695" width="145.56" height="31.650000000000002" /></mxCell><mxCell id="e85" value="질문 음성 결과" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="765" y="1754" width="145.56" height="31.650000000000002" /></mxCell><mxCell id="e87" value="후보를 Text/음성으로 제시" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="150" y="1813" width="261.46000000000004" height="31.650000000000002" /></mxCell><mxCell id="e89" value="실제 게시 구간" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="150" y="1872" width="145.56" height="31.650000000000002" /></mxCell><mxCell id="e91" value="게시 기록" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="355" y="1931" width="95.78" height="31.650000000000002" /></mxCell><mxCell id="e93" value="6  새 사용자 입력: “예산 보고서”. 실제 게시 질문에 대한 연결 후보" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="150" y="1990" width="664.26" height="31.650000000000002" /></mxCell><mxCell id="e95" value="같은 답변/입력 버전과 현재 질문 안내" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="355" y="2049" width="363.68" height="31.650000000000002" /></mxCell><mxCell id="e97" value="답변 해석 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="560" y="2108" width="145.56" height="31.650000000000002" /></mxCell><mxCell id="e99" value="질문/후보와 답변 해석" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="765" y="2167" width="214.34" height="31.650000000000002" /></mxCell><mxCell id="e101" value="답변 의미 반환: 예산 Task 연결 + 표 삽입 + 메일 초안/발송 금지" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="765" y="2226" width="642.6" height="31.650000000000002" /></mxCell><mxCell id="e103" value="해석 결과 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="560" y="2285" width="145.56" height="31.650000000000002" /></mxCell><mxCell id="e105" value="관계/조건 보존 검사, 필요하면 검증 가능한 부분 수정" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="560" y="2344" width="513.02" height="31.650000000000002" /></mxCell><mxCell id="e107" value="7  완성 의미 + 근거/Task 버전 제안" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="355" y="2403" width="362.92" height="31.650000000000002" /></mxCell><mxCell id="e109" value="현재 자료 제공/실행 인계 권한 검사" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="355" y="2462" width="344.68" height="31.650000000000002" /></mxCell><mxCell id="e111" value="현재 허용 또는 거절" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="355" y="2521" width="195.34" height="31.650000000000002" /></mxCell><mxCell id="e113" value="사용한 자료 버전의 현재 유효성 확인" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="355" y="2580" width="351.9" height="31.650000000000002" /></mxCell><mxCell id="e115" value="유효/변경/철회 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="355" y="2639" width="195.34" height="31.650000000000002" /></mxCell><mxCell id="e117" value="Task/질문의 현재 상태 확인" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="355" y="2698" width="273.24" height="31.650000000000002" /></mxCell><mxCell id="e119" value="현재 상태와 버전" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="355" y="2757" width="164.56" height="31.650000000000002" /></mxCell><mxCell id="e121" value="입력/질문과 채택 버전 검사. 불일치면 인계하지 않고 재평가" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="355" y="2816" width="570.02" height="31.650000000000002" /></mxCell><mxCell id="e123" value="채택 의미/질문 연결을 State Store에 보관. 실패면 인계 보류" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="355" y="2875" width="604.6" height="31.650000000000002" /></mxCell><mxCell id="e125" value="8  조건부 Task 생성/변경 + command ID. 버전이 또 바뀌면 거절" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="355" y="2934" width="641.84" height="31.650000000000002" /></mxCell><mxCell id="e127" value="허용된 요청/조건/참조와 command ID" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1380" y="2993" width="362.92" height="31.650000000000002" /></mxCell><mxCell id="e129" value="외부 업무 위임. 업무 계획/도구 실행은 Agent 책임" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1995" y="3052" width="495.92" height="31.650000000000002" /></mxCell><mxCell id="e131" value="접수 결과. 완료와 구별" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1995" y="3111" width="226.12" height="31.650000000000002" /></mxCell><mxCell id="e133" value="해당 Task의 접수/거절/불명" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1380" y="3170" width="273.24" height="31.650000000000002" /></mxCell><mxCell id="e135" value="확인된 상태" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="355" y="3229" width="114.78" height="31.650000000000002" /></mxCell><mxCell id="e137" value="사용자에게 확인된 상태 전달 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="355" y="3288" width="321.12" height="31.650000000000002" /></mxCell><mxCell id="e139" value="필요한 응답 구성 요청" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="765" y="3347" width="214.34" height="31.650000000000002" /></mxCell><mxCell id="e141" value="같은 Omni의 분리된 응답 세션" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="765" y="3406" width="292.24" height="31.650000000000002" /></mxCell><mxCell id="e143" value="응답 결과" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="765" y="3465" width="95.78" height="31.650000000000002" /></mxCell><mxCell id="e145" value="Text/음성 구성 결과" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="765" y="3524" width="204.46" height="31.650000000000002" /></mxCell><mxCell id="e147" value="같은 사용자 출력: 접수 상태/질문/보류. 작업 완료로 꾸미지 않음" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="150" y="3583" width="624.36" height="31.650000000000002" /></mxCell><mxCell id="e149" value="실제 전달 기록" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="150" y="3642" width="145.56" height="31.650000000000002" /></mxCell><mxCell id="e151" value="게시 기록 반환" style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=white;fontColor=#195FBD;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="355" y="3701" width="145.56" height="31.650000000000002" /></mxCell><mxCell id="e153" value="같은 열/시작/끝. A의 Engine 열은 비움. 모델 가중치 한 벌, 해석/응답 세션은 분리. 채택 상태 보관은 State Store." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="3868" width="1148.76" height="31.650000000000002" /></mxCell><mxCell id="e154" value="B의 조건부 부분 해석: Engine → Interpreter → Model Access → Omni → 역순 후보 반환 → Engine 결합. 이 사례는 추가 해석 없이 질문." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="3908" width="1376.38" height="31.650000000000002" /></mxCell><mxCell id="e155" value="실선=전달/요청, 점선=반환. 논리 순서를 수작업으로 추적한 설계이며 호출 횟수/간격은 성능 측정값이 아님." style="text;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontColor=#5B697B;fontSize=19;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="3948" width="1018.04" height="31.650000000000002" /></mxCell></root></mxGraphModel></diagram></mxfile>

          <mxGeometry x="70" y="1529" width="220" height="63.86" as="geometry" />
        </mxCell>
        <mxCell id="slot1" value="검출 또는 OCR 또는 SAM2" style="text;html=0;strokeColor=none;fillColor=none;whiteSpace=wrap;align=center;verticalAlign=top;fontFamily=Arial;fontSize=21;fontColor=#13724c;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="125" y="1409" width="350" height="35.93" as="geometry" />
        </mxCell>
        <mxCell id="state1_l" value="RAM: embedding·mask·추적 상태&#10;모델 해제 후에도 호환성 확인 후 보존" style="text;html=0;strokeColor=none;fillColor=none;whiteSpace=wrap;align=center;verticalAlign=top;fontFamily=Arial;fontSize=18;fontColor=#13724c;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="500" y="1412" width="380" height="55.88" as="geometry" />
        </mxCell>
        <mxCell id="r1_note" value="Runtime는 유지한다. 가중치·실행 메모리를 해제해도&#10;allocator가 OS에 RAM을 즉시 반환한다고 보장하지 않는다." style="text;html=0;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=19;fontColor=#243247;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="85" y="1956" width="810" height="58.540000000000006" as="geometry" />
        </mxCell>
        <mxCell id="load2_l" value="최초 필요 시 로드&#10;모델 가중치 유지" style="text;html=0;strokeColor=none;fillColor=none;whiteSpace=wrap;align=center;verticalAlign=top;fontFamily=Arial;fontSize=20;fontColor=#13724c;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1375" y="1565" width="390" height="61.2" as="geometry" />
        </mxCell>
        <mxCell id="state2_l" value="R1과 같은 Episode 보존 정책&#10;Episode 종료·무효화 시 재계산" style="text;html=0;strokeColor=none;fillColor=none;whiteSpace=wrap;align=center;verticalAlign=top;fontFamily=Arial;fontSize=19;fontColor=#13724c;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1425" y="1411" width="390" height="58.540000000000006" as="geometry" />
        </mxCell>
        <mxCell id="r2_note" value="가중치는 함께 상주하되 CPU 작업은 기본 직렬 실행.&#10;상주 ≠ 병렬. 실행 허용 정책은 별도 선택이다." style="text;html=0;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=19;fontColor=#243247;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1005" y="1956" width="810" height="58.540000000000006" as="geometry" />
        </mxCell>
        <mxCell id="ip3l_ui" value="개별 IPC 큐" style="text;html=0;strokeColor=none;fillColor=none;whiteSpace=wrap;align=center;verticalAlign=top;fontFamily=Arial;fontSize=19;fontColor=#13724c;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1945" y="766" width="260" height="33.27" as="geometry" />
        </mxCell>
        <mxCell id="pool3_ui" value="개별 thread pool" style="text;html=0;strokeColor=none;fillColor=none;whiteSpace=wrap;align=center;verticalAlign=top;fontFamily=Arial;fontSize=20;fontColor=#13724c;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1945" y="1185" width="350" height="34.6" as="geometry" />
        </mxCell>
        <mxCell id="state3l_ui" value="요청별 생성·해제" style="text;html=0;strokeColor=none;fillColor=none;whiteSpace=wrap;align=center;verticalAlign=top;fontFamily=Arial;fontSize=19;fontColor=#13724c;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1945" y="1416" width="350" height="33.27" as="geometry" />
        </mxCell>
        <mxCell id="ip3l_sam" value="개별 IPC 큐" style="text;html=0;strokeColor=none;fillColor=none;whiteSpace=wrap;align=center;verticalAlign=top;fontFamily=Arial;fontSize=19;fontColor=#13724c;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="2365" y="766" width="260" height="33.27" as="geometry" />
        </mxCell>
        <mxCell id="pool3_sam" value="개별 thread pool" style="text;html=0;strokeColor=none;fillColor=none;whiteSpace=wrap;align=center;verticalAlign=top;fontFamily=Arial;fontSize=20;fontColor=#13724c;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="2365" y="1185" width="350" height="34.6" as="geometry" />
        </mxCell>
        <mxCell id="state3l_sam" value="요청별 생성·해제" style="text;html=0;strokeColor=none;fillColor=none;whiteSpace=wrap;align=center;verticalAlign=top;fontFamily=Arial;fontSize=19;fontColor=#13724c;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="2365" y="1416" width="350" height="33.27" as="geometry" />
        </mxCell>
        <mxCell id="disknote3" value="각 Worker 시작 시 자기 모델 로드" style="text;html=0;strokeColor=none;fillColor=none;whiteSpace=wrap;align=center;verticalAlign=top;fontFamily=Arial;fontSize=20;fontColor=#243247;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="2015" y="1897" width="630" height="34.6" as="geometry" />
        </mxCell>
        <mxCell id="r3_note" value="Core가 전체 CPU 실행량을 제한. 장애·재시작 경계 2개.&#10;private RAM 증가; 공유 library 페이지 전체를 중복 합산하지 않는다." style="text;html=0;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=19;fontColor=#243247;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1925" y="1956" width="810" height="58.540000000000006" as="geometry" />
        </mxCell>
        <mxCell id="footer1" value="R1/R2는 같은 Component·IPC·Episode 보존 정책에서 가중치 수명만 비교한다. R3는 process·큐·runtime·장애 경계가 달라진다. 모델 가중치 ≠ Episode 상태." style="text;html=0;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=22;fontColor=#243247;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="50" y="2048" width="2720" height="37.260000000000005" as="geometry" />
        </mxCell>
        <mxCell id="footer2" value="세 안은 대안이며 동시에 배치하지 않는다. 위의 논리 Worker 연결을 아래에서 각각 펼쳤다. 모든 추론은 CPU; 모델 크기·성능의 측정 결과를 나타내지 않는다." style="text;html=0;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=20;fontColor=#243247;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="50" y="2090" width="2720" height="34.6" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>

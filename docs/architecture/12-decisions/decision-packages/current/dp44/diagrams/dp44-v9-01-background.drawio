<mxfile host="app.diagrams.net"><diagram name="dp44-v9-01-background" id="dp44-v9-01-background"><mxGraphModel dx="1920" dy="1080" page="1" pageWidth="1920" pageHeight="1080"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="DP44. 음성 준비와 재생 실행 방안 (배경)" vertex="1" parent="1" style="text;strokeColor=none;fillColor=none;fontSize=44;fontStyle=1;align=left;fontFamily=Calibri;whiteSpace=wrap;html=0;"><mxGeometry x="60" y="29" width="1140" height="68" as="geometry"/></mxCell><mxCell id="subtitle" value="이미 완성된 질문과 결과가 겹칠 때, 언제 음성을 준비하고 누가 재생을 제어할 것인가?" vertex="1" parent="1" style="text;strokeColor=none;fillColor=none;fontSize=27;fontStyle=1;align=left;fontFamily=Calibri;whiteSpace=wrap;html=0;"><mxGeometry x="60" y="129" width="1800" height="47" as="geometry"/></mxCell><mxCell id="progress0" value="과제 소개" vertex="1" parent="1" style="shape=chevron;fillColor=#98999B;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontSize=19;fontStyle=1;fontFamily=Calibri;whiteSpace=wrap;html=0;"><mxGeometry x="1210" y="33" width="143" height="44" as="geometry"/></mxCell><mxCell id="progress1" value="요구사항 분석" vertex="1" parent="1" style="shape=chevron;fillColor=#98999B;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontSize=19;fontStyle=1;fontFamily=Calibri;whiteSpace=wrap;html=0;"><mxGeometry x="1344" y="33" width="143" height="44" as="geometry"/></mxCell><mxCell id="progress2" value="설계" vertex="1" parent="1" style="shape=chevron;fillColor=#35A8CD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontSize=19;fontStyle=1;fontFamily=Calibri;whiteSpace=wrap;html=0;"><mxGeometry x="1478" y="33" width="143" height="44" as="geometry"/></mxCell><mxCell id="progress3" value="구현 및 검증" vertex="1" parent="1" style="shape=chevron;fillColor=#98999B;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontSize=19;fontStyle=1;fontFamily=Calibri;whiteSpace=wrap;html=0;"><mxGeometry x="1612" y="33" width="143" height="44" as="geometry"/></mxCell><mxCell id="progress4" value="결론" vertex="1" parent="1" style="shape=chevron;fill
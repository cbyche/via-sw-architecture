entryX=0;entryY=0.7692307692307693;exitPerimeter=0;entryPerimeter=0;edgeStyle=none;endArrow=block;strokeColor=#111111;dashed=0;strokeWidth=1.8;"><mxGeometry relative="1" as="geometry"><mxPoint x="315" y="710" as="sourcePoint"/><mxPoint x="845" y="480" as="targetPoint"/><Array as="points"><mxPoint x="740" y="710"/><mxPoint x="740" y="480"/></Array></mxGeometry></mxCell><mxCell id="register" edge="1" parent="1" source="admit" target="pending" style="exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=0;entryPerimeter=0;edgeStyle=none;endArrow=block;strokeColor=#111111;dashed=0;strokeWidth=1.8;"><mxGeometry relative="1" as="geometry"><mxPoint x="1060" y="495" as="sourcePoint"/><mxPoint x="1060" y="550" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="prepare" edge="1" parent="1" source="pending" target="voice" style="exitX=1;exitY=0.30434782608695654;entryX=0;entryY=0.4631578947368421;exitPerimeter=0;entryPerimeter=0;edgeStyle=none;endArrow=block;strokeColor=#111111;dashed=0;strokeWidth=1.8;"><mxGeometry relative="1" as="geometry"><mxPoint x="1275" y="585" as="sourcePoint"/><mxPoint x="1525" y="430" as="targetPoint"/><Array as="points"><mxPoint x="1420" y="585"/><mxPoint x="1420" y="430"/></Array></mxGeometry></mxCell><mxCell id="play" edge="1" parent="1" source="voice" target="device" style="exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=0;entryPerimeter=0;edgeStyle=none;endArrow=block;strokeColor=#111111;dashed=0;strokeWidth=1.8;"><mxGeometry relative="1" as="geometry"><mxPoint x="1685" y="481" as="sourcePoint"/><mxPoint x="1685" y="620" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="cell1" value="공통으로 지키는 것" vertex="1" parent="1" style="shape=rectangle;fillColor=#C9E1B3;strokeColor=#B7B9B9;fontSize=24;fontStyle=1;fontColor=#111111;fontFamily=Calibri;whiteSpace=wrap;html=0;"><mxGeometry x="60" y="865" width="900" height="42" as="geometry"/></mxCell><mxCell id="cell2" value="선택에 따라 달라지는 것" vertex="1" parent="1" style="shape=rectangle;fillColor=#C9E1B3;strokeColor=#B7B9B9;fontSize=24;fontStyle=1;fontColor=#111111;fontFamily=Calibri;whiteSpace=wrap;html=0;"><mxGeometry x="960" y="865" width="900" height="42" as="geometry"/></mxCell><mxCell id="cell3" value="질문과 결과의 업무 내용은 Downstream Agent가 작성&#xa;화면 표시, 로컬 발화 감지와 DP2 의미 채택은 동일" vertex="1" parent="1" style="shape=rectangle;fillColor=#FFFFFF;strokeColor=#B7B9B9;fontSize=24;fontStyle=0;fontColor=#111111;fontFamily=Calibri;whiteSpace=wrap;html=0;"><mxGeometry x="60" y="907" width="900" height="80" as="geometry"/></mxCell><mxCell id="cell4" value="A: 응답별 생성 실행과 보관을 재생과 분리&#xa;B: 현재 발화 실행이 생성과 버퍼를 함께 관리" vertex="1" parent="1" style="shape=rectangle;fillColor=#FFFFFF;strokeColor=#B7B9B9;fontSize=24;fontStyle=0;fontColor=#111111;fontFamily=Calibri;whiteSpace=wrap;html=0;"><mxGeometry x="960" y="907" width="900" height="80" as="geometry"/></mxCell><mxCell id="cell5" value="구판 재생 차단, 유효 음성 재사용, 실제 출력 이력" vertex="1" parent="1" style="shape=rectangle;fillColor=#FFFFFF;strokeColor=#B7B9B9;fontSize=24;fontStyle=0;fontColor=#111111;fontFamily=Calibri;whiteSpace=wrap;html=0;"><mxGeometry x="60" y="987" width="900" height="52" as="geometry"/></mxCell><mxCell id="cell6" value="A의 준비 적중 이익 ↔ 미전달 음성의 생성 비용" vertex="1" parent="1" style="shape=rectangle;fillColor=#FFFFFF;strokeColor=#B7B9B9;fontSize=24;fontStyle=0;fontColor=#111111;fontFamily=Calibri;whiteSpace=wrap;html=0;"><mxGeometry x="960" y="987" width="900" height="52" as="geometry"/></mxCell><mxCell id="text7" value="배경: R0를 말하는 중에 Q1과 R1이 도착한다. 사용자는 R0를 끊고 보고서 정정과 읽기 순서를 요청한다." vertex="1" parent="1" style="text;strokeColor=none;fillColor=none;fontSize=26.666667;align=left;fontStyle=1;fontColor=#111111;fontFamily=Calibri;whiteSpace=wrap;html=0;"><mxGeometry x="60" y="795" width="1800" height="50" as="geometry"/></mxCell><mxCell id="flowlabel8" value="1 “6월 기준으로 고쳐줘.&#xa;메일 질문부터 읽어줘.”" vertex="1" parent="1" style="text;strokeColor=none;fillColor=#FFFFFF;fontSize=21.333333;align=center;fontFamily=Calibri;whiteSpace=wrap;html=0;"><mxGeometry x="345" y="259" width="430" height="82" as="geometry"/></mxCell><mxCell id="flowlabel9" value="2 정정 범위와 순서 채택" vertex="1" parent="1" style="text;strokeColor=none;fillColor=#FFFFFF;fontSize=21.333333;align=center;fontFamily=Calibri;whiteSpace=wrap;html=0;"><mxGeometry x="1075" y="315" width="395" height="38" as="geometry"/></mxCell><mxCell id="flowlabel10" value="Q1: “수신자는 김 대리인가요?”" vertex="1" parent="1" style="text;strokeColor=none;fillColor=#FFFFFF;fontSize=21.333333;align=center;fontFamily=Calibri;whiteSpace=wrap;html=0;"><mxGeometry x="340" y="484" width="430" height="50" as="geometry"/></mxCell><mxCell id="flowlabel11" value="R1-v1: 보고서 결과 텍스트" vertex="1" parent="1" style="text;strokeColor=none;fillColor=#FFFFFF;fontSize=21.333333;align=center;fontFamily=Calibri;whiteSpace=wrap;html=0;"><mxGeometry x="340" y="650" width="430" height="50" as="geometry"/></mxCell><mxCell id="flowlabel12" value="3 현재 판본 저장" vertex="1" parent="1" style="text;strokeColor=none;fillColor=#FFFFFF;fontSize=21.333333;align=center;fontFamily=Calibri;whiteSpace=wrap;html=0;"><mxGeometry x="1080" y="503" width="270" height="35" as="geometry"/></mxCell><mxCell id="flowlabel13" value="음성 준비 시점?" vertex="1" parent="1" style="text;strokeColor=none;fillColor=#FFFFFF;fontSize=21.333333;align=center;fontFamily=Calibri;whiteSpace=wrap;html=0;"><mxGeometry x="1332" y="490" width="225" height="60" as="geometry"/></mxCell><mxCell id="flowlabel14" value="생성과 재생의&#xa;수명 분리?" vertex="1" parent="1" style="text;strokeColor=none;fillColor=#FFFFFF;fontSize=21.333333;align=center;fontFamily=Calibri;whiteSpace=wrap;html=0;"><mxGeometry x="1525" y="520" width="320" height="65" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
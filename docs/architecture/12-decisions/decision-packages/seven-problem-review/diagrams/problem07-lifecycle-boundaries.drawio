        </mxCell>
        <mxCell id="ac" value="Request Controller + Task Manager&lt;br&gt;같은 Core 안의 별도 기능 Module&lt;br&gt;트랜잭션 관리자가 관련 변경을 공동 확정&lt;br&gt;짧은 transaction. 외부 I/O는 commit 밖에서 수행" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F4FB;strokeColor=#176EAD;fontColor=#182B40;fontFamily=Arial;fontSize=25;align=left;verticalAlign=top;spacing=16;">
          <mxGeometry x="90" y="470" width="750" height="150" as="geometry" />
        </mxCell>
        <mxCell id="as" value="관련 Request / Task / command 상태 저장&lt;br&gt;R1↔T1 연결과 X1 의도 / outbox를 함께 확정" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E7;strokeColor=#A45A18;fontColor=#182B40;fontFamily=Arial;fontSize=25;align=left;verticalAlign=top;spacing=16;">
          <mxGeometry x="90" y="685" width="750" height="110" as="geometry" />
        </mxCell>
        <mxCell id="ao" value="Agent Gateway → 외부 수신 / 수행 사실 별도 확인" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F4FB;strokeColor=#176EAD;fontColor=#182B40;fontFamily=Arial;fontSize=25;align=left;verticalAlign=top;spacing=16;">
          <mxGeometry x="90" y="865" width="750" height="80" as="geometry" />
        </mxCell>
        <mxCell id="bd" value="대화 서비스&lt;br&gt;R1과 pending 의도 저장&lt;br&gt;inbox / outbox / receipt&lt;br&gt;대화 저장소와 writer&lt;br&gt;업무 접수 사실 반영" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E7;strokeColor=#A45A18;fontColor=#182B40;fontFamily=Arial;fontSize=25;align=left;verticalAlign=top;spacing=16;">

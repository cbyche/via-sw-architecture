        <mxCell id="label0" value="DP-42: 대화와 업무 상태를 어디서 확정하는가" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontFamily=Arial;fontSize=42;fontColor=#182B40;fontStyle=1;">
          <mxGeometry x="55" y="47" width="1705" height="54" as="geometry" />
        </mxCell>
        <mxCell id="label1" value="대화 C1의 요청 R1을 Task T1에 연결하고 실행 X1을 위임한다. 두 안 모두 대화와 업무의 수명이 다르다." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontFamily=Arial;fontSize=27;fontColor=#516275;fontStyle=0;">
          <mxGeometry x="55" y="112" width="1705" height="39" as="geometry" />
        </mxCell>
        <mxCell id="label2" value="기본 구조의 선택   |   파랑: 처리 경로   |   주황: 유지 상태   |   하단: 선택 후 보완 기법" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontFamily=Arial;fontSize=22;fontColor=#176EAD;fontStyle=0;">
          <mxGeometry x="55" y="170" width="1705" height="34" as="geometry" />
        </mxCell>
        <mxCell id="label3" value="설계 분석 그림. 성능 수치와 측정 결과가 아니며 실패 및 복구 계약은 연결된 본문에 수록." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontFamily=Arial;fontSize=21;fontColor=#516275;fontStyle=0;">
          <mxGeometry x="55" y="1125" width="1705" height="33" as="geometry" />
        </mxCell>
        <mxCell id="label4" value="B의 독립 writer / 장애 경계 가능성 ↔ 서비스 간 접수와 반영의 복구 비용. 정상 이익은 조건부." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontFamily=Arial;fontSize=24;fontColor=#176EAD;fontStyle=0;">
          <mxGeometry x="70" y="1015" width="1690" height="36" as="geometry" />

        <mxCell id="Bin" value="C1 / R1은 대화 상태, T1 / X1은 업무 상태&lt;br&gt;별도 논리 수명과 owner를 두 안 모두 유지" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F4FB;strokeColor=#176EAD;fontColor=#182B40;fontFamily=Arial;fontSize=25;align=left;verticalAlign=top;spacing=16;">

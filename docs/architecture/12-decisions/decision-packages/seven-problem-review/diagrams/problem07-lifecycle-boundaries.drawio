        <mxCell id="label5" value="선택 A 이후 A1 저장 작업의 짧은 단위와 우선순위 / A2 읽기용 Task snapshot" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontFamily=Arial;fontSize=24;fontColor=#A45A18;fontStyle=0;">

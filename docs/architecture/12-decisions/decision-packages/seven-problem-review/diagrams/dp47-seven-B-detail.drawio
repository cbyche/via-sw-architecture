        <mxCell id="label0" value="DP-47 상세 B: producer 소유 후보를 생산하고 호환 revision으로 결합" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontFamily=Arial;fontSize=42;fontColor=#182B40;fontStyle=1;">
          <mxGeometry x="55" y="47" width="2305" height="54" as="geometry" />
        </mxCell>
        <mxCell id="label1" value="같은 장면: D1의 두 대상을 가리키고 페이지를 바꾼 뒤 “이 둘과 방금 그래프를 비교해줘.” 이후 일부 정정." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontFamily=Arial;fontSize=27;fontColor=#516275;fontStyle=0;">
          <mxGeometry x="55" y="112" width="2305" height="39" as="geometry" />
        </mxCell>
        <mxCell id="label2" value="파랑: 역할과 처리  |  주황: 보존 상태  |  실선: 입력/결과  |  점선: 조건부 호출/제어/재조회  |  하단: 선택 후 보완" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontFamily=Arial;fontSize=25;fontColor=#176EAD;fontStyle=0;">
          <mxGeometry x="55" y="170" width="2305" height="37" as="geometry" />
        </mxCell>
        <mxCell id="label3" value="설계 분석 그림. 성능 수치와 측정 결과가 아니며 실패 및 복구 계약은 연결된 본문에 수록." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontFamily=Arial;fontSize=21;fontColor=#516275;fontStyle=0;">

        <mxCell id="label0" value="DP-44: 비동기 작업의 다음 단계를 누가 시작하는가" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontFamily=Arial;fontSize=42;fontColor=#182B40;fontStyle=1;">

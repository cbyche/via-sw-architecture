        <mxCell id="label0" value="문제 2 / 기본 B: 공통 대화를 유지하고 긴 판단을 요청별 실행으로 나눈다" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontFamily=Arial;fontSize=42;fontColor=#182B40;fontStyle=1;">
          <mxGeometry x="55" y="47" width="2105" height="54" as="geometry" />
        </mxCell>
        <mxCell id="label1" value="A와 같은 원본 / 실제 전달 / 호출 상한 K. 짧은 답은 바로 반환하며 R1과 R2는 자원 여유가 있을 때만 함께 진행한다." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontFamily=Arial;fontSize=27;fontColor=#516275;fontStyle=0;">
          <mxGeometry x="55" y="112" width="2105" height="39" as="geometry" />
        </mxCell>

        <mxCell id="label0" value="Agent 선택: 요청 판단에 결합할 것인가, 선택 실행을 분리할 것인가" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontFamily=Arial;fontSize=42;fontColor=#182B40;fontStyle=1;">

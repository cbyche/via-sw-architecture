        <mxCell id="label0" value="문제 2 / 기본 A: 하나의 대화 해석 실행에서 다음 판단으로 이어 간다" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontFamily=Arial;fontSize=42;fontColor=#182B40;fontStyle=1;">
          <mxGeometry x="55" y="47" width="2105" height="54" as="geometry" />
        </mxCell>
        <mxCell id="label1" value="D1 판단 중 새 질문, D2 요청, “비용만” 정정과 Agent의 Q1이 들어온다. 앞선 요청 전체 완료를 기다리지 않는다." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontFamily=Arial;fontSize=27;fontColor=#516275;fontStyle=0;">
          <mxGeometry x="55" y="112" width="2105" height="39" as="geometry" />
        </mxCell>
        <mxCell id="label2" value="기본 구조의 선택   |   파랑: 처리 경로   |   주황: 유지 상태   |   하단: 선택 후 보완 기법" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontFamily=Arial;fontSize=22;fontColor=#176EAD;fontStyle=0;">
          <mxGeometry x="55" y="170" width="2105" height="34" as="geometry" />
        </mxCell>
        <mxCell id="label3" value="설계 분석 그림. 성능 수치와 측정 결과가 아니며 실패 및 복구 계약은 연결된 본문에 수록." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontFamily=Arial;fontSize=21;fontColor=#516275;fontStyle=0;">
          <mxGeometry x="55" y="1645" width="2105" height="33" as="geometry" />
        </mxCell>
        <mxCell id="label4" value="선택 후 보완: 아래 기법은 기본 A의 정상 경로에 포함하지 않는다. A2는 A1을 자동 포함하지 않는다." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontFamily=Arial;fontSize=25;fontColor=#A45A18;fontStyle=0;">
          <mxGeometry x="55" y="1450" width="2105" height="37" as="geometry" />

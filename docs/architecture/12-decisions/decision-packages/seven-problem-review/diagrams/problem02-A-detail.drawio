<mxfile host="app.diagrams.net">
  <diagram name="problem02-A-detail">
    <mxGraphModel page="1" pageWidth="2200" pageHeight="1700">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="user" value="1a 사용자 입력: Interaction Manager&lt;br&gt;수신 / VAD에서 로컬 음성 즉시 중단 [코드]&lt;br&gt;원문 / 전사 revision / 화면 근거 참조&lt;br&gt;새 질문, 정정, 실제 표시한 질문의 답변" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F4FB;strokeColor=#176EAD;fontColor=#182B40;fontFamily=Arial;fontSize=25;align=left;verticalAlign=top;spacing=16;">
          <mxGeometry x="55" y="235" width="650" height="165" as="geometry" />
        </mxCell>
        <mxCell id="agent" value="1b 외부 Agent 통지: Task Manager&lt;br&gt;진행 / 질문 / 승인 필요 / 결과 / 실패&lt;br&gt;접수 ID와 외부에서 확인된 사실 보존&lt;br&gt;취소 요청과 확인된 종료는 별도 사실" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F4FB;strokeColor=#176EAD;fontColor=#182B40;fontFamily=Arial;fontSize=25;align=left;verticalAlign=top;spacing=16;">
          <mxGeometry x="775" y="235" width="650" height="165" as="geometry" />
        </mxCell>
        <mxCell id="delivered" value="1c 실제 전달 receipt: 표시 / 재생 결과&lt;br&gt;Interaction Manager: UI 표시 / 실제 재생&lt;br&gt;Response Manager: 전달 범위 / Q1 기록&lt;br&gt;생성 문장과 실제 전달 / 미전달을 구별" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F4FB;strokeColor=#176EAD;fontColor=#182B40;fontFamily=Arial;fontSize=25;align=left;verticalAlign=top;spacing=16;">
          <mxGeometry x="1495" y="235" width="650" height="165" as="geometry" />
        </mxCell>
        <mxCell id="ingress" value="2 입력 등록 / hold: Request Controller [코드]&lt;br&gt;입력 / revision 보존, 관련 미전송 효과 hold&lt;br&gt;명시 ID 제어 / 단순 상태는 코드로 6에 전달&lt;br&gt;관계가 모호한 입력은 의미 판단에 전달" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F4FB;strokeColor=#176EAD;fontColor=#182B40;fontFamily=Arial;fontSize=25;align=left;verticalAlign=top;spacing=16;">
          <mxGeometry x="775" y="450" width="650" height="165" as="geometry" />
        </mxCell>
        <mxCell id="records" value="원본 상태: 각 owner의 내구 원장&lt;br&gt;Request Controller: 입력 / 목표 / revision&lt;br&gt;Task Manager: Task / execution / 외부 사실&lt;br&gt;Response Manager: 실제 전달 / 질문 receipt" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E7;strokeColor=#A45A18;fontColor=#182B40;fontFamily=Arial;fontSize=25;align=left;verticalAlign=top;spacing=16;">
          <mxGeometry x="55" y="450" width="650" height="165" as="geometry" />
        </mxCell>
        <mxCell id="cloud" value="cloud 모델 호출 경계: 공통 상한 K&lt;br&gt;모든 [모델] 단계는 같은 예산에서 admission&lt;br&gt;시작한 호출은 실제 종료까지 slot 점유&lt;br&gt;외부 Agent 업무 대기는 VIA slot 미점유&lt;br&gt;API 송신 시각은 provider 계산 시작 아님" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F4FB;strokeColor=#176EAD;fontColor=#182B40;fontFamily=Arial;fontSize=25;align=left;verticalAlign=top;spacing=16;">
          <mxGeometry x="1495" y="450" width="650" height="190" as="geometry" />
        </mxCell>
        <mxCell id="context" value="대화 해석 문맥: Request Interpreter&lt;br&gt;대화 수명 동안 읽은 근거와 잠정 판단 유지&lt;br&gt;R1 / R2의 미해결 목표와 사용 근거를 구별&lt;br&gt;모델 문맥은 왼쪽 위 내구 원장의 대체물 아님" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E7;strokeColor=#A45A18;fontColor=#182B40;fontFamily=Arial;fontSize=25;align=left;verticalAlign=top;spacing=16;">
          <mxGeometry x="55" y="665" width="650" height="165" as="geometry" />
        </mxCell>
        <mxCell id="boundary" value="3 다음 판단 경계에서 입력 반영 [코드]&lt;br&gt;현재 VIA 호출 / 읽기 step의 종료를 기다림&lt;br&gt;원래 목표 전체 완료나 외부 업무 종료는 안 기다림" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F4FB;strokeColor=#176EAD;fontColor=#182B40;fontFamily=Arial;fontSize=25;align=left;verticalAlign=top;spacing=16;">
          <mxGeometry x="775" y="665" width="650" height="130" as="geometry" />
        </mxCell>
        <mxCell id="active" value="진행 중인 step: Request Interpreter&lt;br&gt;필요한 원본 조회 [코드 / I/O]&lt;br&gt;자유 의미 판단이 필요할 때만 [모델]" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F4FB;strokeColor=#176EAD;fontColor=#182B40;fontFamily=Arial;fontSize=25;align=left;verticalAlign=top;spacing=16;">
          <mxGeometry x="1495" y="690" width="650" height="140" as="geometry" />
        </mxCell>
        <mxCell id="evidence" value="필요 근거 공급: 문제 1의 같은 정책&lt;br&gt;새 입력 + 최근 실제 전달 + 활성 목표&lt;br&gt;유지 문맥의 유효 근거를 계속 사용&lt;br&gt;부족한 범위는 허용 원본을 bounded read" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F4FB;strokeColor=#176EAD;fontColor=#182B40;fontFamily=Arial;fontSize=25;align=left;verticalAlign=top;spacing=16;">
          <mxGeometry x="55" y="880" width="650" height="165" as="geometry" />
        </mxCell>
        <mxCell id="interpret" value="4 관계와 내용 판단: Request Interpreter&lt;br&gt;모호한 의미 / 대상 / 목표 연결이면 [모델]&lt;br&gt;독립 질문, 정정, Q1 답변의 관계를 제안&lt;br&gt;새 입력 전에 읽은 유효 문맥도 함께 사용" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F4FB;strokeColor=#176EAD;fontColor=#182B40;fontFamily=Arial;fontSize=25;align=left;verticalAlign=top;spacing=16;">
          <mxGeometry x="775" y="880" width="650" height="165" as="geometry" />
        </mxCell>
        <mxCell id="branch" value="5 관계에 따른 다음 처리&lt;br&gt;독립 질문: 원래 목표를 남기고 새 답 준비&lt;br&gt;정정: 해당 요청의 변경 / 보존 범위 반영&lt;br&gt;Q1 답변: 실제 제시한 질문과 연결" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F4FB;strokeColor=#176EAD;fontColor=#182B40;fontFamily=Arial;fontSize=25;align=left;verticalAlign=top;spacing=16;">
          <mxGeometry x="1495" y="880" width="650" height="165" as="geometry" />
        </mxCell>
        <mxCell id="display" value="7 Response Manager: 응답 준비 / 게시 원장&lt;br&gt;Interaction Manager: 실제 UI 표시 / 음성 재생&lt;br&gt;표시 / 재생 receipt로 실제 전달 범위 기록&lt;br&gt;실제 표시한 질문의 답변은 새 입력 1a로" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F4FB;strokeColor=#176EAD;fontColor=#182B40;fontFamily=Arial;fontSize=25;align=left;verticalAlign=top;spacing=16;">
          <mxGeometry x="55" y="1100" width="650" height="165" as="geometry" />
        </mxCell>
        <mxCell id="adopt" value="6 현재성 확인 / 채택: Request Controller&lt;br&gt;입력 / source revision, 관계, 권한 재확인&lt;br&gt;미해결 효과는 hold, 재판단이 필요하면 4로&lt;br&gt;늦은 결과는 보관해도 최신 답으로 채택 안 함" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F4FB;strokeColor=#176EAD;fontColor=#182B40;fontFamily=Arial;fontSize=25;align=left;verticalAlign=top;spacing=16;">
          <mxGeometry x="775" y="1100" width="650" height="165" as="geometry" />
        </mxCell>
        <mxCell id="failure" value="실패 / 늦은 완료: 같은 실행에서 복구&lt;br&gt;실패 step과 유효 목표를 보존해 다시 진행&lt;br&gt;취소 요청과 실제 종료를 구별해 slot 추적&lt;br&gt;외부 수행 불명이면 새 Action으로 재시작 금지" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F4FB;strokeColor=#176EAD;fontColor=#182B40;fontFamily=Arial;fontSize=25;align=left;verticalAlign=top;spacing=16;">
          <mxGeometry x="1495" y="1100" width="650" height="165" as="geometry" />
        </mxCell>
        <mxCell id="resume" value="8 남은 유효 목표 / 입력을 같은 실행에서 계속 처리 → 다음 판단 경계 3&lt;br&gt;외부 Agent 결과나 사용자 답변을 기다릴 때는 VIA 호출 자원을 놓는다. 내구 원본과 실제 전달 기록은 해석 문맥보다 오래 보존한다." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F4FB;strokeColor=#176EAD;fontColor=#182B40;fontFamily=Arial;fontSize=25;align=left;verticalAlign=top;spacing=16;">
          <mxGeometry x="55" y="1330" width="2090" height="100" as="geometry" />
        </mxCell>
        <mxCell id="tactic_a1" value="A1 제한된 별도 질문: 도구 없는 side 답변 경로&lt;br&gt;짧은 질문의 대기를 줄이되 실제 전달 이력은 보존&lt;br&gt;추가 근거 필요 / 분류 오류이면 본 실행 복귀와 중복 비용" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F4FB;strokeColor=#176EAD;fontColor=#182B40;fontFamily=Arial;fontSize=25;align=left;verticalAlign=top;spacing=16;">
          <mxGeometry x="55" y="1495" width="1010" height="115" as="geometry" />
        </mxCell>
        <mxCell id="tactic_a2" value="A2 현재 호출 중단 / 재개: 최신 정정으로 다시 판단&lt;br&gt;취소 요청 뒤 실제 종료까지 slot 유지, 폐기 / 재입력 비용&lt;br&gt;독립 질문 때문에 중단했다면 원래 목표의 재개 비용도 기록" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F4FB;strokeColor=#176EAD;fontColor=#182B40;fontFamily=Arial;fontSize=25;align=left;verticalAlign=top;spacing=16;">
          <mxGeometry x="1135" y="1495" width="1010" height="115" as="geometry" />
        </mxCell>

<mxfile host="app.diagrams.net">
  <diagram name="problem05-B-detail">
    <mxGraphModel page="1" pageWidth="2200" pageHeight="1700">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="work" value="지속 업무 기록: Context Manager&lt;br&gt;공개 결과의 확인 범위 / 미확인 설명&lt;br&gt;조건과 결과의 source-backed 관계&lt;br&gt;record / 의존성 / coverage / job" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E7;strokeColor=#A45A18;fontColor=#182B40;fontFamily=Arial;fontSize=25;align=left;verticalAlign=top;spacing=16;">
          <mxGeometry x="70" y="455" width="630" height="150" as="geometry" />
        </mxCell>
        <mxCell id="prepare" value="2 목적에 맞는 업무 기록 조회&lt;br&gt;Context Manager: 유효 record에서 추출&lt;br&gt;공통 기록에 없는 현재 목적은 추가 구성&lt;br&gt;현재 Task 조건은 원본과 대조" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F4FB;strokeColor=#176EAD;fontColor=#182B40;fontFamily=Arial;fontSize=25;align=left;verticalAlign=top;spacing=16;">
          <mxGeometry x="780" y="455" width="650" height="150" as="geometry" />
        </mxCell>
        <mxCell id="model" value="별도 생산: 자유문 관계 필요 때 호출&lt;br&gt;Model Access → cloud 의미 모델&lt;br&gt;공개 결과 / 실제 전달 변경으로 갱신&lt;br&gt;구조화 필드는 코드, domain 계획 제외" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F4FB;strokeColor=#176EAD;fontColor=#182B40;fontFamily=Arial;fontSize=25;align=left;verticalAlign=top;spacing=16;">
          <mxGeometry x="1510" y="455" width="650" height="150" as="geometry" />
        </mxCell>
        <mxCell id="cap" value="지속 게시와 요청별 추출을 구별&lt;br&gt;record / coverage / job 일관 확정&lt;br&gt;목적별 capsule은 요청 수명&lt;br&gt;원본과 같은 내용이면 추가 이익 없음" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E7;strokeColor=#A45A18;fontColor=#182B40;fontFamily=Arial;fontSize=25;align=left;verticalAlign=top;spacing=16;">
          <mxGeometry x="70" y="640" width="630" height="150" as="geometry" />
        </mxCell>
        <mxCell id="candidate" value="3 추출 자료와 부족한 원본을 결합&lt;br&gt;source 판본 / 실제 전달 범위 확인&lt;br&gt;새 목적의 원본 보완 / 재구성도 계상&lt;br&gt;준비가 끝난 인계 후보만 4로 전달" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F4FB;strokeColor=#176EAD;fontColor=#182B40;fontFamily=Arial;fontSize=25;align=left;verticalAlign=top;spacing=16;">
          <mxGeometry x="780" y="640" width="650" height="150" as="geometry" />
        </mxCell>
        <mxCell id="failure" value="게시 / 추출 오류 또는 source 변경&lt;br&gt;해당 record revision을 사용 차단&lt;br&gt;재생산 또는 허용 원본에서 보완&lt;br&gt;필수 근거 없으면 보류 / 확인" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F4FB;strokeColor=#176EAD;fontColor=#182B40;fontFamily=Arial;fontSize=25;align=left;verticalAlign=top;spacing=16;">
          <mxGeometry x="1510" y="640" width="650" height="150" as="geometry" />
        </mxCell>
        <mxCell id="ledger" value="복구 원장: record / 게시 cursor&lt;br&gt;삭제 원장 먼저, 확정 게시부터 복원&lt;br&gt;오래된 job의 재게시를 거절&lt;br&gt;수행 불명 Action은 다시 보내지 않음" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E7;strokeColor=#A45A18;fontColor=#182B40;fontFamily=Arial;fontSize=25;align=left;verticalAlign=top;spacing=16;">
          <mxGeometry x="70" y="1010" width="630" height="150" as="geometry" />
        </mxCell>
        <mxCell id="out" value="6 공개 사건을 보존하고 기록 갱신&lt;br&gt;Task Manager / Response Manager 원본&lt;br&gt;다음 인계는 갱신된 record를 재사용&lt;br&gt;미소비 생산 / 폐기 / 재시도도 계상" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F4FB;strokeColor=#176EAD;fontColor=#182B40;fontFamily=Arial;fontSize=25;align=left;verticalAlign=top;spacing=16;">
          <mxGeometry x="780" y="1195" width="650" height="150" as="geometry" />
        </mxCell>
        <mxCell id="resume" value="B의 실제 이익이 없는 경우&lt;br&gt;공통 Task / 01이 같은 설명을 이미 제공&lt;br&gt;A도 그 근거를 사용하므로 추가 절약 0&lt;br&gt;목적마다 재구성이면 상각 이익 감소" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F4FB;strokeColor=#176EAD;fontColor=#182B40;fontFamily=Arial;fontSize=25;align=left;verticalAlign=top;spacing=16;">
          <mxGeometry x="1510" y="1195" width="650" height="150" as="geometry" />
        </mxCell>
        <mxCell id="raw" value="원본의 권위는 각 owner에 있음&lt;br&gt;입력 / 정정: Request Controller&lt;br&gt;실제 전달: Response Manager&lt;br&gt;결과 / 현재 업무: Task Manager" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E7;strokeColor=#A45A18;fontColor=#182B40;fontFamily=Arial;fontSize=25;align=left;verticalAlign=top;spacing=16;">
          <mxGeometry x="70" y="270" width="630" height="150" as="geometry" />
        </mxCell>
        <mxCell id="in" value="1 현재 인계 요청과 채택 상태&lt;br&gt;Request Controller / Task Manager&lt;br&gt;목표 / 조건 / 제외 / 허용 Action&lt;br&gt;Agent 선택은 공통으로 고정한 별도 결정" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F4FB;strokeColor=#176EAD;fontColor=#182B40;fontFamily=Arial;fontSize=25;align=left;verticalAlign=top;spacing=16;">
          <mxGeometry x="780" y="270" width="650" height="150" as="geometry" />
        </mxCell>
        <mxCell id="scope" value="공통 실제 근거 / 권한 계약&lt;br&gt;원본 + 공개 결과 + 실제 전달만 사용&lt;br&gt;필수 조건은 수신자 추측에 맡기지 않음&lt;br&gt;공통 생산은 01과 한 번만 비용 계상" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F4FB;strokeColor=#176EAD;fontColor=#182B40;fontFamily=Arial;fontSize=25;align=left;verticalAlign=top;spacing=16;">
          <mxGeometry x="1510" y="270" width="650" height="150" as="geometry" />
        </mxCell>
        <mxCell id="gate" value="4 외부 실행 허가 계약 확정&lt;br&gt;요청 / attempt / delegation 판본&lt;br&gt;source / 권한 / 필수 조건 재확인&lt;br&gt;불명인 동일 Action의 중복 실행 금지" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F4FB;strokeColor=#176EAD;fontColor=#182B40;fontFamily=Arial;fontSize=25;align=left;verticalAlign=top;spacing=16;">
          <mxGeometry x="780" y="825" width="650" height="150" as="geometry" />
        </mxCell>
        <mxCell id="sent" value="내구 원장: 계약 / 송신 / 수신 사실&lt;br&gt;4 계약 확정, 5 실제 송신 등록&lt;br&gt;Agent Gateway: 수신 확인은 별도 기록&lt;br&gt;Task Manager: 공개 수행 사실만 기록" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E7;strokeColor=#A45A18;fontColor=#182B40;fontFamily=Arial;fontSize=25;align=left;verticalAlign=top;spacing=16;">
          <mxGeometry x="70" y="825" width="630" height="150" as="geometry" />
        </mxCell>
        <mxCell id="change" value="정정 / 철회 / 실행 상태 불명&lt;br&gt;원본 revision / 권한 epoch를 먼저 변경&lt;br&gt;미전송 계약과 늦은 이전 완료 차단&lt;br&gt;이미 보낸 외부 자료의 회수는 별도" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F4FB;strokeColor=#176EAD;fontColor=#182B40;fontFamily=Arial;fontSize=25;align=left;verticalAlign=top;spacing=16;">
          <mxGeometry x="1510" y="825" width="650" height="150" as="geometry" />
        </mxCell>
        <mxCell id="send" value="5 Agent Gateway가 확정 계약 전송&lt;br&gt;adapter의 입력 형식 / 예산을 준수&lt;br&gt;실제 전송 등록과 철회 경쟁을 차단&lt;br&gt;정정 적용 완료는 외부 확인과 구별" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F4FB;strokeColor=#176EAD;fontColor=#182B40;fontFamily=Arial;fontSize=25;align=left;verticalAlign=top;spacing=16;">
          <mxGeometry x="780" y="1010" width="650" height="150" as="geometry" />
        </mxCell>
        <mxCell id="agent" value="외부 Downstream Agent 경계&lt;br&gt;받은 계약 안에서 domain 판단 / 실행&lt;br&gt;비공개 추론 / memory 이전 가정 없음&lt;br&gt;수신 확인과 실제 수행은 다른 사실" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F4FB;strokeColor=#176EAD;fontColor=#182B40;fontFamily=Arial;fontSize=25;align=left;verticalAlign=top;spacing=16;">
          <mxGeometry x="1510" y="1010" width="650" height="150" as="geometry" />
        </mxCell>
        <mxCell id="tactic1" value="B1 변경 묶음 갱신&lt;br&gt;여러 공개 사건을 묶어 기록 생산&lt;br&gt;추가: 최신 record 대기 / 원본 보완&lt;br&gt;철회 사용 차단은 갱신을 기다리지 않음" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E7;strokeColor=#A45A18;fontColor=#182B40;fontFamily=Arial;fontSize=25;align=left;verticalAlign=top;spacing=16;">
          <mxGeometry x="70" y="1450" width="1010" height="155" as="geometry" />
        </mxCell>
        <mxCell id="tactic2" value="B2 변경 조각 갱신&lt;br&gt;확인된 dependency의 설명 블록만 재생산&lt;br&gt;추가: index / 부분 정합성 검사 / fallback&lt;br&gt;B+C 수신자 읽기는 tactic이 아닌 구조 조합" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E7;strokeColor=#A45A18;fontColor=#182B40;fontFamily=Arial;fontSize=25;align=left;verticalAlign=top;spacing=16;">
          <mxGeometry x="1150" y="1450" width="1010" height="155" as="geometry" />
        </mxCell>

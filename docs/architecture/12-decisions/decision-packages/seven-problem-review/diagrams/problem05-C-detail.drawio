<mxfile host="app.diagrams.net">
  <diagram name="problem05-C-detail">
    <mxGraphModel page="1" pageWidth="2200" pageHeight="1700">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="work" value="공통 상태와 adapter capability&lt;br&gt;현재 목표 / 조건 / 결과 locator&lt;br&gt;protocol / 형식 / namespace / 권한&lt;br&gt;읽기 미지원이면 A/B 전환 또는 보류" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E7;strokeColor=#A45A18;fontColor=#182B40;fontFamily=Arial;fontSize=25;align=left;verticalAlign=top;spacing=16;">
          <mxGeometry x="70" y="455" width="630" height="150" as="geometry" />
        </mxCell>
        <mxCell id="prepare" value="2 필수 manifest와 자료 목록 구성&lt;br&gt;Context Manager: 목적과 원본 범위 연결&lt;br&gt;필수 조건은 명시하고 세부 선택만 위임&lt;br&gt;모든 원문을 미리 골라 요약하지 않음" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F4FB;strokeColor=#176EAD;fontColor=#182B40;fontFamily=Arial;fontSize=25;align=left;verticalAlign=top;spacing=16;">
          <mxGeometry x="780" y="455" width="650" height="150" as="geometry" />
        </mxCell>
        <mxCell id="model" value="2 필수 설명에 의미 가공 필요 때 호출&lt;br&gt;Model Access → cloud 의미 모델&lt;br&gt;명시 조건 / 판본 / 접근 검사는 코드&lt;br&gt;수신자의 domain 자료 선택과 구별" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F4FB;strokeColor=#176EAD;fontColor=#182B40;fontFamily=Arial;fontSize=25;align=left;verticalAlign=top;spacing=16;">
          <mxGeometry x="1510" y="455" width="650" height="150" as="geometry" />
        </mxCell>
        <mxCell id="cap" value="지속 접근 상태: manifest / lease&lt;br&gt;수신자 / source revision / 허용 범위&lt;br&gt;만료 / 철회 epoch / read receipt&lt;br&gt;session ID만으로 권한을 주지 않음" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E7;strokeColor=#A45A18;fontColor=#182B40;fontFamily=Arial;fontSize=25;align=left;verticalAlign=top;spacing=16;">
          <mxGeometry x="70" y="640" width="630" height="150" as="geometry" />
        </mxCell>
        <mxCell id="candidate" value="3 유효 자료 접근을 준비&lt;br&gt;실제 읽기 방법과 범위 제한을 확인&lt;br&gt;허용 자료의 판본 / lease / 만료 명시&lt;br&gt;필수 자료 접근이 없으면 허가하지 않음" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F4FB;strokeColor=#176EAD;fontColor=#182B40;fontFamily=Arial;fontSize=25;align=left;verticalAlign=top;spacing=16;">
          <mxGeometry x="780" y="640" width="650" height="150" as="geometry" />
        </mxCell>
        <mxCell id="failure" value="접근 실패 / 판본 변경 / 기능 미지원&lt;br&gt;묵시적 최신판 교체나 성공 처리 금지&lt;br&gt;허용 계약 갱신 또는 A/B로 명시 전환&lt;br&gt;지원 가능한 일부만 전체 성공으로 안 셈" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F4FB;strokeColor=#176EAD;fontColor=#182B40;fontFamily=Arial;fontSize=25;align=left;verticalAlign=top;spacing=16;">
          <mxGeometry x="1510" y="640" width="650" height="150" as="geometry" />
        </mxCell>
        <mxCell id="ledger" value="복구 / 철회 원장과 read receipt&lt;br&gt;lease 복원 전에 현재 권한을 재검사&lt;br&gt;철회 즉시 신규 읽기와 늦은 반환 차단&lt;br&gt;외부에 이미 전달한 자료 회수는 별도" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E7;strokeColor=#A45A18;fontColor=#182B40;fontFamily=Arial;fontSize=25;align=left;verticalAlign=top;spacing=16;">
          <mxGeometry x="70" y="1010" width="630" height="150" as="geometry" />
        </mxCell>
        <mxCell id="out" value="6 요청된 범위마다 자료 읽기 제공&lt;br&gt;Context Manager: 권한 / 판본 재확인&lt;br&gt;유효 구간 / 누락 / read receipt 반환&lt;br&gt;자료 읽기 자체가 외부 실행 허가는 아님" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F4FB;strokeColor=#176EAD;fontColor=#182B40;fontFamily=Arial;fontSize=25;align=left;verticalAlign=top;spacing=16;">
          <mxGeometry x="780" y="1195" width="650" height="150" as="geometry" />
        </mxCell>
        <mxCell id="pull" value="수신 Agent가 필요한 상세를 선택&lt;br&gt;manifest를 받은 뒤 허용 범위를 요청&lt;br&gt;읽은 자료로 domain 업무 수행&lt;br&gt;공개 결과는 Task Manager로 별도 수신" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F4FB;strokeColor=#176EAD;fontColor=#182B40;fontFamily=Arial;fontSize=25;align=left;verticalAlign=top;spacing=16;">
          <mxGeometry x="1510" y="1195" width="650" height="150" as="geometry" />
        </mxCell>
        <mxCell id="raw" value="원본의 권위는 각 owner에 있음&lt;br&gt;입력 / 정정: Request Controller&lt;br&gt;실제 전달: Response Manager&lt;br&gt;결과 / 현재 업무: Task Manager" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E7;strokeColor=#A45A18;fontColor=#182B40;fontFamily=Arial;fontSize=25;align=left;verticalAlign=top;spacing=16;">
          <mxGeometry x="70" y="270" width="630" height="150" as="geometry" />
        </mxCell>
        <mxCell id="in" value="1 현재 인계 요청과 채택 상태&lt;br&gt;Request Controller / Task Manager&lt;br&gt;목표 / 조건 / 제외 / 허용 Action&lt;br&gt;Agent 선택은 공통으로 고정한 별도 결정" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F4FB;strokeColor=#176EAD;fontColor=#182B40;fontFamily=Arial;fontSize=25;align=left;verticalAlign=top;spacing=16;">
          <mxGeometry x="780" y="270" width="650" height="150" as="geometry" />
        </mxCell>
        <mxCell id="scope" value="공통 실제 근거 / 권한 계약&lt;br&gt;원본 + 공개 결과 + 실제 전달만 사용&lt;br&gt;필수 조건은 수신자 추측에 맡기지 않음&lt;br&gt;공통 생산은 01과 한 번만 비용 계상" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F4FB;strokeColor=#176EAD;fontColor=#182B40;fontFamily=Arial;fontSize=25;align=left;verticalAlign=top;spacing=16;">
          <mxGeometry x="1510" y="270" width="650" height="150" as="geometry" />
        </mxCell>
        <mxCell id="gate" value="4 외부 실행 허가 계약 확정&lt;br&gt;요청 / attempt / delegation 판본&lt;br&gt;source / 권한 / 필수 조건 재확인&lt;br&gt;불명인 동일 Action의 중복 실행 금지" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F4FB;strokeColor=#176EAD;fontColor=#182B40;fontFamily=Arial;fontSize=25;align=left;verticalAlign=top;spacing=16;">
          <mxGeometry x="780" y="825" width="650" height="150" as="geometry" />
        </mxCell>
        <mxCell id="sent" value="내구 원장: 계약 / 송신 / 수신 사실&lt;br&gt;4 계약 확정, 5 실제 송신 등록&lt;br&gt;Agent Gateway: 수신 확인은 별도 기록&lt;br&gt;Task Manager: 공개 수행 사실만 기록" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E7;strokeColor=#A45A18;fontColor=#182B40;fontFamily=Arial;fontSize=25;align=left;verticalAlign=top;spacing=16;">
          <mxGeometry x="70" y="825" width="630" height="150" as="geometry" />
        </mxCell>
        <mxCell id="change" value="정정 / 철회 / 실행 상태 불명&lt;br&gt;원본 revision / 권한 epoch를 먼저 변경&lt;br&gt;미전송 계약과 늦은 이전 완료 차단&lt;br&gt;이미 보낸 외부 자료의 회수는 별도" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F4FB;strokeColor=#176EAD;fontColor=#182B40;fontFamily=Arial;fontSize=25;align=left;verticalAlign=top;spacing=16;">
          <mxGeometry x="1510" y="825" width="650" height="150" as="geometry" />
        </mxCell>
        <mxCell id="send" value="5 Agent Gateway가 확정 계약 전송&lt;br&gt;adapter의 입력 형식 / 예산을 준수&lt;br&gt;실제 전송 등록과 철회 경쟁을 차단&lt;br&gt;정정 적용 완료는 외부 확인과 구별" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F4FB;strokeColor=#176EAD;fontColor=#182B40;fontFamily=Arial;fontSize=25;align=left;verticalAlign=top;spacing=16;">
          <mxGeometry x="780" y="1010" width="650" height="150" as="geometry" />
        </mxCell>
        <mxCell id="agent" value="외부 Downstream Agent 경계&lt;br&gt;받은 계약 안에서 domain 판단 / 실행&lt;br&gt;비공개 추론 / memory 이전 가정 없음&lt;br&gt;수신 확인과 실제 수행은 다른 사실" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F4FB;strokeColor=#176EAD;fontColor=#182B40;fontFamily=Arial;fontSize=25;align=left;verticalAlign=top;spacing=16;">
          <mxGeometry x="1510" y="1010" width="650" height="150" as="geometry" />
        </mxCell>
        <mxCell id="tactic1" value="C1 특정 자료 prefetch&lt;br&gt;사용 가능성이 높은 원본을 미리 준비&lt;br&gt;추가: 미사용 I/O / buffer / 만료 처리&lt;br&gt;작은 반환 범위가 작은 backend RAM은 아님" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E7;strokeColor=#A45A18;fontColor=#182B40;fontFamily=Arial;fontSize=25;align=left;verticalAlign=top;spacing=16;">
          <mxGeometry x="70" y="1450" width="1010" height="155" as="geometry" />
        </mxCell>
        <mxCell id="tactic2" value="C2 읽기 결과 cache&lt;br&gt;같은 허용 판본 / 범위의 결과를 재사용&lt;br&gt;추가: 저장 / 무효화 / 수신자 권한 확인&lt;br&gt;QA03 종료 뒤 serving / 외부 비용은 별도" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E7;strokeColor=#A45A18;fontColor=#182B40;fontFamily=Arial;fontSize=25;align=left;verticalAlign=top;spacing=16;">
          <mxGeometry x="1150" y="1450" width="1010" height="155" as="geometry" />
        </mxCell>

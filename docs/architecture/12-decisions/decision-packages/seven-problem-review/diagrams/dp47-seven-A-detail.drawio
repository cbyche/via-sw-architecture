<mxfile host="app.diagrams.net">
  <diagram name="dp47-seven-A-detail">
    <mxGraphModel page="1" pageWidth="2400" pageHeight="1800">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="capture" value="1 Interaction Manager: 실제 관측&lt;br&gt;발화 중 원음 + 전사 revision&lt;br&gt;frame + source 시각 / 수신 시각&lt;br&gt;유효한 발화 전 selection / pre-roll&lt;br&gt;pointer path / 버튼 / page / 창&lt;br&gt;circle / page 이동을 함께 기록" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F4FB;strokeColor=#176EAD;fontColor=#182B40;fontFamily=Arial;fontSize=25;align=left;verticalAlign=top;spacing=16;">
          <mxGeometry x="55" y="235" width="550" height="245" as="geometry" />
        </mxCell>
        <mxCell id="control" value="정정과 권한의 공통 제어&lt;br&gt;r2 등록 즉시 r1 후속 사용 hold&lt;br&gt;BeginRevision: expected 값 교체&lt;br&gt;TryApply / TryPublish와 같은 Gate&lt;br&gt;취소와 채택 차단은 별도 처리&lt;br&gt;의미 worker 완료를 기다리지 않음" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F4FB;strokeColor=#176EAD;fontColor=#182B40;fontFamily=Arial;fontSize=25;align=left;verticalAlign=top;spacing=16;">
          <mxGeometry x="1795" y="235" width="550" height="245" as="geometry" />
        </mxCell>
        <mxCell id="raw" value="Raw Evidence Window + Reader&lt;br&gt;원음 / encoded frame / native&lt;br&gt;source ID / 판본 / locator / 시각 오차&lt;br&gt;순서 / gap / 권한 / 만료를 보존&lt;br&gt;시간 대응은 의도 판단의 근거&lt;br&gt;timestamp만으로 의도 확정 안 함&lt;br&gt;worker가 범위 read lease로 읽음&lt;br&gt;callback을 막지 않는 유한 Queue&lt;br&gt;포화: payload 누락과 gap 기록&lt;br&gt;없던 원본은 생성하지 않음&lt;br&gt;현재 화면으로 과거 원본 대체 금지" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E7;strokeColor=#A45A18;fontColor=#182B40;fontFamily=Arial;fontSize=25;align=left;verticalAlign=top;spacing=16;">
          <mxGeometry x="55" y="555" width="550" height="420" as="geometry" />
        </mxCell>
        <mxCell id="retention" value="원본과 임시 상태의 수명&lt;br&gt;bytes 안전 복사 후 OS frame 반납&lt;br&gt;raw: 시간 / byte / lease 한도 적용&lt;br&gt;필요 정정 구간 보존, 철회 우선&lt;br&gt;후보가 생겨도 raw 삭제 안 함&lt;br&gt;decoded / staging: reader 종료 후&lt;br&gt;SDK 참조 종료도 확인 후 회수&lt;br&gt;임시 상태는 채택 / 종료 후 정리&lt;br&gt;채택된 허용 artifact만 지속 저장&lt;br&gt;raw 해제 뒤 불가능한 재판단 명시&lt;br&gt;영속 파일 크기와 local RAM 구별" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E7;strokeColor=#A45A18;fontColor=#182B40;fontFamily=Arial;fontSize=25;align=left;verticalAlign=top;spacing=16;">
          <mxGeometry x="55" y="1040" width="550" height="430" as="geometry" />
        </mxCell>
        <mxCell id="failure" value="정정 / 오류 / unknown 경로&lt;br&gt;r2: 현재 요청 binding을 재판단&lt;br&gt;늦은 r1: writer가 stale 게시 거절&lt;br&gt;권한 철회: raw / 파생 사용 차단&lt;br&gt;source: 역사 / 현재 selector 구별&lt;br&gt;관측 gap: 한도 대기 또는 확인&lt;br&gt;모델 실패: 예산 내 재시도 / 보류&lt;br&gt;coverage 불명은 정답이 아님&lt;br&gt;불완전 binding으로 업무 위임 금지&lt;br&gt;제어 / 완료 inbox와 job Queue 분리&lt;br&gt;state lock 안에서 I/O await 금지" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F4FB;strokeColor=#176EAD;fontColor=#182B40;fontFamily=Arial;fontSize=25;align=left;verticalAlign=top;spacing=16;">
          <mxGeometry x="1795" y="1040" width="550" height="430" as="geometry" />
        </mxCell>
        <mxCell id="adoption" value="6 공통 Currentness + Adoption Gate → Request Controller / State Store&lt;br&gt;input / source / policy / base 및 A 원본 의존 / B 후보 read-set의 현재성 검사&lt;br&gt;통과한 binding만 요청 해석 / 응답 / 업무에 사용. 불일치는 거절, 모호함은 확인&lt;br&gt;QA02 최초 채택 오류 보존. 후속 수정으로 최초 실패를 지우지 않음" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F4FB;strokeColor=#176EAD;fontColor=#182B40;fontFamily=Arial;fontSize=25;align=left;verticalAlign=top;spacing=16;">
          <mxGeometry x="665" y="1315" width="1070" height="155" as="geometry" />
        </mxCell>
        <mxCell id="trigger" value="2 Request Controller → Grounding Attempt Control&lt;br&gt;완성 입력 revision 등록 후 의미 판단 시작. 발화 중 원본 수집은 계속&lt;br&gt;GroundingInput: rawRefs / 전사 / prior / 권한 / revision / deadline&lt;br&gt;bounded Joint Work Queue에는 참조 job. worker가 Reader를 직접 읽음&lt;br&gt;정정 시 현재 요청의 전체 binding 집합 재검토. 전체 대화 재실행은 아님&lt;br&gt;제어 / 완료 inbox 분리. 현재 시도 안의 유효 binding은 재사용" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F4FB;strokeColor=#176EAD;fontColor=#182B40;fontFamily=Arial;fontSize=25;align=left;verticalAlign=top;spacing=16;">
          <mxGeometry x="665" y="235" width="1070" height="245" as="geometry" />
        </mxCell>
        <mxCell id="joint" value="3 Joint Grounding Interpreter: extent와 binding의 의미 writer&lt;br&gt;native 선택과 표현이 명백하면 code. 의미 판단이 필요하면 M 공통 모델&lt;br&gt;원음 / 전사 + frame / path / native를 함께 읽어 지칭 집합과 관계를 생산&lt;br&gt;한 call에서 두 graph와 제목 등 다수 지칭 가능. 표현 수만큼 call 강제 없음&lt;br&gt;같은 판단에서 읽은 원본과 binding으로 충분한 검사에는 재입력을 강제 안 함&lt;br&gt;부족한 발화 / 화면 범위는 5에서 원본 재조회. 별도 후보 게시 관문 없음&lt;br&gt;기본에는 semantic crop/cache, 부분 binding patch, 증분 의미 판단 미포함" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F4FB;strokeColor=#176EAD;fontColor=#182B40;fontFamily=Arial;fontSize=25;align=left;verticalAlign=top;spacing=16;">
          <mxGeometry x="665" y="555" width="1070" height="270" as="geometry" />
        </mxCell>
        <mxCell id="state" value="4 Joint Grounding State: 현재 시도의 불변 결과와 근거 의존&lt;br&gt;bindings / source read-set / input revision / base version / 불확실성&lt;br&gt;TryApply 현재성 통과 시 게시. 같은 판단 안의 후속 검사에 재사용&lt;br&gt;요청 채택 / 종료 뒤 필요한 binding과 source만 남기고 임시 상태 회수" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E7;strokeColor=#A45A18;fontColor=#182B40;fontFamily=Arial;fontSize=25;align=left;verticalAlign=top;spacing=16;">
          <mxGeometry x="665" y="880" width="1070" height="155" as="geometry" />
        </mxCell>
        <mxCell id="decision" value="5 Ready / NeedEvidence / Ambiguous&lt;br&gt;NeedEvidence → 같은 Joint Grounding Interpreter가 bounded 원본 재조회&lt;br&gt;관측이 충분해지면 3 재판단. 원본이 없으면 unknown / 질문 / 보류&lt;br&gt;source 오류나 r2 정정은 새 근거 판본으로 현재 요청 binding을 재검토&lt;br&gt;Ready도 직접 사용하지 않음. 6 공통 gate에서 최초 채택 확정" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F4FB;strokeColor=#176EAD;fontColor=#182B40;fontFamily=Arial;fontSize=25;align=left;verticalAlign=top;spacing=16;">
          <mxGeometry x="665" y="1085" width="1070" height="190" as="geometry" />
        </mxCell>
        <mxCell id="model" value="M 조건부 cloud 의미 의존&lt;br&gt;Model Access / 같은 capability&lt;br&gt;native 충분 → 모델 생략 가능&lt;br&gt;3: 원본 의미 판단에만 요청&lt;br&gt;발화 + 관련 media + prior 입력&lt;br&gt;다수 지칭도 한 번에 처리 가능&lt;br&gt;worker가 결과 / usage를 회수&lt;br&gt;입력 / 출력 / 재시도 청구 포함&lt;br&gt;취소 뒤 청구와 staging도 포함&lt;br&gt;cloud weights / KV는 RAM 제외&lt;br&gt;기본 A에 별도 screen parser 없음" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F4FB;strokeColor=#176EAD;fontColor=#182B40;fontFamily=Arial;fontSize=25;align=left;verticalAlign=top;spacing=16;">
          <mxGeometry x="1795" y="555" width="550" height="420" as="geometry" />
        </mxCell>
        <mxCell id="tactics" value="선택 후 보완: 각각 기본 A + 개별 기법. 함께 쓰면 조합을 명시&lt;br&gt;A1 crop/cache: 실제 read와 청구 감소 확인.  A2 부분 binding patch: 의미 영향 범위 판단과 전체 재검토 fallback 필요&lt;br&gt;A3 발화 중 증분 의미 판단: 양쪽에 가능한 보완.  A4 동일 parser를 advisory 입력으로 사용: 최종 의미 writer는 Joint&lt;br&gt;현재 기본 추천 A. A1/A2는 필요 시 선택. 큰 원본 입력과 재판단 비용은 남으며, 정확도 우위나 비용 승자는 미측정" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E7;strokeColor=#A45A18;fontColor=#182B40;fontFamily=Arial;fontSize=25;align=left;verticalAlign=top;spacing=16;">
          <mxGeometry x="55" y="1510" width="2290" height="190" as="geometry" />
        </mxCell>
        <mxCell id="edge0" value="" edge="1" parent="1" source="capture" target="raw" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;strokeColor=#516275;strokeWidth=2;dashed=0;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points" />

        <mxCell id="label0" value="근거 공급 C: 과거 관계를 게시하고 현재 요청의 빈 곳은 원본으로 보완한다" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontFamily=Arial;fontSize=42;fontColor=#182B40;fontStyle=1;">
          <mxGeometry x="55" y="47" width="2105" height="54" as="geometry" />
        </mxCell>
        <mxCell id="label1" value="같은 입력과 과거 원본. 미래 요청의 정답 Task를 미리 생산하지 않는다. 게시 생산과 현재 조회는 별도 수명이다." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontFamily=Arial;fontSize=27;fontColor=#516275;fontStyle=0;">
          <mxGeometry x="55" y="112" width="2105" height="39" as="geometry" />
        </mxCell>
        <mxCell id="label2" value="기본 구조의 선택   |   파랑: 처리 경로   |   주황: 유지 상태   |   하단: 선택 후 보완 기법" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontFamily=Arial;fontSize=22;fontColor=#176EAD;fontStyle=0;">
          <mxGeometry x="55" y="170" width="2105" height="34" as="geometry" />
        </mxCell>
        <mxCell id="label3" value="설계 분석 그림. 성능 수치와 측정 결과가 아니며 실패 및 복구 계약은 연결된 본문에 수록." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontFamily=Arial;fontSize=21;fontColor=#516275;fontStyle=0;">
          <mxGeometry x="55" y="1645" width="2105" height="33" as="geometry" />
        </mxCell>
        <mxCell id="label4" value="원본과 상태: 각 owner가 보존" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontFamily=Arial;fontSize=27;fontColor=#176EAD;fontStyle=1;">
          <mxGeometry x="70" y="220" width="2090" height="39" as="geometry" />
        </mxCell>
        <mxCell id="label5" value="VIA 기본 처리: 번호 순서" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontFamily=Arial;fontSize=27;fontColor=#176EAD;fontStyle=1;">
          <mxGeometry x="780" y="220" width="1380" height="39" as="geometry" />
        </mxCell>
        <mxCell id="label6" value="Cloud 호출과 변경 / 실패" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontFamily=Arial;fontSize=27;fontColor=#176EAD;fontStyle=1;">
          <mxGeometry x="1510" y="220" width="650" height="39" as="geometry" />
        </mxCell>
        <mxCell id="label7" value="기본의 이익과 비용: 교차 대화의 반복 관계 조합 감소 ↔ 선생산, 미사용 기록, 갱신과 원본 보완 비용." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontFamily=Arial;fontSize=25;fontColor=#176EAD;fontStyle=0;">
          <mxGeometry x="70" y="1370" width="2090" height="37" as="geometry" />
        </mxCell>

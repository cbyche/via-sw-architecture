;fontSize=25.333333;fontStyle=0;fontColor=#111111;fontFamily=Calibri;whiteSpace=wrap;html=0;"><mxGeometry x="420" y="262" width="720" height="92" as="geometry"/></mxCell><mxCell id="cell5" value="미선택 구판의 생성 비용 회피&#xa;예상 변경 범위가 작음" vertex="1" parent="1" style="shape=rectangle;fillColor=#FFFFFF;strokeColor=#B7B9B9;fontSize=25.333333;fontStyle=0;fontColor=#111111;fontFamily=Calibri;whiteSpace=wrap;html=0;"><mxGeometry x="1140" y="262" width="720" height="92" as="geometry"/></mxCell><mxCell id="cell6" value="감수하는 비용" vertex="1" parent="1" style="shape=rectangle;fillColor=#FFFFFF;strokeColor=#B7B9B9;fontSize=25.333333;fontStyle=0;fontColor=#111111;fontFamily=Calibri;whiteSpace=wrap;html=0;"><mxGeometry x="60" y="354" width="360" height="92" as="geometry"/></mxCell><mxCell id="cell7" value="전체 VIA 모델 비용 11.47% 증가&#xa;준비 job, 구간과 판본의 관리 부담" vertex="1" parent="1" style="shape=rectangle;fillColor=#FFFFFF;strokeColor=#B7B9B9;fontSize=25.333333;fontStyle=0;fontColor=#111111;fontFamily=Calibri;whiteSpace=wrap;html=0;"><mxGeometry x="420" y="354" width="720" height="92" as="geometry"/></mxCell><mxCell id="cell8" value="발화 선택 뒤 생성 대기&#xa;긴 응답 재개 시 후반 문맥 재입력" vertex="1" parent="1" style="shape=rectangle;fillColor=#FFFFFF;strokeColor=#B7B9B9;fontSize=25.333333;fontStyle=0;fontColor=#111111;fontFamily=Calibri;whiteSpace=wrap;html=0;"><mxGeometry x="1140" y="354" width="720" height="92" as="geometry"/></mxCell><mxCell id="cell9" value="유리한 사용 조건" vertex="1" parent="1" style="shape=rectangle;fillColor=#FFFFFF;strokeColor=#B7B9B9;fontSize=25.333333;fontStyle=0;fontColor=#111111;fontFamily=Calibri;whiteSpace=wrap;html=0;"><mxGeometry x="60" y="446" width="360" height="92" as="geometry"/></mxCell><mxCell id="cell10" value="유효한 질문과 결과가 자주 대기&#xa;정정 뒤에도 준비 내용이 유지" vertex="1" parent="1" style="shape=rectangle;fillColor=#FFFFFF;strokeColor=#B7B9B9;fontSize=25.333333;fontStyle=0;fontColor=#111111;fontFamily=Calibri;whiteSpace=wrap;html=0;"><mxGeometry x="420" y="446" width="720" height="92" as="geometry"/></mxCell><mxCell id="cell11" value="전달 전 철회와 대체가 잦음&#xa;선행 준비할 시간 여유가 적음" vertex="1" parent="1" style="shape=rectangle;fillColor=#FFFFFF;strokeColor=#B7B9B9;fontSize=25.333333;fontStyle=0;fontColor=#111111;fontFamily=Calibri;whiteSpace=wrap;html=0;"><mxGeometry x="1140" y="446" width="720" height="92" as="geometry"/></mxCell><mxCell id="cell12" value="조건부 판단" vertex="1" parent="1" style="shape=rectangle;fillColor=#FFFFFF;strokeColor=#B7B9B9;fontSize=25.333333;fontStyle=0;fontColor=#111111;fontFamily=Calibri;whiteSpace=wrap;html=0;"><mxGeometry x="60" y="538" width="360" height="96" as="geometry"/></mxCell><mxCell id="cell13" value="A 권고: QA01 UI, QA02 동점 다음 QA03&#xa;QA07을 임의 우선순위에 넣지 않음" vertex="1" parent="1" style="shape=rectangle;fillColor=#FFFFFF;strokeColor=#B7B9B9;fontSize=25.333333;fontStyle=0;fontColor=#111111;fontFamily=Calibri;whiteSpace=wrap;html=0;"><mxGeometry x="420" y="538" width="720" height="96" as="geometry"/></mxCell><mxCell id="cell14" value="B 보존: 비용 제약 또는 준비 적중 저하&#xa;무과금 모델이면 QA05 차이 재검토" vertex="1" parent="1" style="shape=rectangle;fillColor=#FFFFFF;strokeColor=#B7B9B9;fontSize=25.333333;fontStyle=0;fontColor=#111111;fontFamily=Calibri;whiteSpace=wrap;html=0;"><mxGeometry x="1140" y="538" width="720" height="96" as="geometry"/></mxCell><mxCell id="rule15" edge="1" parent="1"  style="edgeStyle=none;endArrow=none;strokeColor=#4676CB;dashed=0;strokeWidth=4;"><mxGeometry relative="1" as="geometry"><mxPoint x="420" y="214" as="sourcePoint"/><mxPoint x="420" y="214" as="targetPoint"/><Array as="points"><mxPoint x="1140" y="214"/><mxPoint x="1140" y="634"/><mxPoint x="420" y="634"/></Array></mxGeometry></mxCell><mxCell id="band16" value="보완 후보 A1: 다음 응답 하나만 준비 / 미적용, 미평가" vertex="1" parent="1" style="shape=rectangle;rounded=0;fillColor=#C9E1B3;strokeColor=#B7B9B9;strokeWidth=1.7;fontSize=27;fontStyle=1;verticalAlign=middle;spacingTop=0;dashed=0;fontFamily=Calibri;whiteSpace=wrap;html=0;"><mxGeometry x="60" y="673" width="1800" height="45" as="geometry"/></mxCell><mxCell id="limit" value="Speech Preparation Coordinator" vertex="1" parent="1" style="shape=rectangle;rounded=0;fillColor=#FFF6DD;strokeColor=#4676CB;strokeWidth=1.7;fontSize=26.666667;fontStyle=1;verticalAlign=top;spacingTop=5;dashed=0;fontFamily=Calibri;whiteSpace=wrap;html=0;"><mxGeometry x="60" y="750" width="900" height="175" as="geometry"/></mxCell><mxCell id="divider-limit" edge="1" parent="limit" style="endArrow=none;strokeColor=#4676CB;strokeWidth=1;"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="38" as="sourcePoint"/><mxPoint x="900" y="38" as="targetPoint"/></mxGeometry></mxCell><mxCell id="admission" value="Next Response Admission" vertex="1" parent="limit" style="shape=rectangle;rounded=1;fillColor=#FFFFFF;strokeColor=#4676CB;strokeWidth=1.7;fontSize=25.333333;fontStyle=0;verticalAlign=middle;spacingTop=0;dashed=0;fontFamily=Calibri;whiteSpace=wrap;html=0;"><mxGeometry x="30" y="60" width="380" height="65" as="geometry"/></mxCell><mxCell id="jobs" value="Preparation Jobs" vertex="1" parent="limit" style="shape=rectangle;rounded=1;fillColor=#FFFFFF;strokeColor=#4676CB;strokeWidth=1.7;fontSize=25.333333;fontStyle=0;verticalAlign=middle;spacingTop=0;dashed=0;fontFamily=Calibri;whiteSpace=wrap;html=0;"><mxGeometry x="510" y="60" width="350" height="65" as="geometry"/></mxCell><mxCell id="onejob" edge="1" parent="1" source="admission" target="jobs" style="exitX=1;exitY=0.49230769230769234;entryX=0;entryY=0.49230769230769234;exitPerimeter=0;entryPerimeter=0;edgeStyle=none;endArrow=block;strokeColor=#4676CB;dashed=0;strokeWidth=1.8;"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="842" as="sourcePoint"/><mxPoint x="570" y="842" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="text17" value="✓" vertex="1" parent="1" style="text;strokeColor=none;fillColor=none;fontSize=38.666667;align=center;fontStyle=1;fontColor=#C00000;fontFamily=Calibri;whiteSpace=wrap;html=0;"><mxGeometry x="1080" y="223" width="55" height="46" as="geometry"/></mxCell><mxCell id="text18" value="버려질 준비를 줄이는 대신, 순서가 바뀌면 준비되지 않은 항목을 기다린다.&#xa;기본 A의 값에 A1의 효과를 섞지 않는다. 같은 80개 입력으로 별도 평가한다." vertex="1" parent="1" style="text;strokeColor=none;fillColor=none;fontSize=25.333333;align=left;fontStyle=0;fontColor=#111111;fontFamily=Calibri;whiteSpace=wrap;html=0;"><mxGeometry x="1010" y="770" width="820" height="120" as="geometry"/></mxCell><mxCell id="text19" value="반대 사례: S01/S06 동점 / S03/S04 폐기 / S05 유효분 재사용과 후반 재개 / S08 준비 여유 50ms" vertex="1" parent="1" style="text;strokeColor=none;fillColor=none;fontSize=22.666667;align=left;fontStyle=0;fontColor=#111111;fontFamily=Calibri;whiteSpace=wrap;html=0;"><mxGeometry x="60" y="953" width="1800" height="40" as="geometry"/></mxCell><mxCell id="text20" value="가정 기반 합성 수치 / 실측 아님" vertex="1" parent="1" style="text;strokeColor=none;fillColor=none;fontSize=21.333333;align=right;fontStyle=0;fontColor=#50555B;fontFamily=Calibri;whiteSpace=wrap;html=0;"><mxGeometry x="1350" y="1009" width="510" height="28" as="geometry"/></mxCell><mxCell id="flowlabel21" value="최대 1개" vertex="1" parent="1" style="text;strokeColor=none;fillColor=#FFFFFF;fontSize=21.333333;align=center;fontFamily=Calibri;whiteSpace=wrap;html=0;"><mxGeometry x="470" y="810" width="100" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
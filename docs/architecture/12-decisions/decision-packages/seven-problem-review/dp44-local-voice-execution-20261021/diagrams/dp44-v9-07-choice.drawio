<mxfile host="app.diagrams.net"><diagram name="dp44-v9-07-choice" id="dp44-v9-07-choice"><mxGraphModel dx="1920" dy="1080" page="1" pageWidth="1920" pageHeight="1080"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="DP44. 선택과 보완" vertex="1" parent="1" style="text;strokeColor=none;fillColor=none;fontSize=44;fontStyle=1;align=left;fontFamily=Calibri;whiteSpace=wrap;html=0;"><mxGeometry x="60" y="29" width="1140" height="68" as="geometry"/></mxCell><mxCell id="subtitle" value="화면 첫 응답은 동점이다. 현 합성 조건에서는 QA03의 이익을 우선하여 A를 권고한다" vertex="1" parent="1" style="text;strokeColor=none;fillColor=none;fontSize=27;fontStyle=1;align=left;fontFamily=Calibri;whiteSpace=wrap;html=0;"><mxGeometry x="60" y="129" width="1800" height="47" as="geometry"/></mxCell><mxCell id="progress0" value="과제 소개" vertex="1" parent="1" style="shape=chevron;fillColor=#98999B;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontSize=19;fontStyle=1;fontFamily=Calibri;whiteSpace=wrap;html=0;"><mxGeometry x="1210" y="33" width="143" height="44" as="geometry"/></mxCell><mxCell id="progress1" value="요구사항 분석" vertex="1" parent="1" style="shape=chevron;fillColor=#98999B;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontSize=19;fontStyle=1;fontFamily=Calibri;whiteSpace=wrap;html=0;"><mxGeometry x="1344" y="33" width="143" height="44" as="geometry"/></mxCell><mxCell id="progress2" value="설계" vertex="1" parent="1" style="shape=chevron;fillColor=#35A8CD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontSize=19;fontStyle=1;fontFamily=Calibri;whiteSpace=wrap;html=0;"><mxGeometry x="1478" y="33" width="143" height="44" as="geometry"/></mxCell><mxCell id="progress3" value="구현 및 검증" vertex="1" parent="1" style="shape=chevron;fillColor=#98999B;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontSize=19;fontStyle=1;fontFamily=Calibri;whiteSpace=wrap;html=0;"><mxGeometry x="1612" y="33" width="143" height="44" as="geometry"/></mxCell><mxCell id="progress4" value="결론" vertex="1" parent="1" style="shape=chevron;fillColor=#98999B;strokeCo
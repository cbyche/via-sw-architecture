{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://via.local/schemas/core-dependency-mock-profile.schema.json",
  "title": "VIA Core-DP Dependency Mock Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "profile_revision",
    "dependency_role",
    "logical_instance_count",
    "evidence_label",
    "primary_timing_profile_id",
    "timing_profiles",
    "behavior_variants",
    "evidence_basis",
    "deterministic_seed"
  ],
  "properties": {
    "schema_version": {
      "const": "via.core-dependency-mock-profile.v0.1"
    },
    "profile_id": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "profile_revision": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "dependency_role": {
      "enum": [
        "s2s",
        "semantic_llm",
        "context_source",
        "downstream_agent",
        "streaming_asr"
      ]
    },
    "logical_instance_count": {
      "const": 1
    },
    "evidence_label": {
      "const": "MEASURED_MOCK_E2E"
    },
    "primary_timing_profile_id": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "timing_profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/timingProfile"
      }
    },
    "behavior_variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/behaviorVariant"
      }
    },
    "evidence_basis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidenceBasis"
      }
    },
    "deterministic_seed": {
      "type": "integer",
      "minimum": 0
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "scheduledEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_name",
        "clock_origin",
        "scheduled_offset_ms"
      ],
      "properties": {
        "event_name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "clock_origin": {
          "enum": [
            "audio_start",
            "referenced_audio_interval_end",
            "utterance_end",
            "source_available",
            "request_received",
            "fault_injected"
          ]
        },
        "scheduled_offset_ms": {
          "type": "number",
          "minimum": 0
        },
        "payload_fixture_ref": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "timingProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timing_profile_id",
        "role",
        "events"
      ],
      "properties": {
        "timing_profile_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "role": {
          "enum": [
            "primary",
            "fast_sensitivity",
            "slow_sensitivity",
            "fault"
          ]
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/scheduledEvent"
          }
        }
      }
    },
    "behaviorVariant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variant_id",
        "class",
        "event_fixture_ref"
      ],
      "properties": {
        "variant_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "class": {
          "enum": [
            "correct",
            "ambiguous",
            "corrected",
            "missing",
            "malformed",
            "duplicate",
            "late",
            "stale",
            "disconnect_reconnect",
            "timeout"
          ]
        },
        "event_fixture_ref": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "applicable_spine_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "uniqueItems": true
        }
      }
    },
    "evidenceBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "reference",
        "supported_claim"
      ],
      "properties": {
        "kind": {
          "enum": [
            "official_specification",
            "primary_research",
            "team_dependency_contract",
            "interface_precedent",
            "system_budget_allocation"
          ]
        },
        "reference": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "supported_claim": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    }
  }
}

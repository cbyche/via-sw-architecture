e="fontFamily=Apple SD Gothic Neo;edgeStyle=none;rounded=0;strokeColor=#18232E;strokeWidth=2;endArrow=open;endFill=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="999" y="607" /><mxPoint as="targetPoint" x="670" y="719" /><Array as="points"><mxPoint x="999" y="669" /><mxPoint x="670" y="669" /></Array></mxGeometry></mxCell><mxCell id="n38" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;각 소유자의 허용된 읽기 계약&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=23;fontColor=#5F6B77;fontStyle=0;"><mxGeometry as="geometry" x="64" y="684" width="400" height="29.900000000000002" /></mxCell><mxCell id="n39" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;출처·버전·누락 범위를&lt;br&gt;함께 확인해 공급&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=25;fontColor=#2858A5;fontStyle=1;"><mxGeometry as="geometry" x="64" y="757" width="352" height="65.0" /></mxCell><mxCell id="n40" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;이번 대상·Task는&lt;br&gt;현재 요청에서 판단&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=25;fontColor=#2858A5;fontStyle=1;"><mxGeometry as="geometry" x="824" y="757" width="350" height="65.0" /></mxCell><mxCell id="n41" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;과거 정정은 자동으로 장기 선호가 되지 않는다. 원본·파생 기억·현재 판단을 구별한다.&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=23;fontColor=#5F6B77;fontStyle=0;"><mxGeometry as="geometry" x="64" y="832" width="1120" height="29.900000000000002" /></mxCell><mxCell id="n42" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;01  검색 일치와 관계의 차이&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=28;fontColor=#2858A5;fontStyle=1;"><mxGeometry as="geometry" x="1260" y="364" width="596" height="36.4" /></mxCell><mxCell id="n43" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;‘보고서’라는 단어만 찾아서는&lt;br&gt;정정의 전후와 실제 제시를 모른다.&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=25;fontColor=#18232E;fontStyle=0;"><mxGeometry as="geometry" x="1260" y="411" width="596" height="70" /></mxCell><mxCell id="n44" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;02  반복 조합과 공통 생산 비용&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=28;fontColor=#2858A5;fontStyle=1;"><mxGeometry as="geometry" x="1260" y="515" width="596" height="36.4" /></mxCell><mxCell id="n45" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;요청별 결합 부담과 파생 기억의&lt;br&gt;생산·유지·미게시 범위를 비교한다.&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=25;fontColor=#18232E;fontStyle=0;"><mxGeometry as="geometry" x="1260" y="562" width="596" height="70" /></mxCell><mxCell id="n46" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;03  압축·오류·삭제의 파급&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=28;fontColor=#2858A5;fontStyle=1;"><mxGeometry as="geometry" x="1260" y="666" width="596" height="36.4" /></mxCell><mxCell id="n47" parent="1" vertex="1" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;요약이 조건을 잃거나 원본이 바뀌면&lt;br&gt;재사용 근거도 다시 확인해야 한다.&lt;/div&gt;" style="fontFamily=Apple SD Gothic Neo;text;html=1;whiteSpace=nowrap;overflow=visible;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=25;fontColor=#18232E;fontStyle=0;"><mxGeometry as="geometry" x="1260" y="713" width="596" height="70" /></mxCell></root></mxGraphModel></diagram></mxfile>

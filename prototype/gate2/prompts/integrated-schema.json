{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "referent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "version",
        "target_id"
      ],
      "properties": {
        "source_id": {
          "type": "string"
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "type",
        "condition"
      ],
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "type": {
          "enum": [
            "independent",
            "sequential",
            "data_dependent",
            "conditional"
          ]
        },
        "condition": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "request_revision",
    "requests",
    "relations",
    "clarification"
  ],
  "properties": {
    "status": {
      "enum": [
        "READY",
        "NEED_CONTEXT",
        "CLARIFY",
        "REJECT"
      ]
    },
    "request_revision": {
      "type": "integer",
      "minimum": 0
    },
    "requests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "referents",
          "constraints",
          "task_relation",
          "task_id",
          "handling",
          "required_capability"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "referents": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/referent"
            }
          },
          "constraints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "task_relation": {
            "enum": [
              "no_tracked_task",
              "new_task",
              "existing_task",
              "pending_interaction"
            ]
          },
          "task_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "handling": {
            "enum": [
              "direct_s2s_eligible",
              "bounded_core",
              "downstream_agent",
              "clarify",
              "reject"
            ]
          },
          "required_capability": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "clarification": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}

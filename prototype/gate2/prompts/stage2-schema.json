{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "request_revision",
    "associations",
    "correction_reason",
    "clarification"
  ],
  "properties": {
    "status": {
      "enum": [
        "READY",
        "CORRECT_STAGE1",
        "CLARIFY",
        "REJECT"
      ]
    },
    "request_revision": {
      "type": "integer",
      "minimum": 0
    },
    "associations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "task_relation",
          "task_id",
          "pending_interaction_id",
          "task_view_revision"
        ],
        "properties": {
          "request_id": {
            "type": "string"
          },
          "task_relation": {
            "enum": [
              "no_tracked_task",
              "new_task",
              "existing_task",
              "pending_interaction"
            ]
          },
          "task_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "pending_interaction_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "task_view_revision": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        }
      }
    },
    "correction_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "clarification": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}

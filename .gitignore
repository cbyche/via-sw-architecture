# Generated result formats
results/**/*.csv
results/**/*.jsonl
results/**/*.parquet
results/**/*.log

# Current Architecture campaigns keep reprocessable structured raw evidence in Git.
!results/architecture-evaluation/current/via-dp-*-evaluation-*/raw/*.jsonl
!results/architecture-evaluation/archive/pre-core-asr-reference-20260927/evidence/via-dp-*-evaluation-*/raw/*.jsonl

# DP41 PoC retains original observations and derived tables for reprocessing.
!results/architecture-evaluation/current/dp41-*/**/*.jsonl
!results/architecture-evaluation/current/dp41-*/**/*.csv
!results/architecture-evaluation/current/dp41-*/**/*.log

# Oversized excluded V3 raw is published losslessly as .jsonl.gz with SHA manifest.
results/architecture-evaluation/current/dp41-p21-mac-text-v3-20261012/workers/A2/trials-unjudged.jsonl
results/architecture-evaluation/current/dp41-p21-mac-text-v3-20261012/workers/A2/events.jsonl
results/architecture-evaluation/current/dp41-p21-mac-text-v3-20261012/workers/A2/effects.jsonl

# Four-DP expanded evidence is restored from the lossless publication bundle.
# Directly published reports are added only through the reviewed explicit file list.
results/architecture-evaluation/current/four-dp-qwen37-20261018/
results/architecture-evaluation/current/four-dp-qwen37-review-v2-20261018/

# Ephemeral controller lock; campaign status and ledgers are preserved separately.
results/architecture-evaluation/current/common9-poc-20261019/shared-paid-controller/controller.lock

# Physical audio captures remain on the target Mac; reports and digests are committed.
results/architecture-evaluation/current/**/artifacts/**/*.wav
results/architecture-evaluation/current/**/stimuli/*.wav

# Archived physical captures stay local just as they did in the originating current campaign.
results/architecture-evaluation/archive/pre-core-asr-reference-20260927/evidence/**/artifacts/**/*.wav
results/architecture-evaluation/archive/pre-core-asr-reference-20260927/evidence/**/stimuli/*.wav


+++ b/prototypes/dp00/crates/alternative-d/tests/qa03_e1_specialist.rs
@@ -0,0 +1,109 @@
+use std::collections::VecDeque;
+use std::sync::{Arc, Mutex};
+
+use alternative_d::AdaptiveVia;
+use bench_core::{
+    ArchitectureEvent, ArchitectureObservation, ArchitectureUnderTest, ExecutionId, ExecutionPort,
+    ExecutionRequest, ExecutionResult, InitialProductState, InputModality, ModelPort, ModelRequest,
+    ModelResponse, ModelStatus, ObservationPort, ProductFact, ResultId, TurnId, UserTurn,
+};
+
+#[derive(Clone)]
+struct Model(Arc<Mutex<VecDeque<String>>>);
+
+impl Model {
+    fn scripted(outputs: &[&str]) -> Self {
+        Self(Arc::new(Mutex::new(
+            outputs.iter().map(|value| (*value).to_owned()).collect(),
+        )))
+    }
+}
+
+impl ModelPort for Model {
+    type Error = String;
+
+    fn generate(&self, _request: ModelRequest) -> Result<ModelResponse, Self::Error> {
+        Ok(ModelResponse {
+            composite_output: self.0.lock().unwrap().pop_front().unwrap(),
+            model_status: ModelStatus::Completed,
+        })
+    }
+}
+
+#[derive(Clone, Default)]
+struct Executor(Arc<Mutex<Vec<ExecutionRequest>>>);
+
+impl ExecutionPort for Executor {
+    type Error = String;
+
+    fn execute(&self, request: ExecutionRequest) -> Result<ExecutionResult, Self::Error> {
+        self.0.lock().unwrap().push(request);
+        Ok(ExecutionResult {
+            execution_id: ExecutionId::from("e-summary"),
+            result_id: ResultId::from("r-summary"),
+            payload: "document summary".into(),
+        })
+    }
+}
+
+#[derive(Clone, Default)]
+struct Observations(Arc<Mutex<Vec<ArchitectureObservation>>>);
+
+impl ObservationPort for Observations {
+    fn emit(&self, observation: ArchitectureObservation) {
+        self.0.lock().unwrap().push(observation);
+    }
+}
+
+fn run(capability_present: bool) -> Result<(Executor, Observations), String> {
+    let model = Model::scripted(&["GENERAL_FILE_WORK", "DOCUMENT_SUMMARY_AGENT"]);
+    let executor = Executor::default();
+    let observations = Observations::default();
+    let mut architecture = AdaptiveVia::new(model, observations.clone(), executor.clone());
+    architecture.setup(InitialProductState {
+        capability_facts: capability_present
+            .then(|| ProductFact {
+                key: "executor".into(),
+                value: "DocumentSummaryAgent".into(),
+            })
+            .into_iter()
+            .collect(),
+        ..InitialProductState::default()
+    })?;
+    architecture.handle_user_turn(UserTurn {
+        turn_id: TurnId::from("turn-summary"),
+        modality: InputModality::Text,
+        content: "SUMMARIZE_DOCUMENT".into(),
+        context_evidence: Vec::new(),
+    })?;
+    Ok((executor, observations))
+}
+
+#[test]
+fn document_summary_agent_is_discoverable_routes_executes_and_binds_result() {
+    let (executor, observations) = run(true).expect("registered specialist succeeds");
+    let requests = executor.0.lock().unwrap();
+    assert_eq!(requests.len(), 1);
+    assert_eq!(
+        requests[0]
+            .route
+            .final_executor_id_if_known
+            .as_ref()
+            .unwrap()
+            .0,
+        "DocumentSummaryAgent"
+    );
+    assert!(
+        observations
+            .0
+            .lock()
+            .unwrap()
+            .iter()
+            .any(|item| item.event == ArchitectureEvent::ResultBound)
+    );
+}
+
+#[test]
+fn document_summary_agent_is_not_discoverable_without_capability_fact() {
+    assert!(run(false).is_err());
+}

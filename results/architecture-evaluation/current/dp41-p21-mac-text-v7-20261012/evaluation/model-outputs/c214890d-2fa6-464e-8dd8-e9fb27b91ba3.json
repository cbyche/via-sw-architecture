n      \"evidence\": [\"E6294\", \"E6416\"],\n      \"reason\": \"채택된 의미에 D1@v1 요약과 Cal13@v1 일정 조회라는 두 목표가 구분되어 있고, 모두 직접 응답으로 처리했습니다. 직접 처리는 허용된 방향입니다.\"\n    },\n    \"C2\": {\n      \"passed\": true,\n      \"evidence\": [\"E6346\", \"E6350\", \"P:1:c1d1ed1a-9334-4b47-ab92-3d57edf50907\", \"P:2:84605c1e-7b84-4e9d-9342-ae184798fa94\"],\n      \"reason\": \"D1@v1의 마감일 2026년 10월 15일과 담당자 민수, Cal13@v1의 10월 13일 09:00~09:30 팀 회의가 근거와 일치하며 다른 날짜나 일정은 추가되지 않았습니다.\"\n    },\n    \"C3\": {\n      \"passed\": true,\n      \"evidence\": [\"E6416\", \"E6436\"],\n      \"reason\": \"두 목표 모두 직접 응답으로 채택되어 새 Task에 위임되지 않았고, 기존 T보호는 목표에 연결되지 않았습니다.\"\n    },\n    \"C4\": {\n      \"passed\": true,\n      \"evidence\": [\"E6346\", \"E6350\", \"E6416\", \"E6432\"],\n      \"reason\": \"채택된 목표 사이에 의존 관계가 없으며 각 원본을 별도로 조회했습니다. 일정 조회는 요약 결과를 입력으로 사용하지 않았습니다.\"\n    },\n    \"C5\": {\n      \"passed\": true,\n      \"evidence\": [\"E6432\", \"E6436\", \"P:1:c1d1ed1a-9334-4b47-ab92-3d57edf50907\", \"P:2:84605c1e-7b84-4e9d-9342-ae184798fa94\"],\n      \"reason\": \"D1 요약 산출물이 생성되고 두 목표의 결과가 모두 실제 전달되었습니다. 외부 변경 효과는 관찰되지 않았습니다.\"\n    },\n    \"C6\": {\n      \"passed\": true,\n      \"evidence\": [\"P:1:c1d1ed1a-9334-4b47-ab92-3d57edf50907\", \"P:2:84605c1e-7b84-4e9d-9342-ae184798fa94\", \"E6459\", \"E6466\", \"E6473\", \"E6704\"],\n      \"reason\": \"두 결과가 구분되어 실제 표시 및 음성 전달되었습니다. 요약에는 10월 15일과 민수가, 일정에는 10월 13일 09:00 팀 회의가 포함됩니다.\"\n    }\n  },\n  \"reactions\": [\n    {\n      \"id\": \"I-S3-01-1\",\n      \"first_actual_publication_id\": \"P:1:c1d1ed1a-9334-4b47-ab92-3d57edf50907\",\n      \"valid_publication_id\": \"P:2:84605c1e-7b84-4e9d-9342-ae184798fa94\",\n      \"first_actual_core_quote\": \"하늘 프로젝트의 마감일은 2026년 10월 15일이고 담당자는 민수입니다.\",\n      \"valid_core_quote\": \"2026-10-13 09:00~09:30 팀 회의\",\n      \"wrong_first\": false,\n      \"evidence\": [\"P:1:c1d1ed1a-9334-4b47-ab92-3d57edf50907\", \"P:2:84605c1e-7b84-4e9d-9342-ae184798fa94\", \"E6473\", \"E6704\"],\n      \"reason\
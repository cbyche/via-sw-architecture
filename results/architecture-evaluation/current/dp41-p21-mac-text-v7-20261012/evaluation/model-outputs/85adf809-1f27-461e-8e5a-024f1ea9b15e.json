ION_READ에는 참조 자료가 없다. SalesH1@v1 및 2026년 1~6월 근거가 답변 처리에 사용됐다는 사실이 입증되지 않았다.\"\n    },\n    \"C3\": {\n      \"passed\": false,\n      \"evidence\": [\n        \"E21595\",\n        \"E21599\",\n        \"E21602\"\n      ],\n      \"reason\": \"목표에는 Q기간 참조가 있지만 기존 작업 대상 사용 불가로 실패했다. 답변이 T보고서/X보고서에 연결되어 전달된 사실은 없으며, 다른 작업이 무변경인 것만으로 연결 요건은 충족되지 않는다.\"\n    },\n    \"C4\": {\n      \"passed\": false,\n      \"evidence\": [\n        \"E21595\",\n        \"E21599\",\n        \"E21602\"\n      ],\n      \"reason\": \"의미상 상반기 답변이며 send/share 동의 확대는 없지만, 실행이 거부되어 기간이 실제로 확정되지 않았다.\"\n    },\n    \"C5\": {\n      \"passed\": false,\n      \"evidence\": [\n        \"E21599\",\n        \"E21602\",\n        \"P:1:978a33be-da7e-47d2-bf76-dfacc2921053\"\n      ],\n      \"reason\": \"목표 실행이 기존 작업 대상 사용 불가로 실패했고 실제 효과는 없다. 답변 접수나 질문 답변됨/기간 상반기 상태가 확인되지 않았다.\"\n    },\n    \"C6\": {\n      \"passed\": false,\n      \"evidence\": [\n        \"E21630\",\n        \"E21638\",\n        \"P:1:978a33be-da7e-47d2-bf76-dfacc2921053\"\n      ],\n      \"reason\": \"실제 전달된 음성은 상반기 답변 요청이 실패했다고 알린다. 답변이 접수됐다는 안내는 전달되지 않았다.\"\n    }\n  },\n  \"reactions\": [\n    {\n      \"id\": \"I-S6-04-1\",\n      \"first_actual_publication_id\": \"P:1:978a33be-da7e-47d2-bf76-dfacc2921053\",\n      \"valid_publication_id\": null,\n      \"first_actual_core_quote\": \"기존 작업 대상 사용 불가로 인해 '上半期' 답변 요청이 실패했습니다.\",\n      \"valid_core_quote\": null,\n      \"wrong_first\": false,\n      \"evidence\": [\n        \"E21599\",\n        \"E21630\",\n        \"E21638\",\n        \"P:1:978a33be-da7e-47d2-bf76-dfacc2921053\"\n      ],\n      \"reason\": \"실패를 알리는 응답이 실제 음성으로 전달됐지만, 유효 답변의 접수와 기간 안내라는 반응 종점은 달성되지 않았다. 전달된 실패 안내 자체는 실제 실패와 일치하므로 잘못된 첫 답변은 아니다.\"\n    }\n  ],\n  \"cycle\": {\n    \"valid_publication_id\": null,\n    \"valid_core_quote\": null,\n    \"evidence\": [\n      \"E21599\",\n      \"E21602\",\n      \"P:1:978a33be-da7e-47d2-bf76-dfacc2921053\"\n    ],\n    \"reason\": \"유효 기간 답변이 접수되거나 확정됐다는 안내가 없고
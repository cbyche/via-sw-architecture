:"{\n  \"conditions\": {\n    \"C1\": {\n      \"passed\": false,\n      \"evidence\": [\"E5793\", \"E6317\", \"E6319\", \"E6320\"],\n      \"reason\": \"사용자 발화에는 새 근거로 제안서를 만들어 달라는 목표가 있지만, VIA의 의미 제안과 채택은 예산 초과로 미해결 상태이며 요청이 실패했다. VIA가 목표를 이해했거나 준비되지 않은 자료를 이미 준비된 것으로 취급하지 않았다는 사실이 입증되지 않았다.\"\n    },\n    \"C2\": {\n      \"passed\": false,\n      \"evidence\": [\"E5780\", \"E5781\", \"E5784\", \"E5785\", \"E5788\", \"E5789\", \"E6319\", \"E6320\"],\n      \"reason\": \"E새와 두 비교·견적 원본 v1의 내용은 실제 게시됐지만, 이를 이번 제안서의 근거로 채택하거나 기존 관계와 구별했다는 증거가 없다. 의미는 미해결이고 요청은 실패했다.\"\n    },\n    \"C3\": {\n      \"passed\": false,\n      \"evidence\": [\"E6320\", \"T보호\"],\n      \"reason\": \"새 제안서 Task/Execution이 생성되지 않았다. T보호는 최종 상태에도 RUNNING으로 남아 있으나, 기존 제안서의 변경 없음까지 포함해 필수 연결·범위를 입증할 새 업무 결과가 없다.\"\n    },\n    \"C4\": {\n      \"passed\": false,\n      \"evidence\": [\"E5793\", \"E6319\", \"E6320\"],\n      \"reason\": \"납기 기준과 가격 평가 제외, 비교·견적의 역할 및 금액 존재와 평가 제외의 구별을 VIA가 보존했다는 채택된 의미나 결과가 없다.\"\n    },\n    \"C5\": {\n      \"passed\": false,\n      \"evidence\": [\"E6320\"],\n      \"reason\": \"요청이 실패했고 effects와 deliveries가 비어 있다. 유효 근거를 사용한 단일 접수나 올바른 ProposalFresh@v1 결과 반영이 발생하지 않았다.\"\n    },\n    \"C6\": {\n      \"passed\": false,\n      \"evidence\": [\"E6320\"],\n      \"reason\": \"실제 근거·접수 또는 최종 결과를 전달한 기록이 없다. 실패 사실과 완료되지 않았다는 응답도 전달되지 않았다.\"\n    }\n  },\n  \"reactions\": [\n    {\n      \"id\": \"I-S2-05-1\",\n      \"first_actual_publication_id\": null,\n      \"valid_publication_id\": null,\n      \"first_actual_core_quote\": null,\n      \"valid_core_quote\": null,\n      \"wrong_first\": false,\n      \"evidence\": [\"E6320\"],\n      \"reason\": \"요청 실패 뒤 실제 publication이나 전달된 응답이 없어 반응 endpoint가 관측되지 않았다.\"\n    }\n  ],\n  \"cycle\": {\n    \"valid_publication_id\": null,\n    \"valid_core_quote\": null,\n    \"evidence\": [\"E6320\"],\n    \"reason\": \"지정된 endpoint인 ProposalFresh@v1 최종 전달에 도달하지 않았다. 요청이 실패했고 결과 publication 및 전달이 없다.\"\n  },\n  \"critica
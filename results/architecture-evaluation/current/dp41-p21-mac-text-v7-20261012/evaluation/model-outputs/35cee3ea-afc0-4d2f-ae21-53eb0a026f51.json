5ac6d-f7c7-420c-9b8d-789029e6edf0\", \"E14329\", \"E14543\", \"E14024\", \"E14036\", \"E14430\"],\n      \"reason\": \"정정 명령은 T보고서에 연결됐고, 질문과 결과는 각각의 Task/Execution에 연결됐다. T메일과 T보호는 유지됐으며 메일에 대한 새 명령은 없다.\"\n    },\n    \"C4\": {\n      \"passed\": true,\n      \"evidence\": [\"CMD:c4f5ac6d-f7c7-420c-9b8d-789029e6edf0\", \"P옛설명\", \"P:6:1a57566f-fed0-4298-9178-d1d0e6765a16\", \"E14104\", \"E14114\", \"E14200\"],\n      \"reason\": \"보고서의 연도·분기·D1 근거와 메일 지시가 유지됐다. 기존 음성 중단과 Task 취소는 구별됐고, Task 취소 효과는 관찰되지 않았다. 새 음성은 발화 종료 뒤 시작됐다.\"\n    },\n    \"C5\": {\n      \"passed\": true,\n      \"evidence\": [\"CMD:c4f5ac6d-f7c7-420c-9b8d-789029e6edf0\", \"E14188\", \"E14329\", \"E14543\", \"E14024\", \"E14036\", \"E14427\", \"P:7:e0639ea3-63d5-4156-97ab-6b12d9a69925\"],\n      \"reason\": \"현재 권한·근거를 반영한 보고서 UPDATE 명령이 한 번 접수됐다. 두 결과 Task는 각각 완료됐고 질문 두 건은 실제 제시 후 답변 대기로 남았다. 현재 요청의 revision 2, TABLE 속성 및 D1@v1 근거로 결과 artifact가 생성·완료됐다. 임의 ANSWER/SEND 효과는 없다.\"\n    },\n    \"C6\": {\n      \"passed\": true,\n      \"evidence\": [\"P옛설명\", \"P:1:9031b7b3-5935-41d4-8450-245c049f2155\", \"P:2:5b2dc1d5-4eb0-4b4e-82c5-17ea319462ef\", \"P:3:3dc04d5d-c75c-4547-a3ab-cf716ddfed9b\", \"P:4:399fac1b-7f54-4cd8-91ad-88aaa019ce95\", \"P:5:869ac760-dd0b-4cb2-80c4-39371fe03835\", \"P:6:1a57566f-fed0-4298-9178-d1d0e6765a16\", \"P:7:e0639ea3-63d5-4156-97ab-6b12d9a69925\", \"E14329\", \"E14543\", \"E14467\"],\n      \"reason\": \"기존 음성 중단 후 발화가 끝난 뒤 새 음성이 시작됐다. 접수 시점에는 ACCEPTED/RUNNING으로 알렸고, 최종 결과는 완료 후 실제 전달됐다. 두 질문과 두 결과도 각각 실제 Text/Voice 전달 receipt가 있다.\"\n    }\n  },\n  \"reactions\": [\n    {\n      \"id\": \"I-S5-04-1\",\n      \"first_actual_publication_id\": null,\n      \"valid_publication_id\": null,\n      \"first_actual_core_quote\": null,\n      \"valid_core_quote\": null,\n      \"wrong_first\": false,\n      \"evidence\": [\"P옛설명\"],\n      \"reason\": \"자동 평가 대상인 기존 음성 중단 endpoint다.\"\n    },\n    {\n      \"id\": \"I-S5-04-2\",\n      \"first_actual_publication_id\": \"P:5:86
90-4b97-8d74-516409b1a1f7\",\"P:2:1e304909-c4d5-45d9-85bc-9000abe08778\",\"P:3:0ee7e147-01b2-414f-b083-b24de637b123\",\"P:4:4d6166a3-9bdd-44d7-a8d5-a2d7bc624b48\",\"P:6:db676009-b8dd-41b0-bba1-d55cacbbd754\",\"E11427\"],\"reason\":\"정정 명령은 T보고서에 연결됐고, 응답은 T메일이 RUNNING 상태로 유지됨을 나타냅니다. 각 질문 및 결과 발행물은 해당 Task/Execution에 연결되며 T보호는 RUNNING으로 유지됐습니다.\"},\"C4\":{\"passed\":true,\"evidence\":[\"TL:f06d3c7d364244b8b3acaa31126c146b:N2\",\"E11313\",\"E11334\",\"CMD:0e99db09-eaf5-4e84-b420-cd955a9523b3\",\"E11656\",\"P:6:db676009-b8dd-41b0-bba1-d55cacbbd754\"],\"reason\":\"보고서의 분기와 D1 근거가 유지됐고 메일 상태 및 지시도 변경되지 않았습니다. 옛 음성 중단은 업무 취소와 별개로 처리됐으며, 새 안내 음성은 사용자 발화 종료 후 시작했습니다. 보고서 결과는 실제 수정 payload에서 생성됐습니다.\"},\"C5\":{\"passed\":true,\"evidence\":[\"CMD:0e99db09-eaf5-4e84-b420-cd955a9523b3\",\"E11427\",\"E11243\",\"E11256\",\"E11483\",\"E11597\",\"E11656\",\"E11659\"],\"reason\":\"SET_PROPERTY 명령은 한 번 접수됐고, 두 결과 Task는 각각 완료됐으며 질문 둘은 실제 제시 후 답변 대기 상태로 남았습니다. 실제 payload로 현재 ReportBurst 결과가 생성됐고 중복 효과나 임의 ANSWER/SEND 효과는 관측되지 않았습니다.\"},\"C6\":{\"passed\":true,\"evidence\":[\"TL:f06d3c7d364244b8b3acaa31126c146b:N2\",\"E11313\",\"E11334\",\"P:1:85b4da2d-f690-4b97-8d74-516409b1a1f7\",\"P:2:1e304909-c4d5-45d9-85bc-9000abe08778\",\"P:3:0ee7e147-01b2-414f-b083-b24de637b123\",\"P:4:4d6166a3-9bdd-44d7-a8d5-a2d7bc624b48\",\"P:5:317aeeff-0e7c-4aac-9303-be04c3b6fd5b\",\"P:6:db676009-b8dd-41b0-bba1-d55cacbbd754\",\"P:7:02a393ea-8c5d-42e4-9251-36da07c007a8\",\"E11483\",\"E11597\",\"E11690\",\"E12301\"],\"reason\":\"기존 음성 중단이 관측됐고, 질문 둘과 결과 둘 모두 실제 Text/Voice 제시 및 전달 receipt가 있습니다. 수정 접수 응답은 접수 시점의 미완료 상태를 알렸고, 생성된 최종 결과는 완료와 올바른 매출 값을 전달했습니다. 새 음성은 사용자 발화 종료 뒤 시작했습니다.\"}},\"reactions\":[{\"id\":\"I-S5-04-1\",\"first_actual_publication_id\":null,\"valid_publication_id\":null,\"first_actual_core_quote\":null,\"valid_core_quote\":null,\"wrong_first\":false,\"evidence\":[\"P옛설명\",\"TL:f06d3c7d364244b8b3acaa31126c146b:N2\"],\"reason\":\"P옛설명에 대한 자동 평가 대상 로컬 중단 endpoint입니다.\"},{\"id\":\"I-S5-04-2\",\"fi
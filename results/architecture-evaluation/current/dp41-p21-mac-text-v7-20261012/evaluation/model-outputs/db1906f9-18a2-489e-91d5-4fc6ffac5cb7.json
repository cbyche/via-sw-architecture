ayload references the completed current summary artifact.\"\n    },\n    \"C5\": {\n      \"passed\": true,\n      \"evidence\": [\n        \"E8107\",\n        \"E8120\",\n        \"E8124\",\n        \"E8353\",\n        \"E8356\"\n      ],\n      \"reason\": \"The current summary artifact was ready before the single SEND_MAIL command was accepted. The mail effect used that artifact and reached SENT for Minsu. The duplicate summary event was ignored, with no duplicate send effect.\"\n    },\n    \"C6\": {\n      \"passed\": true,\n      \"evidence\": [\n        \"P:3:9dc942d1-65ea-4d4e-bb2e-c39968350f13\",\n        \"P:4:a66356a5-0d4f-4801-92d5-ab30c62b1800\",\n        \"E8356\"\n      ],\n      \"reason\": \"At the checkpoint, the delivered response truthfully reports that the Minsu mail task was accepted and gives the current summary content; it does not claim the mail was already sent. After the SENT result, the final delivered voice text correctly reports that the content was sent to Minsu.\"\n    }\n  },\n  \"reactions\": [\n    {\n      \"id\": \"I-S3-02-1\",\n      \"first_actual_publication_id\": \"P:1:56e45aa6-59bc-4034-9f2c-136df2aeb913\",\n      \"valid_publication_id\": \"P:3:9dc942d1-65ea-4d4e-bb2e-c39968350f13\",\n      \"first_actual_core_quote\": \"업무는 접수(ACCEPTED)되었으며, 현재 실행 중(RUNNING)입니다.\",\n      \"valid_core_quote\": \"민수에게 메일 발송 업무가 접수(ACCEPTED)되었습니다.\",\n      \"wrong_first\": false,\n      \"evidence\": [\n        \"E8163\",\n        \"E8746\",\n        \"E9081\",\n        \"P:1:56e45aa6-59bc-4034-9f2c-136df2aeb913\",\n        \"P:3:9dc942d1-65ea-4d4e-bb2e-c39968350f13\"\n      ],\n      \"reason\": \"The first core status update accurately says the summary task was accepted and running. The earliest response that reports the dependent mail acceptance, with the current summary as its body, is P:3.\"\n    }\n  ],\n  \"cycle\": {\n    \"valid_publication_id\": \"P:4:a66356a5-0d4f-4801-92d5-ab30c62b1800\",\n    \"valid_core_quote\": \"민수에게 '하늘 프로
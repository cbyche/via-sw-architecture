+ let mut replacement=json!({"section_id":section,"revision":new,"text":event["text"],"source_spans":event["source_spans"],"delivery_history":old["delivery_history"]});if !section_valid(&replacement,sources){return Err("INVALID_UPDATED_SECTION_OR_PROVENANCE".into());}

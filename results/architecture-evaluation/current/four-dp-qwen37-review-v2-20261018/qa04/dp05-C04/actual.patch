+// QA04 C04: incremental external artifacts are public state; domain work remains downstream.
+fn section_source(artifact:&str,section:&str)->String{format!("artifact/{}/section/{}",artifact,section)}
+fn register_section(sources:&mut Sources,artifact:&str,section:&str,value:&Value){let sid=section_source(artifact,section);let text=value["text"].as_str().unwrap();let lines=text.lines().count().max(1);sources.insert(sid.clone(),json!({"id":sid,"title":format!("{} / {}",artifact,section),"revision":value["revision"],"line_count":lines,"allowed_lines":[1,lines],"outline":[{"section":section,"lines":[1,lines]}],"text":text,"kind":"PUBLIC_AGENT_ARTIFACT_SECTION","original_source_spans":value["source_spans"],"revoked":false}));}
+fn section_valid(v:&Value,sources:&Sources)->bool{!v["text"].as_str().unwrap_or("").trim().is_empty()&&v["revision"].as_u64().is_some()&&!array(&v["source_spans"]).is_empty()&&array(&v["source_spans"]).iter().all(|p|valid_span(p,sources))}
+fn receive_artifact(artifacts:&mut Value,sources:&mut Sources,event:&Value)->Result<Value,String>{
+ let id=event["artifact_id"].as_str().ok_or("artifact id")?;let task=event["task_id"].as_str().ok_or("task id")?;let sections=array(&event["sections"]);if artifacts.get(id).is_some(){return Err("ARTIFACT_ALREADY_REGISTERED".into());}if sections.is_empty()||!sections.iter().all(|v|v["section_id"].is_string()&&section_valid(v,sources)){return Err("INVALID_INITIAL_SECTIONS_OR_PROVENANCE".into());}

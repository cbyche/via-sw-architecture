+fn delivered_provenance(outputs:&[Value],sources:&Sources,response:&str)->Value{
+ let Some(out)=outputs.iter().find(|o|o["goal_id"].as_str()==Some(response)&&o["content_contract_checked"]==true&&o["text"].as_str().map(|t|!t.is_empty()).unwrap_or(false))else{return json!({"status":"NO_MATCH","response_goal_id":response});};
+ let mut spans=Vec::new();for fact in array(&out["details"]["facts"]){let source=fact["source_id"].as_str().and_then(|id|sources.get(id));let status=match source{None=>"UNAVAILABLE",Some(s)if s["revoked"]==true=>"REVOKED",Some(s)if s["revision"]!=fact["revision"]=>"STALE",Some(_)=>"CURRENT"};let p=json!({"source_id":fact["source_id"],"revision":fact["revision"],"start_line":fact["start_line"],"end_line":fact["end_line"],"unit":"one_based_line_inclusive","current_use_status":status});if !spans.contains(&p){spans.push(p);}}
+ json!({"status":"DELIVERED","response_goal_id":response,"source_spans":spans,"historical_delivery_not_claimed_current":true})
+}
+#[cfg(test)]mod qa04_c05_tests{use super::*;
+ #[test]fn delivered_only_and_currentness(){let mut sources=Sources::new();sources.insert("s".into(),json!({"revision":2}));let delivered=json!({"goal_id":"g","content_contract_checked":true,"text":"Displayed actual answer","details":{"facts":[{"source_id":"s","revision":1,"start_line":2,"end_line":3}]}});let failed=json!({"goal_id":"failed","text":null,"status":"FAILED_CONTRACT"});let outputs=vec![delivered,failed];for _variant in ["A","B","C"]{let d=delivered_provenance(&outputs,&sources,"g");assert_eq!(d["status"],"DELIVERED");assert_eq!(d["source_spans"][0]["current_use_status"],"STALE");assert_eq!(delivered_provenance(&outputs,&sources,"failed")["status"],"NO_MATCH");assert_eq!(delivered_provenance(&outputs,&sources,"unpresented")["status"],"NO_MATCH");assert_eq!(d,delivered_provenance(&outputs,&sources,"g"));}}
+}

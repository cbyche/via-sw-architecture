+pub fn ranges_overlap(source:&Value,lo:u64,hi:u64)->bool{array(&source["withdrawn_ranges"]).iter().any(|r|r[0].as_u64().unwrap_or(u64::MAX)<=hi&&r[1].as_u64().unwrap_or(0)>=lo)}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qa-evaluation-contract-v1.schema.json",
  "title": "VIA QA Evaluation Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "contract_id",
    "contract_version",
    "status",
    "normative_entry_point",
    "immutability_rule",
    "reference_environment_id",
    "corpus_manifest_id",
    "decision_point_policy",
    "quality_attributes"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "contract_id": {"const": "qa-evaluation-contract-v1"},
    "contract_version": {"const": "1.0.0"},
    "status": {"const": "ACTIVE_NORMATIVE"},
    "normative_entry_point": {"const": "docs/evaluation/qa-contracts/v1/README.md"},
    "immutability_rule": {"type": "string", "minLength": 1},
    "reference_environment_id": {"const": "via-reference-environment-v1"},
    "corpus_manifest_id": {"const": "qa-v1-corpus-manifest-v1"},
    "decision_point_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["may_nominate_primary_qa_ids", "may_define_custom_metric", "may_define_custom_target", "may_define_custom_score_bands", "may_define_custom_population", "required_binding_schema"],
      "properties": {
        "may_nominate_primary_qa_ids": {"const": true},
        "may_define_custom_metric": {"const": false},
        "may_define_custom_target": {"const": false},
        "may_define_custom_score_bands": {"const": false},
        "may_define_custom_population": {"const": false},
        "required_binding_schema": {"const": "#/$defs/decisionPointEvaluationBinding"}
      }
    },
    "quality_attributes": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {"$ref": "#/$defs/qualityAttribute"}
    }
  },
  "$defs": {
    "qualityAttribute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["qa_id", "name", "official_scalar_metric", "unit", "direction", "formula", "measurement_boundary", "population_id", "planned_population", "failure_missing_treatment", "target", "score_bands", "diagnostics"],
      "properties": {
        "qa_id": {"type": "string", "pattern": "^QA-(0[1-9]|1[0-2])$"},
        "name": {"type": "string", "minLength": 1},
        "official_scalar_metric": {"type": "string", "minLength": 1},
        "unit": {"enum": ["seconds", "milliseconds", "percent", "x"]},
        "direction": {"enum": ["lower_is_better", "higher_is_better"]},
        "formula": {"type": "string", "minLength": 1},
        "measurement_boundary": {"type": "object", "required": ["start", "end"], "properties": {"start": {"type": "string", "minLength": 1}, "end": {"type": "string", "minLength": 1}}, "additionalProperties": true},
        "population_id": {"type": "string", "pattern": "^qa(0[1-9]|1[0-2])-[a-z0-9-]+-v1$"},
        "planned_population": {"type": "string", "minLength": 1},
        "failure_missing_treatment": {"type": "string", "minLength": 1},
        "target": {"$ref": "#/$defs/target"},
        "score_mapping_id": {"enum": ["success95", "containment90"]},
        "score_bands": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "#/$defs/scoreBand"}},
        "hard_eligibility_gates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/hardGate"}},
        "diagnostics": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operator", "value", "display"],
      "properties": {
        "operator": {"enum": ["<=", ">="]},
        "value": {"type": "number"},
        "display": {"type": "string", "minLength": 1}
      }
    },
    "scoreBand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "min", "min_inclusive", "max", "max_inclusive"],
      "properties": {
        "score": {"type": "integer", "minimum": 0, "maximum": 5},
        "min": {"type": ["number", "null"]},
        "min_inclusive": {"type": "boolean"},
        "max": {"type": ["number", "null"]},
        "max_inclusive": {"type": "boolean"}
      }
    },
    "hardGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "rule", "offsettable"],
      "properties": {
        "gate_id": {"type": "string", "minLength": 1},
        "triggers": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "rule": {"type": "string", "minLength": 1},
        "offsettable": {"const": false}
      }
    },
    "artifactIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "resultMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["qa_contract", "reference_environment", "corpus_manifest"],
      "properties": {
        "qa_contract": {"$ref": "#/$defs/artifactIdentity"},
        "reference_environment": {"$ref": "#/$defs/artifactIdentity"},
        "corpus_manifest": {"$ref": "#/$defs/artifactIdentity"}
      }
    },
    "decisionPointEvaluationBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dp_id", "qa_contract_id", "reference_environment_id", "corpus_manifest_id", "primary_qa_ids"],
      "properties": {
        "dp_id": {"type": "string", "pattern": "^DP-[0-9]{2,}$"},
        "qa_contract_id": {"const": "qa-evaluation-contract-v1"},
        "reference_environment_id": {"const": "via-reference-environment-v1"},
        "corpus_manifest_id": {"const": "qa-v1-corpus-manifest-v1"},
        "primary_qa_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^QA-(0[1-9]|1[0-2])$"}}
      }
    }
  }
}

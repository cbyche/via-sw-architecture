{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "historical-evidence-registry-v1.schema.json",
  "title": "VIA Historical Evidence Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "registry_id", "registry_version", "qa_contract_id", "classification_policy", "artifacts"],
  "properties": {
    "$schema": {"type": "string"},
    "registry_id": {"const": "historical-evidence-registry-v1"},
    "registry_version": {"const": "1.0.0"},
    "qa_contract_id": {"const": "qa-evaluation-contract-v1"},
    "classification_policy": {"const": "docs/evaluation/qa-contracts/v1/EVIDENCE-REUSE-POLICY.md"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/artifact"}
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "path", "experiment_family", "legacy_contract", "architecture_identity", "evidence_class", "candidate_qa_v1_usage", "reuse_role", "compatibility_checks", "limitations", "re_run_required"],
      "properties": {
        "artifact_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
        "path": {"type": "string", "minLength": 1},
        "experiment_family": {"type": "string", "minLength": 1},
        "legacy_contract": {"type": "string", "minLength": 1},
        "architecture_identity": {"type": "string", "minLength": 1},
        "evidence_class": {"enum": ["E0", "E1", "E2", "E3", "E4", "E5"]},
        "candidate_qa_v1_usage": {"type": "array", "items": {"type": "string", "pattern": "^QA-(0[1-9]|1[0-2])$"}, "uniqueItems": true},
        "reuse_role": {"type": "string", "minLength": 1},
        "compatibility_checks": {
          "type": "object",
          "additionalProperties": false,
          "required": ["metric_boundary", "population", "reference_environment", "architecture_identity", "required_observability", "provenance"],
          "properties": {
            "metric_boundary": {"type": "string", "minLength": 1},
            "population": {"type": "string", "minLength": 1},
            "reference_environment": {"type": "string", "minLength": 1},
            "architecture_identity": {"type": "string", "minLength": 1},
            "required_observability": {"type": "string", "minLength": 1},
            "provenance": {"type": "string", "minLength": 1}
          }
        },
        "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "re_run_required": {"type": "boolean"}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dp-vnext-catalog-v1.schema.json",
  "title": "VIA vNext Decision Point Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalog_id", "status", "qa_contract", "reference_environment", "corpus_manifest", "all_qa_ids", "selection_policy", "decision_points"],
  "properties": {
    "$schema": {"type": "string"},
    "catalog_id": {"const": "via-dp-vnext-catalog-v1"},
    "status": {"const": "ACTIVE"},
    "qa_contract": {"type": "string", "minLength": 1},
    "reference_environment": {"type": "string", "minLength": 1},
    "corpus_manifest": {"type": "string", "minLength": 1},
    "all_qa_ids": {"type": "array", "minItems": 12, "maxItems": 12, "uniqueItems": true, "items": {"type": "string", "pattern": "^QA-(0[1-9]|1[0-2])$"}},
    "selection_policy": {"type": "string", "minLength": 1},
    "decision_points": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/decision_point"}}
  },
  "$defs": {
    "alternative": {
      "type": "object", "additionalProperties": false,
      "required": ["alternative_id", "name", "classification"],
      "properties": {"alternative_id": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1}, "classification": {"enum": ["base_family", "base_alternative", "tactic_realization"]}, "inherits": {"type": "string", "minLength": 1}}
    },
    "decision_point": {
      "type": "object", "additionalProperties": false,
      "required": ["dp_id", "title", "decision_question", "status", "alternatives", "primary_qas", "all_qas_evaluated", "dependencies", "structural_discriminator", "excluded_mechanisms", "legacy_mapping"],
      "properties": {
        "dp_id": {"type": "string", "pattern": "^DP-[0-9]{2}$"}, "title": {"type": "string", "minLength": 1}, "decision_question": {"type": "string", "minLength": 1}, "status": {"const": "active"},
        "alternatives": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/alternative"}},
        "primary_qas": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^QA-(0[1-9]|1[0-2])$"}},
        "all_qas_evaluated": {"const": true}, "dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "structural_discriminator": {"type": "string", "minLength": 20}, "excluded_mechanisms": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "legacy_mapping": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}

{
  "bootstrap": {
    "confidence_level": 0.95,
    "interval_endpoint_estimator": "nearest-rank",
    "method": "paired-stratified-by-cycle-half-and-first-mode",
    "purpose": "DIAGNOSTIC_ONLY",
    "random_seed": 20260911,
    "resamples": 10000
  },
  "contract_version": "dp00-calibration-acceptance-v1",
  "cycle_drift": {
    "early_cycles": [0, 1, 2, 3, 4, 5, 6, 7],
    "late_cycles": [8, 9, 10, 11, 12, 13, 14, 15],
    "mode_pass_requires": [
      "absolute_early_late_p50_shift_within_margin",
      "absolute_theil_sen_predicted_cycle0_to_15_shift_within_margin"
    ],
    "modes": ["CAPTURE", "MINIMAL"],
    "predicted_shift_cycle_span": 15,
    "slope_estimator": "theil-sen-median-of-all-pairwise-cycle-p50-slopes"
  },
  "ftol_boundary": "UsefulOutcomeObserved.timestamp-AcousticEos.timestamp",
  "margin": {
    "baseline": "pooled-QA01-correctness-qualified-MINIMAL-p50-FTOL",
    "fraction": 0.05,
    "project_engineering_threshold": true
  },
  "measured_cycle_count": 16,
  "mode_order_interaction": {
    "delta": "FTOL_CAPTURE-FTOL_MINIMAL",
    "required_first_mode_balance_per_identical_pair": {
      "CAPTURE": 8,
      "MINIMAL": 8
    },
    "statistic": "abs(median(delta|CAPTURE-first)-median(delta|MINIMAL-first))"
  },
  "outlier_policy": "NO_EXCLUSION",
  "percentile_estimator": "linear-interpolated-(n-1)",
  "qualification": "QA01_EXACT_CORRECTNESS_QUALIFIED_COMPLETE_PAIRS_ONLY"
}
